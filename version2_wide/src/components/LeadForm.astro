---
// Форма заявки. Может стоять на странице несколько раз (попап и футер) — у каждой свой prefix.
// layout: stack — поля столбиком (попап); row — горизонтально (тёмный блок над футером).
// tone: light — на светлом фоне; dark — на тёмном.
// Нужна и на страницах продуктов (этап 2).
import Icon from './Icon.astro';
import { PRODUCTS, PRODUCT_ORDER, CONTACTS, FORM_ENDPOINT, withBase } from '../config/site';

interface Props {
  prefix?: string;
  layout?: 'stack' | 'row';
  tone?: 'light' | 'dark';
}

const { prefix = 'lf', layout = 'stack', tone = 'light' } = Astro.props;
const id = (s: string) => `${prefix}-${s}`;
---

<form class:list={['lf', `lf--${layout}`, `lf--${tone}`]} data-lead-form data-endpoint={FORM_ENDPOINT} novalidate>
  <div class="lf__fields" data-lf-fields>
    <div class="lf__field lf__name" data-field="name">
      <label for={id('name')}>Имя<span class="lf__req" aria-hidden="true">*</span></label>
      <input id={id('name')} name="name" type="text" autocomplete="name" required aria-describedby={id('name-err')} />
      <p class="lf__err" id={id('name-err')} data-err>Укажите имя</p>
    </div>
    <div class="lf__field lf__phone" data-field="phone">
      <label for={id('phone')}>Телефон<span class="lf__req" aria-hidden="true">*</span></label>
      <input
        id={id('phone')}
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        required
        aria-describedby={id('phone-err')}
      />
      <p class="lf__err" id={id('phone-err')} data-err>Укажите телефон</p>
    </div>

    <fieldset class="lf__field lf__interest">
      <legend>Что интересно</legend>
      <div class="lf__chips">
        {
          PRODUCT_ORDER.map((pid) => (
            <label class="chip" style={`--pc:${PRODUCTS[pid].color}`}>
              <input type="checkbox" name="interest" value={pid} data-interest-box />
              <span class="chip__box" aria-hidden="true">
                <Icon name="check" size={13} strokeWidth={3} />
              </span>
              {PRODUCTS[pid].name}
            </label>
          ))
        }
        <label class="chip chip--all">
          <input type="checkbox" name="interest_all" value="all" data-interest-all />
          <span class="chip__box" aria-hidden="true">
            <Icon name="check" size={13} strokeWidth={3} />
          </span>
          Всё вместе
        </label>
      </div>
    </fieldset>

    <div class="lf__field lf__consent-field" data-field="consent">
      <label class="lf__consent">
        <input type="checkbox" name="consent" required aria-describedby={id('consent-err')} />
        <span class="chip__box" aria-hidden="true">
          <Icon name="check" size={13} strokeWidth={3} />
        </span>
        <span>Соглашаюсь на обработку персональных данных</span>
      </label>
      <p class="lf__docs">
        <a href={withBase('/soglasie')}>Согласие на обработку персональных данных</a>
        <span aria-hidden="true">·</span>
        <a href={withBase('/politika')}>Политика конфиденциальности</a>
      </p>
      <p class="lf__err" id={id('consent-err')} data-err>Отметьте согласие на обработку персональных данных</p>
    </div>

    <div class="lf__submit">
      <button type="submit" class="btn btn--primary lf__btn" data-submit>
        <span class="lf__btn-text">Отправить заявку</span>
        <span class="lf__spinner" aria-hidden="true"></span>
        <Icon name="arrow-right" />
      </button>
      <p class="lf__hint">Свяжемся в ближайший рабочий день</p>
    </div>

    <p class="lf__fail" data-fail role="alert" hidden>
      Не получилось отправить заявку. Позвоните <a href={CONTACTS.phoneHref} data-goal="phone_click">{CONTACTS.phone}</a>
      или напишите на <a href={CONTACTS.emailHref}>{CONTACTS.email}</a>
    </p>
  </div>

  <div class="lf__done" data-done role="status" hidden>
    <span class="lf__done-icon"><Icon name="check" size={28} strokeWidth={2.5} /></span>
    <p>Заявка отправлена. Свяжемся в ближайший рабочий день</p>
  </div>
</form>

<style>
  /* ── Тона ─────────────────────────────────────────────── */
  .lf--light {
    --f-bg: var(--surface);
    --f-border: #c7cbd2;
    --f-border-hover: #676b72;
    --f-focus: var(--ink);
    --f-text: var(--ink);
    --f-label: #2a2d33;
    --f-muted: #676b72;
    --f-chip-bg: var(--surface);
    --f-box-on: var(--ink);
    --f-box-check: #fff;
    --f-ring: rgb(11 12 15 / 0.08);
    --f-err: var(--danger);
  }

  .lf--dark {
    --f-bg: rgb(255 255 255 / 0.05);
    --f-border: rgb(255 255 255 / 0.16);
    --f-border-hover: rgb(255 255 255 / 0.4);
    --f-focus: #fff;
    --f-text: #fff;
    --f-label: #d6d8dc;
    --f-muted: #a1a5ad;
    --f-chip-bg: rgb(255 255 255 / 0.04);
    --f-box-on: #fff;
    --f-box-check: var(--ink);
    --f-ring: rgb(255 255 255 / 0.1);
    --f-err: #ff8a95;
  }

  .lf {
    position: relative;
    color: var(--f-text);
  }

  .lf__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 16px;
  }

  .lf__interest,
  .lf__consent-field,
  .lf__submit,
  .lf__fail {
    grid-column: 1 / -1;
  }

  .lf__field {
    display: grid;
    align-content: start;
    gap: 8px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .lf__field > label,
  .lf__field legend {
    padding: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--f-label);
  }

  .lf__field legend {
    margin-bottom: 10px;
  }

  .lf__req {
    margin-left: 2px;
    color: var(--c-robot);
  }

  .lf--dark .lf__req {
    color: #a594ff;
  }

  input[type='text'],
  input[type='tel'] {
    width: 100%;
    min-height: 52px;
    padding: 12px 16px;
    border: 1px solid var(--f-border);
    border-radius: 14px;
    background: var(--f-bg);
    color: var(--f-text);
    font-size: 16px;
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      background-color 0.2s;
  }

  input[type='text']:hover,
  input[type='tel']:hover {
    border-color: var(--f-border-hover);
  }

  input[type='text']:focus,
  input[type='tel']:focus {
    outline: none;
    border-color: var(--f-focus);
    box-shadow: 0 0 0 4px var(--f-ring);
  }

  .lf__err {
    display: none;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--f-err);
  }

  .is-invalid .lf__err {
    display: block;
    animation: err-in 0.3s var(--ease-out);
  }

  @keyframes err-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  .is-invalid input[type='text'],
  .is-invalid input[type='tel'] {
    border-color: var(--f-err);
  }

  /* Чипы «Что интересно» */
  .lf__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 16px 0 12px;
    border: 1px solid var(--f-border);
    border-radius: 999px;
    background: var(--f-chip-bg);
    font-size: 14.5px;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .chip:hover {
    border-color: var(--f-border-hover);
  }

  .chip input,
  .lf__consent input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .chip__box {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    flex: none;
    border: 1.5px solid var(--f-border);
    border-radius: 5px;
    color: transparent;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .chip input:checked ~ .chip__box,
  .lf__consent input:checked ~ .chip__box {
    background: var(--f-box-on);
    border-color: var(--f-box-on);
    color: var(--f-box-check);
  }

  .lf--light .chip:has(input:checked) {
    border-color: var(--ink);
    background: color-mix(in oklab, var(--pc, var(--c-robot)) 10%, white);
  }

  .lf--dark .chip:has(input:checked) {
    border-color: color-mix(in oklab, var(--pc, #fff) 70%, white);
    background: color-mix(in oklab, var(--pc, #fff) 22%, transparent);
  }

  .chip input:focus-visible ~ .chip__box,
  .lf__consent input:focus-visible ~ .chip__box {
    outline: 2px solid var(--f-focus);
    outline-offset: 2px;
  }

  .chip.is-flash {
    animation: flash 1.2s var(--ease-out);
  }

  @keyframes flash {
    0% {
      box-shadow: 0 0 0 0 rgb(107 77 255 / 0.6);
    }
    100% {
      box-shadow: 0 0 0 12px rgb(107 77 255 / 0);
    }
  }

  .lf__consent {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 15px;
    cursor: pointer;
  }

  .lf__consent .chip__box {
    margin-top: 1px;
  }

  .lf__docs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    padding-left: 32px;
    font-size: 13px;
    color: var(--f-muted);
  }

  .lf__docs a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklab, currentColor 40%, transparent);
  }

  .lf__docs a:hover {
    color: var(--f-text);
    text-decoration-color: currentColor;
  }

  .is-invalid .lf__consent .chip__box {
    border-color: var(--f-err);
  }

  .lf__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .lf__btn {
    min-height: 54px;
    padding: 0 28px;
  }

  .lf--dark .lf__btn {
    --btn-bg: #fff;
    --btn-fg: var(--ink);
  }

  .lf__spinner {
    display: none;
    width: 18px;
    height: 18px;
    border: 2px solid color-mix(in oklab, currentColor 30%, transparent);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  .lf.is-sending .lf__spinner {
    display: block;
  }

  .lf.is-sending .lf__btn :global(svg) {
    display: none;
  }

  .lf.is-sending .lf__btn {
    pointer-events: none;
    opacity: 0.85;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .lf__hint {
    font-size: 14px;
    color: var(--f-muted);
  }

  .lf__fail {
    padding: 14px 16px;
    border: 1px solid rgb(214 41 59 / 0.35);
    border-radius: 12px;
    background: rgb(214 41 59 / 0.08);
    font-size: 15px;
  }

  .lf__fail a {
    font-weight: 600;
    text-decoration: underline;
    white-space: nowrap;
  }

  .lf__done {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: 32px 28px;
    border-radius: var(--radius-lg);
    background: var(--f-bg);
    border: 1px solid var(--f-border);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    animation: done-in 0.6s var(--ease-out);
  }

  .lf__done-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--f-box-on);
    color: var(--f-box-check);
    animation: pop 0.6s var(--ease-out) 0.1s both;
  }

  @keyframes done-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes pop {
    from {
      transform: scale(0.4);
    }
  }

  /* ── Горизонтальная раскладка ─────────────────────────── */
  @media (min-width: 1100px) {
    .lf--row .lf__fields {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(300px, 0.85fr);
      grid-template-areas:
        'name phone submit'
        'interest interest consent'
        'fail fail fail';
      column-gap: 14px;
      row-gap: 26px;
    }

    .lf--row .lf__name {
      grid-area: name;
    }

    .lf--row .lf__phone {
      grid-area: phone;
    }

    .lf--row .lf__interest {
      grid-area: interest;
    }

    .lf--row .lf__consent-field {
      grid-area: consent;
      align-self: center;
      padding-left: 22px;
      border-left: 1px solid var(--f-border);
    }

    .lf--row .lf__fail {
      grid-area: fail;
    }

    /* кнопка на одной линии с полями; подпись под ней */
    .lf--row .lf__submit {
      grid-area: submit;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      padding-top: 26px;
    }

    .lf--row .lf__btn {
      min-height: 52px;
    }

    .lf--row .lf__docs {
      flex-direction: column;
      gap: 4px;
    }

    .lf--row .lf__docs span[aria-hidden] {
      display: none;
    }

    .lf--row .lf__hint {
      font-size: 13px;
      text-align: center;
    }

  }

  @media (max-width: 560px) {
    .lf__fields {
      grid-template-columns: 1fr;
    }

    .lf__btn {
      width: 100%;
    }

    .lf__docs {
      flex-direction: column;
      gap: 6px;
    }

    .lf__docs span[aria-hidden] {
      display: none;
    }
  }
</style>

<script>
  import { PRODUCT_ORDER, type ProductId } from '../config/site';
  import { getInterest, setInterest, INTEREST_EVENT } from '../scripts/interest';
  import { goal } from '../scripts/goals';

  const UTM_KEY = 'qodex:utm';

  // UTM-метки запоминаются с первого захода на сайт
  try {
    const params = new URLSearchParams(location.search);
    const utm = [...params].filter(([k]) => k.startsWith('utm_'));
    if (utm.length) sessionStorage.setItem(UTM_KEY, JSON.stringify(Object.fromEntries(utm)));
  } catch {
    /* нет доступа к хранилищу */
  }

  const validators: Record<string, (f: HTMLFormElement) => boolean> = {
    name: (f) => (f.elements.namedItem('name') as HTMLInputElement).value.trim().length > 0,
    phone: (f) => (f.elements.namedItem('phone') as HTMLInputElement).value.replace(/\D/g, '').length >= 10,
    consent: (f) => (f.elements.namedItem('consent') as HTMLInputElement).checked,
  };

  function setup(form: HTMLFormElement) {
    const boxes = [...form.querySelectorAll<HTMLInputElement>('[data-interest-box]')];
    const all = form.querySelector<HTMLInputElement>('[data-interest-all]')!;
    const fields = form.querySelector<HTMLElement>('[data-lf-fields]')!;
    const done = form.querySelector<HTMLElement>('[data-done]')!;
    const fail = form.querySelector<HTMLElement>('[data-fail]')!;

    const syncAll = () => (all.checked = boxes.every((b) => b.checked));

    const applyInterest = (ids: ProductId[], flash: boolean) => {
      boxes.forEach((b) => {
        const on = ids.includes(b.value as ProductId);
        if (flash && on && !b.checked) {
          const chip = b.closest<HTMLElement>('.chip')!;
          chip.classList.remove('is-flash');
          void chip.offsetWidth;
          chip.classList.add('is-flash');
        }
        b.checked = on;
      });
      syncAll();
    };

    applyInterest(getInterest(), false);
    document.addEventListener(INTEREST_EVENT, (e) => applyInterest((e as CustomEvent<ProductId[]>).detail, true));

    const saveInterest = () => setInterest(boxes.filter((b) => b.checked).map((b) => b.value as ProductId));
    boxes.forEach((b) => b.addEventListener('change', saveInterest));
    all.addEventListener('change', () => {
      boxes.forEach((b) => (b.checked = all.checked));
      saveInterest();
    });

    const check = (key: string): boolean => {
      const wrap = form.querySelector<HTMLElement>(`[data-field="${key}"]`)!;
      const ok = validators[key](form);
      wrap.classList.toggle('is-invalid', !ok);
      wrap.querySelector('input')!.setAttribute('aria-invalid', String(!ok));
      return ok;
    };

    Object.keys(validators).forEach((key) => {
      const input = form.querySelector<HTMLInputElement>(`[data-field="${key}"] input`)!;
      input.addEventListener(input.type === 'checkbox' ? 'change' : 'blur', () => {
        if (input.type !== 'checkbox' && !input.value) return;
        check(key);
      });
      input.addEventListener('input', () => {
        if (form.querySelector(`[data-field="${key}"]`)!.classList.contains('is-invalid')) check(key);
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      fail.hidden = true;
      const results = Object.keys(validators).map(check);
      if (results.includes(false)) {
        form.querySelector<HTMLInputElement>('.is-invalid input')?.focus();
        return;
      }

      const interest = boxes.filter((b) => b.checked).map((b) => b.value as ProductId);
      let utm: Record<string, string> = {};
      try {
        utm = JSON.parse(sessionStorage.getItem(UTM_KEY) ?? '{}');
      } catch {
        /* пусто */
      }
      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') ?? '').trim(),
        phone: String(data.get('phone') ?? '').trim(),
        interest: PRODUCT_ORDER.filter((pid) => interest.includes(pid)),
        // заявку с отмеченным Tracker обрабатываем как запрос демо, пилот по нему не обещаем
        trackerDemo: interest.includes('tracker'),
        utm,
        page: location.href,
      };

      form.classList.add('is-sending');
      try {
        const endpoint = form.dataset.endpoint;
        if (endpoint) {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error(String(res.status));
        } else {
          // Адрес отправки ещё не подключён: имитация. ?form=error показывает состояние ошибки.
          await new Promise((r) => setTimeout(r, 900));
          if (new URLSearchParams(location.search).get('form') === 'error') throw new Error('demo');
          console.info('[QODEX] Заявка (адрес отправки не задан):', payload);
        }
        goal('form_submit', { products: payload.interest });
        fields.hidden = true;
        done.hidden = false;
      } catch {
        fail.hidden = false;
      } finally {
        form.classList.remove('is-sending');
      }
    });
  }

  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach(setup);
</script>
