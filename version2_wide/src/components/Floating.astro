---
// Плавающие кнопки связи (телефон первым) на компьютере и баннер cookies.
// На телефоне и планшете их нет: телефон и «Запустить пилот» уже в шапке.
import Icon from './Icon.astro';
import { CONTACTS, withBase } from '../config/site';
---

<div class="fab" data-fab>
  <a href={CONTACTS.phoneHref} class="fab__btn" data-goal="phone_click" aria-label={`Позвонить ${CONTACTS.phone}`}>
    <Icon name="phone" size={20} />
    <span class="fab__tip">{CONTACTS.phone}</span>
  </a>
  <a
    href={CONTACTS.telegramHref}
    class="fab__btn fab__btn--tg"
    target="_blank"
    rel="noopener"
    data-goal="telegram_click"
    aria-label={`Написать в Telegram ${CONTACTS.telegram}`}
  >
    <Icon name="send" size={20} />
    <span class="fab__tip">Telegram {CONTACTS.telegram}</span>
  </a>
</div>

<div class="cookie" data-cookie hidden>
  <p>
    Мы используем файлы cookie, чтобы сайт работал корректно. Подробнее — в&nbsp;<a href={withBase('/politika')}
      >политике конфиденциальности</a
    >.
  </p>
  <button type="button" class="btn btn--ghost btn--sm" data-cookie-ok>Понятно</button>
</div>

<style>
  .fab {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    display: grid;
    gap: 10px;
    animation: fab-in 0.6s var(--ease-out) 1.6s both;
  }

  @keyframes fab-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .fab__btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
    transition:
      transform 0.3s var(--ease-out),
      background-color 0.2s,
      color 0.2s;
  }

  .fab__btn:hover {
    transform: translateY(-2px);
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }

  .fab__btn--tg {
    color: var(--c-tracker);
  }

  .fab__tip {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    padding: 6px 10px;
    border-radius: 8px;
    background: var(--ink);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transform: translate(6px, -50%);
    pointer-events: none;
    transition:
      opacity 0.2s,
      transform 0.3s var(--ease-out);
  }

  .fab__btn:hover .fab__tip,
  .fab__btn:focus-visible .fab__tip {
    opacity: 1;
    transform: translate(0, -50%);
  }

  .cookie {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 480px;
    padding: 14px 14px 14px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-lg);
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--muted);
    animation: fab-in 0.5s var(--ease-out) 2s both;
  }

  .cookie a {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--ink);
  }

  .cookie[hidden] {
    display: none;
  }

  /* Телефон и планшет: плавающих кнопок нет, всё нужное в шапке */
  @media (max-width: 1120px) {
    .fab {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .cookie {
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      max-width: none;
    }
  }
</style>

<script>
  const KEY = 'qodex:cookie-ok';
  const cookie = document.querySelector<HTMLElement>('[data-cookie]');
  if (cookie) {
    let seen = false;
    try {
      seen = localStorage.getItem(KEY) === '1';
    } catch {
      /* хранилище недоступно */
    }
    cookie.hidden = seen;
    cookie.querySelector('[data-cookie-ok]')!.addEventListener('click', () => {
      cookie.hidden = true;
      try {
        localStorage.setItem(KEY, '1');
      } catch {
        /* хранилище недоступно */
      }
    });
  }
</script>
