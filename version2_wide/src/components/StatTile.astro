---
// Плитка цифры: крупное значение, подпись, мелко — продукт. Вариант forecast — для прогнозов, feature — главная плитка.
import { PRODUCTS, type ProductId } from '../config/site';

interface Props {
  /** Знак перед числом: «+», «−», «>». */
  prefix?: string;
  /** Число для досчёта и его вид на странице (с запятой, неразрывными пробелами). */
  count?: number;
  decimals?: number;
  value: string;
  /** Единицы после числа — крупно. */
  unit?: string;
  /** Хвост значения — мелко, в той же строке. */
  tail?: string;
  caption: string;
  product?: ProductId;
  forecast?: boolean;
  feature?: boolean;
  index?: number;
  class?: string;
}

const {
  prefix,
  count,
  decimals = 0,
  value,
  unit,
  tail,
  caption,
  product,
  forecast = false,
  feature = false,
  index = 0,
  class: className,
} = Astro.props;
const p = product ? PRODUCTS[product] : null;
---

<div
  class:list={['stat', product && `p-${product}`, { 'stat--forecast': forecast, 'stat--feature': feature }, className]}
  style={`--d:${index}`}
  data-reveal
>
  {feature && <div class="stat__grid" aria-hidden="true" />}
  <p class="stat__product label" hidden={!p && feature}>
    {
      p ? (
        <>
          <span class="tag__dot" aria-hidden="true" />
          {p.name}
        </>
      ) : (
        <span aria-hidden="true">—</span>
      )
    }
  </p>
  <p class="stat__value num">
    <span class="stat__v">
      {prefix}<span data-count={count} data-decimals={decimals}>{value}</span>{unit}
    </span>
    {tail && <span class="stat__tail">{tail}</span>}
  </p>
  {forecast && <span class="tag tag--forecast stat__badge">прогноз</span>}
  <p class="stat__caption">{caption}</p>
</div>

<style>
  .stat {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(22px, 2.6vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }

  .stat:hover {
    box-shadow: var(--shadow);
  }

  /* Лёгкое наполнение: еле заметная сетка цвета продукта, без свечений */
  .stat::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(color-mix(in oklab, var(--pc, var(--ink)) 11%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, var(--pc, var(--ink)) 11%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: -1px -1px;
  }

  .stat--feature::before {
    display: none;
  }

  .stat__product {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--subtle);
  }

  .stat__value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: auto;
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    font-weight: 700;
    line-height: 1;
    color: var(--pc-num, var(--pc-ink, var(--ink)));
  }

  .stat__v {
    white-space: nowrap;
  }

  .stat__tail {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }

  .stat--forecast .stat__value {
    color: var(--muted);
    font-weight: 500;
  }

  .stat__badge {
    align-self: flex-start;
  }

  .stat__caption {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
    max-width: 40ch;
  }

  /* Главная плитка: тёмная, с огромной четырёхцветной цифрой */
  .stat--feature {
    border-color: var(--night);
    background: var(--night);
    color: var(--night-text);
  }

  .stat--feature .stat__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse at 30% 60%, #000 20%, transparent 80%);
  }

  .stat--feature::after {
    content: '';
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    width: 420px;
    height: 300px;
    left: -80px;
    right: auto;
    top: auto;
    bottom: -120px;
    background: var(--c-robot);
    opacity: 0.35;
    filter: blur(80px);
  }

  .stat--feature .stat__product {
    color: var(--night-muted);
  }

  .stat--feature .stat__value {
    font-size: clamp(6rem, 13vw, 11rem);
    letter-spacing: -0.06em;
    color: #fff;
  }

  .stat--feature .stat__caption {
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    color: #fff;
    max-width: 22ch;
  }
</style>
