---
// Заглушка под скриншот в тёмной «оконной» рамке. Позже заменяется на <img> (WebP/AVIF) с тем же соотношением сторон.
import Icon from './Icon.astro';

interface Props {
  /** Что будет на скриншоте. */
  caption: string;
  /** Метка в заголовке окна, например «РО-БОТ». */
  fig?: string;
  demo?: boolean;
  ratio?: string;
  /** Подпись под скриншотом (figcaption), а не внутри заглушки. */
  captionBelow?: boolean;
  class?: string;
}

const { caption, fig, demo = false, ratio = '16 / 10', captionBelow = false, class: className } = Astro.props;
---

<figure class:list={['shot', className]} style={`--ratio:${ratio}`}>
  <div class="shot__frame">
    <div class="shot__bar" aria-hidden="true">
      <span></span><span></span><span></span>
      {fig && <em class="label">{fig}</em>}
    </div>
    <div class="shot__body">
      <div class="shot__grid" aria-hidden="true"></div>
      <div class="shot__scan" aria-hidden="true"></div>
      <div class="shot__label">
        <span class="shot__icon"><Icon name="image" size={20} /></span>
        <span class="label">Скриншот</span>
        {!captionBelow && <p>{caption}</p>}
        {demo && <span class="tag tag--demo">демо-данные</span>}
      </div>
      <i class="shot__corner shot__corner--tl" aria-hidden="true"></i>
      <i class="shot__corner shot__corner--tr" aria-hidden="true"></i>
      <i class="shot__corner shot__corner--bl" aria-hidden="true"></i>
      <i class="shot__corner shot__corner--br" aria-hidden="true"></i>
      <slot />
    </div>
  </div>
  {captionBelow && <figcaption class="shot__caption">{caption}</figcaption>}
</figure>

<style>
  .shot {
    width: 100%;
  }

  .shot__frame {
    border: 1px solid #23262d;
    border-radius: var(--radius);
    background: var(--night-2);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .shot__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border-bottom: 1px solid var(--night-line);
    background: var(--night);
  }

  .shot__bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #2c3038;
  }

  .shot__bar em {
    margin-left: auto;
    font-style: normal;
    font-size: 13px;
    color: var(--night-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .shot__body {
    position: relative;
    aspect-ratio: var(--ratio);
    display: grid;
    place-items: center;
    padding: 28px;
    overflow: hidden;
    color: var(--night-muted);
  }

  .shot__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 85%);
  }

  /* Медленная «сканирующая» полоса */
  .shot__scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0 45%, rgb(255 255 255 / 0.04) 50%, transparent 55% 100%);
    background-size: 100% 220%;
    animation: scan 6s linear infinite;
  }

  @keyframes scan {
    from {
      background-position: 0 100%;
    }
    to {
      background-position: 0 -120%;
    }
  }

  .shot__label {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 10px;
    max-width: 40ch;
    text-align: center;
  }

  .shot__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--night-line-2);
    border-radius: 10px;
    color: #fff;
  }

  .shot__label p {
    font-size: 14.5px;
    line-height: 1.45;
    color: #c9ccd2;
    text-wrap: balance;
  }

  .shot__label .label {
    font-size: 13px;
  }

  .shot__label .tag--demo {
    background: #fff;
    color: var(--ink);
  }

  .shot__corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid rgb(255 255 255 / 0.35);
  }

  .shot__corner--tl {
    top: 14px;
    left: 14px;
    border-width: 1.5px 0 0 1.5px;
  }

  .shot__corner--tr {
    top: 14px;
    right: 14px;
    border-width: 1.5px 1.5px 0 0;
  }

  .shot__corner--bl {
    bottom: 14px;
    left: 14px;
    border-width: 0 0 1.5px 1.5px;
  }

  .shot__corner--br {
    bottom: 14px;
    right: 14px;
    border-width: 0 1.5px 1.5px 0;
  }

  .shot__caption {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }
</style>
