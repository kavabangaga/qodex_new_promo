---
import SectionHead from '../components/SectionHead.astro';
import ProductHow from '../components/ProductHow.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { PRODUCTS, type ProductId } from '../config/site';

const NB = ' ';

type Item = {
  id: ProductId;
  icon: IconName;
  shot: { caption: string; demo?: boolean };
  steps: string[];
  benefits: string[];
  note: string;
};

const items: Item[] = [
  {
    id: 'robot',
    icon: 'users',
    shot: { caption: 'Сверка базы начислений с ГИС ЖКХ — список расхождений с источником и датой.', demo: true },
    steps: [
      'Вы выгружаете базу начислений в Excel — интеграция не нужна.',
      'РО-БОТ сверяет её с ГИС ЖКХ, Росреестром, ФИАС и ФНС.',
      'Вы получаете список расхождений с источником и датой.',
      'Сотрудник подтверждает расхождения, и данные уходят в биллинг или 1С одной кнопкой.',
    ],
    benefits: [
      `+4${NB}548 жителей (+10%) за один день сверки в одном районе — ≈7,5${NB}млн${NB}₽ в год.`,
      `145${NB}494 квартиры сверены за 5${NB}дней. Вручную это ≈560 рабочих дней сотрудника.`,
    ],
    note: 'Разные пилоты, регионы не раскрываются. Ничего не начисляется автоматически: решение по расхождениям принимает ваш сотрудник.',
  },
  {
    id: 'tracker',
    icon: 'truck',
    shot: { caption: 'Кадры с четырёх камер — ИИ считает контейнеры, спорные случаи диспетчер проверяет по фото.' },
    steps: [
      'Четыре камеры на мусоровозе снимают площадку до и после погрузки. Водитель ничего не нажимает.',
      'ИИ считает контейнеры: 96,4% — сам, спорные 3,6% диспетчер проверяет по фото.',
      'Tracker сверяет погрузку с планом маршрута. Итог по площадке в течение дня: норма, недовывоз или левак.',
    ],
    benefits: [
      `20${NB}минут в день на сверку вместо 2${NB}часов: −83% времени диспетчера.`,
      'Жалоба жителя закрывается за минуты: фото «до» и «после» без выезда на площадку.',
      'Фото и видео вывоза с координатами и временем — доказательство в споре с перевозчиком или юрлицом.',
    ],
    note: 'Оборудование и монтаж камер — на QODEX.',
  },
  {
    id: 'tonn',
    icon: 'scale',
    shot: { caption: 'Кабинет регоператора — начисления площадкам, выполнение терсхемы, акты с фото.' },
    steps: [
      'Номер машины распознаётся на въезде.',
      'Вес и фото кузова записываются без ручного ввода.',
      'Акт сразу попадает в облако — задним числом его не исправить.',
      'О подозрительном взвешивании система сразу уведомляет.',
    ],
    benefits: [
      '−57% тоннажа в актах: март 2025 к марту 2024, 4 района Башкортостана.',
      'Одни и те же взвешивания сразу видят и объект, и регоператор.',
      `Соответствует п.${NB}36 ПП №${NB}567 и передаёт данные во ФГИС УТКО.`,
    ],
    note: `Работает с любыми автовесами. Монтаж от 3${NB}дней.`,
  },
  {
    id: 'kodeks',
    icon: 'database',
    shot: { caption: 'Список актов — проверены и готовы к отправке во ФГИС УТКО.' },
    steps: [
      'Регистрация за минуту.',
      'Ключ доступа к ФГИС (ObjectID и AccessKey) — поможем получить.',
      'Выгрузка Excel из вашей учётной системы: файл разбирается на акты автоматически, есть готовый шаблон.',
      'Проверка до отправки: ошибки и дубли ловятся до ФГИС, повторно тот же акт не добавить.',
      'Отправка во ФГИС УТКО по API.',
    ],
    benefits: [`Подключение за 15${NB}минут.`, 'Без сложных внедрений, доработок 1С и обучения персонала.'],
    note: 'Подходит объектам, которым нужно начать передачу данных уже сейчас. Следующий шаг — QODEX TONN.',
  },
];
---

<section class="section section--white" id="interfeysy">
  <div class="container">
    <SectionHead idx="07" label="Как работают продукты">Работающие системы, а не концепция</SectionHead>

    <div class="ifx" data-ifx>
      <div class="ifx__tabs" role="tablist" aria-label="Продукты" data-reveal>
        {
          items.map((it, i) => (
            <button
              class:list={['ifx__tab', `p-${it.id}`]}
              type="button"
              role="tab"
              id={`ifx-tab-${it.id}`}
              aria-controls={`ifx-panel-${it.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="ifx__tab-icon">
                <Icon name={it.icon} size={20} />
              </span>
              <span class="ifx__tab-name">{PRODUCTS[it.id].name}</span>
            </button>
          ))
        }
      </div>

      {
        items.map((it, i) => (
          <div class:list={['ifx__item', `p-${it.id}`]}>
            <button
              class="ifx__acc"
              type="button"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`ifx-panel-${it.id}`}
            >
              <span class="ifx__tab-icon">
                <Icon name={it.icon} size={18} />
              </span>
              <span>{PRODUCTS[it.id].name}</span>
              <Icon name="plus" size={20} class="ifx__acc-plus" />
            </button>
            <div
              class="ifx__panel"
              id={`ifx-panel-${it.id}`}
              role="tabpanel"
              aria-labelledby={`ifx-tab-${it.id}`}
              hidden={i !== 0}
            >
              <ProductHow id={it.id} shot={it.shot} steps={it.steps} benefits={it.benefits} note={it.note} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Единый фирменный цвет для всех продуктов в этом блоке */
  :global(#interfeysy .p-robot),
  :global(#interfeysy .p-tracker),
  :global(#interfeysy .p-tonn),
  :global(#interfeysy .p-kodeks) {
    --pc: var(--accent);
    --pc-ink: var(--accent);
    --pc-glow: #b69cff;
    --pc-on: #fff;
  }

  /* Вкладки — крупные карточки продуктов */
  .ifx__tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 14px;
  }

  .ifx__tab {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    color: var(--ink);
    text-align: left;
    transition:
      background-color 0.3s,
      border-color 0.3s,
      color 0.3s,
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .ifx__tab:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--pc) 40%, var(--line));
    box-shadow: var(--shadow);
  }

  .ifx__tab-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: var(--surface);
    color: var(--ink-2);
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .ifx__tab-name {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .ifx__tab-idx {
    font-size: 13px;
    color: var(--subtle);
  }

  .ifx__tab[aria-selected='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    transform: translateY(-2px);
    box-shadow:
      0 0 0 4px var(--accent-soft),
      0 22px 44px -18px rgb(109 40 246 / 0.65);
  }

  .ifx__tab[aria-selected='true'] .ifx__tab-icon {
    border-color: transparent;
    background: rgb(255 255 255 / 0.18);
    color: #fff;
  }

  .ifx__tab[aria-selected='true'] .ifx__tab-idx {
    color: var(--pc-on);
    opacity: 0.75;
  }

  .ifx__acc {
    display: none;
  }

  /* Телефон: раскрывающиеся списки */
  @media (max-width: 860px) {
    .ifx__tabs {
      display: none;
    }

    .ifx__item + .ifx__item {
      margin-top: 10px;
    }

    .ifx__acc {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      min-height: 68px;
      padding: 12px 14px;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--paper);
      font-size: 17px;
      font-weight: 600;
      text-align: left;
      transition:
        background-color 0.3s,
        color 0.3s;
    }

    .ifx__acc :global(.ifx__acc-plus) {
      margin-left: auto;
      color: var(--subtle);
      transition: transform 0.35s var(--ease-out);
    }

    .ifx__acc[aria-expanded='true'] {
      background: var(--pc);
      border-color: var(--pc);
      color: var(--pc-on);
    }

    .ifx__acc[aria-expanded='true'] .ifx__tab-icon {
      background: color-mix(in oklab, var(--pc-on) 16%, transparent);
      color: var(--pc-on);
    }

    .ifx__acc[aria-expanded='true'] :global(.ifx__acc-plus) {
      transform: rotate(45deg);
      color: var(--pc-on);
    }

    .ifx__panel {
      padding-top: 10px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-ifx]');

  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const accs = [...root.querySelectorAll<HTMLButtonElement>('.ifx__acc')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const mobile = window.matchMedia('(max-width: 860px)');
    let active = 0;
    const open = new Set<number>([0]);

    const apply = () => {
      if (mobile.matches) {
        panels.forEach((p, i) => (p.hidden = !open.has(i)));
        accs.forEach((a, i) => a.setAttribute('aria-expanded', String(open.has(i))));
      } else {
        panels.forEach((p, i) => (p.hidden = i !== active));
        tabs.forEach((t, i) => {
          t.setAttribute('aria-selected', String(i === active));
          t.tabIndex = i === active ? 0 : -1;
        });
      }
    };

    tabs.forEach((t, i) =>
      t.addEventListener('click', () => {
        active = i;
        apply();
      }),
    );

    root.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key !== 'ArrowRight' && key !== 'ArrowLeft') return;
      e.preventDefault();
      active = (active + (key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      apply();
      tabs[active].focus();
    });

    accs.forEach((a, i) =>
      a.addEventListener('click', () => {
        open.has(i) ? open.delete(i) : open.add(i);
        apply();
      }),
    );

    mobile.addEventListener('change', apply);
    apply();
  }
</script>
