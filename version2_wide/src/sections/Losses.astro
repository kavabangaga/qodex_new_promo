---
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { PRODUCTS, productHref, type ProductId } from '../config/site';

const NB = ' ';

const rows: { problem: string; meaning: string; loss: string; forecast?: boolean; product: ProductId }[] = [
  {
    problem: 'Жильцов нет в базе',
    meaning: 'Живут четверо, а платит один',
    loss: `≈7,5${NB}млн${NB}₽/год на район`,
    product: 'robot',
  },
  {
    problem: 'Юрлица без договора',
    meaning: 'Бизнес работает, а договора нет',
    loss: `До 26% юрлиц вне базы и долг за 3${NB}года`,
    product: 'robot',
  },
  {
    problem: 'Рейсы без контроля',
    meaning: 'Левак и недовывоз не видны',
    loss: `≈180${NB}тыс.${NB}₽/год на машину`,
    forecast: true,
    product: 'tracker',
  },
  {
    problem: 'Приписки в актах',
    meaning: 'По бумагам тонн больше, чем по факту',
    loss: 'До 57% тоннажа — «бумажные» тонны',
    product: 'tonn',
  },
  {
    problem: 'Данные не во ФГИС',
    meaning: 'Объекты не передают данные — баланс ТКО не сходится',
    loss: `До 150${NB}000${NB}₽ штрафа`,
    product: 'kodeks',
  },
];
---

<section class="section section--white" id="poteri">
  <div class="container">
    <SectionHead idx="03" label="Где теряете деньги">
      Проверьте, где вы теряете деньги, — а мы сразу покажем решение
      <Fragment slot="lead">Отметьте то, что узнаёте у себя, — покажем, с чего начать.</Fragment>
    </SectionHead>

    <div class="table-wrap loss" data-reveal data-losses>
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Проблема</th>
            <th scope="col">Что это значит</th>
            <th scope="col">Сколько вы теряете</th>
            <th scope="col">Решение</th>
            <th scope="col" class="loss__th-toggle">Узнаю у себя</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r, i) => (
              <tr class:list={['loss__row', `p-${r.product}`]} data-row data-product={r.product}>
                <th scope="row" class="loss__problem">
                  {r.problem}
                </th>
                <td data-label="Что это значит">{r.meaning}</td>
                <td data-label="Сколько вы теряете" class:list={['loss__amount', { 'is-forecast': r.forecast }]}>
                  <span class="loss__sum">{r.loss}</span>
                  {r.forecast && <span class="tag tag--forecast">прогноз</span>}
                </td>
                <td data-label="Решение">
                  <a
                    href={productHref(r.product, 'poteri')}
                    class="product-link"
                    data-goal="product_landing"
                    data-goal-product={r.product}
                  >
                    <span class="tag__dot" aria-hidden="true" />
                    {PRODUCTS[r.product].name}
                  </a>
                </td>
                <td class="loss__toggle">
                  <label class="switch">
                    <input type="checkbox" role="switch" data-goal="selfcheck_toggle" data-goal-product={r.product} />
                    <span class="switch__track" aria-hidden="true">
                      <span class="switch__knob" />
                    </span>
                    <span class="switch__text">Узнаю у себя</span>
                    <span class="visually-hidden">: {r.problem}</span>
                  </label>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="result" data-result aria-live="polite">
      <div class="result__clip">
        <div class="result__panel">
          <div class="result__body">
            <p class="result__row">
              <strong>С чего начать:</strong>
              <span class="result__products" data-result-products></span>
            </p>
            <p class="result__row result__step">
              Первый шаг: <span data-result-step></span>
            </p>
          </div>
          <a href="#forma" class="btn btn--primary btn--light" data-result-cta data-goal="selfcheck_to_form">
            Перейти к заявке
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>

    <p class="footnote loss__notes" data-reveal>
      ≈7,5&nbsp;млн&nbsp;₽ и 26% — данные разных пилотов РО-БОТа. ≈180&nbsp;тыс.&nbsp;₽ — прогноз, а не фактический
      результат. 57% — март 2025 к марту 2024, 4 района Башкортостана. Штраф — ч.&nbsp;13 ст.&nbsp;8.2 КоАП.
    </p>
  </div>
</section>

<style>
  .loss.table-wrap {
    background: var(--paper);
  }

  .loss .table th,
  .loss .table td {
    vertical-align: middle;
  }

  .loss .table thead th {
    background: var(--paper-2);
  }

  .loss__row {
    cursor: pointer;
    transition: background-color 0.3s;
  }

  .loss__row > * {
    position: relative;
  }

  .loss__row:hover {
    background: rgb(255 255 255 / 0.7);
  }

  .loss__row.is-on {
    background: color-mix(in oklab, var(--pc) 9%, white);
  }

  .loss__row.is-on .loss__problem::before {
    transform: scaleY(1);
  }

  .loss__problem {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.015em;
    min-width: 210px;
  }

  .loss__problem::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 4px;
    border-radius: 0 4px 4px 0;
    background: var(--pc);
    transform: scaleY(0);
    transition: transform 0.35s var(--ease-out);
  }

  .loss__n {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--subtle);
  }

  .loss__amount {
    font-weight: 600;
    color: var(--ink);
  }

  .loss__sum {
    font-variant-numeric: tabular-nums;
  }

  /* Прогноз оформлен иначе, чем фактические потери */
  .loss__amount.is-forecast .loss__sum {
    font-weight: 500;
    color: var(--muted);
    text-decoration: underline dashed var(--subtle);
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .loss__amount .tag {
    margin-left: 8px;
    vertical-align: 1px;
  }

  .loss__th-toggle {
    width: 1%;
    white-space: nowrap;
    text-align: right !important;
  }

  .loss__toggle {
    text-align: right !important;
  }

  /* Переключатель */
  .switch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    min-height: 44px;
  }

  .switch input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .switch__track {
    position: relative;
    width: 48px;
    height: 28px;
    flex: none;
    border-radius: 999px;
    background: var(--line-2);
    transition: background-color 0.3s;
  }

  .switch__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(11 12 15 / 0.3);
    transition: transform 0.45s var(--ease-out);
  }

  .switch input:checked + .switch__track {
    background: var(--pc);
  }

  .switch input:checked + .switch__track .switch__knob {
    transform: translateX(20px);
  }

  .switch input:focus-visible + .switch__track {
    outline: 2px solid var(--pc);
    outline-offset: 3px;
  }

  .switch__text {
    display: none;
    font-size: 14px;
    font-weight: 500;
  }

  /* Панель результата */
  .result {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s var(--ease-out);
  }

  .result.is-open {
    grid-template-rows: 1fr;
  }

  .result__clip {
    overflow: hidden;
    padding: 0 2px;
  }

  .result__panel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 16px 0 4px;
    padding: 22px 24px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--radius-lg);
    background: var(--night);
    color: #fff;
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.4s,
      transform 0.6s var(--ease-out);
  }

  .result.is-open .result__panel {
    opacity: 1;
    transform: none;
  }

  .result__body {
    display: grid;
    gap: 10px;
  }

  .result__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 16px;
  }

  .result__row strong {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .result__products {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .result__products :global(.tag) {
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.16);
    color: #fff;
    animation: chip-in 0.4s var(--ease-out) both;
  }

  @keyframes chip-in {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
  }

  .result__step {
    color: rgb(255 255 255 / 0.72);
  }

  .result__step span {
    color: #fff;
    font-weight: 600;
  }

  .loss__notes {
    margin-top: 20px;
    max-width: 880px;
  }

  /* Телефон: строки превращаются в карточки */
  @media (max-width: 900px) {
    .loss.table-wrap {
      border: 0;
      background: none;
      box-shadow: none;
      overflow: visible;
    }

    .loss .table thead {
      display: none;
    }

    .loss .table,
    .loss .table tbody {
      display: grid;
      gap: 12px;
    }

    .loss__row {
      display: grid;
      grid-template-columns: 1fr;
      padding: 18px 18px 8px;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--paper);
      overflow: hidden;
    }

    .loss .table th,
    .loss .table td {
      display: block;
      padding: 0;
      border: 0;
    }

    .loss__problem {
      font-size: 16px;
      margin-bottom: 12px;
      min-width: 0;
    }

    .loss__problem::before {
      left: -18px;
      top: -18px;
      bottom: auto;
      height: calc(100% + 36px);
    }

    .loss .table td[data-label] {
      padding: 10px 0;
      border-top: 1px dashed var(--line-2);
      font-size: 15px;
    }

    .loss .table td[data-label]::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 4px;
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 400;
      color: var(--subtle);
    }

    .loss__toggle {
      text-align: left !important;
      border-top: 1px solid var(--line-2) !important;
      margin-top: 4px;
    }

    .switch__text {
      display: inline;
    }

    .result__panel {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<script>
  import { PRODUCTS, PRODUCT_ORDER, type ProductId } from '../config/site';
  import { addInterest, removeInterest } from '../scripts/interest';

  const root = document.querySelector<HTMLElement>('[data-losses]');
  const result = document.querySelector<HTMLElement>('[data-result]');

  if (root && result) {
    const rows = [...root.querySelectorAll<HTMLTableRowElement>('[data-row]')];
    const productsEl = result.querySelector<HTMLElement>('[data-result-products]')!;
    const stepEl = result.querySelector<HTMLElement>('[data-result-step]')!;
    const cta = result.querySelector<HTMLAnchorElement>('[data-result-cta]')!;

    const checkedProducts = (): ProductId[] => {
      const set = new Set(
        rows.filter((r) => r.querySelector('input')!.checked).map((r) => r.dataset.product as ProductId),
      );
      return PRODUCT_ORDER.filter((id) => set.has(id));
    };

    // Правило первого шага из ТЗ
    const firstStep = (ids: ProductId[]): string => {
      if (ids.includes('robot')) return 'бесплатный пилот РО-БОТа на одном районе';
      if (ids.includes('tonn')) return 'месяц бесплатно после запуска';
      if (ids.includes('kodeks')) return 'неделя бесплатно';
      return 'покажем демо';
    };

    const render = () => {
      const ids = checkedProducts();
      result.classList.toggle('is-open', ids.length > 0);
      if (!ids.length) return;
      productsEl.innerHTML = ids
        .map(
          (id, i) =>
            `<span class="tag p-${id}" style="animation-delay:${i * 60}ms"><span class="tag__dot"></span>${PRODUCTS[id].name}</span>`,
        )
        .join('');
      stepEl.textContent = firstStep(ids);
    };

    rows.forEach((row) => {
      const input = row.querySelector<HTMLInputElement>('input')!;
      input.addEventListener('change', () => {
        row.classList.toggle('is-on', input.checked);
        const product = row.dataset.product as ProductId;
        if (input.checked) addInterest([product]);
        else if (!checkedProducts().includes(product)) removeInterest([product]);
        render();
      });
      // Клик по строке тоже переключает, кроме ссылок и самого переключателя
      row.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a, label, input')) return;
        input.click();
      });
    });

    cta.addEventListener('click', () => addInterest(checkedProducts()));
  }
</script>
