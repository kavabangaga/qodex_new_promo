---
import Faq from '../components/Faq.astro';
import { FAQ } from '../data/faq';
---

<section class="section section--white" id="voprosy">
  <div class="container q">
    <header class="q__head">
      <span class="eyebrow label" data-reveal>
        <span class="eyebrow__dot" aria-hidden="true"></span>
        <span>Вопросы</span>
      </span>
      <h2 class="h2" data-reveal style="--d:1">Частые вопросы</h2>
    </header>
    <Faq items={FAQ} />
  </div>
</section>

<style>
  .q {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.6fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .q__head {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    display: grid;
    gap: 18px;
  }

  @media (min-width: 1600px) {
    :global(html.wide) .q {
      grid-template-columns: minmax(0, 0.5fr) minmax(0, 2fr);
    }
  }

  @media (max-width: 900px) {
    .q {
      grid-template-columns: 1fr;
    }

    .q__head {
      position: static;
    }
  }
</style>
