---
import SectionHead from '../components/SectionHead.astro';
import ProductTag from '../components/ProductTag.astro';
import type { ProductId } from '../config/site';

const NB = ' ';

const items: { when: string; text: string; products: ProductId[]; draft?: boolean }[] = [
  {
    when: `1${NB}января 2026.`,
    text: 'Весовой контроль на объектах стал обязательным. РЭО запретил загружать данные во ФГИС УТКО файлом.',
    products: ['tonn', 'kodeks'],
  },
  {
    when: `1${NB}сентября 2026.`,
    text: `Действуют новые Единые требования к объектам — ПП №${NB}567. По п.${NB}36 объект оснащается системой весового контроля и автоматизированной системой учёта и передачи данных во ФГИС УТКО.`,
    products: ['tonn'],
  },
  {
    when: `509 из 1100.`,
    text: 'Столько объектов подключили весовые посты к ФГИС УТКО на февраль 2026.',
    products: ['kodeks'],
  },
  {
    when: `3${NB}года.`,
    text: `За такой срок можно взыскать плату с юрлица, которое работало без договора: договор считается заключённым на типовых условиях (п.${NB}8(17) Правил №${NB}1156), срок исковой давности — ст.${NB}196 ГК РФ. Чем раньше найдено юрлицо, тем больше долга можно вернуть.`,
    products: ['robot'],
  },
  {
    when: 'Готовится.',
    text: 'Минприроды готовит передачу во ФГИС УТКО данных о начислениях и задолженности перед регоператорами, а сведения по жилым помещениям будут приходить туда из ГИС ЖКХ автоматически. Тогда расхождения в базе увидит и регулятор.',
    products: ['robot'],
    draft: true,
  },
];
---

<section class="section" id="pochemu-seychas">
  <div class="container">
    <SectionHead idx="04" label="Почему сейчас">
      Почему этим стоит заняться в 2026 году
      <Fragment slot="lead">
        Требования к данным об отходах ужесточились, а плату за прошлые периоды можно взыскать только за три года.
      </Fragment>
    </SectionHead>
  </div>

  <div class="ribbon-wrap">
    <ol class="ribbon container" data-inview>
      {
        items.map((it, i) => (
          <li class:list={['rcard', `p-${it.products[0]}`, { 'rcard--draft': it.draft }]} style={`--i:${i}`}>
            <span class="rcard__node" aria-hidden="true" />
            <div class="rcard__body">
              <p class="rcard__when">{it.when}</p>
              <p class="rcard__text">{it.text}</p>
              {it.draft && <span class="tag tag--forecast rcard__draft">проект, ещё не принят</span>}
              <div class="rcard__tags">
                {it.products.map((id) => (
                  <ProductTag id={id} />
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="container">
    <p class="footnote why__note" data-reveal>Нормативные данные актуальны на сентябрь 2026.</p>
  </div>
</section>

<style>
  .ribbon {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    padding-top: 34px;
  }

  /* Четырёхцветная линия времени */
  .ribbon::before {
    content: '';
    position: absolute;
    top: 8px;
    left: var(--gutter);
    right: var(--gutter);
    height: 2px;
    border-radius: 2px;
    background: #a3a8b0;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.6s var(--ease-out);
  }

  .ribbon.is-in::before {
    transform: scaleX(1);
  }

  .rcard {
    position: relative;
    display: flex;
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.8s var(--ease-out);
    transition-delay: calc(250ms + var(--i) * 150ms);
  }

  .ribbon.is-in .rcard,
  html:not(.js) .rcard {
    opacity: 1;
    transform: none;
  }

  .rcard__node {
    position: absolute;
    top: -34px;
    left: 22px;
    width: 18px;
    height: 18px;
    border: 2px solid var(--paper);
    border-radius: 5px;
    background: var(--line-2);
    box-shadow: 0 0 0 1px var(--line-2);
    transition:
      background-color 0.4s,
      box-shadow 0.4s;
    transition-delay: calc(400ms + var(--i) * 150ms);
  }

  .ribbon.is-in .rcard__node {
    background: var(--pc);
    box-shadow:
      0 0 0 1px var(--pc),
      0 0 0 6px color-mix(in oklab, var(--pc) 18%, transparent);
  }

  .rcard--draft .rcard__node {
    background: var(--paper) !important;
    box-shadow: 0 0 0 1px var(--subtle) !important;
    border-style: dashed;
  }

  .rcard__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    padding: 22px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .rcard:hover .rcard__body {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .rcard--draft .rcard__body {
    border: 1.5px dashed var(--line-2);
    background: transparent;
    box-shadow: none;
  }

  .rcard__when {
    position: relative;
    padding-left: 14px;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .rcard__when::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.2em;
    bottom: 0.2em;
    width: 3px;
    border-radius: 3px;
    background: var(--pc);
  }

  .rcard--draft .rcard__when::before {
    background: repeating-linear-gradient(180deg, var(--subtle) 0 3px, transparent 3px 6px);
  }

  .rcard__draft {
    align-self: flex-start;
  }

  .rcard__text {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  .rcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
  }

  .why__note {
    margin-top: 24px;
  }

  /* Уже 1200px — лента прокручивается по горизонтали */
  @media (max-width: 1180px) {
    .ribbon-wrap {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }

    .ribbon-wrap::-webkit-scrollbar {
      display: none;
    }

    .ribbon {
      grid-template-columns: repeat(5, min(78vw, 300px));
      width: max-content;
      max-width: none;
      margin: 0;
    }

    .rcard {
      scroll-snap-align: start;
      scroll-margin-left: var(--gutter);
    }
  }
</style>
