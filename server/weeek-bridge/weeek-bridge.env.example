# Настройки моста. Копия на сервере: /etc/qodex/weeek-bridge.env (владелец root, группа qodex, права 640).
# Ключ сюда вписывает администратор на сервере; в репозиторий и чаты его не кладут.

# Ключ API Weeek: Weeek → название пространства слева вверху → «Настройки» → «API» → «Добавить токен».
# Всё, что мост создаёт, будет от имени того, кто создал ключ.
WEEEK_TOKEN=

# Колонка «Новая заявка» воронки «Сайт qodex.tech» (id из GET /crm/funnels/{id}/statuses)
WEEEK_STATUS_ID=PaLMfjIJaFuF8dqL

# Ответственные по сделке — id сотрудников через запятую (GET /ws/members); пусто — без ответственного
WEEEK_ASSIGNEES=

# Метки сделки — числовые id через запятую; пусто — без меток
WEEEK_TAGS=

# Начало названия карточки: «Заявка с сайта: Компания — Имя»
TITLE_PREFIX="Заявка с сайта"

LISTEN_HOST=127.0.0.1
LISTEN_PORT=9031
QUEUE_DIR=/var/lib/qodex-weeek/queue
# сколько часов повторять, если Weeek недоступен; потом заявка уходит в QUEUE_DIR/failed
GIVE_UP_HOURS=72
