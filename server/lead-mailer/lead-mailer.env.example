# Настройки приёмника заявок QODEX (lead_mailer.py). Образец без настоящих паролей.
#
# На сервере: скопировать в /etc/qodex/lead-mailer.env, владелец root, права 600 —
# файл читает systemd при запуске службы, сама служба и другие пользователи его не видят.
# Пароль администратор сервера вписывает сам, прямо в этот файл на сервере.
# Пароли не пересылают в чатах, мессенджерах и письмах.
#
# Формат: ИМЯ=значение, без пробелов вокруг «=» и без кавычек.

# Почтовый сервер Mail.ru / VK WorkSpace (почта домена qodex.tech), SSL на порту 465
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
# 1 — SSL (так и должно быть). 0 разрешён только для локального теста с SMTP_HOST=127.0.0.1
SMTP_SSL=1

# Ящик, от имени которого уходят письма с заявками: логин целиком, с @qodex.tech.
# Отдельный ящик site@qodex.tech (его нужно завести в VK WorkSpace): на сервере не хранится пароль от info@,
# а если кто-то завалит форму заявками, почтовый сервис ограничит отправку с site@, а не с основного ящика компании.
# Можно указать и info@qodex.tech, если отдельный ящик заводить не стали.
SMTP_USER=site@qodex.tech

# Пароль для внешнего приложения, созданный в настройках этого ящика (не основной пароль от почты)
SMTP_PASSWORD=

# Куда приходят заявки. Несколько адресов — через запятую. Только ящики в России (согласие, раздел 4).
MAIL_TO=info@qodex.tech

# Порт на 127.0.0.1, куда nginx передаёт /api/lead (тот же, что в nginx-api-lead.conf)
PORT=8787

# Общий потолок: сколько заявок в час принимается со всех адресов вместе (дальше — ответ 429 и строка
# «общий лимит» в журнале). Защищает почтовый ящик от рассылки спама через форму. По умолчанию 30.
MAX_LEADS_PER_HOUR=30

# Файл записей о согласии. По умолчанию — в папке службы /var/lib/qodex-lead (её создаёт systemd).
# Если поменять: (1) добавить новую папку в ReadWritePaths= в /etc/systemd/system/qodex-lead-mailer.service
# и выполнить systemctl daemon-reload — иначе служба не сможет писать и не запустится; (2) поменять путь
# в задании cron (README.md, шаг 6).
CONSENT_LOG=/var/lib/qodex-lead/consent.jsonl
