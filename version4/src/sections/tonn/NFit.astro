    .nfit-tile:not(.nfit-tile--main) .nfit-title {
      grid-area: title;
      margin-top: 0;
      font-size: 1.0625rem;
      text-wrap: pretty;
    }

    .nfit-tile:not(.nfit-tile--main) .nfit-text {
      grid-area: text;
      margin-top: 4px;
      font-size: 15px;
    }

    .nfit-head {
      padding: 20px 20px 0;
    }

    /* заголовок в одной строке со значком — без отступа сверху, иначе встаёт ниже центра значка */
    .nfit-title--main {
