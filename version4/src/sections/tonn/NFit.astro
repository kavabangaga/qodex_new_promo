---
// Раздел 2 страницы «QODEX TONN» [#komu-podhodit] — «Для каких предприятий подходит QODEX TONN» (лендинг, блок B06).
// Бенто из бежевых плиток на фоне страницы: крупная плитка «Полигоны ТКО и МСК» (два столбца и два ряда) и пять
// отраслей. В крупной плитке — текст лендинга и рисунок весовой (демо-данные): машина заезжает на платформу,
// камера читает номер, акт с весом уходит во ФГИС УТКО. Что видят регоператор и объект, рассказывает раздел
// «Честный вес выгоден обеим сторонам» (NBoth) — здесь эти фразы не повторяем. Рисунок «проигрывается»
// один раз, когда он на экране; без анимации виден итог. Стоковые фото лендинга не используем.
import SectionIntro from '../../components/SectionIntro.astro';
import Icon, { type IconName } from '../../components/Icon.astro';

const NB = ' ';

// Тексты — с лендинга (опечатки и кавычки исправлены), решения заказчика: «подходит», а не «работаем»
const MAIN = {
  icon: 'recycle' as IconName,
  title: 'Полигоны ТКО и МСК',
  text: `Подмена класса отходов, занижение веса промышленных грузов под видом ТКО. Обязательная передача во ФГИС${NB}УТКО с${NB}2026${NB}года.`,
};

const FITS: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'mountain',
    title: 'Карьеры: песок, щебень, ПГС',
    text: `Недогруз самосвалов, «забытые» взвешивания, споры с покупателями о фактическом тоннаже. До${NB}20% машин уходит с${NB}занижением.`,
  },
  {
    icon: 'wheat',
    title: 'Элеваторы и комбикормовые заводы',
    text: 'Журналы ЗПП-28 вручную, споры с поставщиками зерна, потери до 2% оборота при ручном учёте. Интеграция с 1С:Элеватор.',
  },
  {
    icon: 'molecules',
    title: 'Производство полимеров и пластика',
    text: 'Гранулят в биг-бегах и навалом, отгрузка переработчикам. Споры по весу с дилерами и контроль «своих» водителей.',
  },
  {
    icon: 'paint-bucket',
    title: 'Лакокрасочные заводы',
    text: 'Приёмка сырья (пигменты, смолы, растворители) и отгрузка готовой продукции. Контроль соответствия фактического и заявленного тоннажа.',
  },
  {
    icon: 'magnet',
    title: 'Приёмка металлолома',
    text: 'Самая высокая цена за тонну — самые дорогие «ошибки». Сговор приёмщиков, занижение засора, теневые отгрузки. Обязательный ПСА.',
  },
];

// «ЗПП-28» не рвётся по дефису (типограф склеивает только буквы с буквами)
const nobr = (s: string) => s.replace('ЗПП-28', '<span class="nobr">ЗПП-28</span>');

// Рисунок весовой (вид сбоку), сцена 340×210, земля — y = 180. Один стиль с машинами в «Схемах хищений» (NSchemes)
// и весовой на странице «Кодекса ТКО» (KFit): белые плашки с графитовым контуром, платформа вровень с землёй
// на трёх датчиках. Фон, земля и холм полигона уходят далеко за края сцены — до краёв рисунка любой ширины.
const INK = '#1d1d1f';

const scene =
  // холм полигона и корпус сортировки вдали — бледные, без контура
  `<path d="M120 180C190 146 250 122 330 116C420 110 560 138 760 180Z" fill="#dfe8e3"/>` +
  `<rect x="-440" y="112" width="470" height="68" fill="#e2e9ee"/><rect x="-440" y="104" width="478" height="10" rx="3" fill="#d6dee5"/>` +
  `<path d="M-200 124h28v20h-28zM-150 124h28v20h-28zM-100 124h28v20h-28zM-50 124h28v20h-28zM0 124h20v20H0z" fill="#d3dce3"/>` +
  // земля
  `<rect x="-460" y="180" width="1260" height="260" fill="#dfe7ec"/><path d="M-460 180H800" stroke="#ccd7de" stroke-width="2"/>` +
  // платформа весов и датчики под ней
  `<rect x="22" y="180" width="282" height="11" rx="2.5" fill="#fff" stroke="${INK}" stroke-width="2.5"/>` +
  [46, 163, 280].map((cx) => `<rect x="${cx - 8}" y="193" width="16" height="6" rx="1.5" fill="${INK}"/>`).join('') +
  // столб с камерой распознавания номеров перед машиной (объектив — слева, навстречу машине)
  `<rect x="325" y="58" width="5" height="122" rx="2" fill="${INK}"/><path d="M326 62h-8" stroke="${INK}" stroke-width="3" stroke-linecap="round"/>` +
  `<rect x="295" y="54" width="24" height="14" rx="4" fill="#fff" stroke="${INK}" stroke-width="2.5"/>` +
  `<rect x="289" y="56.5" width="7" height="9" rx="2" fill="${INK}"/><circle cx="312" cy="61" r="2" fill="#12b886"/>`;

// луч камеры к передней части машины — отдельным слоем: появляется, когда машина встала на весы
const beam = `<path d="M290 61 246 128 260 150Z" fill="#12b886" fill-opacity=".16"/><path d="M290 61 246 128M290 61 260 150" stroke="#12b886" stroke-opacity=".45" stroke-width="1.2" stroke-dasharray="3 4"/>`;

// мусоровоз — отдельным слоем, заезжает на платформу. Кузов — как у весовой «Кодекса ТКО» (задний борт со скосом,
// бирюзовая полоса), кабина и колёса — как у самосвала в «Схемах хищений»; колёса стоят на y = 180
const truck =
  `<g stroke="${INK}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">` +
  `<rect x="50" y="149" width="206" height="7" rx="3" fill="${INK}" stroke="none"/>` +
  `<path d="M73 94H192a8 8 0 0 1 8 8v47H58a9 9 0 0 1-9-9v-19a9 9 0 0 1 2.9-6.6L66 97a9 9 0 0 1 7-3Z" fill="#fff"/>` +
  `<path d="M82 97v49" stroke-opacity=".22"/><rect x="98" y="115" width="86" height="10" rx="5" fill="#7fe5de" stroke="none"/>` +
  `<path d="M206 149V114a8 8 0 0 1 8-8h22a8 8 0 0 1 7 4l12 21a8 8 0 0 1 1 4V149Z" fill="#fff"/>` +
  `<path d="M214 114h20l10 17h-30Z" fill="#cfe2ff" stroke-width="2"/><path d="M216 139h7"/>` +
  `<rect x="249" y="137" width="6" height="6" rx="2" fill="#eef3a6" stroke-width="1.75"/></g>` +
  [90, 120, 234].map((cx) => `<circle cx="${cx}" cy="167" r="13" fill="${INK}"/><circle cx="${cx}" cy="167" r="5" fill="#fff"/>`).join('');
---

<section class="section" id="komu-podhodit" aria-labelledby="komu-podhodit-title">
  <div class="container nfit">
    <SectionIntro eyebrow="Отрасли" titleId="komu-podhodit-title">
      Для каких предприятий подходит QODEX&nbsp;TONN
      <Fragment slot="lead">
        Везде, где есть автомобильные весы и тарифы за тонну — там есть и потери. QODEX TONN подходит для
        6&nbsp;ключевых отраслей.
      </Fragment>
    </SectionIntro>

    <ul class="nfit-grid">
      <!-- Отходы: крупная плитка — текст лендинга и рисунок весовой -->
      <li class="nfit-tile nfit-tile--main" data-reveal style="--d:1">
        <div class="nfit-head">
          <span class="nfit-ico" aria-hidden="true"><Icon name={MAIN.icon} size={24} /></span>
          <h3 class="nfit-title nfit-title--main">{MAIN.title}</h3>
        </div>
        <p class="nfit-text nfit-text--main">{MAIN.text}</p>

        <!-- Весовая: камера читает номер, вес и акт уходят во ФГИС УТКО (демо-данные) -->
        <div class="nfit-art" aria-hidden="true" data-nfit-art>
          <span class="tag tag--demo nfit-demo">демо-данные</span>
          <span class="nfit-stage">
            <svg class="nfit-scene" viewBox="0 0 340 210" set:html={scene} />
            <svg class="nfit-scene nfit-beam" viewBox="0 0 340 210" set:html={beam} />
            <svg class="nfit-scene nfit-truck" viewBox="0 0 340 210" set:html={truck} />
            <span class="nfit-act">
              <span class="nfit-act__no">Акт №{NB}4127</span>
              <span class="nfit-plate">
                <span class="nfit-plate__num">А{NB}983{NB}ВВ</span>
                <span class="nfit-plate__reg">102</span>
              </span>
              <span class="nfit-act__w">
                <small>Нетто</small>
                <b>4{NB}170 кг</b>
              </span>
              <span class="nfit-fgis">
                <span class="nfit-fgis__ok"><Icon name="check" size={11} strokeWidth={3.2} /></span>
                ФГИС{NB}УТКО
              </span>
            </span>
          </span>
        </div>
      </li>

      {
        FITS.map((f, i) => (
          <li class="nfit-tile" data-reveal style={`--d:${i + 2}`}>
            <span class="nfit-ico" aria-hidden="true">
              <Icon name={f.icon} size={24} />
            </span>
            <h3 class="nfit-title">{f.title}</h3>
            <p class="nfit-text" set:html={nobr(f.text)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .nfit {
    --nfit-gap: clamp(14px, calc(var(--vw) * 1.4), 20px);
    --nfit-r: clamp(22px, calc(var(--vw) * 2), 28px);
    --nfit-pad: clamp(22px, calc(var(--vw) * 2.2), 28px);
    --nfit-in: 10px;
    /* значки отраслей — цветом QODEX TONN, чуть темнее: на белой плашке контраст не ниже 3:1 */
    --nfit-green: #0e9f74;
  }

  /* ── Бенто: крупная плитка — два столбца и два ряда, рядом две плитки, ниже ещё три ── */
  .nfit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--nfit-gap);
  }

  .nfit-tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding: var(--nfit-pad);
    border-radius: calc(var(--nfit-r) * var(--rk));
    corner-shape: var(--corner);
    background: var(--panel);
  }

  .nfit-ico {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: calc(14px * var(--rk));
    corner-shape: var(--corner);
    background: #fff;
    color: var(--nfit-green);
    box-shadow:
      0 1px 2px rgb(29 29 31 / 0.05),
      0 10px 18px -12px rgb(29 29 31 / 0.22);
    transition: transform 0.4s var(--ease-out);
  }

  /* при наведении приподнимается значок, плитка стоит на месте */
  .nfit-tile:hover .nfit-ico {
    transform: translateY(-2px) scale(1.05);
  }

  .nfit-title {
    margin-top: 22px;
    font-size: clamp(1.2rem, calc(var(--vw) * 1.5), 1.3125rem);
    line-height: 1.22;
    letter-spacing: -0.02em;
    font-weight: 560;
    text-wrap: balance;
  }

  .nfit-text {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ── Крупная плитка: текст, рисунок внизу на всю оставшуюся высоту ── */
  .nfit-tile--main {
    grid-column: span 2;
    grid-row: span 2;
    align-items: stretch;
    padding: 0;
  }

  /* значок и заголовок — в одну строку: крупная плитка ниже, рядом с ней две плитки без пустот */
  .nfit-head {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: var(--nfit-pad) var(--nfit-pad) 0;
  }

  .nfit-title--main {
    margin-top: 0;
    font-size: clamp(1.5rem, calc(var(--vw) * 2.2), 1.875rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .nfit-text--main {
    max-width: 40em;
    margin: 12px var(--nfit-pad) 0;
    font-size: clamp(1rem, calc(var(--vw) * 1.2), 1.0625rem);
  }

  /* ── Рисунок: светлая «карточка» внутри плитки (фон — как у рисунков «Схем хищений») ─────────── */
  .nfit-art {
    position: relative;
    flex: 1;
    min-height: 246px;
    margin: 22px var(--nfit-in) var(--nfit-in);
    overflow: hidden;
    isolation: isolate;
    border-radius: calc(calc(var(--nfit-r) - var(--nfit-in)) * var(--rk));
    corner-shape: var(--corner);
    background: #edf3f5;
    color: var(--ink);
    font-size: 12.5px;
    line-height: 1.25;
    text-align: left;
    -webkit-user-select: none;
    user-select: none;
  }

  .nfit-demo {
    position: absolute;
    z-index: 3;
    top: 12px;
    left: 12px;
    pointer-events: none;
  }

  /* сцена фиксированного размера внизу по центру: весовая слева, карточка акта справа от камеры.
     На компьютере рисунок занимает высоту двух соседних плиток (около 390 px) — весовая крупнее */
  .nfit-stage {
    --nfit-s: 1.45;
    --nfit-sw: calc(340px * var(--nfit-s));
    position: absolute;
    left: 50%;
    bottom: 0;
    width: calc(var(--nfit-sw) + 28px + 176px);
    height: calc(210px * var(--nfit-s));
    transform: translateX(-50%);
  }

  /* рисунок весовой крупнее на широкой плитке (векторный — не мылится) */
  .nfit-scene {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--nfit-sw);
    height: 100%;
    overflow: visible;
  }

  /* карточка акта: номер, вес нетто, передача во ФГИС УТКО */
  .nfit-act {
    position: absolute;
    left: calc(var(--nfit-sw) + 28px);
    top: 24px;
    display: grid;
    justify-items: start;
    gap: 8px;
    width: 176px;
    padding: 13px 14px 14px;
    border-radius: 16px;
    background: #fff;
    box-shadow:
      0 0 0 5px rgb(255 255 255 / 0.5),
      0 14px 30px -12px rgb(29 29 31 / 0.3);
  }

  .nfit-act__no {
    font-size: 12px;
    color: var(--muted);
  }

  /* госномер — в рамке, как на главной (рамка — внутренней тенью: border при дробном масштабе в Safari пропадает) */
  .nfit-plate {
    display: inline-flex;
    align-items: stretch;
    height: 24px;
    border-radius: 5px;
    box-shadow: inset 0 0 0 1.5px #1b2229;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .nfit-plate__num {
    display: grid;
    place-items: center;
    padding: 0 7px;
    letter-spacing: 0.02em;
  }

  .nfit-plate__reg {
    display: grid;
    place-items: center;
    padding: 0 6px;
    box-shadow: inset 1.5px 0 0 #1b2229;
    font-size: 11.5px;
  }

  .nfit-act__w {
    display: grid;
    gap: 2px;
  }

  .nfit-act__w small {
    font-size: 12px;
    color: var(--muted);
  }

  .nfit-act__w b {
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .nfit-fgis {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px 0 5px;
    border-radius: 999px;
    background: #e3f6ee;
    color: #07704f;
    font-weight: 600;
    white-space: nowrap;
  }

  .nfit-fgis__ok {
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: var(--c-tonn);
    color: #fff;
  }

  /* ── Движение: один раз, когда рисунок на экране ──────────
     Классы is-armed и is-live ставит скрипт; без них (нет скриптов, «уменьшить движение»)
     сразу видно итоговое состояние: машина на весах, акт передан. */
  .nfit-art.is-armed:not(.is-live) .nfit-truck,
  .nfit-art.is-armed:not(.is-live) .nfit-beam,
  .nfit-art.is-armed:not(.is-live) .nfit-act,
  .nfit-art.is-armed:not(.is-live) .nfit-fgis {
    opacity: 0;
  }

  .nfit-art.is-live .nfit-truck {
    animation: nfit-drive 1.6s var(--ease-out) 0.1s both;
  }

  .nfit-art.is-live .nfit-beam {
    animation: nfit-fade 0.5s ease-out 1.45s both;
  }

  .nfit-art.is-live .nfit-act {
    animation: nfit-rise 0.6s var(--ease-out) 1.8s both;
  }

  .nfit-art.is-live .nfit-fgis {
    animation: nfit-pop 0.45s cubic-bezier(0.2, 1.4, 0.4, 1) 2.55s both;
  }

  @keyframes nfit-drive {
    from {
      opacity: 0;
      transform: translateX(-150px);
    }
    25% {
      opacity: 1;
    }
  }

  @keyframes nfit-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes nfit-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes nfit-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nfit-art * {
      animation: none !important;
    }

    .nfit-ico {
      transition: none;
    }
  }

  /* ── Планшет: два столбца, крупная плитка во всю ширину, последняя отрасль — тоже ── */
  @media (max-width: 1199.98px) {
    .nfit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nfit-tile--main {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .nfit-tile:last-child {
      grid-column: 1 / -1;
    }

    .nfit-tile:last-child .nfit-text {
      max-width: 40em;
    }

    .nfit-art {
      flex: none;
      height: 280px;
    }

    .nfit-stage {
      --nfit-s: 1.1;
    }
  }

  /* ── Телефон: один столбец; у отраслей значок слева, заголовок и текст справа ── */
  @media (max-width: 699.98px) {
    .nfit-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .nfit-tile:not(.nfit-tile--main) {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      grid-template-areas:
        'ico title'
        'ico text';
      align-content: start;
      column-gap: 14px;
      padding: 18px 20px 20px 18px;
    }

    .nfit-tile:not(.nfit-tile--main) .nfit-ico {
      grid-area: ico;
      width: 44px;
      height: 44px;
      border-radius: calc(13px * var(--rk));
      corner-shape: var(--corner);
    }

    .nfit-tile:not(.nfit-tile--main) .nfit-title {
      grid-area: title;
      margin-top: 0;
      font-size: 1.0625rem;
      text-wrap: pretty;
    }

    .nfit-tile:not(.nfit-tile--main) .nfit-text {
      grid-area: text;
      margin-top: 4px;
      font-size: 15px;
    }

    .nfit-head {
      padding: 20px 20px 0;
    }

    /* заголовок в одной строке со значком — без отступа сверху, иначе встаёт ниже центра значка */
    .nfit-title--main {
      font-size: 1.5rem;
    }

    .nfit-text--main {
      font-size: 15.5px;
    }

    /* рисунок: весовая по центру, карточка акта — в левом верхнем углу, метка — справа */
    .nfit-art {
      height: 276px;
      margin-top: 18px;
    }

    .nfit-demo {
      left: auto;
      right: 12px;
    }

    .nfit-stage {
      --nfit-s: 1;
      width: 340px;
    }

    /* сцена стоит на нижнем крае рисунка (276 − 210 = 66 px сверху): карточка — в 12 px от верха и края */
    .nfit-act {
      left: 12px;
      top: -54px;
      gap: 6px;
      width: auto;
      padding: 10px 12px 12px;
      border-radius: 14px;
    }

    .nfit-act__no {
      display: none;
    }

    .nfit-act__w b {
      font-size: 18px;
    }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Рисунок «проигрывается» один раз, когда заметная часть его на экране и вкладка открыта
  // (во фоновой вкладке ждёт, пока на неё вернутся). При «уменьшить движение» классы не ставятся —
  // видно итоговое состояние.
  const art = document.querySelector<HTMLElement>('[data-nfit-art]');
  if (art && !reducedMotion() && 'IntersectionObserver' in window) {
    art.classList.add('is-armed');
    let inView = false;
    const play = () => {
      if (!inView || document.hidden) return;
      art.classList.add('is-live');
      io.disconnect();
      document.removeEventListener('visibilitychange', play);
    };
    const io = new IntersectionObserver(
      ([entry]) => {
        inView = entry.intersectionRatio >= 0.5;
        play();
      },
      { threshold: [0, 0.5] },
    );
    io.observe(art);
    document.addEventListener('visibilitychange', play);
  }
</script>
