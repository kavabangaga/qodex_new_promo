      grid-template-columns: 44px minmax(0, 1fr);
      grid-template-areas:
        'ico title'
        'ico text';
      align-content: start;
      column-gap: 14px;
      padding: 18px 20px 20px 18px;
    }

    .nfit-tile:not(.nfit-tile--main) .nfit-ico {
