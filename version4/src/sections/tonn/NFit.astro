<script>
  import { reducedMotion } from '../../scripts/motion';

  // Рисунок «проигрывается» один раз, когда заметная часть его на экране и вкладка открыта
  // (во фоновой вкладке ждёт, пока на неё вернутся). При «уменьшить движение» классы не ставятся —
  // видно итоговое состояние.
  const art = document.querySelector<HTMLElement>('[data-nfit-art]');
  if (art && !reducedMotion() && 'IntersectionObserver' in window) {
    art.classList.add('is-armed');
    let inView = false;
    const play = () => {
      if (!inView || document.hidden) return;
      art.classList.add('is-live');
      io.disconnect();
      document.removeEventListener('visibilitychange', play);
    };
    const io = new IntersectionObserver(
      ([entry]) => {
        inView = entry.intersectionRatio >= 0.5;
        play();
      },
      { threshold: [0, 0.5] },
    );
    io.observe(art);
    document.addEventListener('visibilitychange', play);
  }
</script>
