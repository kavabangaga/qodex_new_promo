---
// Раздел 2 страницы «QODEX TONN» [#komu-podhodit] — «Для каких предприятий подходит QODEX TONN» (лендинг, блок B06).
// Бенто из бежевых плиток на фоне страницы: крупная плитка «Полигоны ТКО и МСК» (два столбца и два ряда) и пять
// отраслей. В крупной плитке — текст лендинга и рисунок весовой (демо-данные): мусоровоз заезжает на весы,
// камера читает номер, акт с весом уходит во ФГИС УТКО. Что видят регоператор и объект, рассказывает раздел
// «Честный вес выгоден обеим сторонам» (NBoth) — здесь эти фразы не повторяем. Рисунок «проигрывается»
// один раз, когда он на экране; без анимации виден итог. Стоковые фото лендинга не используем.
import SectionIntro from '../../components/SectionIntro.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import { TRUCK, TRUCK_WHEELS, TRUCK_WHEEL_Y, TRUCK_WHEEL } from '../../components/art/truck';

const NB = ' ';

// Тексты — с лендинга (опечатки и кавычки исправлены), решения заказчика: «подходит», а не «работаем»
const MAIN = {
  icon: 'recycle' as IconName,
  title: 'Полигоны ТКО и МСК',
  text: `Подмена класса отходов, занижение веса промышленных грузов под видом ТКО. Обязательная передача во ФГИС${NB}УТКО с${NB}2026${NB}года.`,
};

const FITS: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'mountain',
    title: 'Карьеры: песок, щебень, ПГС',
    text: `Недогруз самосвалов, «забытые» взвешивания, споры с покупателями о фактическом тоннаже. До${NB}20% машин уходит с${NB}занижением.`,
  },
  {
    icon: 'wheat',
    title: 'Элеваторы и комбикормовые заводы',
    text: 'Журналы ЗПП-28 вручную, споры с поставщиками зерна, потери до 2% оборота при ручном учёте. Интеграция с 1С:Элеватор.',
  },
  {
    icon: 'molecules',
    title: 'Производство полимеров и пластика',
    text: 'Гранулят в биг-бегах и навалом, отгрузка переработчикам. Споры по весу с дилерами и контроль «своих» водителей.',
  },
  {
    icon: 'paint-bucket',
    title: 'Лакокрасочные заводы',
    text: 'Приёмка сырья (пигменты, смолы, растворители) и отгрузка готовой продукции. Контроль соответствия фактического и заявленного тоннажа.',
  },
  {
    icon: 'magnet',
    title: 'Приёмка металлолома',
    text: 'Самая высокая цена за тонну — самые дорогие «ошибки». Сговор приёмщиков, занижение засора, теневые отгрузки. Обязательный ПСА.',
  },
];

// «ЗПП-28» не рвётся по дефису (типограф склеивает только буквы с буквами)
const nobr = (s: string) => s.replace('ЗПП-28', '<span class="nobr">ЗПП-28</span>');

// ── Рисунок весовой (вид сбоку) — как сцена «Как это работает» (NHow): плоская серо-голубая гамма, общий
//    мусоровоз (components/art/truck.ts), стальной настил весов, мачта с камерами. Сцена 530×290 в единицах
//    мусоровоза: настил — x 24…480, колёса стоят на y 230; машина на весах — x 68…432 (сдвиг 68 58), мачта —
//    x 516. Небо, полигон, забор и дорога уходят далеко за края сцены — до краёв рисунка любой ширины ──
const POSTS = Array.from({ length: 44 }, (_, i) => `M${-694 + i * 46} 96v50`).join('');
const RIBS = Array.from({ length: 9 }, (_, i) => `M${68 + i * 46} 237v8`).join('');

const BACKDROP =
  `<rect x="-700" y="-600" width="2000" height="700" fill="#e2eaf0"/>` +
  // вдали слева: холм, ангар сортировки, деревья
  `<path d="M-430 98C-376 68 -298 56 -228 62C-178 66 -144 82 -114 98Z" fill="#d9e1e7"/>` +
  `<circle cx="-92" cy="80" r="20" fill="#d2dce3"/><circle cx="-122" cy="88" r="13" fill="#d6e0e6"/>` +
  `<rect x="-60" y="50" width="148" height="48" fill="#d2dce3"/><path d="M-66 52Q14 16 94 52Z" fill="#c8d3db"/>` +
  `<rect x="-34" y="66" width="22" height="32" rx="2" fill="#c9d4dc"/><rect x="4" y="68" width="64" height="12" rx="2" fill="#c9d4dc"/>` +
  // тело полигона с уступами — за весами и мачтой; справа пологий холм и дерево
  `<path d="M150 98C206 54 286 32 370 28L600 22C660 24 716 40 780 66C840 88 900 96 960 98Z" fill="#d6dfe6"/>` +
  `<path d="M240 70C306 52 392 46 520 44M310 50C364 40 440 36 560 34" stroke="#cbd5dd" stroke-width="2" fill="none"/>` +
  `<path d="M930 98C1000 76 1090 70 1170 76C1220 80 1260 90 1300 98Z" fill="#d9e1e7"/>` +
  `<circle cx="1010" cy="80" r="18" fill="#d2dce3"/>` +
  // забор, дорога с разметкой, бордюр, тротуар
  `<rect x="-700" y="94" width="2000" height="52" fill="#ccd6dd"/><path d="M-700 105H1300${POSTS}" stroke="#bac5cd" stroke-width="2"/>` +
  `<rect x="-700" y="146" width="2000" height="120" fill="#c3ccd4"/>` +
  `<path d="M-700 190H1300" stroke="#fff" stroke-opacity=".45" stroke-width="3" stroke-dasharray="28 24"/>` +
  `<rect x="-700" y="264" width="2000" height="8" fill="#aab5be"/><rect x="-700" y="272" width="2000" height="200" fill="#d1d9df"/>`;

// Весы: стальной настил со светлой кромкой, рёбра на боковине, пандусы, фундамент
const DECK =
  `<rect x="16" y="246" width="472" height="7" rx="1.5" fill="#a3aeb7"/>` +
  `<path d="M24 230 4 246H24ZM480 230 500 246H480Z" fill="#9aa6b0"/>` +
  `<rect x="24" y="230" width="456" height="16" rx="2" fill="#8d99a4"/>` +
  `<rect x="24" y="230" width="456" height="4" rx="1.5" fill="#b8c2ca"/>` +
  `<path d="${RIBS}" stroke="#7d8a95" stroke-width="2"/>`;

// Мачта перед весами (как в NHow, зеркально): внизу камера номеров — объективом к морде машины, наверху на вылете —
// обзорная камера над кузовом
const MAST =
  `<rect x="506" y="226" width="20" height="6" rx="2" fill="#6f7c88"/>` +
  `<rect x="512" y="16" width="8" height="212" rx="3" fill="#6f7c88"/>` +
  `<path d="M512 116h-8" stroke="#6f7c88" stroke-width="4"/>` +
  `<rect x="474" y="108" width="30" height="15" rx="4" fill="#f4f6f9" stroke="#8d9aa5" stroke-width="1.5"/>` +
  `<path d="M473 106.5h22" stroke="#8d9aa5" stroke-width="3" stroke-linecap="round"/>` +
  `<circle cx="479" cy="115.5" r="3.6" fill="#006bff"/>` +
  `<path d="M516 20H474" stroke="#6f7c88" stroke-width="5" stroke-linecap="round"/>` +
  `<g transform="rotate(-34 472 26)"><rect x="457" y="19" width="27" height="14" rx="4" fill="#f4f6f9" stroke="#8d9aa5" stroke-width="1.5"/>` +
  `<path d="M460 17.5h22" stroke="#8d9aa5" stroke-width="3" stroke-linecap="round"/><circle cx="462" cy="26" r="3.4" fill="#006bff"/></g>`;

// Когда машина встала на весы: настил подсвечивается, камера номеров «видит» морду машины (луч — под машиной)
const BEAM =
  `<rect x="24" y="228" width="456" height="6" rx="3" fill="#5ddfd7"/>` +
  `<path d="M476 116 430 160V210Z" fill="#006bff" fill-opacity=".16"/>`;
---

<section class="section" id="komu-podhodit" aria-labelledby="komu-podhodit-title">
  <div class="container nfit">
    <SectionIntro eyebrow="Отрасли" titleId="komu-podhodit-title">
      Для каких предприятий подходит QODEX&nbsp;TONN
      <Fragment slot="lead">
        Везде, где есть автомобильные весы и тарифы за тонну — там есть и потери. QODEX TONN подходит для
        6&nbsp;ключевых отраслей.
      </Fragment>
    </SectionIntro>

    <ul class="nfit-grid">
      <!-- Отходы: крупная плитка — текст лендинга и рисунок весовой -->
      <li class="nfit-tile nfit-tile--main" data-reveal style="--d:1">
        <div class="nfit-head">
          <span class="nfit-ico" aria-hidden="true"><Icon name={MAIN.icon} size={24} /></span>
          <h3 class="nfit-title nfit-title--main">{MAIN.title}</h3>
        </div>
        <p class="nfit-text nfit-text--main">{MAIN.text}</p>

        <!-- Весовая: камера читает номер, вес и акт уходят во ФГИС УТКО (демо-данные) -->
        <div class="nfit-art" aria-hidden="true" data-nfit-art>
          <span class="tag tag--demo nfit-demo">демо-данные</span>
          <span class="nfit-stage">
            <svg class="nfit-scene" viewBox="0 0 530 290" focusable="false">
              <g set:html={BACKDROP} />
              <g set:html={DECK} />
              <g set:html={MAST} />
              <g class="nfit-beam" set:html={BEAM} />
              {/* мусоровоз — общий рисунок; заезжает на весы, колёса крутятся в движении */}
              <g transform="translate(68 58)">
                <g class="nfit-truck">
                  <g set:html={TRUCK} />
                  {
                    TRUCK_WHEELS.map((cx) => (
                      <g transform={`translate(${cx} ${TRUCK_WHEEL_Y})`}>
                        <g class="nfit-wheel" set:html={TRUCK_WHEEL} />
                      </g>
                    ))
                  }
                </g>
              </g>
            </svg>
            <span class="nfit-act">
              <span class="nfit-act__no">Акт №{NB}4127</span>
              <span class="nfit-plate">
                <span class="nfit-plate__num">А{NB}983{NB}ВВ</span>
                <span class="nfit-plate__reg">102</span>
              </span>
              <span class="nfit-act__w">
                <small>Нетто</small>
                <b>4{NB}170 кг</b>
              </span>
              <span class="nfit-fgis">
                <span class="nfit-fgis__ok"><Icon name="check" size={11} strokeWidth={3.2} /></span>
                ФГИС{NB}УТКО
              </span>
            </span>
          </span>
        </div>
      </li>

      {
        FITS.map((f, i) => (
          <li class="nfit-tile" data-reveal style={`--d:${i + 2}`}>
            <span class="nfit-ico" aria-hidden="true">
              <Icon name={f.icon} size={24} />
            </span>
            <h3 class="nfit-title">{f.title}</h3>
            <p class="nfit-text" set:html={nobr(f.text)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .nfit {
    --nfit-gap: clamp(14px, calc(var(--vw) * 1.4), 20px);
    --nfit-r: clamp(22px, calc(var(--vw) * 2), 28px);
    --nfit-pad: clamp(22px, calc(var(--vw) * 2.2), 28px);
    --nfit-in: 10px;
    /* значки отраслей — цветом QODEX TONN, чуть темнее: на белой плашке контраст не ниже 3:1 */
    --nfit-green: #0e9f74;
  }

  /* ── Бенто: крупная плитка — два столбца и два ряда, рядом две плитки, ниже ещё три ── */
  .nfit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--nfit-gap);
  }

  .nfit-tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding: var(--nfit-pad);
    border-radius: calc(var(--nfit-r) * var(--rk));
    corner-shape: var(--corner);
    background: var(--panel);
  }

  .nfit-ico {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: calc(14px * var(--rk));
    corner-shape: var(--corner);
    background: #fff;
    color: var(--nfit-green);
    box-shadow:
      0 1px 2px rgb(29 29 31 / 0.05),
      0 10px 18px -12px rgb(29 29 31 / 0.22);
    transition: transform 0.4s var(--ease-out);
  }

  /* при наведении приподнимается значок, плитка стоит на месте */
  .nfit-tile:hover .nfit-ico {
    transform: translateY(-2px) scale(1.05);
  }

  .nfit-title {
    margin-top: 22px;
    font-size: clamp(1.2rem, calc(var(--vw) * 1.5), 1.3125rem);
    line-height: 1.22;
    letter-spacing: -0.02em;
    font-weight: 560;
    text-wrap: balance;
  }

  .nfit-text {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ── Крупная плитка: текст, рисунок внизу на всю оставшуюся высоту ── */
  .nfit-tile--main {
    grid-column: span 2;
    grid-row: span 2;
    align-items: stretch;
    padding: 0;
  }

  /* значок и заголовок — в одну строку: крупная плитка ниже, рядом с ней две плитки без пустот */
  .nfit-head {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: var(--nfit-pad) var(--nfit-pad) 0;
  }

  .nfit-title--main {
    margin-top: 0;
    font-size: clamp(1.5rem, calc(var(--vw) * 2.2), 1.875rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .nfit-text--main {
    max-width: 40em;
    margin: 12px var(--nfit-pad) 0;
    font-size: clamp(1rem, calc(var(--vw) * 1.2), 1.0625rem);
  }

  /* ── Рисунок: окно на сцену весовой внутри плитки (небо — как в «Как это работает») ─────────── */
  .nfit-art {
    position: relative;
    flex: 1;
    min-height: 246px;
    margin: 22px var(--nfit-in) var(--nfit-in);
    overflow: hidden;
    isolation: isolate;
    border-radius: calc(calc(var(--nfit-r) - var(--nfit-in)) * var(--rk));
    corner-shape: var(--corner);
    background: #e2eaf0;
    color: var(--ink);
    font-size: 12.5px;
    line-height: 1.25;
    text-align: left;
    -webkit-user-select: none;
    user-select: none;
  }

  .nfit-demo {
    position: absolute;
    z-index: 3;
    top: 12px;
    left: 12px;
    pointer-events: none;
  }

  /* сцена 530×290 внизу по центру: весовая слева, карточка акта справа от мачты. --nfit-s — пикселей
     на единицу сцены. На компьютере рисунок занимает высоту двух соседних плиток (около 390 px) — весовая крупнее */
  .nfit-stage {
    --nfit-s: 1;
    --nfit-sw: calc(530px * var(--nfit-s));
    position: absolute;
    left: 50%;
    bottom: 0;
    width: calc(var(--nfit-sw) + 28px + 176px);
    height: calc(290px * var(--nfit-s));
    transform: translateX(-50%);
  }

  /* рисунок векторный — не мылится; фон сцены выходит за её края (overflow) */
  .nfit-scene {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--nfit-sw);
    max-width: none;
    height: 100%;
    overflow: visible;
  }

  /* колёса крутятся вокруг своего центра */
  .nfit-wheel {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* карточка акта: номер, вес нетто, передача во ФГИС УТКО */
  .nfit-act {
    position: absolute;
    left: calc(var(--nfit-sw) + 28px);
    top: 24px;
    display: grid;
    justify-items: start;
    gap: 8px;
    width: 176px;
    padding: 13px 14px 14px;
    border-radius: 16px;
    background: #fff;
    box-shadow:
      0 0 0 5px rgb(255 255 255 / 0.5),
      0 14px 30px -12px rgb(29 29 31 / 0.3);
  }

  .nfit-act__no {
    font-size: 12px;
    color: var(--muted);
  }

  /* госномер — в рамке, как на главной (рамка — внутренней тенью: border при дробном масштабе в Safari пропадает) */
  .nfit-plate {
    display: inline-flex;
    align-items: stretch;
    height: 24px;
    border-radius: 5px;
    box-shadow: inset 0 0 0 1.5px #1b2229;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .nfit-plate__num {
    display: grid;
    place-items: center;
    padding: 0 7px;
    letter-spacing: 0.02em;
  }

  .nfit-plate__reg {
    display: grid;
    place-items: center;
    padding: 0 6px;
    box-shadow: inset 1.5px 0 0 #1b2229;
    font-size: 11.5px;
  }

  .nfit-act__w {
    display: grid;
    gap: 2px;
  }

  .nfit-act__w small {
    font-size: 12px;
    color: var(--muted);
  }

  .nfit-act__w b {
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .nfit-fgis {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px 0 5px;
    border-radius: 999px;
    background: #e3f6ee;
    color: #07704f;
    font-weight: 600;
    white-space: nowrap;
  }

  .nfit-fgis__ok {
    display: grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: var(--c-tonn);
    color: #fff;
  }

  /* ── Движение: один раз, когда рисунок на экране ──────────
     Классы is-armed и is-live ставит скрипт; без них (нет скриптов, «уменьшить движение»)
     сразу видно итоговое состояние: машина на весах, акт передан. */
  .nfit-art.is-armed:not(.is-live) .nfit-truck,
  .nfit-art.is-armed:not(.is-live) .nfit-beam,
  .nfit-art.is-armed:not(.is-live) .nfit-act,
  .nfit-art.is-armed:not(.is-live) .nfit-fgis {
    opacity: 0;
  }

  .nfit-art.is-live .nfit-truck {
    animation: nfit-drive 1.6s var(--ease-out) 0.1s both;
  }

  /* колёса — с тем же ходом, что и машина: катятся, а не скользят */
  .nfit-art.is-live .nfit-wheel {
    animation: nfit-roll 1.6s var(--ease-out) 0.1s both;
  }

  .nfit-art.is-live .nfit-beam {
    animation: nfit-fade 0.5s ease-out 1.45s both;
  }

  .nfit-art.is-live .nfit-act {
    animation: nfit-rise 0.6s var(--ease-out) 1.8s both;
  }

  .nfit-art.is-live .nfit-fgis {
    animation: nfit-pop 0.45s cubic-bezier(0.2, 1.4, 0.4, 1) 2.55s both;
  }

  /* сдвиг — в единицах сцены (две трети машины) */
  @keyframes nfit-drive {
    from {
      opacity: 0;
      transform: translateX(-240px);
    }
    25% {
      opacity: 1;
    }
  }

  /* 240 / 22 рад ≈ 625° */
  @keyframes nfit-roll {
    from {
      transform: rotate(-625deg);
    }
  }

  @keyframes nfit-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes nfit-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes nfit-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nfit-art * {
      animation: none !important;
    }

    .nfit-ico {
      transition: none;
    }
  }

  /* ── Планшет: два столбца, крупная плитка во всю ширину, последняя отрасль — тоже ── */
  @media (max-width: 1199.98px) {
    .nfit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nfit-tile--main {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .nfit-tile:last-child {
      grid-column: 1 / -1;
    }

    .nfit-tile:last-child .nfit-text {
      max-width: 40em;
    }

    .nfit-art {
      flex: none;
      height: 280px;
    }

    /* сцена с карточкой — 607 px: помещается и в рисунок шириной 632 px (окно 700 px) */
    .nfit-stage {
      --nfit-s: 0.76;
    }
  }

  /* ── Телефон: один столбец; у отраслей значок слева, заголовок и текст справа ── */
  @media (max-width: 699.98px) {
    .nfit-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .nfit-tile:not(.nfit-tile--main) {
