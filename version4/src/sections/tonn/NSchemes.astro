    .nsch-ro {
      padding-inline: 0;
    }

    /* надпись в две строки — по левому краю, стрелка справа */
    .nsch-band-cta {
      justify-self: stretch;
      text-wrap: balance;
      justify-content: space-between;
      min-height: 56px;
      padding-block: 12px;
      line-height: 1.25;
      white-space: normal;
      text-align: left;
    }
  }

  @media (max-width: 380px) {
    .nsch-in {
      padding: 16px 14px 14px;
    }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Рисунки «проигрываются» один раз, когда карточка на экране; за экраном возвращаются в начало.
  // При «уменьшить движение» классы не ставятся — видно итоговое состояние.
  const arts = document.querySelectorAll<HTMLElement>('[data-nsch-art]');
  if (arts.length && !reducedMotion() && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          if (entry.intersectionRatio >= 0.45) el.classList.add('is-live');
          else if (!entry.isIntersecting) el.classList.remove('is-live');
        }
      },
      { threshold: [0, 0.45] },
    );
    arts.forEach((el) => {
      el.classList.add('is-armed');
      io.observe(el);
    });
  }
</script>
