---
// Раздел страницы «QODEX TONN» — «Честный вес выгоден обеим сторонам» [#obe-storony]. Фон страницы.
// 1. Лавандовая подложка с макетом (демо-данные): одно взвешивание в двух кабинетах сразу — объекта и регоператора.
//    От весовой в середине линии расходятся к обоим кабинетам, и акт появляется в них одновременно.
//    Сцена проигрывается один раз, когда она на экране; ушла с экрана — возвращается в начало.
// 2. «Единый баланс ТКО» с главной в компактном виде: четыре звена с мостиками и знаками «=»;
//    звенья других продуктов ведут на их страницы, звено «Весовая» — эта страница («вы здесь»).
// 3. Две карточки с главной: «100 → 60» (QODEX Tracker) и «Начать передавать данные сейчас» (Кодекс ТКО).
import SectionIntro from '../../components/SectionIntro.astro';
import GradientVisual from '../../components/GradientVisual.astro';
import ProductLabel from '../../components/ProductLabel.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import { productHref, type ProductId } from '../../config/site';

const NB = String.fromCharCode(160);

// ── Макет: один акт в двух кабинетах (демо-данные; тот же акт, что в макетах QODEX TONN на главной и в «Кому подходит»:
//    № 4127, А983ВВ 102, 09:42, нетто 4 170 кг) ──
const ACT = { n: `Акт №${NB}4127`, plate: `А983ВВ${NB}102`, net: `4${NB}170${NB}кг`, time: '09:42' };
const APPS: { key: 'a' | 'b'; title: string; icon: IconName }[] = [
  { key: 'a', title: 'Кабинет объекта', icon: 'warehouse' },
  { key: 'b', title: 'Кабинет регоператора', icon: 'building-2' },
];
const DEMO_LABEL =
  `Пример (демо-данные): ${ACT.n}, ${ACT.plate}, нетто ${ACT.net}, с фото кузова — ` +
  'одновременно в кабинете объекта и в кабинете регоператора';

// Кузов сверху — «фото кузова» в акте (тот же рисунок, что в макетах QODEX TONN на главной)
const BODY =
  `<rect width="120" height="80" fill="#9aa6b0"/><rect x="14" y="10" width="92" height="60" rx="6" fill="#55708a"/>` +
  `<rect x="20" y="16" width="80" height="48" rx="4" fill="#6c7f74"/>` +
  `<ellipse cx="40" cy="34" rx="16" ry="10" fill="#8a8f6e"/><ellipse cx="70" cy="44" rx="18" ry="11" fill="#a29373"/>` +
  `<ellipse cx="62" cy="28" rx="11" ry="7" fill="#7f8c96"/><ellipse cx="86" cy="30" rx="9" ry="7" fill="#c2b28f"/>` +
  `<ellipse cx="34" cy="52" rx="10" ry="6" fill="#5f6b5a"/>`;

// ── Единый баланс ТКО: звенья — тексты с главной ──
interface Step {
  step: string;
  place: string;
  products: ProductId[];
  text: string;
  /** Страница продукта звена; у звена этой страницы ссылки нет. */
  to?: ProductId;
}
const STEPS: Step[] = [
  {
    step: 'Начислено',
    place: 'Лицевой счёт',
    products: ['robot'],
    text: 'Все, кто должен платить, есть в базе начислений.',
    to: 'robot',
  },
  {
    step: 'Вывезено',
    place: 'Контейнерная площадка',
    products: ['tracker'],
    text: 'Вывоз на видео: левак и недовывоз обнаружены.',
    to: 'tracker',
  },
  { step: 'Взвешено', place: 'Весовая', products: ['tonn'], text: 'Плата за реальный вес, а не приписанный.' },
  {
    step: 'Передано',
    place: `ФГИС${NB}УТКО`,
    products: ['kodeks', 'tonn'],
    text: `Быстрая отправка данных во${NB}ФГИС${NB}УТКО.`,
    to: 'kodeks',
  },
];
---

<section class="section" id="obe-storony" aria-labelledby="obe-storony-title">
  <div class="container">
    <SectionIntro eyebrow="Регоператор и объект" titleId="obe-storony-title">
      Честный вес выгоден обеим сторонам
      <Fragment slot="lead">Одни и те же взвешивания сразу видят и объект, и регоператор.</Fragment>
    </SectionIntro>

    <!-- 1. Одно взвешивание — в двух кабинетах сразу -->
    <div data-reveal style="--d:2">
      <GradientVisual preset="lavender" deco="none" class="nbo-vis" label={DEMO_LABEL} data-nbo-demo>
        <span class="tag tag--demo nbo-vis__demo">демо-данные</span>
        <div class="nbo-scene">
          {
            APPS.map((a) => (
              <div class:list={['ui', 'nbo-app', `nbo-app--${a.key}`]}>
                <p class="nbo-app__head">
                  <span class="nbo-app__ico">
                    <Icon name={a.icon} size={16} strokeWidth={2} />
                  </span>
                  <span class="nbo-app__title">{a.title}</span>
                  <span class="nbo-app__tab">Акты</span>
                </p>

                <div class="nbo-app__slot">
                  <!-- пока акта нет — пустая строка-заготовка -->
                  <span class="nbo-skel">
                    <span class="nbo-skel__ph" />
                    <span class="nbo-skel__lines">
                      <i />
                      <i />
                      <i />
                    </span>
                  </span>

                  <span class="nbo-act">
                    <span class="nbo-act__ph">
                      <svg viewBox="0 0 120 80" preserveAspectRatio="xMidYMid slice" set:html={BODY} />
                      <span class="nbo-act__cam">
                        <Icon name="camera" size={11} strokeWidth={2.2} />
                        фото
                      </span>
                    </span>
                    <span class="nbo-act__main">
                      <b class="nbo-act__n">{ACT.n}</b>
                      <span class="nbo-act__plate">{ACT.plate}</span>
                      <span class="nbo-act__net">
                        <span class="nbo-act__net-l">Нетто</span>
                        <b class="nbo-act__net-v">{ACT.net}</b>
                      </span>
                    </span>
                  </span>
                </div>

                <p class="nbo-app__foot">
                  <span class="nbo-app__ok">
                    <Icon name="cloud-check" size={14} strokeWidth={2.2} />
                    в облаке
                  </span>
                  <span class="nbo-app__time">{ACT.time}</span>
                </p>
              </div>
            ))
          }

          <!-- весовая посередине: от неё линии расходятся к обоим кабинетам -->
          <div class="nbo-link">
            <span class="nbo-wire nbo-wire--a"><i></i></span>
            <span class="nbo-hub">
              <span class="nbo-hub__ring"></span>
              <span class="nbo-hub__ico p-tonn"><Icon name="scale" size={20} strokeWidth={2} /></span>
              <span class="nbo-hub__t">Весовая</span>
            </span>
            <span class="nbo-wire nbo-wire--b"><i></i></span>
          </div>
        </div>
      </GradientVisual>
    </div>

    <!-- 2. Единый баланс ТКО -->
    <div class="nbo-bal">
      <h3 class="nbo-bal__title" data-reveal>
        Единый баланс ТКО: <span class="nbo-bal__line">начислено&nbsp;<span class="nbo-bal__eq">=</span> вывезено&nbsp;<span class="nbo-bal__eq">=</span> взвешено&nbsp;<span class="nbo-bal__eq">=</span> передано</span>
      </h3>

      <ol class="nbo-chain bridged">
        {
          STEPS.map((s, i) => {
            const inner = (
              <>
                <span class="nbo-step__top">
                  <span class="nbo-step__word">{s.step}</span>
                  {s.to ? (
                    <span class="arrow-btn nbo-step__go" aria-hidden="true">
                      <Icon name="arrow-right" />
                    </span>
                  ) : (
                    <span class="tag nbo-step__here">
                      <span class="tag__dot p-tonn" aria-hidden="true" />
                      вы здесь
                    </span>
                  )}
                </span>
                <span class="nbo-step__place">{s.place}</span>
                <span class="nbo-step__labels">
                  {s.products.map((id) => (
                    <ProductLabel id={id} />
                  ))}
                </span>
                <span class="nbo-step__text">{s.text}</span>
              </>
            );
            return (
              <li class:list={['nbo-step', { 'is-here': !s.to }]} style={`--d:${i + 1}`} data-reveal>
                {s.to ? (
                  <a
                    class="nbo-step__card"
                    href={productHref(s.to, 'tonn')}
                    data-goal="product_landing"
                    data-goal-product={s.to}
                  >
                    {inner}
                  </a>
                ) : (
                  <div class="nbo-step__card" aria-current="page">
                    {inner}
                  </div>
                )}
              </li>
            );
          })
        }
      </ol>
    </div>

    <!-- 3. Две карточки с главной -->
    <div class="nbo-more">
      <article class="nbo-card" aria-labelledby="nbo-card-diff" data-reveal style="--d:1">
        <p class="nbo-card__labels">
          <ProductLabel id="tracker" />
          <!-- «+» переносится вместе со второй меткой, а не остаётся в конце строки -->
          <span class="nbo-card__pair">
            <span class="nbo-card__plus" aria-hidden="true">+</span>
            <ProductLabel id="tonn" />
          </span>
        </p>
        <h3 class="nbo-card__title" id="nbo-card-diff">
          Вывезли 100&nbsp;контейнеров — а&nbsp;до полигона доехало&nbsp;60?
        </h3>
        <p class="nbo-card__text">
          Tracker и TONN покажут разницу между вывезенным и взвешенным. Разница — это приписки или слив на свалку.
        </p>
        <p class="nbo-card__act">
          <a
            class="link-arrow nbo-card__link"
            href={productHref('tracker', 'tonn')}
            data-goal="product_landing"
            data-goal-product="tracker"
          >
            QODEX&nbsp;Tracker
            <Icon name="arrow-right" />
          </a>
        </p>
      </article>

      <article class="nbo-card" aria-labelledby="nbo-card-fgis" data-reveal style="--d:2">
        <p class="nbo-card__labels">
          <ProductLabel id="kodeks" />
        </p>
        <h3 class="nbo-card__title" id="nbo-card-fgis">Начать передавать данные сейчас — Кодекс&nbsp;ТКО</h3>
        <p class="nbo-card__text">
          Загружаете Excel из своей учётной системы, сервис проверяет ошибки и дубли и отправляет данные во ФГИС&nbsp;УТКО
          по&nbsp;API. Без&nbsp;доработок 1С и обучения персонала. Подключение за 15&nbsp;минут, неделя бесплатно, поможем получить
          ключ доступа к ФГИС.
        </p>
        <p class="nbo-card__act">
          <a
            class="link-arrow nbo-card__link"
            href={productHref('kodeks', 'tonn')}
            data-goal="product_landing"
            data-goal-product="kodeks"
          >
            Кодекс&nbsp;ТКО
            <Icon name="arrow-right" />
          </a>
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  /* ── 1. Подложка со сценой ─────────────────────────────── */
  .nbo-vis {
    min-height: clamp(400px, calc(var(--vw) * 30), 440px);
    padding: 64px clamp(20px, calc(var(--vw) * 3), 48px) 56px;
  }

  .nbo-vis__demo {
    position: absolute;
    top: 18px;
    left: 18px;
  }

  /* два кабинета по краям, весовая посередине */
  .nbo-scene {
    --nbo-link: 196px;
    display: grid;
    grid-template-columns: minmax(0, 396px) var(--nbo-link) minmax(0, 396px);
    grid-template-areas: 'a link b';
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  /* ── Кабинет: белая карточка интерфейса ── */
  .nbo-app {
    width: 100%;
    padding: 18px;
    border-radius: 22px;
    font-size: 13px;
    line-height: 1.3;
    text-align: left;
    -webkit-user-select: none;
    user-select: none;
  }

  .nbo-app--a {
    grid-area: a;
  }

  .nbo-app--b {
    grid-area: b;
  }

  .nbo-app__head {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 12px;
  }

  .nbo-app__ico {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 9px;
    background: #f1f3f5;
    color: var(--ink);
  }

  .nbo-app__title {
    min-width: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nbo-app__tab {
    margin-left: auto;
    flex: none;
    padding: 4px 9px;
    border-radius: 999px;
    background: #f1f3f5;
    font-size: 12px;
    font-weight: 560;
    color: var(--muted);
  }

  /* строка акта и заготовка лежат в одной клетке */
  .nbo-app__slot {
    display: grid;
  }

  .nbo-skel,
  .nbo-act {
    grid-area: 1 / 1;
  }

  .nbo-act {
    position: relative;
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 14px;
    padding: 8px;
    border-radius: 14px;
    background: #f5f6f8;
  }

  /* мягкая подсветка строки, когда акт пришёл (только в движении) */
  .nbo-act::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1.5px #9d85f2;
    opacity: 0;
    pointer-events: none;
  }

  .nbo-act__ph {
    position: relative;
    display: block;
    height: 92px;
    border-radius: 9px;
    overflow: hidden;
  }

  .nbo-act__ph svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .nbo-act__cam {
    position: absolute;
    left: 6px;
    bottom: 6px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 6px;
    background: rgb(29 29 31 / 0.66);
    color: #fff;
    /* не мельче 12 px, как остальные подписи макета */
    font-size: 12px;
    font-weight: 500;
  }

  .nbo-act__main {
    display: grid;
    align-content: center;
    gap: 3px;
    min-width: 0;
  }

  .nbo-act__n {
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nbo-act__plate {
    font-size: 13px;
    color: var(--muted);
  }

  .nbo-act__net {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 5px;
  }

  .nbo-act__net-l {
    font-size: 12px;
    color: var(--muted);
  }

  .nbo-act__net-v {
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* заготовка: серое «фото» и три полоски; видна только до прихода акта */
  .nbo-skel {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    padding: 8px;
    border-radius: 14px;
    background: #f5f6f8;
    opacity: 0;
  }

  .nbo-skel__ph {
    height: 92px;
    border-radius: 9px;
    background: #e7e9ee;
  }

  .nbo-skel__lines {
    display: grid;
    gap: 9px;
  }

  .nbo-skel__lines i {
    height: 9px;
    width: 78%;
    border-radius: 5px;
    background: #e7e9ee;
  }

  .nbo-skel__lines i:nth-child(2) {
    width: 52%;
  }

  .nbo-skel__lines i:nth-child(3) {
    width: 64%;
  }

  .nbo-app__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 12px;
    padding: 10px 2px 0;
    border-top: 1px dashed #dfe2e7;
  }

  .nbo-app__ok {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 24px;
    padding: 0 9px;
    border-radius: 999px;
    background: #e1f5ec;
    color: #0a7a52;
    font-size: 12px;
    font-weight: 560;
    white-space: nowrap;
  }

  .nbo-app__time {
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  /* ── Весовая и линии к кабинетам ── */
  .nbo-link {
    grid-area: link;
    position: relative;
    align-self: stretch;
    display: grid;
    place-items: center;
  }

  .nbo-hub {
    position: relative;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 7px rgb(255 255 255 / 0.4),
      var(--shadow-card);
  }

  .nbo-hub__ico {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--pc);
    color: #fff;
  }

  /* кольцо расходится от весовой, когда пришло взвешивание */
  .nbo-hub__ring {
    position: absolute;
    inset: -2px;
    border: 2px solid #fff;
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }

  .nbo-hub__t {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    translate: -50% 0;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.85);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  /* линия: пунктир-«путь» и сплошная заливка поверх; точка — где линия входит в кабинет */
  .nbo-wire {
    --hub-r: 39px;
    position: absolute;
    top: calc(50% - 1px);
    height: 2px;
    background: repeating-linear-gradient(90deg, rgb(29 29 31 / 0.22) 0 5px, transparent 5px 10px);
  }

  .nbo-wire--a {
    left: 0;
    right: calc(50% + var(--hub-r));
  }

  .nbo-wire--b {
    left: calc(50% + var(--hub-r));
    right: 0;
  }

  .nbo-wire i {
    position: absolute;
    inset: 0;
    border-radius: 2px;
    background: rgb(29 29 31 / 0.6);
  }

  .nbo-wire--a i {
    transform-origin: 100% 50%;
  }

  .nbo-wire--b i {
    transform-origin: 0 50%;
  }

  .nbo-wire::after {
    content: '';
    position: absolute;
    top: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    box-shadow: inset 0 0 0 2px rgb(29 29 31 / 0.6);
  }

  .nbo-wire--a::after {
    left: -4px;
  }

  .nbo-wire--b::after {
    right: -4px;
  }

  /* ── Движение: один раз, когда сцена на экране ──────────────
     Классы is-armed и is-live ставит скрипт; без них (нет скриптов, «уменьшить движение») сразу видно
     итоговое состояние: в обоих кабинетах один и тот же акт, линии от весовой проведены.
     Расписание (с): кольцо у весовой — 0,15; линии тянутся к кабинетам 0,45–1,05; акт появляется в обоих
     кабинетах одновременно — 1,05, подсветка строки — 1,1–2,7; «в облаке» — 1,45. */
  .nbo-vis.is-armed:not(.is-live) .nbo-act,
  .nbo-vis.is-armed:not(.is-live) .nbo-app__ok,
  .nbo-vis.is-armed:not(.is-live) .nbo-app__time,
  .nbo-vis.is-armed:not(.is-live) .nbo-wire::after {
    opacity: 0;
  }

  .nbo-vis.is-armed:not(.is-live) .nbo-skel {
    opacity: 1;
  }

  .nbo-vis.is-armed:not(.is-live) .nbo-wire i {
    transform: scaleX(0);
  }

  .nbo-vis.is-live .nbo-hub__ring {
    animation: nbo-ring 1.1s ease-out 0.15s both;
  }

  .nbo-vis.is-live .nbo-hub__ico {
    animation: nbo-pop 0.45s cubic-bezier(0.2, 1.5, 0.4, 1) 0.05s both;
  }

  .nbo-vis.is-live .nbo-wire i {
    animation: nbo-grow-x 0.6s var(--ease-in-out) 0.45s both;
  }

  .nbo-vis.is-live .nbo-wire::after {
    animation: nbo-pop 0.35s cubic-bezier(0.2, 1.5, 0.4, 1) 0.98s both;
  }

  .nbo-vis.is-live .nbo-skel {
    animation: nbo-out 0.3s ease 1.05s both;
  }

  .nbo-vis.is-live .nbo-act {
    animation: nbo-rise 0.55s var(--ease-out) 1.05s both;
  }

  .nbo-vis.is-live .nbo-act::after {
    animation: nbo-glow 1.6s ease 1.1s both;
  }

  .nbo-vis.is-live .nbo-app__ok {
    animation: nbo-pop 0.4s cubic-bezier(0.2, 1.5, 0.4, 1) 1.45s both;
  }

  .nbo-vis.is-live .nbo-app__time {
    animation: nbo-in 0.4s ease 1.45s both;
  }

  /* вкладка скрыта — сцена ждёт */
  .nbo-vis.is-paused *,
  .nbo-vis.is-paused *::after {
    animation-play-state: paused !important;
  }

  @keyframes nbo-ring {
    from {
      opacity: 0.9;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.7);
    }
  }

  @keyframes nbo-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @keyframes nbo-grow-x {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes nbo-grow-y {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes nbo-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes nbo-in {
    from {
      opacity: 0;
    }
  }

  @keyframes nbo-rise {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }

  @keyframes nbo-glow {
    0% {
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nbo-vis *,
    .nbo-vis *::after {
      animation: none !important;
    }
  }

  /* ── 2. Единый баланс ТКО ─────────────────────────────── */
  .nbo-bal {
    margin-top: clamp(64px, calc(var(--vw) * 8), 112px);
  }

  .nbo-bal__title {
    max-width: 1000px;
    margin: 0 auto clamp(24px, calc(var(--vw) * 2.8), 36px);
    font-size: clamp(1.45rem, calc(var(--vw) * 2.3), 2rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    font-weight: 600;
    text-align: center;
    text-wrap: balance;
  }

  /* «Единый баланс ТКО:» — первой строкой, цепочка равенств — второй (на телефоне она переносится сама) */
  .nbo-bal__line {
    display: block;
  }

  /* «=» — тише слов, как в заголовке «Единого баланса» на главной */
  .nbo-bal__eq {
    color: var(--subtle);
    font-weight: 400;
  }

  .nbo-chain {
    --gap: clamp(18px, calc(var(--vw) * 1.8), 24px);
    --bridge-y: 26px;
    --bridge: 18px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    isolation: isolate;
  }

  .nbo-step {
    /* цвет карточки и её соседки слева — из них мостик */
    --c: var(--panel);
    --cl: var(--panel);
    position: relative;
    display: flex;
    min-width: 0;
  }

  .nbo-step.is-here {
    --c: var(--card);
  }

  .nbo-step.is-here + .nbo-step {
    --cl: var(--card);
  }

  /* мостик к соседней карточке слева (маски — .bridged в global.css) */
  .nbo-step + .nbo-step::before {
    content: '';
    position: absolute;
    top: var(--bridge-y);
    left: calc(var(--gap) * -1 - 1px);
    width: calc(var(--gap) + 2px);
    height: calc(var(--gap) + var(--bridge));
    background: linear-gradient(90deg, var(--cl), var(--c));
    -webkit-mask: var(--bridge-mask-row);
    mask: var(--bridge-mask-row);
  }

  /* на мостике — знак «=» */
  .nbo-step + .nbo-step::after {
    content: '';
    position: absolute;
    z-index: 1;
    left: calc(var(--gap) / -2 - 7px);
    top: calc(var(--bridge-y) + (var(--gap) + var(--bridge)) / 2 - 4px);
    width: 14px;
    height: 8px;
    border-radius: 1px;
    background: linear-gradient(var(--subtle) 0 2px, transparent 2px 6px, var(--subtle) 6px 8px);
  }

  .nbo-step__card {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 22px 22px 24px;
    border-radius: calc(var(--r) * var(--rk));
    corner-shape: var(--corner);
    background: var(--c);
    color: var(--ink);
    transition: transform 0.4s var(--ease-out);
  }

  .nbo-step.is-here .nbo-step__card {
    box-shadow: var(--shadow-card);
  }

  a.nbo-step__card:hover {
    transform: scale(1.015);
  }

  .nbo-step__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 32px;
  }

  .nbo-step__word {
    font-size: clamp(1.3rem, calc(var(--vw) * 1.6), 1.5rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 560;
  }

  a.nbo-step__card:hover .nbo-step__go {
    background: var(--line-2);
  }

  .nbo-step__go :global(svg) {
    transition: transform 0.3s var(--ease-out);
  }

  a.nbo-step__card:hover .nbo-step__go :global(svg) {
    transform: translateX(2px);
  }

  .nbo-step__here {
    background: var(--panel);
    color: var(--ink);
    font-weight: 560;
  }

  .nbo-step__place {
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.4;
    color: var(--muted);
  }

  .nbo-step__labels {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-top: 14px;
  }

  .nbo-step__labels :global(.plabel) {
    font-size: 15px;
  }

  .nbo-step__text {
    margin-top: 14px;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* звенья в ряд: две метки «Передано» встают в две строки — у всех звеньев место под две строки меток
     (значок метки 26 px + зазор 8 px), чтобы пояснения начинались на одной высоте */
  @media (min-width: 1200px) {
    .nbo-step__labels {
      min-height: calc(2 * 26px + 8px);
      align-content: flex-start;
    }
  }

  /* ── 3. Две карточки ─────────────────────────────────── */
  .nbo-more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, calc(var(--vw) * 1.8), 24px);
    margin-top: clamp(18px, calc(var(--vw) * 1.8), 24px);
  }

  .nbo-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding: clamp(22px, calc(var(--vw) * 2.6), 32px);
    border-radius: calc(var(--r-lg) * var(--rk));
    corner-shape: var(--corner);
    background: var(--panel);
  }

  .nbo-card__labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }

  .nbo-card__pair {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .nbo-card__plus {
    font-size: 18px;
    color: var(--subtle);
  }

  .nbo-card__title {
    margin-top: 20px;
    font-size: clamp(1.35rem, calc(var(--vw) * 2), 1.75rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 560;
    text-wrap: balance;
  }

  .nbo-card__text {
    max-width: 52ch;
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  .nbo-card__act {
    margin-top: auto;
    padding-top: 26px;
  }

  /* ссылка невысокая: область нажатия больше её самой — не меньше 44 px */
  .nbo-card__link {
    position: relative;
  }

  .nbo-card__link::after {
    content: '';
    position: absolute;
    inset: -10px -8px -8px;
  }

  /* ── Планшет: звенья столбиком, мостики — между ними ───── */
  @media (max-width: 1199.98px) {
    .nbo-scene {
      --nbo-link: 120px;
      grid-template-columns: minmax(0, 340px) var(--nbo-link) minmax(0, 340px);
    }

    /* кабинеты уже: фото меньше, вкладка «Акты» прячется */
    .nbo-app {
      padding: 16px;
    }

    .nbo-app__tab {
      display: none;
    }

    .nbo-act,
    .nbo-skel {
      grid-template-columns: 100px minmax(0, 1fr);
      gap: 12px;
    }

    .nbo-act__ph,
    .nbo-skel__ph {
      height: 80px;
    }

    .nbo-act__net-v {
      font-size: 17px;
    }

    /* заголовок здесь мельче 24 px — «=» темнее, чтобы контраст был не ниже 4,5:1 */
    .nbo-bal__eq {
      color: var(--muted);
    }

    .nbo-chain {
      grid-template-columns: minmax(0, 1fr);
    }

    .nbo-step + .nbo-step::before {
      top: calc(var(--gap) * -1 - 1px);
      left: calc(50% - (var(--gap) + var(--bridge)) / 2);
      width: calc(var(--gap) + var(--bridge));
      height: calc(var(--gap) + 2px);
      background: linear-gradient(180deg, var(--cl), var(--c));
      -webkit-mask: var(--bridge-mask-col);
      mask: var(--bridge-mask-col);
    }

    .nbo-step + .nbo-step::after {
      left: calc(50% - 7px);
      top: calc(var(--gap) / -2 - 4px);
    }

    /* в карточке: слева шаг, место и продукты, справа текст */
    .nbo-step__card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      grid-template-areas:
        'top text'
        'place text'
        'labels text';
      grid-template-rows: auto auto 1fr;
      column-gap: 32px;
      position: relative;
    }

    .nbo-step__top {
      grid-area: top;
    }

    /* стрелка и «вы здесь» — в правом верхнем углу карточки */
    .nbo-step__go,
    .nbo-step__here {
      position: absolute;
      top: 20px;
      right: 20px;
    }

    .nbo-step__place {
      grid-area: place;
    }

    .nbo-step__labels {
      grid-area: labels;
      align-self: start;
    }

    .nbo-step__text {
      grid-area: text;
      align-self: center;
      margin-top: 0;
      padding-right: 44px;
    }
  }

  @media (max-width: 759.98px) {
    .nbo-more {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── Узкий планшет и телефон: кабинеты друг под другом, весовая между ними ── */
  @media (max-width: 819.98px) {
    .nbo-vis {
      min-height: 0;
      padding: 56px 14px 18px;
    }

    .nbo-vis__demo {
      top: 14px;
      left: 14px;
    }

    .nbo-app__tab {
      display: inline-block;
    }

    .nbo-scene {
      --nbo-link: 112px;
      grid-template-columns: minmax(0, 360px);
      grid-template-rows: auto var(--nbo-link) auto;
      grid-template-areas: 'a' 'link' 'b';
    }

    /* линии вертикальные: от весовой вверх и вниз; подпись — справа от весовой */
    .nbo-hub__t {
      top: 50%;
      left: calc(100% + 14px);
      translate: 0 -50%;
    }

    .nbo-hub {
      width: 56px;
      height: 56px;
    }

    .nbo-hub__ico {
      width: 36px;
      height: 36px;
      border-radius: 11px;
    }

    .nbo-wire {
      --hub-r: 35px;
      top: auto;
      bottom: auto;
      left: calc(50% - 1px);
      right: auto;
      width: 2px;
      height: auto;
      background: repeating-linear-gradient(180deg, rgb(29 29 31 / 0.22) 0 5px, transparent 5px 10px);
    }

    .nbo-wire--a {
      top: 0;
      bottom: calc(50% + var(--hub-r));
    }

    .nbo-wire--b {
      top: calc(50% + var(--hub-r));
      bottom: 0;
    }

    .nbo-wire--a i {
      transform-origin: 50% 100%;
    }

    .nbo-wire--b i {
      transform-origin: 50% 0;
    }

    .nbo-wire::after {
      left: -3px;
      right: auto;
    }

    .nbo-wire--a::after {
      top: -4px;
    }

    .nbo-wire--b::after {
      top: auto;
      bottom: -4px;
    }

    .nbo-vis.is-armed:not(.is-live) .nbo-wire i {
      transform: scaleY(0);
    }

    .nbo-vis.is-live .nbo-wire i {
      animation-name: nbo-grow-y;
    }
  }

  /* ── Телефон: звенья баланса — в один столбец и внутри ── */
  @media (max-width: 679.98px) {
    .nbo-step__card {
      display: flex;
      padding: 20px 20px 22px;
    }

    .nbo-step__text {
      align-self: auto;
      margin-top: 12px;
      padding-right: 0;
    }

    .nbo-card__title {
      margin-top: 16px;
    }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Сцена «одно взвешивание — два кабинета» проигрывается один раз, когда заметная её часть на экране;
  // ушла с экрана — возвращается в начало. Пока вкладка скрыта, сцена стоит. При «уменьшить движение»
  // классы не ставятся — видно итоговое состояние.
  const demo = document.querySelector<HTMLElement>('[data-nbo-demo]');
  if (demo && !reducedMotion() && 'IntersectionObserver' in window) {
    demo.classList.add('is-armed');
    new IntersectionObserver(
      ([entry]) => {
        if (entry.intersectionRatio >= 0.45) demo.classList.add('is-live');
        else if (!entry.isIntersecting) demo.classList.remove('is-live');
      },
      { threshold: [0, 0.45] },
    ).observe(demo);
    document.addEventListener('visibilitychange', () => demo.classList.toggle('is-paused', document.hidden));
  }
</script>
