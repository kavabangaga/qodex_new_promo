---
// Раздел страницы «QODEX TONN» — «Результаты» [#rezultaty], бежевая панель. Два разных кейса, цифры не складываем.
// 1. История РО «Эко-Сити» (как в «Историях» главной: задача → решение → результат, без цитат). Слева белая карточка:
//    метка, две крупные цифры — это и есть результат (>60 млн ₽, 28 млн ₽), под ними задача и решение строками.
//    Справа градиент mint (единственный на странице) с белой карточкой −57%: рисунок «тоннаж в актах — март 2024
//    и март 2025».
//    Подложка собрана классами .gv, а не компонентом GradientVisual: компонент прячет содержимое от скринридера,
//    а здесь настоящая цифра и её подпись.
// 2. Кейс мусоросортировочного комплекса с лендинга (блок B13): текст, кнопка, четыре цифры и «Что внедрили».
//    Скана письма и цитаты нет — по ТЗ заказчика.
// Числа досчитываются при появлении (data-count, scripts/motion.ts); «45 дней» и «1200%» не досчитываются:
// «0 дней», «1 дней» по дороге читаются как ошибка, а «1 200» в досчёте не совпало бы с итоговым «1200».
import SectionIntro from '../../components/SectionIntro.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import GvBlobs from '../../components/GvBlobs.astro';

const NB = String.fromCharCode(160); // неразрывный пробел

interface Fig {
  /** Знак перед числом — не досчитывается. */
  prefix?: string;
  /** Число для досчёта; без него число стоит сразу итоговым. */
  count?: number;
  value: string;
  /** Единицы после числа — вдвое мельче. */
  unit?: string;
  caption: string;
}

// Кейс 1 — история РО «Эко-Сити» (тексты из ТЗ главной)
const STORY_FIGS: Fig[] = [
  { prefix: '>', count: 60, value: '60', unit: `${NB}млн${NB}₽`, caption: `сэкономил РО${NB}«Эко-Сити» за${NB}год` },
  { count: 28, value: '28', unit: `${NB}млн${NB}₽`, caption: `за июнь–декабрь 2021, 10${NB}объектов` },
];

const STORY_QA = [
  { term: 'Задача', text: `Платить объектам приёма ТКО за${NB}реальный вес.` },
  {
    term: 'Решение',
    text: `QODEX${NB}TONN на${NB}весовых объектов — номер, фото и${NB}вес без ручного ввода, акты в${NB}облаке.`,
  },
  // строки «Результат» нет: его уже говорят две крупные цифры с подписями — второй раз те же числа не повторяем
];

// Кейс 2 — мусоросортировочный комплекс (лендинг, блок B13)
const CASE_FIGS: Fig[] = [
  { prefix: '+', count: 18, value: '18', unit: '%', caption: 'рост выручки' },
  { prefix: '−', count: 95, value: '95', unit: '%', caption: 'снижение потерь' },
  { value: '45', unit: `${NB}дней`, caption: 'окупаемость' },
  { value: '1200', unit: '%', caption: 'окупаемость системы' },
];

const DONE: { icon: IconName; text: string }[] = [
  { icon: 'do-not-touch', text: 'Автоматическую фиксацию входящего тоннажа без участия человека' },
  { icon: 'task-done', text: `Электронные акты с${NB}фото: брутто, тара, нетто` },
  { icon: 'arrow-shrink', text: `Интеграцию с${NB}1С и${NB}государственными системами учёта` },
  { icon: 'cctv', text: 'Контроль работы сортировочного комплекса' },
];
---

<section class="section panel" id="rezultaty" aria-labelledby="rezultaty-title">
  <div class="container">
    <SectionIntro eyebrow="Результаты" titleId="rezultaty-title">
      Реальные результаты наших клиентов
      <Fragment slot="lead"
        ><span class="nres-lead">Система работает на объектах ТКО по всей России.</span>
        <span class="nres-lead">Вот что получили наши клиенты.</span></Fragment
      >
    </SectionIntro>

    <div class="nres">
      <!-- Кейс 1: история РО «Эко-Сити» -->
      <div class="nres-story">
        <article class="nres-card nres-story__card" aria-labelledby="rezultaty-eko" data-reveal style="--d:1">
          <h3 class="nres-chip" id="rezultaty-eko">
            <span class="nres-chip__ico nres-chip__ico--tonn p-tonn" aria-hidden="true">
              <Icon name="scale" size={17} strokeWidth={2} />
            </span>
            <span>РО{NB}«Эко-Сити»{NB}· QODEX{NB}TONN</span>
          </h3>

          <ul class="nres-figs">
            {
              STORY_FIGS.map((f) => (
                <li class="nres-fig">
                  <p class="nres-num nres-num--story">
                    <span class="nres-num__fix" aria-hidden="true">
                      {f.prefix}{f.value}<span class="nres-unit">{f.unit}</span>
                    </span>
                    <span class="nres-num__live">
                      {f.prefix}<span data-count={f.count}>{f.value}</span><span class="nres-unit">{f.unit}</span>
                    </span>
                  </p>
                  <p class="nres-fig__cap">{f.caption}</p>
                </li>
              ))
            }
          </ul>

          <dl class="nres-qa">
            {
              STORY_QA.map((q) => (
                <div class="nres-qa__row">
                  <dt>{q.term}</dt>
                  <dd>{q.text}</dd>
                </div>
              ))
            }
          </dl>
        </article>

        <!-- −57%: рисунок «до / после» на градиенте mint -->
        <div class="gv gv--mint gv--blobs nres-vis" data-reveal style="--d:2">
          <GvBlobs preset="mint" />
          <div class="ui nres-chart" data-nres-chart>
            <p class="nres-num nres-num--chart">
              <span class="nres-num__fix" aria-hidden="true">−57<span class="nres-unit nres-unit--pct">%</span></span>
              <span class="nres-num__live">−<span data-count="57">57</span><span class="nres-unit nres-unit--pct">%</span></span>
            </p>
            <p class="nres-chart__cap">тоннажа в актах после установки</p>

            <!-- март 2024 — полный столбик; март 2025 — 43%, ушедшая часть штрихом. Сначала оба столбика
                 вырастают одинаковыми, затем верх второго тает — остаётся штриховка. Подписи «−57%» на ней нет:
                 крупная цифра стоит прямо над рисунком. -->
            <div class="nres-plot" aria-hidden="true">
              <div class="nres-plot__bars">
                <span class="nres-bar">
                  <span class="nres-bar__grow">
                    <i class="nres-bar__fill nres-bar__fill--before"></i>
                  </span>
                </span>
                <span class="nres-bar nres-bar--after">
                  <span class="nres-bar__ghost"></span>
                  <span class="nres-bar__grow">
                    <i class="nres-bar__gone"></i>
                    <i class="nres-bar__fill nres-bar__fill--after"></i>
                  </span>
                </span>
              </div>
              <div class="nres-plot__axis">
                <span>март{NB}2024</span>
                <span>март{NB}2025</span>
              </div>
            </div>

            <p class="nres-chart__note">март{NB}2025 к{NB}марту{NB}2024, 4{NB}района Башкортостана</p>
          </div>
        </div>
      </div>

      <!-- Кейс 2: мусоросортировочный комплекс -->
      <article class="nres-card nres-case" aria-labelledby="rezultaty-msk" data-reveal style="--d:1">
        <h3 class="nres-chip nres-case__chip" id="rezultaty-msk">
          <span class="nres-chip__ico" aria-hidden="true">
            <Icon name="factory" size={17} strokeWidth={2} />
          </span>
          <span>Республика{NB}Башкортостан{NB}· Мусоросортировочный комплекс</span>
        </h3>
        <p class="nres-case__text">
          Система фиксирует каждое взвешивание, автоматически формирует акт с{NB}фотографиями и{NB}передаёт данные
          в{NB}учётные системы.
        </p>

        <ul class="nres-case__figs">
          {
            CASE_FIGS.map((f) => (
              <li class="nres-fig">
                <p class="nres-num nres-num--case">
                  {f.count ? (
                    <>
                      <span class="nres-num__fix" aria-hidden="true">
                        {f.prefix}{f.value}<span class:list={['nres-unit', { 'nres-unit--pct': f.unit === '%' }]}>{f.unit}</span>
                      </span>
                      <span class="nres-num__live">
                        {f.prefix}<span data-count={f.count}>{f.value}</span><span class:list={['nres-unit', { 'nres-unit--pct': f.unit === '%' }]}>{f.unit}</span>
                      </span>
                    </>
                  ) : (
                    <span>
                      {f.value}<span class:list={['nres-unit', { 'nres-unit--pct': f.unit === '%' }]}>{f.unit}</span>
                    </span>
                  )}
                </p>
                <p class="nres-fig__cap">{f.caption}</p>
              </li>
            ))
          }
        </ul>

        <div class="nres-case__cta">
          <a href="#forma" class="btn btn--primary" data-interest="tonn" data-goal="pilot_click">
            Хочу такой же результат <Icon name="arrow-right" />
          </a>
        </div>

        <div class="nres-done">
          <h4 class="nres-done__title">Что внедрили</h4>
          <ul class="nres-done__list">
            {
              DONE.map((d) => (
                <li class="nres-done__item">
                  <span class="nres-done__ico" aria-hidden="true">
                    <Icon name={d.icon} size={20} strokeWidth={1.8} />
                  </span>
                  <span class="nres-done__text">{d.text}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  /* подзаголовок — каждое предложение своей строкой, как на лендинге (содержимое слота lead) */
  .nres-lead {
    display: block;
  }

  .nres {
    --nres-gap: clamp(16px, calc(var(--vw) * 1.6), 24px);
    --nres-pad: clamp(24px, calc(var(--vw) * 3), 44px);
    display: grid;
    gap: clamp(40px, calc(var(--vw) * 4.4), 64px);
  }

  /* ── Белые карточки на панели ── */
  .nres-card {
    position: relative;
    min-width: 0;
    padding: var(--nres-pad);
    border-radius: calc(var(--r-lg) * var(--rk));
    corner-shape: var(--corner);
    background: var(--card);
  }

  /* Метка кейса (h3): плитка значка + «клиент · продукт» */
  .nres-chip {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    font-weight: 560;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--ink);
  }

  .nres-chip__ico {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: calc(10px * var(--rk));
    corner-shape: var(--corner);
    background: var(--panel);
    color: var(--ink);
  }

  /* цвет продукта — только в плитке значка */
  .nres-chip__ico--tonn {
    background: var(--pc);
    color: #fff;
  }

  /* ── Цифры: ширину держит невидимое итоговое значение, досчёт идёт поверх него ── */
  .nres-num {
    position: relative;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: var(--ink);
  }

  .nres-num__fix {
    visibility: hidden;
  }

  .nres-num__live {
    position: absolute;
    top: 0;
    left: 0;
  }

  /* единицы вдвое мельче (как в кейсах РО-БОТа), но не мельче подписи; трекинг свой — lib/tight-pairs.ts */
  .nres-unit {
    font-size: max(0.5em, 15px);
    font-weight: 560;
    letter-spacing: -0.02em;
  }

  /* знак процента — крупнее единиц: читается частью числа */
  .nres-unit--pct {
    font-size: 0.72em;
    letter-spacing: -0.03em;
  }

  .nres-fig {
    position: relative;
    display: grid;
    gap: 10px;
    align-content: start;
    min-width: 0;
    padding-top: 20px;
  }

  /* разделитель — полоска-псевдоэлемент: однопиксельную рамку при дробном масштабе Safari не рисует */
  .nres-fig::before,
  .nres-qa__row::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--line);
  }

  .nres-fig__cap {
    max-width: 30ch;
    font-size: 16px;
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ── Кейс 1: карточка истории и градиент рядом ── */
  .nres-story {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: var(--nres-gap);
  }

  .nres-story__card {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, calc(var(--vw) * 2.8), 40px);
  }

  /* карточку по высоте задаёт градиент рядом: лишнее место делится поровну над цифрами и под ними,
     а не одной дырой между цифрами и задачей */
  .nres-figs {
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px clamp(20px, calc(var(--vw) * 2.2), 32px);
  }

  .nres-num--story {
    font-size: clamp(3rem, calc(var(--vw) * 4.6), 4.5rem);
  }

  /* Задача и решение — строками: подпись слева, текст справа */
  .nres-qa {
    display: grid;
    margin-top: auto;
  }

  .nres-qa__row {
    position: relative;
    display: grid;
    grid-template-columns: 7.2em minmax(0, 1fr);
    gap: 6px 20px;
    padding-block: 16px;
    font-size: 16px;
    line-height: 1.5;
  }

  .nres-qa__row:last-child {
    padding-bottom: 0;
  }

  .nres-qa dt {
    font-weight: 600;
    color: var(--ink);
  }

  .nres-qa dd {
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ── Градиент mint с карточкой −57% ── */
  .nres-vis {
    min-height: 0;
    padding: clamp(24px, calc(var(--vw) * 2.2), 36px) clamp(16px, calc(var(--vw) * 3), 48px);
  }

  /* белая карточка настоящей цифры: оформление .ui, но это плашка — форма угла как у плашек */
  .nres-chart {
    --rk: inherit;
    --corner: inherit;
    display: grid;
    gap: 12px;
    width: min(100%, 440px);
    border-radius: calc(24px * var(--rk));
    corner-shape: var(--corner);
  }

  .nres-num--chart {
    font-size: clamp(4rem, calc(var(--vw) * 6), 5.75rem);
    line-height: 0.92;
  }

  .nres-chart__cap {
    font-size: clamp(1.06rem, calc(var(--vw) * 1.2), 1.15rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink-2);
  }

  /* рисунок на тёплой подложке, как «100 → 60» на странице Tracker */
  .nres-plot {
    --nres-h: clamp(150px, calc(var(--vw) * 10), 172px);
    margin-top: 10px;
    padding: 22px 22px 14px;
    border-radius: 16px;
    background: var(--bg);
  }

  .nres-plot__bars,
  .nres-plot__axis {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 22px;
  }

  .nres-plot__bars {
    position: relative;
    height: var(--nres-h);
  }

  /* линия основания */
  .nres-plot__bars::after {
    content: '';
    position: absolute;
    inset: auto -8px 0;
    height: 1.5px;
    border-radius: 1px;
    background: var(--line-2);
  }

  .nres-bar {
    position: relative;
    display: block;
    width: min(100%, 104px);
    height: 100%;
    justify-self: center;
  }

  .nres-bar__grow {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 3px;
    transform-origin: 50% 100%;
  }

  .nres-bar__fill {
    display: block;
    border-radius: 10px 10px 0 0;
  }

  .nres-bar__fill--before {
    height: 100%;
    background: #cfcac0;
  }

  .nres-bar__fill--after {
    height: 43%;
    flex: none;
    border-radius: 3px 3px 0 0;
    background: var(--ink);
  }

  /* верх второго столбика в начале движения — как первый столбик; в итоге его нет */
  .nres-bar__gone {
    display: block;
    flex: 1;
    border-radius: 10px 10px 3px 3px;
    background: #cfcac0;
    opacity: 0;
  }

  /* ушедшая часть: штриховка с обводкой (обводка — внутренней тенью: border Safari при дробном масштабе не рисует) */
  .nres-bar__ghost {
    position: absolute;
    font-style: normal;
    inset: 0 0 calc(43% + 3px);
    border-radius: 10px 10px 3px 3px;
    background: repeating-linear-gradient(135deg, rgb(29 29 31 / 0.13) 0 1.5px, transparent 1.5px 7px);
    box-shadow: inset 0 0 0 1.5px rgb(29 29 31 / 0.2);
  }

  .nres-plot__axis {
    margin-top: 10px;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    color: var(--muted);
  }

  .nres-chart__note {
    margin-top: 4px;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* Движение — один раз, когда рисунок на экране: столбики вырастают одинаковыми, затем верх второго тает
     и проступает штриховка. Классы ставит скрипт; без них (нет скриптов, «уменьшить движение») сразу
     видно итоговое состояние. */
  .nres-chart.is-armed .nres-bar__grow {
    transform: scaleY(0);
  }

  .nres-chart.is-armed .nres-bar__gone {
    opacity: 1;
  }

  .nres-chart.is-armed .nres-bar__ghost {
    opacity: 0;
  }

  .nres-chart.is-live .nres-bar__grow {
    transform: none;
    transition: transform 1.1s var(--ease-out);
  }

  .nres-chart.is-live .nres-bar--after .nres-bar__grow {
    transition-delay: 0.12s;
  }

  .nres-chart.is-live .nres-bar__gone {
    opacity: 0;
    transition: opacity 0.7s var(--ease-in-out) 1.45s;
  }

  .nres-chart.is-live .nres-bar__ghost {
    opacity: 1;
    transition: opacity 0.7s var(--ease-in-out) 1.45s;
  }

  @media (prefers-reduced-motion: reduce) {
    .nres-chart * {
      transition: none !important;
    }
  }

  /* ── Кейс 2: мусоросортировочный комплекс ──
     Сетка: метка во всю ширину; под ней слева текст и кнопка, справа четыре цифры 2 × 2;
     внизу «Что внедрили» во всю ширину. */
  .nres-case {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-areas:
      'chip chip'
      'text figs'
      'cta  figs'
      'done done';
    grid-template-rows: auto auto 1fr auto;
    column-gap: clamp(32px, calc(var(--vw) * 5), 80px);
  }

  .nres-case__chip {
    grid-area: chip;
    margin-bottom: clamp(28px, calc(var(--vw) * 2.8), 40px);
  }

  .nres-case__text {
    grid-area: text;
    max-width: 24em;
    font-size: clamp(1.25rem, calc(var(--vw) * 1.6), 1.5rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: pretty;
  }

  .nres-case__cta {
    grid-area: cta;
    align-self: end;
    padding-top: 28px;
  }

  .nres-case__figs {
    grid-area: figs;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, calc(var(--vw) * 2.4), 36px) clamp(20px, calc(var(--vw) * 2.2), 32px);
    align-content: start;
  }

  .nres-num--case {
    font-size: clamp(2.6rem, calc(var(--vw) * 4), 3.75rem);
  }

  /* «Что внедрили»: бежевая подложка внутри карточки, четыре пункта в ряд */
  .nres-done {
    grid-area: done;
    margin-top: clamp(32px, calc(var(--vw) * 3.4), 48px);
    padding: clamp(20px, calc(var(--vw) * 2.2), 28px);
    border-radius: calc(var(--r) * var(--rk));
    corner-shape: var(--corner);
    background: var(--panel);
  }

  .nres-done__title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .nres-done__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px clamp(20px, calc(var(--vw) * 2.2), 32px);
    margin-top: 18px;
  }

  .nres-done__item {
    display: grid;
    gap: 14px;
    align-content: start;
    min-width: 0;
  }

  .nres-done__ico {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: calc(12px * var(--rk));
    corner-shape: var(--corner);
    background: var(--card);
    color: var(--ink);
  }

  .nres-done__text {
    font-size: 15.5px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* ── Планшет и уже: кейс 1 — карточка, под ней градиент; у кейса 2 цифры под текстом в ряд ── */
  @media (max-width: 959.98px) {
    .nres-story {
      grid-template-columns: minmax(0, 1fr);
    }

    .nres-case {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'chip'
        'text'
        'figs'
        'cta'
        'done';
      grid-template-rows: none;
    }

    .nres-case__chip {
      margin-bottom: 24px;
    }

    .nres-case__figs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 32px;
    }

    /* пункты «Что внедрили» — значок слева от текста */
    .nres-done__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
