</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Рисунок «−57%»: столбики вырастают один раз, когда он на экране. При «уменьшить движение» классы
  // не ставятся — видно итоговое состояние.
  if (!reducedMotion() && 'IntersectionObserver' in window) {
    const chart = document.querySelector<HTMLElement>('[data-nres-chart]');
    if (chart) {
      chart.classList.add('is-armed');
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          chart.classList.add('is-live');
          io.disconnect();
        },
        { threshold: 0.5 },
      );
      io.observe(chart);
    }
  }
</script>
