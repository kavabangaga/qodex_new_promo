</style>

<script>
  // Движение в картинках и полосе — только пока они на экране
  const live = document.querySelectorAll<HTMLElement>('.ob [data-live]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('is-live', e.isIntersecting)),
      { threshold: 0.15 },
    );
    live.forEach((el) => io.observe(el));
  } else {
    live.forEach((el) => el.classList.add('is-live'));
  }
</script>
