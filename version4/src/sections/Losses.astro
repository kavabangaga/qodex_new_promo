    }

    .lc.is-on:not(.is-open) .lc__mark {
      opacity: 1;
      transform: none;
      transition-delay: 0.2s;
    }
  }

  /* узкий ряд (1200–1359 px): закрытые карточки уже, текст чуть мельче */
  @media (min-width: 1200px) and (max-width: 1359px) {
    .lc-chain {
      --lc-pad: 20px;
    }

    .lc__title {
      font-size: 1.375rem;
    }
  }

  /* Лёгкое движение в раскрытой карточке — только пока цепочка на экране */
  .lc-chain.is-live .lc.is-open .mi__p.is-miss,
  .lc-chain.is-live .lc.is-open .mi__stop.is-q {
    animation: mi-blink 2.4s var(--ease-in-out) infinite;
    animation-delay: calc(var(--k) * 0.35s);
  }

  .lc-chain.is-live .lc.is-open .mi__blink {
    animation: mi-blink 2.4s var(--ease-in-out) infinite;
  }

  .lc-chain.is-live .lc.is-open .mi__live::before {
    animation: mi-dot 1.8s var(--ease-in-out) infinite;
  }

  @keyframes mi-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @keyframes mi-dot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.7);
    }
