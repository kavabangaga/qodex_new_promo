    flex: none;
  }

  @media (max-width: 760px) {
    .lr__panel {
      flex-direction: column;
      align-items: stretch;
      padding: 20px;
    }

    .lr__cta {
      white-space: normal;
    }
  }

  .lc-notes {
    max-width: 860px;
    margin: 28px auto 0;
