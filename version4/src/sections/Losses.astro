  }

  .lr__clip {
    min-height: 0;
    overflow: hidden;
    margin-inline: -24px;
    padding-inline: 24px;
  }

  .lr__panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    margin: 24px 0 30px;
    padding: 20px 22px 20px 28px;
    border-radius: var(--r);
    background: var(--card);
    box-shadow: var(--shadow-soft);
    opacity: 0;
    transform: translateY(-10px);
    visibility: hidden;
    transition:
      opacity 0.35s,
      transform 0.55s var(--ease-out),
      visibility 0s linear 0.55s;
