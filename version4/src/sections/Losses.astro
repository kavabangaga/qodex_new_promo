    .lc {
      flex: none;
      height: auto;
    }

    .lc.is-open {
      box-shadow: none;
    }

    /* звенья — вертикальные, как у общей цепочки на узком экране */
    .lc + .lc::before,
    .lc + .lc::after {
      left: 34px;
      top: calc(var(--chain-gap) * -1 - 4px);
      width: 22px;
      height: calc(var(--chain-gap) + 8px);
    }

    .lc + .lc::after {
      left: auto;
      right: 34px;
    }

    .lc__in {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }

    .lc__text {
      padding: 26px 28px 28px;
    }

    .lc__more {
      width: auto;
    }

    .lc__deco,
    .lc__mark {
      display: none;
    }

    .lc__art {
      position: relative;
      width: auto;
      height: auto;
      min-height: 230px;
      margin: 10px;
      border-radius: 14px;
      background:
        radial-gradient(70% 80% at 8% 100%, var(--a1) 0%, transparent 72%),
        radial-gradient(70% 80% at 95% 95%, var(--a2) 0%, transparent 72%),
        linear-gradient(180deg, color-mix(in oklab, var(--a3) 40%, white) 0%, var(--a3) 100%);
    }

    .mi {
      top: 50%;
      bottom: auto;
      translate: -50% -50%;
    }
  }

  /* ── Телефон: лента с прокруткой вбок, видно край следующей карточки ── */
  @media (max-width: 640px) {
    .lc-chain {
      --chain-gap: 18px;
      flex-direction: row;
      margin-inline: calc(var(--gutter) * -1);
      padding: 2px var(--gutter) 6px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .lc-chain::-webkit-scrollbar {
      display: none;
    }

    .lc {
      flex: 0 0 min(86%, 340px);
      scroll-snap-align: start;
    }

    /* звенья снова горизонтальные, как на широком экране */
    .lc + .lc::before,
    .lc + .lc::after {
      left: calc(var(--chain-gap) * -1 - 4px);
      right: auto;
      width: calc(var(--chain-gap) + 8px);
      height: 22px;
    }

    .lc + .lc::before {
