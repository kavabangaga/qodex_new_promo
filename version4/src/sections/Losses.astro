  /* ── Раскрытие на широком экране ─────────────────────────── */
  @media (min-width: 1200px) {
    .lc:not(.is-open) {
      cursor: pointer;
    }

    .lc:not(.is-open) .lc__more {
      opacity: 0;
      pointer-events: none;
      transition-duration: 0.2s;
      transition-delay: 0s;
    }

    .lc:not(.is-open) .lc__art {
      opacity: 0;
      transition-duration: 0.25s;
      transition-delay: 0s;
    }

    .lc:not(.is-open) .lc__deco {
      opacity: 1;
      transition-delay: 0.2s;
    }

    .lc:not(.is-open) .mi {
      opacity: 0;
      transform: translateY(16px);
      transition-delay: 0s;
    }

    .lc:not(.is-open) .mi__bar i {
