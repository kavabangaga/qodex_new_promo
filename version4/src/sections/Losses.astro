  }

  .lr.is-open + .lc-notes {
    margin-top: 0;
  }
</style>

<script>
  import { PRODUCT_ORDER, type ProductId } from '../config/site';
  import { addInterest, removeInterest } from '../scripts/interest';

  const chain = document.querySelector<HTMLElement>('[data-losses]');
  const result = document.querySelector<HTMLElement>('[data-result]');

  if (chain && result) {
    const cards = [...chain.querySelectorAll<HTMLElement>('[data-row]')];
    const chips = [...result.querySelectorAll<HTMLElement>('[data-result-product]')];
    const stepEl = result.querySelector<HTMLElement>('[data-result-step]')!;
    const cta = result.querySelector<HTMLAnchorElement>('[data-result-cta]')!;

    const isOn = (card: HTMLElement) => card.classList.contains('is-on');

    const checkedProducts = (): ProductId[] => {
      const set = new Set(cards.filter(isOn).map((c) => c.dataset.product as ProductId));
      return PRODUCT_ORDER.filter((id) => set.has(id));
    };

    // Правило первого шага из ТЗ
    const firstStep = (ids: ProductId[]): string => {
      if (ids.includes('robot')) return 'бесплатный пилот РО-БОТа на одном районе';
      if (ids.includes('tonn')) return 'месяц бесплатно после запуска';
      if (ids.includes('kodeks')) return 'неделя бесплатно';
      return 'покажем демо';
    };

    const render = () => {
      const ids = checkedProducts();
      result.classList.toggle('is-open', ids.length > 0);
      chips.forEach((chip) => {
        chip.hidden = !ids.includes(chip.dataset.resultProduct as ProductId);
      });
      if (ids.length) stepEl.textContent = firstStep(ids);
    };

    cards.forEach((card) => {
      const btn = card.querySelector<HTMLButtonElement>('[data-check]')!;
      btn.addEventListener('click', () => {
        const on = !isOn(card);
        card.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', String(on));
        const product = card.dataset.product as ProductId;
        if (on) addInterest([product]);
        else if (!checkedProducts().includes(product)) removeInterest([product]);
        render();
      });
    });

    cta.addEventListener('click', () => addInterest(checkedProducts()));

    // Лёгкие анимации иллюстраций идут, только пока цепочка на экране
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => chain.classList.toggle('is-live', entry.isIntersecting), {
        threshold: 0.1,
      }).observe(chain);
    } else {
      chain.classList.add('is-live');
    }
  }
</script>
