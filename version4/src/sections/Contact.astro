---
// Блок 15. Заявка и контакты — приём Calendly «Get started»: надпись, крупный заголовок по центру,
// подзаголовок, горизонтальная форма на белой карточке, ниже — ряд градиентных карточек палитры
// Calendly с белыми плашками интерфейса (вместо фото людей): контакт по пилоту (у номера — плашка MAX), почта, Telegram.
import SectionIntro from '../components/SectionIntro.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import { CONTACTS, withBase } from '../config/site';
import fs from 'node:fs';
import path from 'node:path';
import GvBlobs from '../components/GvBlobs.astro';

// Тексты по умолчанию — главная страница; страница продукта передаёт свои.
interface Props {
  title?: string;
  /** Пустая строка — без подзаголовка. */
  lead?: string;
  /** Строка с зелёной точкой под подзаголовком. */
  proof?: string;
  /** Подпись в карточке контакта. */
  personLabel?: string;
  /** Заголовок меньше обычного (размер заголовка продуктового раздела) — для страниц, где заявка не главное. */
  compact?: boolean;
  /** Шаги «как начать» над формой (страница продукта); последний — с галочкой. Без них блок как на главной. */
  steps?: { title: string; text: string }[];
  /** Презентация рядом с формой (главная): файл в public/files/, надпись ссылки, имя при скачивании. */
  deck?: { file: string; label: string; download: string };
}

const {
  title = 'Покажем эффект в рублях на одном районе или одной весовой',
  lead = 'Пилот РО-БОТа — бесплатно. Напишите или позвоните — пришлём NDA и запустим пилот.',
  proof = '73 клиента работают с продуктами QODEX',
  personLabel = 'Ваш контакт по пилоту',
  compact = false,
  steps = [],
  deck,
} = Astro.props;

// размер презентации — при сборке; нет файла — сборка останавливается
let deckMeta = '';
if (deck) {
  const p = path.join(process.cwd(), 'public', 'files', deck.file);
  if (!fs.existsSync(p)) throw new Error(`Нет файла презентации public/files/${deck.file}`);
  deckMeta = `PDF, ${(fs.statSync(p).size / 1024 / 1024).toFixed(1).replace('.', ',')}${String.fromCharCode(160)}МБ`;
}

// Высоты полос «звуковой волны» в центральной карточке
const BARS = [40, 64, 86, 58, 94, 72, 48, 80];
---

<section class="section contact" id="kontakty" data-contact aria-labelledby="forma">
  <div class="container">
    {
      /* слот, переданный даже пустым, SectionIntro выводит пустым абзацем — поэтому две ветки */
      lead ? (
        <SectionIntro eyebrow="Заявка" titleId="forma" serif={compact}>
          {title}
          <Fragment slot="lead">{lead}</Fragment>
          <p slot="cta" class="contact__proof">
            <span class="contact__dot" aria-hidden="true" />
            {proof}
          </p>
        </SectionIntro>
      ) : (
        <SectionIntro eyebrow="Заявка" titleId="forma" serif={compact}>
          {title}
          <p slot="cta" class="contact__proof">
            <span class="contact__dot" aria-hidden="true" />
            {proof}
          </p>
        </SectionIntro>
      )
    }

    {
      steps.length > 0 && (
        <ol class="contact__steps" aria-label="Как начать">
          {steps.map((st, i) => (
            <li class:list={['contact__step', { 'is-last': i === steps.length - 1 }]} data-reveal style={`--d:${i + 1}`}>
              <span class="contact__step-n">
                {i === steps.length - 1 && <Icon name="circle-check" size={16} strokeWidth={2} />}
                Шаг {i + 1}
              </span>
              <span class="contact__step-title">{st.title}</span>
              <span class="contact__step-text">{st.text}</span>
            </li>
          ))}
        </ol>
      )
    }

    <div class="contact__form" data-reveal>
      <LeadForm prefix="ft" layout="row" tone="light" />
    </div>

    {
      deck && (
        <p class="contact__deck">
          <a class="link-arrow" href={withBase(`/files/${deck.file}`)} download={deck.download} aria-describedby="contact-deck-meta">
            {deck.label}
            <Icon name="download" />
          </a>
          <span class="contact__deck-meta" id="contact-deck-meta">{deckMeta}</span>
        </p>
      )
    }

    <ul class="cc" aria-label="Контакты">
      <li class="cc__item cc__item--person" data-reveal style="--d:1">
        <a href={CONTACTS.phoneHref} class="cc__card gv gv--sky gv--blobs" data-goal="phone_click">
          <GvBlobs preset="sky" />
          <span class="cc__bars" aria-hidden="true">
            {BARS.map((h) => <i style={`--h:${h}%`} />)}
          </span>
          <span class="cc__label">{personLabel}</span>
          <span class="cc__chips">
            <span class="cc__chip">
              <span class="cc__avatar" aria-hidden="true">ДМ</span>
              {CONTACTS.pilotContact}
            </span>
            <span class="cc__chip cc__chip--big">
              <Icon name="phone" size={22} />
              {CONTACTS.phone}
              {/* по этому номеру можно написать в MAX — ссылки «написать по номеру» у MAX нет, поэтому это подпись */}
              <span class="cc__max">
                <span class="visually-hidden">, номер есть в мессенджере </span>
                {CONTACTS.phoneMessenger}
              </span>
            </span>
          </span>
        </a>
      </li>
      <li class="cc__item cc__item--mail" data-reveal>
        <a href={CONTACTS.emailHref} class="cc__card gv gv--lavender gv--blobs">
          <GvBlobs preset="lavender" />
          <span class="cc__label">Почта</span>
          <span class="cc__chips">
            <span class="cc__chip">
              <Icon name="mail" size={20} />
              {CONTACTS.email}
            </span>
          </span>
        </a>
      </li>
      <li class="cc__item cc__item--tg" data-reveal style="--d:2">
        <a
          href={CONTACTS.telegramHref}
          class="cc__card gv gv--teal gv--blobs"
          target="_blank"
          rel="noopener"
          data-goal="telegram_click"
        >
          <GvBlobs preset="teal" />
          <span class="cc__label">Telegram</span>
          <span class="cc__chips">
            <span class="cc__chip">
              <Icon name="send" size={20} />
              {CONTACTS.telegram}
            </span>
          </span>
          <span class="visually-hidden"> (откроется в новой вкладке)</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  /* Строка у формы: «73 клиента…» */
  .contact__proof {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--panel);
    font-size: 15px;
    font-weight: 560;
    color: var(--ink-2);
  }

  .contact__dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 4px rgb(10 159 106 / 0.16);
  }

  /* Шаги «как начать» над формой (только на страницах продуктов) */
  .contact__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, calc(var(--vw) * 1.2), 16px);
    max-width: 1120px;
    margin: 0 auto clamp(14px, calc(var(--vw) * 1.6), 20px);
    padding: 0;
    list-style: none;
  }

  .contact__step {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 18px 20px 20px;
    border-radius: calc(var(--r) * var(--rk));
    corner-shape: var(--corner);
    background: var(--panel);
  }

  .contact__step-n {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 560;
    color: var(--muted);
  }

  .contact__step.is-last .contact__step-n {
    color: var(--ok);
  }

  .contact__step-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .contact__step-text {
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @media (max-width: 759.98px) {
    .contact__steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Презентация под формой (главная) */
  .contact__deck {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 14px;
    margin-top: 22px;
  }

  .contact__deck .link-arrow {
    position: relative;
  }

  /* ссылка невысокая: область нажатия больше её самой — не меньше 44 px */
  .contact__deck .link-arrow::after {
    content: '';
    position: absolute;
    inset: -12px -6px;
  }

  .contact__deck-meta {
    font-size: 14px;
    color: var(--muted);
    white-space: nowrap;
  }

  /* Горизонтальная форма на белой карточке */
  .contact__form {
    max-width: 1120px;
    margin-inline: auto;
    padding: clamp(20px, calc(var(--vw) * 2.8), 36px);
    border: 1px solid var(--line);
    border-radius: calc(var(--r-lg) * var(--rk));
    corner-shape: var(--corner);
    background: var(--card);
    box-shadow: var(--shadow-card);
  }

  /* ── Ряд градиентных карточек с белыми плашками ───────── */
  .cc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(12px, calc(var(--vw) * 1.6), 24px);
    margin-top: clamp(48px, calc(var(--vw) * 6), 88px);
  }

  .cc__item--mail {
    order: 1;
  }

  .cc__item--person {
    order: 2;
  }

  .cc__item--tg {
    order: 3;
  }

  .cc__card {
    --gv-r: clamp(24px, calc(var(--vw) * 2.6), 36px);
    min-height: clamp(220px, calc(var(--vw) * 21), 280px);
    place-items: end start;
    align-content: space-between;
    row-gap: 16px;
    padding: clamp(16px, calc(var(--vw) * 1.8), 24px);
    color: var(--ink);
    transition: transform 0.45s var(--ease-out);
  }

  .cc__item--person .cc__card {
    min-height: clamp(260px, calc(var(--vw) * 26), 340px);
  }

  .cc__card:hover {
    transform: translateY(-4px);
  }

  /* «звуковая волна» из белых полос, как у Calendly */
  .cc__bars {
    position: absolute;
    inset: 18% 10% 30%;
    z-index: -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .cc__bars i {
    width: 3px;
    height: var(--h, 50%);
    border-radius: 3px;
    background: rgb(255 255 255 / 0.5);
  }

  .cc__label {
    justify-self: start;
    padding: 6px 11px;
    border-radius: calc(9px * var(--rk));
    corner-shape: var(--corner);
    background: rgb(255 255 255 / 0.9);
    font-size: 13.5px;
    font-weight: 560;
    color: var(--ink-2);
  }

  .cc__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .cc__chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: calc(14px * var(--rk));
    corner-shape: var(--corner);
    background: #fff;
    box-shadow: var(--shadow-soft);
    font-size: clamp(16px, calc(var(--vw) * 1.4), 19px);
    font-weight: 600;
    letter-spacing: -0.015em;
    white-space: nowrap;
    transition: transform 0.45s var(--ease-out);
  }

  .cc__chip--big {
    padding: 12px 18px;
    font-size: clamp(20px, calc(var(--vw) * 2.1), 30px);
    letter-spacing: -0.03em;
  }

  /* плашка «MAX» у номера: мягкий лавандовый палитры, без логотипа мессенджера */
  .cc__max {
    align-self: center;
    padding: 6px 11px 5px;
    border-radius: 999px;
    background: var(--g-lav-soft);
    font-size: 14px;
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0.01em;
    color: #4b33c8;
  }

  .cc__card:hover .cc__chip {
    transform: translateY(-2px);
  }

  .cc__avatar {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--blue-soft);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  @media (max-width: 599px) {
    .contact__proof {
      padding: 7px 12px;
      font-size: 14px;
    }
  }

  @media (max-width: 899px) {
    .cc {
      grid-template-columns: minmax(0, 1fr);
    }

    .cc__item--person {
      order: 0;
    }

    .cc__card,
    .cc__item--person .cc__card {
      min-height: 180px;
    }
  }
</style>
