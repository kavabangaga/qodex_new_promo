  /* ── Телефон: один столбец, обычные плитки — значок слева, текст справа ── */
  @media (max-width: 699.98px) {
    .kfit__grid,
    .kfit__row {
      grid-template-columns: minmax(0, 1fr);
    }

    .kfit__tile {
      flex-direction: row;
