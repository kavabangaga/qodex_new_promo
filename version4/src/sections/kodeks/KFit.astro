  /* ссылка прижата к низу плитки */
  .kfit__next-more {
    margin-top: auto;
    padding-top: 22px;
  }

  /* ── Планшет: два столбца, крупная плитка во всю ширину ── */
  @media (max-width: 1199.98px) {
    .kfit__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
