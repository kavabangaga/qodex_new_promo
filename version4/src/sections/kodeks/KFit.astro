      border-radius: 14px;
    }

    /* сцена мельче, но целиком в кадре: весы с будкой — 610 единиц по ширине кадра */
    .kfit__stage {
      --u: min(0.5px, 100cqw / 610);
      --pad: 10px;
      border-radius: 9px;
    }

    .kfit__note {
      gap: 22px;
    }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Машина заезжает на весы, когда рисунок появился на экране; за экраном сцена возвращается
  // в начало. При «уменьшить движение» классы не ставятся — видно итоговое состояние.
  const vis = document.querySelector<HTMLElement>('[data-kfit-vis]');
  if (vis && !reducedMotion() && 'IntersectionObserver' in window) {
    vis.classList.add('is-armed');
    new IntersectionObserver(
      ([entry]) => {
        // начинаем, когда видна заметная часть рисунка, а сбрасываем — только когда он ушёл целиком:
        // на границе экрана сцена не дёргается
        if (entry.intersectionRatio >= 0.45) vis.classList.add('is-live');
        else if (!entry.isIntersecting) vis.classList.remove('is-live');
      },
      { threshold: [0, 0.45] },
    ).observe(vis);
  }
</script>
