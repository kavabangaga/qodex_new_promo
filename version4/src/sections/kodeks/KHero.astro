<script>
  import { reducedMotion } from '../../scripts/motion';

  // Анимация экрана «Взвешивания» идёт, только пока он на экране (в разметке она стоит: data-idle).
  // При «уменьшить движение» анимации выключены в CSS — следить не нужно.
  const mock = document.querySelector<HTMLElement>('[data-kh-mock]');
  if (mock && !reducedMotion()) {
    if (!('IntersectionObserver' in window)) {
      delete mock.dataset.idle;
    } else {
      new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) delete mock.dataset.idle;
          else mock.dataset.idle = '';
        },
        { threshold: 0.35 },
      ).observe(mock);
    }
  }
</script>
