  /* ── Планшет и телефон: панель в один столбец, вкладки меньше ──
     Пять вкладок такого размера помещаются в ряд от 768 px; уже — лента с прокруткой. */
  @media (max-width: 1023.98px) {
    .kfe__tabs {
      gap: 6px;
    }

    .kfe__tab {
      --bw: 2px;
      height: 48px;
      border-radius: calc(15px * var(--rk));
