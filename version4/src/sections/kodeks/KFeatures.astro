</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  const stage = document.querySelector<HTMLElement>('[data-kfe]');
  if (stage) {
    const strip = stage.querySelector<HTMLElement>('[data-kfe-tabs]')!;
    const tabs = [...stage.querySelectorAll<HTMLButtonElement>('[data-kfe-tab]')];
    const panes = [...stage.querySelectorAll<HTMLElement>('[data-kfe-pane]')];
    const visuals = [...stage.querySelectorAll<HTMLElement>('[data-kfe-visual]')];
    let active = 0;

    const show = (i: number) => {
      if (i === active) return;
      active = i;
      tabs.forEach((tab, k) => {
        const on = k === i;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      panes.forEach((pane, k) => {
        const on = k === i;
        pane.classList.toggle('is-active', on);
        pane.setAttribute('aria-hidden', String(!on));
        pane.tabIndex = on ? 0 : -1;
      });
      // в ленте (планшет, телефон) выбранная вкладка встаёт по центру — видны края соседних
      const tab = tabs[i];
      strip.scrollTo({
        left: tab.offsetLeft - (strip.clientWidth - tab.offsetWidth) / 2,
        behavior: reducedMotion() ? 'auto' : 'smooth',
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(i));
      tab.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        const edge = e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -1;
        if (!dir && edge < 0) return;
        e.preventDefault();
        const next = edge >= 0 ? edge : (active + dir + tabs.length) % tabs.length;
        show(next);
        tabs[next].focus({ preventScroll: true });
      });
    });

    // Движение в макете идёт, только пока он на экране. При «уменьшить движение» анимации
    // выключены в CSS — следить не нужно.
    if (reducedMotion() || !('IntersectionObserver' in window)) {
      visuals.forEach((el) => delete el.dataset.idle);
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const el = entry.target as HTMLElement;
            if (entry.isIntersecting) delete el.dataset.idle;
            else el.dataset.idle = '';
          }
        },
        { threshold: 0.3 },
      );
      visuals.forEach((el) => io.observe(el));
    }
  }
</script>
