  /* ── Движение в макетах: один раз при открытии вкладки, только transform и opacity.
     Без анимации (и при «уменьшить движение») виден итог. ── */
  .kfe__pane.is-active .a-in {
    animation: kfe-in 0.6s var(--ease-out) both;
    animation-delay: var(--t, 0s);
  }

  .kfe__pane.is-active .a-pop {
    animation: kfe-pop 0.45s cubic-bezier(0.2, 1.5, 0.4, 1) both;
    animation-delay: var(--t, 0s);
  }

  .kfe__pane.is-active .a-fill {
    animation: kfe-fill var(--dur, 1.2s) var(--ease-in-out) both;
    animation-delay: var(--t, 0s);
  }

  .kfe__pane.is-active .a-type {
    animation: kfe-wipe var(--dur, 0.8s) steps(14, end) both;
    animation-delay: var(--t, 0s);
  }

  .kfe__pane.is-active .a-press {
    animation: kfe-press 0.4s ease both;
    animation-delay: var(--t, 0s);
  }

  @keyframes kfe-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @keyframes kfe-pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes kfe-fill {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes kfe-wipe {
    from {
      transform: scaleX(1);
    }
    to {
      transform: scaleX(0);
    }
  }

  @keyframes kfe-press {
    50% {
      transform: scale(0.97);
    }
  }

  /* за экраном макет стоит на первом кадре: data-idle снимает скрипт, когда макет виден */
  .kfe__visual[data-idle] * {
    animation-play-state: paused !important;
  }

  @media (scripting: none) {
    .kfe__visual[data-idle] * {
      animation-play-state: running !important;
