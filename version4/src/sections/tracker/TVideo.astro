---
// Раздел 2 страницы «QODEX Tracker» [#video] — видео о продукте (3:01), как продуктовое видео у Calendly:
// плеер — скруглённая карточка с мягкой тенью прямо на фоне страницы (градиентную подложку заказчик убрал).
// Сначала только обложка и кнопка воспроизведения: файл видео (21 МБ) не грузится, пока его не включили.
// По нажатию обложка сменяется плеером <video> того же размера (без скачка раскладки), фокус — на нём.
import SectionIntro from '../../components/SectionIntro.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../config/site';

const VIDEO = withBase('/media/tracker/video.mp4');
const POSTER = withBase('/media/tracker/poster-1600.webp');
const POSTER_SM = withBase('/media/tracker/poster-800.webp');
---

<section class="section" id="video" aria-labelledby="video-title">
  <div class="container">
    <SectionIntro eyebrow="Видео" titleId="video-title">
      3&nbsp;минуты, и&nbsp;вы увидите, где теряете до&nbsp;30% прибыли
    </SectionIntro>

    <div class="tvd" data-reveal style="--d:2">
      <div class="tvd__player" data-tvd>
        <button class="tvd__facade" type="button" aria-label="Смотреть видео о QODEX Tracker, 3 минуты" data-tvd-play>
          <picture>
            <!-- sizes — ширина плеера: на компьютере около 1050 px раскладки, уже — почти во всю ширину окна -->
            <source
              type="image/webp"
              srcset={`${POSTER_SM} 800w, ${POSTER} 1600w`}
              sizes="(min-width: 1200px) 1060px, 100vw"
            />
            <img
              class="tvd__poster"
              src={POSTER}
              width="1600"
              height="900"
              alt="Мусоровоз с камерами QODEX Tracker"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <span class="tvd__scrim" aria-hidden="true"></span>
          <!-- плашка в левом нижнем углу: там на обложке пустой асфальт, выноски с камерами и мусоровоз открыты -->
          <span class="tvd__play" aria-hidden="true">
            <span class="tvd__play-ico"><Icon name="play" size={40} strokeWidth={1.5} /></span>
            <span class="tvd__play-text">Смотреть видео</span>
            <span class="tvd__time">3:01</span>
          </span>
        </button>

        <!-- плеер вставляется по нажатию; содержимое <template> браузер не загружает -->
        <template data-tvd-tpl>
          <video
            class="tvd__video"
            src={VIDEO}
            poster={POSTER}
            aria-label="Видео о QODEX Tracker"
            controls
            playsinline
            preload="metadata"
            autoplay
          ></video>
        </template>

        <p class="tvd__error" data-tvd-error hidden>
          <span>Видео не загрузилось.</span>
          <a href={VIDEO}>Открыть файл</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* плеер прямо на фоне страницы, без подложки; ширина — как была внутри прежней рамки */
  .tvd {
    --tvd-r: clamp(16px, calc(var(--vw) * 2.2), 34px);
    --tvd-inset: clamp(10px, calc(var(--vw) * 1.4), 24px);
    --tvd-ico: clamp(30px, calc(var(--vw) * 4), 46px);
    position: relative;
    max-width: 1080px;
    margin-inline: auto;
  }

  /* ── Плеер: 16:9, скруглённая карточка с мягкой тенью ── */
  .tvd__player {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    isolation: isolate;
    border-radius: calc(var(--tvd-r) * var(--rk));
    corner-shape: var(--corner);
    background: #16171a;
    box-shadow:
      0 1px 2px rgb(29 29 31 / 0.06),
      0 28px 60px -30px rgb(29 29 31 / 0.45);
  }

  /* обложка и плеер занимают одну и ту же рамку */
  .tvd__facade,
  .tvd__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    corner-shape: inherit;
  }

  .tvd__facade {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    overflow: hidden;
  }

  .tvd__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tvd__video {
    background: #000;
    object-fit: contain;
  }

  /* видео в фокусе — кольцо вокруг плеера: у самого видео его обрезает скругление рамки,
     а внутри кадра низ кольца закрыла бы панель управления */
  .tvd__video:focus-visible {
    outline: none;
  }

  .tvd__player:has(.tvd__video:focus-visible) {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }

  /* при наведении обложка мягко темнеет */
  .tvd__scrim {
    position: absolute;
    inset: 0;
    background: rgb(29 29 31 / 0.22);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  /* белая плашка «▶ Смотреть видео | 3:01», как кнопка видео на первом экране;
     белое кольцо — как рамка у карточек интерфейса */
  .tvd__play {
    position: absolute;
    left: var(--tvd-inset);
    bottom: var(--tvd-inset);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 5px 20px 5px 5px;
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-size: 16px;
    font-weight: 560;
    line-height: 1;
    white-space: nowrap;
    box-shadow:
      0 0 0 6px rgb(255 255 255 / 0.32),
      0 14px 32px -12px rgb(29 29 31 / 0.55);
    transform-origin: 0 100%;
    transition: transform 0.45s var(--ease-out);
  }

  .tvd__play-ico {
    display: grid;
    place-items: center;
    width: var(--tvd-ico);
    height: var(--tvd-ico);
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
  }

  /* значок Icon — контур; здесь он залит, треугольник чуть сдвинут вправо: так он выглядит по центру */
  .tvd__play-ico :global(svg) {
    width: 40%;
    height: 40%;
    fill: currentColor;
    translate: 7% 0;
  }

  .tvd__time {
    padding-left: 12px;
    border-left: 1px solid var(--line-2);
    color: var(--muted);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .tvd__facade:hover .tvd__scrim,
  .tvd__facade:focus-visible .tvd__scrim {
    opacity: 1;
  }

  .tvd__facade:hover .tvd__play,
  .tvd__facade:focus-visible .tvd__play {
    transform: scale(1.04);
  }

  /* фокус с клавиатуры — кольцо вокруг плашки (рамку плеера обрезает скругление) */
  .tvd__facade:focus-visible {
    outline: none;
  }

  .tvd__facade:focus-visible .tvd__play {
    outline: 3px solid var(--blue);
    outline-offset: 4px;
  }

  /* видео не загрузилось — спокойная строка со ссылкой на файл поверх плеера */
  .tvd__error {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 10px;
    width: max-content;
    max-width: calc(100% - 32px);
    padding: 12px 18px;
    border-radius: calc(14px * var(--rk));
    corner-shape: var(--corner);
    background: #fff;
    box-shadow: var(--shadow-card);
    font-size: 15px;
    line-height: 1.4;
    text-align: center;
    translate: -50% -50%;
  }

  .tvd__error a {
    font-weight: 560;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tvd__facade:hover .tvd__play,
    .tvd__facade:focus-visible .tvd__play {
      transform: none;
    }
  }

  /* ── Телефон: кольцо у плашки меньше, на ней только значок и время —
     с надписью она заходила бы на мусоровоз ── */
  @media (max-width: 639.98px) {
    .tvd {
      --tvd-ico: 28px;
    }

    .tvd__play {
      gap: 7px;
      padding: 3px 11px 3px 3px;
      font-size: 13px;
      box-shadow:
        0 0 0 3px rgb(255 255 255 / 0.32),
        0 12px 26px -12px rgb(29 29 31 / 0.55);
    }

    .tvd__play-text {
      display: none;
    }

    .tvd__time {
      padding-left: 0;
      border-left: 0;
      color: var(--ink);
      font-weight: 600;
    }
  }
</style>

<script>
  // Видео включается по нажатию: обложка сменяется плеером в той же рамке.
  const player = document.querySelector<HTMLElement>('[data-tvd]');
  const facade = player?.querySelector<HTMLButtonElement>('[data-tvd-play]');
  const tpl = player?.querySelector<HTMLTemplateElement>('[data-tvd-tpl]');
  const error = player?.querySelector<HTMLElement>('[data-tvd-error]');

  if (player && facade && tpl) {
    facade.addEventListener('click', () => {
      const video = document.importNode(tpl.content, true).querySelector('video');
      if (!video) return;
      // обложка уже загружена — плеер показывает её же, пока грузится видео
      const poster = facade.querySelector('img')?.currentSrc;
      if (poster) video.poster = poster;
      video.addEventListener(
        'error',
        () => {
          if (!error) return;
          error.hidden = false;
          error.querySelector('a')?.focus();
        },
        { once: true },
      );
      facade.replaceWith(video);
      video.focus({ preventScroll: true });
      // Safari фокусирует видео, только если у него есть tabindex
      if (document.activeElement !== video) {
        video.tabIndex = -1;
        video.focus({ preventScroll: true });
      }
      video.play()?.catch(() => {
        /* браузер не дал включить сам — остаются кнопки плеера */
      });
    });
  }
</script>
