  /* у открытого пункта место под две строки: последний текст длиннее остальных, и без запаса
     всё, что ниже, сдвигалось бы при каждом переключении */
  .tsys__steps :global(.acc__inner > p) {
    min-height: calc(3em + 22px);
  }

  .tsys__note {
    margin-top: 18px;
  }

  .tsys__cta {
    margin-top: 26px;
  }

  .tsys__visual {
    grid-area: visual;
    position: relative;
    min-width: 0;
  }

  /* поля градиентной карточки поменьше: схеме с камерами нужна ширина; сверху — место
     для плашки «демо-данные» */
  .tsys__visual :global(.gv) {
    padding: clamp(14px, calc(var(--vw) * 2.6), 46px);
    padding-top: clamp(54px, calc(var(--vw) * 3.4), 60px);
  }

  /* «демо-данные» в углу градиентной карточки */
  .tsys__demo {
    position: absolute;
    z-index: 1;
    top: clamp(14px, calc(var(--vw) * 1.6), 22px);
