  /* числа, которые сменяют друг друга в одной клетке (не .num: тот в global.css со своим весом и трекингом) */
  .tsys__num {
    display: inline-grid;
  }

  .tsys__num > b {
    grid-area: 1 / 1;
    font-weight: inherit;
    font-variant-numeric: tabular-nums;
  }

  /* ── 1. Камеры: схема мусоровоза ───────────────────────── */
  .sch {
    position: relative;
    aspect-ratio: 460 / 420;
    overflow: hidden;
    border-radius: clamp(10px, 3cqi, 16px);
    background: #e2eaf0;
  }

  .sch__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* поле обзора камеры: пунктир, при снимке — ярче */
  .cone {
    fill: rgb(0 107 255 / 0.06);
    stroke: rgb(0 107 255 / 0.42);
    stroke-width: 1.4;
    stroke-dasharray: 4 4;
    stroke-linejoin: round;
  }

  .cone__hi {
    fill: rgb(0 107 255 / 0.17);
    stroke: var(--u-blue);
    stroke-width: 1.6;
    stroke-linejoin: round;
    opacity: 0;
  }

  /* камера на машине — как на мачте весовой в сценах страниц: светлый корпус, синий объектив */
  .cam-body {
    fill: #f4f6f9;
    stroke: #8d9aa5;
    stroke-width: 1.5;
  }

  .cam-lens {
    fill: var(--u-blue);
  }

  .cdot__ring {
    fill: none;
    stroke: var(--u-blue);
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* кадр камеры */
  .cf {
    position: absolute;
    overflow: hidden;
    border-radius: clamp(6px, 2.2cqi, 10px);
    background: #dbe5eb;
    box-shadow:
      0 0 0 2px #fff,
      0 10px 18px -10px rgb(29 29 31 / 0.5);
    isolation: isolate;
  }

  .cf__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* без анимации видно итоговое состояние: кадры «после» */
  .cf__img--before {
    opacity: 0;
  }

  .cf__tag,
  .cf__chip,
  .fr__tag {
    padding: 1px 5px;
    border-radius: 4px;
    background: rgb(29 29 31 / 0.62);
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.45;
    white-space: nowrap;
  }

  .cf__tag {
    position: absolute;
    z-index: 2;
    left: clamp(3px, 1cqi, 5px);
    top: clamp(3px, 1cqi, 5px);
  }

  .cf__state {
    position: absolute;
    z-index: 2;
    right: clamp(3px, 1cqi, 5px);
    bottom: clamp(3px, 1cqi, 5px);
    display: grid;
  }

  .cf__chip {
    grid-area: 1 / 1;
    justify-self: end;
    padding-inline: 6px;
    border-radius: 999px;
    font-weight: 600;
  }

  .cf__chip--do {
    opacity: 0;
  }

  .cf__chip--after {
    background: var(--u-ok);
  }

  /* камера сзади пишет видео погрузки между снимками «до» и «после» */
  .cf__rec {
    position: absolute;
    z-index: 2;
    top: clamp(4px, 1.2cqi, 6px);
    right: clamp(4px, 1.2cqi, 6px);
    display: grid;
    place-items: center;
    width: clamp(11px, 2.8cqi, 14px);
    height: clamp(11px, 2.8cqi, 14px);
    border-radius: 50%;
    background: #fff;
    opacity: 0;
  }

  .cf__rec i {
    width: 58%;
    height: 58%;
    border-radius: 50%;
    background: var(--u-bad-bg);
  }

  /* вспышка: снимок сделан */
  .cf__flash {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }

  .tf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 12px;
    font-size: 13px;
    font-weight: 560;
  }

  .tf__place {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  /* ── 2. ИИ: крупный кадр ───────────────────────────────── */
  .fr {
    position: relative;
    aspect-ratio: 320 / 190;
    overflow: hidden;
    border-radius: 12px;
    background: #dde7ed;
    isolation: isolate;
  }

  /* снимок крупнее окна: виден его участок с контейнерами (размер и сдвиг — в разметке) */
  .fr__img {
    position: absolute;
    max-width: none;
    object-fit: cover;
  }

  /* левая треть кадра свободна от рамок: сверху счётчик, внизу подпись камеры */
  .fr__tag {
    position: absolute;
    z-index: 3;
    left: 8px;
    bottom: 8px;
  }

  /* проход ИИ по кадру: линия с мягким следом */
  .scan {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  .scan i {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: #4f9bff;
  }

  .scan b {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 100%;
    width: 16%;
    background: rgb(79 155 255 / 0.16);
  }

  /* рамки распознавания вокруг контейнеров (место и размер — в разметке). Линия — внутренней тенью:
     border и outline WebKit при дробном масштабе экрана (Windows 145 %) у этих рамок не рисует */
  .det {
    position: absolute;
    z-index: 2;
    border-radius: 8px;
    background: rgb(79 155 255 / 0.12);
    box-shadow: inset 0 0 0 2px #4f9bff;
  }

  .det i {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 6px 0 6px 0;
