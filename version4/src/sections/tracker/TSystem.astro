  .stop--ok {
    background: var(--u-ok-bg);
  }

  /* площадки впереди по плану */
  .stop--plan {
    background: #b8d4ff;
  }

  /* съезд с маршрута: красный пунктир (проявляется вслед за машиной) */
  .dev {
    position: absolute;
    overflow: hidden;
  }

  /* штрихи — полосами с жёсткими краями, а не dashed-рамкой: Safari при дробном масштабе экрана
     (Windows 145 %) тонкую dashed-рамку не рисует */
  .dev i {
    position: absolute;
    inset: 0;
  }

  .dev--v {
    width: 3px;
    margin-left: -1.5px;
  }

  .dev--v i {
    background: repeating-linear-gradient(180deg, var(--u-bad-bg) 0 6px, transparent 6px 10px);
  }

  .dev--h {
    height: 3px;
    margin-top: -1.5px;
  }

  .dev--h i {
    background: repeating-linear-gradient(90deg, var(--u-bad-bg) 0 6px, transparent 6px 10px);
  }

  /* метка машины едет вся вместе со слоем размером с карту: сдвиг в % — от размеров карты */
  .mover {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .pin {
    position: absolute;
    width: 0;
    height: 0;
  }

  .pin__blue,
  .pin__red,
  .pin__pulse {
    position: absolute;
    display: grid;
    place-items: center;
    color: #fff;
  }

  .pin__blue {
    left: -13px;
    top: -13px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--u-blue);
    box-shadow: 0 0 0 4px rgb(0 107 255 / 0.2);
  }

  .pin__red,
  .pin__pulse {
    left: -16px;
    top: -16px;
    width: 32px;
    height: 32px;
    border-radius: 10px;
  }

  .pin__red {
    background: var(--u-bad-bg);
    box-shadow:
      0 0 0 3px #fff,
      0 6px 14px -4px rgb(184 40 58 / 0.55);
  }

  .pin__pulse {
    background: rgb(229 72 77 / 0.35);
    opacity: 0;
  }

  /* Уведомление (как в самом сервисе) стоит справа от метки, сразу под линией маршрута, хвостиком
     к метке. Высота карты — 57.53cqi (ширина карточки минус поля 4.8cqi с каждой стороны, × 280/440),
     поэтому хвостик ставится в cqi: (53.57% − 23%) высоты карты = 17.6cqi от верха уведомления. */
  .alert-pos {
    position: absolute;
    z-index: 3;
    top: 23%;
    left: 43%;
    right: 2.5%;
  }

  /* колонка не шире карточки: длинное слово заголовка не раздвигает её (перенос — мягким дефисом в разметке) */
  .alert {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(7px, 2cqi, 9px);
    width: 100%;
    padding: clamp(9px, 2.6cqi, 12px);
    border-radius: 16px;
    box-shadow:
      0 0 0 1px rgb(229 72 77 / 0.28),
      0 18px 40px -16px rgb(29 29 31 / 0.5);
    transform-origin: 0 50%;
  }

  .alert::before {
    content: '';
    position: absolute;
    top: calc(17.6cqi - 6.5px);
    left: -6px;
    width: 13px;
    height: 13px;
    border-radius: 2px;
    background: #fff;
    box-shadow: -1px 1px 0 rgb(229 72 77 / 0.28);
    transform: rotate(45deg);
  }

  .alert__title {
    padding: clamp(6px, 1.8cqi, 8px) clamp(8px, 2.2cqi, 10px);
    border-radius: 10px;
    background: var(--u-bad-soft);
    color: var(--u-bad);
    font-size: clamp(12.5px, 3.2cqi, 14.5px);
    font-weight: 600;
    line-height: 1.25;
  }

  .alert__coords {
    display: grid;
    gap: 1px;
    padding-inline: 2px;
  }

  .alert__coords small {
    font-size: clamp(11px, 2.9cqi, 12.5px);
    color: var(--muted);
  }

  .alert__coords span {
    font-size: clamp(13px, 3.4cqi, 15px);
    font-weight: 560;
    font-variant-numeric: tabular-nums;
  }

  .alert__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: clamp(30px, 8.4cqi, 36px);
    border-radius: 999px;
    background: #d6293b;
    color: #fff;
    font-size: clamp(12.5px, 3.3cqi, 14px);
    font-weight: 600;
  }

  .alert__btn > span {
    display: grid;
    transform-origin: 50% 10%;
  }

  /* ── 4. Облако ─────────────────────────────────────────── */
  .cl {
    display: grid;
    justify-items: center;
  }

  .cl-truck {
    width: min(100%, 300px);
    padding: clamp(10px, 3cqi, 14px) clamp(12px, 3.6cqi, 16px) clamp(8px, 2.4cqi, 12px);
    border-radius: 18px;
  }

  .th--sm {
    margin-bottom: 6px;
  }

  /* улица с машиной — окно со скруглёнными углами, как кадр сцены на странице TONN */
  .cl-stage {
    overflow: hidden;
    border-radius: clamp(9px, 2.6cqi, 12px);
    background: #e2eaf0;
    isolation: isolate;
  }

  .cl-truck__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .cl-wheel {
    transform-box: fill-box;
    transform-origin: center;
  }

  .sig {
    fill: none;
    stroke: var(--u-blue);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.6;
  }

  /* связь машины с облаком: пунктир (полосами, как у съезда на карте), по нему бегут «пакеты» */
  .cl-link {
    position: relative;
    display: block;
    width: 2px;
    height: clamp(24px, 7.4cqi, 36px);
    background: repeating-linear-gradient(180deg, rgb(0 107 255 / 0.55) 0 5px, transparent 5px 9px);
  }

  .pkt {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .pkt i {
    position: absolute;
    top: 0;
    left: 50%;
    margin-left: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--u-blue);
    box-shadow: 0 0 0 3px rgb(0 107 255 / 0.18);
  }

  .cl-card {
    width: 100%;
    padding: clamp(13px, 4.4cqi, 22px);
    border-radius: clamp(18px, 5cqi, 24px);
  }

  .cl__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .cl__ico {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 10px;
    background: var(--u-blue-soft);
    color: var(--u-blue);
  }

  .cl__txt {
    font-size: clamp(14px, 3.7cqi, 16px);
    font-weight: 560;
    line-height: 1.25;
  }

  .ups {
    display: grid;
    gap: 6px;
  }

  .up {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 8px 10px 9px;
    border-radius: 12px;
    background: var(--u-row);
  }

  /* превью — кадр из видео: крупнее значка, чтобы контейнер было видно; строка от этого не выше */
  .up__thumb {
    width: clamp(48px, 14cqi, 64px);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    background: #dbe5eb;
  }

  .up__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .up__main {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .up__main b {
    overflow: hidden;
    font-size: clamp(13px, 3.4cqi, 14px);
    font-weight: 560;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .up__main small {
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .up__state {
    display: grid;
    width: 26px;
    height: 26px;
  }

  .up__spin,
  .up__done {
    display: grid;
    place-items: center;
    grid-area: 1 / 1;
  }

  .up__spin {
    color: var(--u-blue);
  }

  .up__spin > span {
    display: grid;
  }

  .up__done {
    border-radius: 50%;
    background: var(--u-ok-soft);
    color: var(--u-ok);
  }

  /* полоса загрузки видео: видна, пока файл догружается */
  .up__bar {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 3px;
    height: 3px;
    overflow: hidden;
    border-radius: 999px;
    background: #e1e6ec;
    opacity: 0;
  }

  .up__bar i {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--u-blue);
    transform-origin: left center;
  }

  /* ── Анимации: только у активной панели ──
     Без анимации видно итоговое состояние: «ожидание» и промежуточные числа скрыты. */
  .a-gone,
  .a-blip,
  .up__spin {
    opacity: 0;
  }

  .tsp.is-active .a-in {
    animation: ts-in 0.6s var(--ease-out) both;
    animation-delay: var(--t, 0s);
  }

  .tsp.is-active .a-pop {
    animation: ts-pop 0.45s cubic-bezier(0.2, 1.5, 0.4, 1) both;
    animation-delay: var(--t, 0s);
  }

  .tsp.is-active .a-gone {
    animation: ts-gone 0.25s ease both;
    animation-delay: var(--t, 0s);
  }

  .tsp.is-active .a-blip {
    animation: ts-blip var(--dur, 0.4s) linear forwards;
    animation-delay: var(--t, 0s);
  }

  .tsp.is-active .a-fill {
    animation: ts-fill var(--dur, 1.2s) var(--ease-in-out) both;
    animation-delay: var(--t, 0s);
  }

  .tsp.is-active .a-ring {
    animation: ts-ring 1s ease-in-out both;
    animation-delay: var(--t, 0s);
  }

  .tsp.is-active .a-blink {
    animation: ts-blink 1.4s ease-in-out infinite;
  }

  .tsp.is-active .a-spin {
    animation: ts-spin 0.9s linear infinite;
  }

  /* 1. Камеры по очереди: поле обзора ярче, вспышка, «до»; после погрузки — так же, «после».
     Круг 8 с, у каждой камеры сдвиг 0,3 с: камера 4 снимает «после» на 4,4 с, и итог виден
     ещё 2 с до смены пункта (FeatureAccordion — 6,5 с). */
  .tsp.is-active .cone__hi {
    animation: ts-cone 8s linear infinite both;
    animation-delay: calc(var(--k) * 0.3s);
  }

  .tsp.is-active .cdot__ring {
    animation: ts-shot-ring 8s linear infinite both;
    animation-delay: calc(var(--k) * 0.3s);
  }

  .tsp.is-active .cf__flash {
    animation: ts-flash 8s linear infinite both;
    animation-delay: calc(var(--k) * 0.3s);
  }

  .tsp.is-active .cf__img--before {
    animation: ts-before 8s linear infinite both;
    animation-delay: calc(var(--k) * 0.3s);
  }

  .tsp.is-active .cf__chip--do {
    animation: ts-do 8s linear infinite both;
    animation-delay: calc(var(--k) * 0.3s);
  }

  .tsp.is-active .cf__chip--after {
    animation: ts-after 8s linear infinite both;
    animation-delay: calc(var(--k) * 0.3s);
  }

  .tsp.is-active .cf__rec {
    animation: ts-rec 8s linear infinite both;
    animation-delay: calc(var(--k) * 0.3s);
  }

  .tsp.is-active .cf__rec i {
    animation: ts-blink 1.1s ease-in-out infinite;
  }

  /* 2. ИИ проходит по кадру */
  .tsp.is-active .scan {
    animation: ts-scan 1.3s linear 0.15s both;
  }

  /* 3. Машина едет по маршруту и сворачивает в СНТ, за ней — красный пунктир; затем оповещение.
     Пунктир проявляется вместе с машиной: те же доли пути и времени, что в ts-drive. */
  .tsp.is-active .mover {
    animation: ts-drive 1.5s 0.15s both;
  }

  .tsp.is-active .dev--v i {
    animation: ts-dev-v 0.86s linear 0.46s both;
  }

  .tsp.is-active .dev--h i {
    animation: ts-dev-h 0.33s ease-out 1.32s both;
  }

  .tsp.is-active .pin__pulse {
    animation: ts-pulse 1.8s ease-out 1.9s infinite;
  }

  .tsp.is-active .alert {
    animation: ts-note 0.55s cubic-bezier(0.2, 1.3, 0.4, 1) 1.9s both;
  }

  /* 4. Машина въезжает слева (колёса катятся), модуль связи передаёт, по пунктиру бегут пакеты,
     видео догружаются */
  .tsp.is-active .cl-drive {
    animation: ts-drive-in 1.7s cubic-bezier(0.3, 0.55, 0.25, 1) 0.1s both;
  }

  .tsp.is-active .cl-wheel {
    animation: ts-roll-in 1.7s cubic-bezier(0.3, 0.55, 0.25, 1) 0.1s both;
  }

  .tsp.is-active .sig {
    animation: ts-sig 1.8s ease-in-out infinite;
    animation-delay: calc(var(--s) * 0.22s);
  }

  .tsp.is-active .pkt {
    animation: ts-pkt 1.5s linear infinite;
    animation-delay: calc(var(--p) * 0.5s);
  }

  .tsp.is-active .up__bar {
    animation: ts-bar var(--t1) linear both;
  }

  @keyframes ts-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes ts-pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  /* «ожидание» видно до своей задержки, потом исчезает */
  @keyframes ts-gone {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  /* промежуточное значение видно только во время своей анимации */
  @keyframes ts-blip {
    0%,
    99.9% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes ts-fill {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes ts-ring {
    0%,
    100% {
      transform: rotate(0deg);
    }
    15% {
      transform: rotate(-18deg);
    }
    30% {
      transform: rotate(15deg);
    }
    45% {
      transform: rotate(-10deg);
    }
    60% {
      transform: rotate(6deg);
    }
    75% {
      transform: rotate(-2deg);
    }
  }

  @keyframes ts-blink {
    50% {
      opacity: 0.25;
    }
  }

  @keyframes ts-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* снимки на 6 % («до», 0,5 с) и 44 % («после», 3,5 с) круга камеры */
  @keyframes ts-cone {
    0%,
    4% {
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    14%,
    42% {
      opacity: 0;
    }
    44% {
      opacity: 1;
    }
    52%,
    100% {
      opacity: 0;
    }
  }

  @keyframes ts-shot-ring {
    0%,
    5.9% {
      opacity: 0;
      transform: scale(1);
    }
    6% {
      opacity: 0.8;
      transform: scale(1);
    }
    14% {
      opacity: 0;
      transform: scale(2.8);
    }
    43.9% {
      opacity: 0;
      transform: scale(1);
    }
    44% {
      opacity: 0.8;
      transform: scale(1);
    }
    52% {
      opacity: 0;
      transform: scale(2.8);
    }
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  @keyframes ts-flash {
    0%,
    5.9% {
      opacity: 0;
    }
    6% {
      opacity: 0.85;
      animation-timing-function: ease-out;
    }
    11%,
    43.9% {
      opacity: 0;
    }
    44% {
      opacity: 0.85;
      animation-timing-function: ease-out;
    }
    49%,
    100% {
      opacity: 0;
    }
  }

  /* кадр «до» сменяется кадром «после» во вспышке, к концу круга возвращается */
  @keyframes ts-before {
    0%,
    43.9% {
      opacity: 1;
    }
    44%,
    93% {
      opacity: 0;
    }
    97%,
    100% {
      opacity: 1;
    }
  }

  @keyframes ts-do {
    0%,
    6% {
      opacity: 0;
      transform: scale(0.6);
      animation-timing-function: cubic-bezier(0.2, 1.5, 0.4, 1);
    }
    8.5%,
    43.9% {
      opacity: 1;
      transform: none;
    }
    44%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes ts-after {
    0%,
    44% {
      opacity: 0;
      transform: scale(0.6);
      animation-timing-function: cubic-bezier(0.2, 1.5, 0.4, 1);
    }
    46.5%,
    92% {
      opacity: 1;
      transform: none;
    }
    96%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes ts-scan {
    0% {
      opacity: 1;
      transform: translateX(-16%);
    }
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(100%);
    }
  }

  /* (84, 50) по маршруту → поворот (120, 50) → вниз по проезду (120, 150) → к площадке (158, 150);
     сдвиг — в долях карты, доли времени — по длине отрезков */
  @keyframes ts-drive {
    0% {
      transform: translate(-16.818%, -35.714%);
      animation-timing-function: ease-in;
    }
    20.7% {
      transform: translate(-8.636%, -35.714%);
      animation-timing-function: linear;
    }
    78.2% {
      transform: translate(-8.636%, 0);
      animation-timing-function: ease-out;
    }
    100% {
      transform: none;
    }
  }

  @keyframes ts-dev-v {
    from {
      transform: translateY(-100%);
    }
  }

  @keyframes ts-dev-h {
    from {
      transform: translateX(-100%);
    }
  }

  /* у камеры сзади: запись от снимка «до» до снимка «после» */
  @keyframes ts-rec {
    0%,
    8% {
      opacity: 0;
    }
    9%,
    42% {
      opacity: 1;
    }
    43%,
    100% {
      opacity: 0;
    }
  }

  @keyframes ts-pulse {
    from {
      opacity: 0.7;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(2.1);
    }
  }

  @keyframes ts-note {
    from {
      opacity: 0;
      transform: translateX(-10px) scale(0.92);
    }
  }

  /* старт — за левым краем кадра: 440 единиц рисунка */
  @keyframes ts-drive-in {
    from {
      transform: translateX(-440px);
    }
  }

  /* 440 / (2π · 22) ≈ 3,18 оборота — колёса катятся, а не скользят */
  @keyframes ts-roll-in {
    from {
      transform: rotate(-1146deg);
    }
  }

  @keyframes ts-sig {
    0%,
    100% {
      opacity: 0.18;
    }
    35% {
      opacity: 1;
    }
  }

  @keyframes ts-pkt {
    0% {
      opacity: 0;
      transform: translateY(-10%);
    }
    15%,
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(100%);
    }
  }

  @keyframes ts-bar {
    0%,
    96% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* за экраном и в скрытой вкладке анимации стоят: data-idle снимает скрипт ниже */
  .ts[data-idle] * {
    animation-play-state: paused !important;
  }

  @media (scripting: none) {
    .ts[data-idle] * {
      animation-play-state: running !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ts * {
      animation: none !important;
    }
  }

  /* ── Картинка уже 450 px: «Погружено меньше плана» рядом с адресом не помещается — плашки статуса
     во всех строках стоят под текстом ── */
  @container (max-width: 450px) {
    .tr {
      flex-wrap: wrap;
      gap: 4px 8px;
    }

    .tr__main {
      flex-basis: calc(100% - 20px);
    }

    /* под текстом, а не под точкой: точка 10 px + зазор 8 px */
    .tr > .tp {
      margin-left: 18px;
    }
  }

  /* ── Узкая картинка (телефон): поменьше подписи и отступы ── */
  @container (max-width: 360px) {
    .th__sub {
      display: none;
    }

    /* в кадре только номер камеры: сторону показывает схема */
    .cf__side {
      display: none;
    }

    .fr__tag {
      left: 6px;
      bottom: 6px;
    }

    .fr__count {
      left: 6px;
      top: 6px;
      gap: 5px;
      padding: 4px 9px 4px 7px;
      font-size: 12.5px;
    }

    .det i {
      width: 18px;
      height: 18px;
      font-size: 11px;
    }

    .tr {
      padding: 8px 9px 8px 10px;
    }

    .tp {
      height: 22px;
      padding: 0 8px;
      font-size: 11.5px;
    }

    .alert-pos {
      top: 24%;
      right: 2%;
    }

    .alert {
      gap: 6px;
      border-radius: 14px;
    }

    .alert::before {
      top: calc(17cqi - 6.5px);
    }

    /* подпись СНТ ушла бы под уведомление — место названо в строке под картой */
    .mp__label {
      display: none;
    }
  }

  /* ── Планшет и телефон: столбиком — метка, заголовок, текст, картинка, пункты, сноска, кнопка.
     Обёртка текста «растворяется» (display: contents), чтобы картинка встала между текстом
     и пунктами: нажал пункт — картинка над ним сразу меняется. */
  @media (max-width: 900px) {
    .tsys__row {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    .tsys__text {
      display: contents;
    }

    .tsys__lead {
      max-width: 60ch;
    }

    .tsys__visual {
      order: 1;
      margin-top: 26px;
    }

    .tsys__steps {
      order: 2;
      margin-top: 26px;
    }

    .tsys__note {
      order: 3;
    }

    .tsys__cta {
      order: 4;
    }

    /* карточка интерфейса стоит ниже плашки «демо-данные» */
    .tsys__visual :global(.gv) {
      padding-block: 54px;
    }
  }

  @media (max-width: 620px) {
    .tsys__visual :global(.gv) {
      padding-block: 50px 20px;
    }
  }

  @media (max-width: 560px) {
    .tsys__cta .btn {
      width: 100%;
    }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Анимации иллюстрации идут, только пока она на экране и вкладка открыта (в разметке они стоят:
  // data-idle). При «уменьшить движение» анимации выключены в CSS — следить не нужно.
  document.querySelectorAll<HTMLElement>('[data-ts]').forEach((el) => {
    if (reducedMotion()) return;
    let inView = !('IntersectionObserver' in window);
    const sync = () => {
      if (inView && !document.hidden) delete el.dataset.idle;
      else el.dataset.idle = '';
    };
    if (!inView) {
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          sync();
        },
        { threshold: 0.2 },
      ).observe(el);
    }
    document.addEventListener('visibilitychange', sync);
    sync();
  });
</script>
