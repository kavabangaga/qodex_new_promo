---
// Раздел «О системе» страницы «QODEX Tracker» [#o-sisteme]. Продуктовый ряд, как на главной
// (ProductHow + Shot) и в «Импорте из Excel» «Кодекса ТКО»: слева метка, заголовок, текст, четыре пункта
// с полосой прогресса, сноска и кнопка; справа большая градиентная карточка — у каждого пункта своя
// иллюстрация: мусоровоз сверху с четырьмя камерами → ИИ считает контейнеры → оповещение о погрузке
// вне маршрута → видео погрузок уходят в облако.
// В кадрах камер — настоящие снимки с прежнего лендинга (людей нет, служебные надписи размыты), данные
// вокруг них — демо. Карта нарисована; мусоровоз — общий рисунок сайта (components/art/truck.ts, эталон —
// «Как это работает» на странице QODEX TONN): сверху — на схеме камер, сбоку на улице — в «Облаке».
// Тексты — с лендинга tracker.qodex.tech дословно. Картинку описывают пункты рядом, поэтому для
// скринридера она скрыта (aria-hidden ставит GradientVisual).
import GradientVisual from '../../components/GradientVisual.astro';
import FeatureAccordion, { type AccItem } from '../../components/FeatureAccordion.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../config/site';
import { TRUCK, TRUCK_WHEELS, TRUCK_WHEEL, TRUCK_WHEEL_Y, TRUCK_TOP } from '../../components/art/truck';

const NB = String.fromCharCode(160);

// Пункты: короткое название + текст с лендинга
const items: AccItem[] = [
  { icon: 'cctv', title: 'Камеры', text: 'Камеры автоматически фиксируют погрузки' },
  { icon: 'ai-scan', title: 'ИИ', text: 'ИИ сам считает контейнеры и сверяет с маршрутом' },
  { icon: 'bell-ring', title: 'Оповещения', text: 'Моментальное оповещение о подозрительных случаях' },
  { icon: 'cloud-upload', title: 'Облако', text: 'Всё работает через облако — дорогую технику ставить не нужно' },
];

// ── Демо-данные (общие для страницы и главной: Мусоровоз 07, Маршрут 14, ул. Садовая, 21 — 08:42) ──
// Кадр, адрес и время погрузки — как в списке на первом экране (THero): Садовая, 21 — 08:42,
// Лесная, 3 — 08:31 (площадка с полными контейнерами, «Погружено меньше плана»), Школьная, 8 — 08:24.
const SADOVAYA = `ул.${NB}Садовая,${NB}21`;
const LESNAYA = `ул.${NB}Лесная,${NB}3`;
const SHKOLNAYA = `ул.${NB}Школьная,${NB}8`;
const SNT = `СНТ${NB}«Рассвет»`;

// настоящие кадры камер лежат в public/media/tracker/
const media = (file: string) => withBase(`/media/tracker/${file}`);

// ── Схема 460×420: улица сверху, мусоровоз, четыре камеры, их поля обзора и кадры ──
const SW = 460;
const SH = 420;
const FW = 150;
const FH = 94;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

// Мусоровоз сверху — общий рисунок (TRUCK_TOP) в масштабе 0,45: ось — x 230 (середина дороги), перед — y 128,
// задний борт — y 292. Камеры стоят на нём (координаты рисунка × 0,45): спереди над стеклом (0, 12) → (230, 133),
// по бортам кузова (±62, 182) → (202 и 258, 210) — на высоте середины боковых кадров, сзади над подъёмником
// (0, 356) → (230, 288). Поле обзора — от камеры к краю кадра; на машине его закрывает рисунок
const TOP = { x: 230, y: 128, s: 0.45 };

// Улица сверху в гамме сцен сайта: земля, тротуары, бордюры, дорога с прерывистой осевой; по углам —
// дома (двускатная крыша: светлый и тёмный скаты) и кроны деревьев. Большую часть закрывают кадры камер
const roof = (x: number, y: number, w: number, h: number, ridge: 'x' | 'y') =>
  ridge === 'x'
    ? `<rect x="${x}" y="${y}" width="${w}" height="${h / 2}" fill="#d8e0e7"/><rect x="${x}" y="${y + h / 2}" width="${w}" height="${h / 2}" fill="#cdd7de"/>`
    : `<rect x="${x}" y="${y}" width="${w / 2}" height="${h}" fill="#d8e0e7"/><rect x="${x + w / 2}" y="${y}" width="${w / 2}" height="${h}" fill="#cdd7de"/>`;
// крона — два круга рядом, как деревья вдали в сценах страниц
const tree = (cx: number, cy: number, r: number) =>
  `<circle cx="${cx}" cy="${cy}" r="${r}" fill="#d2dce3"/>` +
  `<circle cx="${cx + r * 1.15}" cy="${cy + r * 0.4}" r="${(r * 0.65).toFixed(1)}" fill="#d6e0e6"/>`;

const STREET =
  `<rect width="460" height="420" fill="#e2eaf0"/>` +
  roof(24, 30, 100, 72, 'x') +
  tree(106, 134, 12) +
  tree(344, 58, 22) +
  tree(388, 112, 13) +
  tree(52, 318, 20) +
  tree(94, 372, 12) +
  roof(336, 298, 96, 78, 'y') +
  `<rect x="156" width="148" height="420" fill="#d1d9df"/>` +
  `<rect x="172" width="116" height="420" fill="#aab5be"/>` +
  `<rect x="176" width="108" height="420" fill="#c3ccd4"/>` +
  `<path d="M230 0V420" stroke="#fff" stroke-opacity=".5" stroke-width="2.5" stroke-dasharray="16 14"/>`;

// Кадры камер: спереди — улица по ходу машины, слева и справа — обочины (справа контейнер у забора),
// сзади — камера над подъёмником. Задняя снимает контейнер до и после погрузки: кадр «до» лежит сверху
// и гаснет во вспышке. У остальных кадр один — меняются только вспышка и плашка «до/после».
// Кадры маленькие (до 150 px), поэтому хватает файлов шириной около 320 px. pos — какая часть широкого кадра видна.
interface Cam {
  n: number;
  side: string;
  x: number;
  y: number;
  dot: [number, number];
  cone: string;
  img: string;
  w: number;
  h: number;
  pos?: string;
  before?: string;
}

const CAMS: Cam[] = [
  {
    n: 1,
    side: 'спереди',
    x: 155,
    y: 8,
    dot: [230, 133],
    cone: 'M230 133 162 102H298Z',
    img: 'cam-front.webp',
    w: 418,
    h: 176,
    pos: '28% 50%',
  },
  {
    n: 2,
    side: 'слева',
    x: 10,
    y: 163,
    dot: [202, 210],
    cone: 'M202 210 160 170V250Z',
    img: 'cam-left.webp',
    w: 316,
    h: 177,
  },
  {
    n: 3,
    side: 'справа',
    x: 300,
    y: 163,
    dot: [258, 210],
    cone: 'M258 210 300 170V250Z',
    img: 'cam-right.webp',
    w: 313,
    h: 177,
  },
  {
    n: 4,
    side: 'сзади',
    x: 155,
    y: 318,
    dot: [230, 288],
    cone: 'M230 288 162 318H298Z',
    img: 'thumb-cam-a-after.webp',
    w: 320,
    h: 180,
    before: 'thumb-cam-a-before.webp',
  },
];

// ── ИИ: крупный кадр боковой камеры — площадка с полными контейнерами, ул. Лесная, 3 в 08:31 (снимок 1200×675) ──
// В окне 320×190 виден участок снимка: VIEW — левый край, верх и высота участка в % снимка, ширина —
// по пропорциям окна. Три ближних контейнера в окне целиком, от дальнего, четвёртого, у верхнего края
// остаётся полоска — его ИИ не считает (план 4, факт 3). Размытая служебная надпись внизу слева — за нижним краем.
const SHOT = { file: 'cam-b-before-1200.webp', w: 1200, h: 675 };
const VIEW = { x: 31.5, y: 38, h: 54.5 };
const VIEW_W = (VIEW.h * (SHOT.h / SHOT.w) * 320) / 190;
const fx = (v: number) => `${v.toFixed(3)}%`;
const SHOT_STYLE =
  `width:${fx(10000 / VIEW_W)}; height:${fx(10000 / VIEW.h)}; ` +
  `left:${fx((-VIEW.x * 100) / VIEW_W)}; top:${fx((-VIEW.y * 100) / VIEW.h)}`;

// рамки распознавания от ближнего контейнера к дальнему: x1, y1, x2, y2 в % снимка (замерены по кадру);
// ближний уходит за нижний край окна — рамка кончается у края, отступив на 0,6 %, и её линия видна целиком
const DETS = [
  [48, 65.5, 75, 100],
  [60, 50, 79, 70],
  [66.5, 40.8, 81, 53],
].map(([x1, y1, x2, y2]) => {
  const top = Math.max(y1, VIEW.y + 0.6);
  const bottom = Math.min(y2, VIEW.y + VIEW.h - 0.6);
  return (
    `left:${fx(((x1 - VIEW.x) / VIEW_W) * 100)}; top:${fx(((top - VIEW.y) / VIEW.h) * 100)}; ` +
    `width:${fx(((x2 - x1) / VIEW_W) * 100)}; height:${fx(((bottom - top) / VIEW.h) * 100)}`
  );
});

// ── Оповещение: карта 440×280 — маршрут идёт по верхней улице, машина сворачивает в СНТ ──
const MW = 440;
const MH = 280;
const TURN = { x: 120, y: 50 };
const PIN = { x: 158, y: 150 };

// участки СНТ: слева от уведомления — вокруг проезда, метки и подписи; справа — у нижнего края
const PLOTS = [
  ...[72, 96, 120].flatMap((y) => [68, 94].map((x) => [x, y])),
  ...[72, 96].flatMap((y) => [128, 154].map((x) => [x, y])),
  ...[68, 94, 128].map((x) => [x, 172]),
  ...[68, 94, 128, 154].map((x) => [x, 194]),
  ...[190, 216, 242, 268, 294].map((x) => [x, 240]),
]
  .map(([x, y]) => `M${x} ${y}h22v16h-22Z`)
  .join('');

// ── Облако: мусоровоз сбоку на улице — общий рисунок (TRUCK + колёса) в его же координатах. Кадр
//    x −58…422, y −30…186 — пропорции прежнего рисунка (0,45), чтобы картинка не выросла («Облако» на телефоне —
//    самая высокая панель): за машиной забор, она стоит на дороге (колёса — на y 172), по низу кадра — бордюр;
//    вдали — ангар и тело полигона, как в сценах страниц. Машина въезжает слева, колёса крутятся ──
const CL_VIEW = '-58 -30 480 216';
const CL_POSTS = Array.from({ length: 11 }, (_, i) => `M${-54 + i * 46} 38v50`).join('');
const CL_STREET =
  `<rect x="-58" y="-30" width="480" height="216" fill="#e2eaf0"/>` +
  `<path d="M226 36C262 18 320 8 380 8C396 8 414 10 424 12V36Z" fill="#d6dfe6"/>` +
  `<rect x="-66" y="6" width="80" height="30" fill="#d2dce3"/><path d="M-72 8Q-26-14 20 8Z" fill="#c8d3db"/>` +
  `<circle cx="196" cy="24" r="16" fill="#d2dce3"/>` +
  `<rect x="-58" y="36" width="480" height="52" fill="#ccd6dd"/><path d="M-58 47H422${CL_POSTS}" stroke="#bac5cd" stroke-width="2"/>` +
  `<rect x="-58" y="88" width="480" height="92" fill="#c3ccd4"/>` +
  `<path d="M-58 132H422" stroke="#fff" stroke-opacity=".45" stroke-width="3" stroke-dasharray="28 24"/>` +
  `<rect x="-58" y="180" width="480" height="6" fill="#aab5be"/>`;

// модуль связи на крыше кабины и антенна (кончик — 300, 2)
const CL_MODULE =
  `<rect x="280" y="16" width="26" height="11" rx="3" fill="#57636e"/>` +
  `<path d="M300 16V3" stroke="#57636e" stroke-width="3" stroke-linecap="round"/>`;

// четыре камеры, как в «Алгоритме работы»: над подъёмником (на углу заднего борта), на кузове, на кабине,
// над стеклом
const CL_CAMS = [
  [33, 5],
  [150, 0],
  [268, 26],
  [334, 38],
];

// дуги сигнала над антенной модуля связи (кончик антенны — 300, 2)
const SIG = [10, 18, 26].map((r) => {
  const d = r * Math.SQRT1_2;
  return `M${(300 - d).toFixed(2)} ${(2 - d).toFixed(2)}A${r} ${r} 0 0 1 ${(300 + d).toFixed(2)} ${(2 - d).toFixed(2)}`;
});

// видео погрузок за смену: первое уже в облаке, два догружаются. Погрузки, время и превью — те же,
// что в списке на первом экране (на Садовой — контейнер камеры 4 из первой панели после погрузки)
const UPLOADS = [
  { place: SHKOLNAYA, time: '08:24', thumb: 'thumb-lift-tip.webp' },
  { place: LESNAYA, time: '08:31', thumb: 'thumb-cam-b-before.webp', t0: 0.35, t1: 1.6 },
  { place: SADOVAYA, time: '08:42', thumb: 'thumb-cam-a-after.webp', t0: 1.0, t1: 2.7 },
];
---

<section class="section tsys" id="o-sisteme" aria-labelledby="o-sisteme-title">
  <div class="container">
    <div class="tsys__row" data-acc-scope>
      <div class="tsys__text">
        <p class="tsys__label" data-reveal>
          <span class="plabel plabel--lg p-tracker">
            <span class="plabel__ico" aria-hidden="true"><Icon name="cctv" strokeWidth={2} /></span>
            О системе
          </span>
        </p>

        <h2 class="t-serif tsys__title" id="o-sisteme-title" data-reveal style="--d:1">
          Полный контроль выгрузки с&nbsp;помощью&nbsp;ИИ
        </h2>

        <p class="tsys__lead" data-reveal style="--d:2">
          QODEX&nbsp;Tracker — это система, которая использует 4&nbsp;камеры, установленные на мусоровозе, для&nbsp;фиксации
          выгрузок.
        </p>

        <div class="tsys__steps" data-reveal style="--d:3">
          <FeatureAccordion id="tracker-system" items={items} color="var(--g-teal)" />
        </div>

        <p class="footnote tsys__note" data-reveal style="--d:4">Оборудование и монтаж камер — на QODEX.</p>

        <div class="tsys__cta" data-reveal style="--d:4">
          <a href="#forma" class="btn btn--primary" data-interest="tracker" data-goal="pilot_click">
            Запросить демо
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>

      <div class="tsys__visual" data-reveal style="--d:1">
        <GradientVisual preset="aqua" deco="bars">
          <div class="ts" data-ts data-idle data-panes>
            {/* 1. Камеры: мусоровоз сверху, четыре камеры по очереди снимают площадку до и после погрузки */}
            <div class="tsp is-active" data-pane>
              <div class="ui tc">
                <div class="th">
                  <span class="th__title">Мусоровоз 07</span>
                  <span class="th__sub">Маршрут 14</span>
                  <span class="tp tp--rec">
                    <i class="a-blink"></i>
                    Запись
                  </span>
                </div>

                <div class="sch">
                  <svg class="sch__svg" viewBox={`0 0 ${SW} ${SH}`}>
                    <g set:html={STREET} />
                    {
                      CAMS.map((c, k) => (
                        <g style={`--k:${k}`}>
                          <path class="cone" d={c.cone} />
                          <path class="cone__hi" d={c.cone} />
                        </g>
                      ))
                    }
                    <g transform={`translate(${TOP.x} ${TOP.y}) scale(${TOP.s})`} set:html={TRUCK_TOP} />
                    {
                      CAMS.map((c, k) => (
                        <g style={`--k:${k}`}>
                          <circle class="cdot__ring" cx={c.dot[0]} cy={c.dot[1]} r="6.5" />
                          <circle class="cam-body" cx={c.dot[0]} cy={c.dot[1]} r="6.5" />
                          <circle class="cam-lens" cx={c.dot[0]} cy={c.dot[1]} r="3.4" />
                        </g>
                      ))
                    }
                  </svg>

                  {
                    CAMS.map((c, k) => (
                      <div
                        class="cf"
                        style={`--k:${k}; left:${pct(c.x, SW)}; top:${pct(c.y, SH)}; width:${pct(FW, SW)}; height:${pct(FH, SH)}`}
                      >
                        <img
                          class="cf__img"
                          src={media(c.img)}
                          width={c.w}
                          height={c.h}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          draggable="false"
                          style={c.pos ? `object-position:${c.pos}` : undefined}
                        />
                        {c.before && (
                          <img
                            class="cf__img cf__img--before"
                            src={media(c.before)}
                            width={c.w}
                            height={c.h}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            draggable="false"
                          />
                        )}
                        <span class="cf__tag">
                          Кам.{NB}{c.n}<span class="cf__side">{` · ${c.side}`}</span>
                        </span>
                        {c.n === 4 && (
                          <span class="cf__rec">
                            <i />
                          </span>
                        )}
                        <span class="cf__state">
                          <span class="cf__chip cf__chip--do">до</span>
                          <span class="cf__chip cf__chip--after">после</span>
                        </span>
                        <span class="cf__flash" />
                      </div>
                    ))
                  }
                </div>

                <div class="tf">
                  <span class="tf__place">
                    <Icon name="map-pin" size={15} strokeWidth={2} />
                    {SADOVAYA}
                  </span>
                  <span class="tp tp--mute">ID КП 3298</span>
                </div>
              </div>
            </div>

            {/* 2. ИИ: рамки вокруг контейнеров по одной, счётчик «Погружено», сверка с планом.
                Кадр — площадка ул. Лесная, 3 (08:31), как в строке первого экрана */}
            <div class="tsp" data-pane>
              <div class="ui tc">
                <div class="th">
                  <span class="th__title th__title--sm">Контроль качества погрузки мусора</span>
                </div>
                <div class="fr">
                  <img
                    class="fr__img"
                    src={media(SHOT.file)}
                    width={SHOT.w}
                    height={SHOT.h}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                    style={SHOT_STYLE}
                  />
                  <span class="scan">
                    <b></b>
                    <i></i>
                  </span>
                  {
                    DETS.map((box, k) => (
                      <span class="det a-pop" style={`${box}; --t:${(0.67 + k * 0.24).toFixed(2)}s`}>
                        <i>{k + 1}</i>
                      </span>
                    ))
                  }
                  <span class="fr__tag">Кам.{NB}3 · 08:31</span>
                  <span class="fr__count">
                    <span class="td td--ok"></span>
                    Погружено:
                    <span class="tsys__num">
                      <b class="a-blip" style="--t:0s; --dur:0.67s">0</b>
                      <b class="a-blip" style="--t:0.67s; --dur:0.24s">1</b>
                      <b class="a-blip" style="--t:0.91s; --dur:0.24s">2</b>
                      <b class="a-pop" style="--t:1.15s">3</b>
                    </span>
                  </span>
                </div>
                <ul class="trs">
                  <li class="tr a-in" style="--t:1.45s">
                    <span class="td td--bad"></span>
                    <span class="tr__main">
                      <b>{LESNAYA}</b>
                      <small>план 4 · факт 3 · посчитал ИИ</small>
                    </span>
                    <span class="tp tp--bad a-pop" style="--t:1.75s">Погружено меньше плана</span>
                  </li>
                  <li class="tr a-in" style="--t:1.65s">
                    <span class="td td--ok"></span>
                    <span class="tr__main">
                      <b>{SADOVAYA}</b>
                      <small>план 3 · факт 3</small>
                    </span>
                    <span class="tp tp--ok a-pop" style="--t:1.95s">
                      <Icon name="check" size={12} strokeWidth={3} />
                      Корректно
                    </span>
                  </li>
                </ul>
              </div>
            </div>

            {/* 3. Оповещения: машина съезжает с маршрута в СНТ — метка краснеет, всплывает оповещение */}
            <div class="tsp" data-pane>
              <div class="ui tc">
                <div class="th">
                  <span class="th__title">Маршрут 14</span>
                  <span class="tp tp--mute">
                    <Icon name="truck" size={13} strokeWidth={2.2} />
                    Мусоровоз 07
                  </span>
                </div>
                <div class="mpw">
                  <div class="mp">
                    <svg class="mp__svg" viewBox={`0 0 ${MW} ${MH}`}>
                      <rect x="14" y="8" width="92" height="30" rx="7" fill="#e3e9f1"></rect>
                      <rect x="134" y="8" width="182" height="30" rx="7" fill="#e3e9f1"></rect>
