    font-weight: 600;
  }

  .fr__count .td {
    width: 9px;
    height: 9px;
  }

  /* ── 3. Оповещения: карта и уведомление ────────────────── */
  .mpw {
    position: relative;
  }

  .mp {
    position: relative;
    aspect-ratio: 440 / 280;
    overflow: hidden;
    border-radius: 14px;
    background: #edf3f5;
  }

  .mp__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .mp__label {
    position: absolute;
    left: 15.5%;
    top: 75.5%;
    padding: 2px 7px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.9);
    color: #1f6b44;
    font-size: clamp(10px, 2.6cqi, 11.5px);
    font-weight: 600;
    line-height: 1.35;
    white-space: nowrap;
  }

  .stop {
    position: absolute;
    z-index: 1;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border: 3px solid #fff;
    border-radius: 50%;
