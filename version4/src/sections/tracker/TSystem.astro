  .tr__main {
    display: grid;
    gap: 1px;
    flex: 1;
    min-width: 0;
  }

  .tr__main b {
    overflow: hidden;
    font-size: clamp(13px, 3.4cqi, 14px);
    font-weight: 560;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tr__main small {
    overflow: hidden;
    font-size: clamp(11.5px, 3cqi, 12.5px);
