  }

  /* ── Иллюстрация: четыре панели, по одной на пункт ─────── */
  .ts {
    --u-blue: #006bff;
    --u-blue-soft: #e8f1ff;
    --u-ok: #087a52;
    --u-ok-bg: #0fa86f;
    --u-ok-soft: #e1f5ec;
    --u-bad: #b8283a;
    --u-bad-bg: #e5484d;
    --u-bad-soft: #fde8ea;
    --u-row: #f5f6f8;
    width: min(100%, 476px);
    container-type: inline-size;
    font-size: 14px;
    line-height: 1.35;
    color: var(--ink);
    text-align: left;
    -webkit-user-select: none;
    user-select: none;
  }

  .tsp {
    display: grid;
    align-content: center;
  }

  .tc {
    width: 100%;
    padding: clamp(13px, 4.8cqi, 24px);
    border-radius: clamp(18px, 5cqi, 24px);
  }

  /* шапка карточки: название, подпись, плашка справа */
  .th {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: clamp(10px, 3cqi, 14px);
  }

  .th__title {
    font-size: clamp(16px, 4.2cqi, 19px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .th__title--sm {
    font-size: clamp(14.5px, 3.6cqi, 16.5px);
