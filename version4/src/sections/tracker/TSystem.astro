---
// Раздел «О системе» страницы «QODEX Tracker» [#o-sisteme]. Продуктовый ряд, как на главной
// (ProductHow + Shot) и в «Импорте из Excel» «Кодекса ТКО»: слева метка, заголовок, текст, четыре пункта
// с полосой прогресса, сноска и кнопка; справа большая градиентная карточка — у каждого пункта своя
// иллюстрация: мусоровоз сверху с четырьмя камерами → ИИ считает контейнеры → оповещение о погрузке
// вне маршрута → видео погрузок уходят в облако.
// Тексты — с лендинга tracker.qodex.tech дословно. Картинку описывают пункты рядом, поэтому для
// скринридера она скрыта (aria-hidden ставит GradientVisual).
import GradientVisual from '../../components/GradientVisual.astro';
import FeatureAccordion, { type AccItem } from '../../components/FeatureAccordion.astro';
import Icon from '../../components/Icon.astro';

const NB = String.fromCharCode(160);

// Пункты: короткое название + текст с лендинга
const items: AccItem[] = [
  { icon: 'cctv', title: 'Камеры', text: 'Камеры автоматически фиксируют погрузки' },
  { icon: 'ai-scan', title: 'ИИ', text: 'ИИ сам считает контейнеры и сверяет с маршрутом' },
  { icon: 'bell-ring', title: 'Оповещения', text: 'Моментальное оповещение о подозрительных случаях' },
  { icon: 'cloud-upload', title: 'Облако', text: 'Всё работает через облако — дорогую технику ставить не нужно' },
];

// ── Демо-данные (общие для страницы и главной: Мусоровоз 07, Маршрут 14, ул. Садовая, 21 — 08:42) ──
const SADOVAYA = `ул.${NB}Садовая,${NB}21`;
const LESNAYA = `ул.${NB}Лесная,${NB}3`;
const SNT = `СНТ${NB}«Рассвет»`;

// Мусорный контейнер (как в Shot.astro): x, y — левый верх, w — ширина
function bin(x: number, y: number, w: number, color: string, full = false): string {
  const s = w / 40;
  const bags = full
    ? '<ellipse cx="13" cy="7" rx="9" ry="6" fill="#4d5a66"/><ellipse cx="26" cy="6" rx="10" ry="7" fill="#6b7884"/><ellipse cx="20" cy="4" rx="6" ry="4" fill="#3e4954"/>'
    : '';
  const lid = full
    ? '<rect x="2" y="2" width="36" height="5" rx="2" fill="#2b3a33" transform="rotate(-24 2 7)"/>'
    : '<rect x="1" y="5" width="38" height="6" rx="2" fill="#2b3a33" fill-opacity=".55"/>';
  return `<g transform="translate(${x} ${y}) scale(${s})">${bags}<path d="M3.5 10h33l-3 28a3 3 0 0 1-3 2.7H9.5a3 3 0 0 1-3-2.7Z" fill="${color}"/>${lid}<path d="M13 16v17M20 16v17M27 16v17" stroke="#000" stroke-opacity=".14" stroke-width="2" stroke-linecap="round"/><circle cx="11" cy="43" r="3.2" fill="#26313a"/><circle cx="29" cy="43" r="3.2" fill="#26313a"/></g>`;
}

// ── Кадры четырёх камер (рисунки 160×100, не фото): full — контейнеры полные, «до» погрузки ──
// спереди: дорога, площадка у обочины справа, внизу капот
const front = (full: boolean) =>
  `<rect width="160" height="100" fill="#dbe5eb"/>` +
  `<circle cx="22" cy="36" r="9" fill="#b9cbc0"/><path d="M34 42V32l10-8 10 8v10Z" fill="#c4ced6"/>` +
  `<rect y="42" width="160" height="58" fill="#c6d1cc"/><path d="M66 42h28l50 58H16Z" fill="#b3bfc7"/>` +
  `<path d="M80 47v5M80 58v7M80 72v9" stroke="#d6dde2" stroke-width="2.2" stroke-linecap="round"/>` +
  `<rect x="102" y="46" width="52" height="11" rx="2" fill="#c5cdd3"/>` +
  bin(106, 32, 20, '#3f8a6c', full) +
  bin(130, 32, 20, '#4a76ad', full) +
  `<path d="M0 89c38-6 122-6 160 0v11H0Z" fill="#57636e"/>`;

// слева: другая сторона улицы — дом, деревья, забор (до и после погрузки одинаково)
const left =
  `<rect width="160" height="100" fill="#dbe5eb"/>` +
  `<circle cx="30" cy="38" r="11" fill="#c3d3c8"/>` +
  `<path d="M64 56V33l22-16 22 16v23Z" fill="#c4ced6"/>` +
  `<path d="M60 35 86 16l26 19" fill="none" stroke="#9eacb8" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round"/>` +
  `<rect x="78" y="35" width="15" height="11" rx="1.5" fill="#a9bccb"/>` +
  `<circle cx="132" cy="33" r="14" fill="#b9cbc0"/><rect x="130" y="44" width="4" height="12" fill="#8d9aa3"/>` +
  `<rect y="50" width="160" height="8" fill="#c8d3da"/>` +
  `<path d="M0 50h160M14 50v8M34 50v8M54 50v8M74 50v8M94 50v8M114 50v8M134 50v8M154 50v8" stroke="#b5c1c9" stroke-width="1.5"/>` +
  `<rect y="58" width="160" height="42" fill="#b3bfc7"/>` +
  `<path d="M8 80h16M40 80h16M72 80h16M104 80h16M136 80h16" stroke="#d3dade" stroke-width="2.4" stroke-linecap="round"/>`;

// справа: контейнерная площадка под навесом
const site = (full: boolean) =>
  `<rect width="160" height="100" fill="#dbe5eb"/>` +
  `<rect x="14" y="26" width="132" height="34" fill="#cdd8d2"/><path d="M8 27h144l-7-9H15Z" fill="#9fb0a6"/>` +
  `<path d="M16 27v33M144 27v33" stroke="#8d9aa3" stroke-width="3"/>` +
  `<rect y="58" width="160" height="42" fill="#b3bfc7"/><rect x="16" y="62" width="128" height="22" rx="3" fill="#c5cdd3"/>` +
  bin(30, 38, 28, '#3f8a6c', full) +
  bin(66, 38, 28, '#3f8a6c', full) +
  bin(102, 38, 28, '#4a76ad', full);

// сзади: камера над подъёмником — контейнер у бункера, по краям борта мусоровоза
const rear = (full: boolean) =>
  `<rect width="160" height="100" fill="#b3bfc7"/><rect width="160" height="30" fill="#c8d3da"/>` +
  `<path d="M0 30h160M22 0v30M62 0v30M102 0v30M142 0v30" stroke="#b5c1c9" stroke-width="1.5"/>` +
  bin(122, 12, 22, '#4a76ad', full) +
  bin(58, 34, 44, '#3f8a6c', full) +
  `<path d="M0 100V56l22 12v32Z" fill="#7d8a95"/><path d="M160 100V56l-22 12v32Z" fill="#7d8a95"/>` +
  `<rect x="22" y="88" width="116" height="12" fill="#57636e"/>`;

// ── Схема 460×420: мусоровоз сверху, четыре камеры, их поля обзора и кадры ──
const SW = 460;
const SH = 420;
const FW = 150;
const FH = 94;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

const CAMS = [
  { n: 1, side: 'спереди', x: 155, y: 8, dot: [230, 140], cone: 'M230 140 162 102H298Z', scene: front },
  { n: 2, side: 'слева', x: 10, y: 163, dot: [206, 210], cone: 'M206 210 160 170V250Z', scene: null },
  { n: 3, side: 'справа', x: 300, y: 163, dot: [254, 210], cone: 'M254 210 300 170V250Z', scene: site },
  { n: 4, side: 'сзади', x: 155, y: 318, dot: [230, 279], cone: 'M230 279 162 318H298Z', scene: rear },
];

// мусоровоз сверху: кабина спереди (вверху), кузов, задний борт с подъёмником
const truckTop =
  `<rect x="211" y="146" width="46" height="138" rx="9" fill="#1d1d1f" fill-opacity=".07"/>` +
  `<rect x="202" y="156" width="6" height="13" rx="2" fill="#2f3840"/><rect x="252" y="156" width="6" height="13" rx="2" fill="#2f3840"/>` +
  `<rect x="202" y="229" width="6" height="13" rx="2" fill="#2f3840"/><rect x="252" y="229" width="6" height="13" rx="2" fill="#2f3840"/>` +
  `<rect x="202" y="246" width="6" height="13" rx="2" fill="#2f3840"/><rect x="252" y="246" width="6" height="13" rx="2" fill="#2f3840"/>` +
  `<rect x="207" y="177" width="46" height="93" rx="5" fill="#e3e9ee" stroke="#c3ccd4" stroke-width="1.5"/>` +
  `<path d="M211 192h38M211 207h38M211 222h38M211 237h38M211 252h38" stroke="#cfd7de" stroke-width="1.5"/>` +
  `<rect x="211" y="269" width="38" height="9" rx="2" fill="#7d8a95"/>` +
  `<rect x="209" y="141" width="42" height="33" rx="9" fill="#f7f9fb" stroke="#c3ccd4" stroke-width="1.5"/>` +
  `<rect x="213" y="145" width="34" height="8" rx="3" fill="#9fb3c6"/>` +
  `<rect x="202" y="149" width="7" height="4" rx="1.5" fill="#6f7c88"/><rect x="251" y="149" width="7" height="4" rx="1.5" fill="#6f7c88"/>`;

// ── ИИ: крупный кадр камеры справа — три контейнера под навесом (320×190) ──
const yard =
  `<rect width="320" height="190" fill="#dde7ed"/>` +
  `<rect x="36" y="44" width="248" height="78" fill="#cdd8d2"/><path d="M22 46h276l-13-17H35Z" fill="#9fb0a6"/>` +
  `<path d="M40 46v86M280 46v86" stroke="#8d9aa3" stroke-width="5"/>` +
  `<rect y="120" width="320" height="70" fill="#b6c2ca"/><rect x="44" y="126" width="232" height="20" rx="3" fill="#c6ced4"/>` +
  bin(66, 80, 50, '#3f8a6c', true) +
  bin(135, 80, 50, '#3f8a6c', true) +
  bin(204, 80, 50, '#4a76ad', true);

// рамки распознавания: левый край каждой — в долях кадра
const DETS = [62, 131, 200].map((x) => pct(x, 320));

// ── Оповещение: карта 440×280 — маршрут идёт по верхней улице, машина сворачивает в СНТ ──
const MW = 440;
const MH = 280;
const TURN = { x: 120, y: 50 };
const PIN = { x: 158, y: 150 };

// участки СНТ: слева от уведомления — вокруг проезда, метки и подписи; справа — у нижнего края
const PLOTS = [
  ...[72, 96, 120].flatMap((y) => [68, 94].map((x) => [x, y])),
  ...[72, 96].flatMap((y) => [128, 154].map((x) => [x, y])),
  ...[68, 94, 128].map((x) => [x, 172]),
  ...[68, 94, 128, 154].map((x) => [x, 194]),
  ...[190, 216, 242, 268, 294].map((x) => [x, 240]),
]
  .map(([x, y]) => `M${x} ${y}h22v16h-22Z`)
  .join('');

// ── Облако: мусоровоз сбоку (240×108) ──
const truckSide =
  `<rect y="100" width="240" height="8" rx="4" fill="#eef2f5"/>` +
  `<rect x="80" y="34" width="128" height="54" rx="8" fill="#e3e9ee" stroke="#c3ccd4" stroke-width="2"/>` +
  `<path d="M100 42v38M120 42v38M140 42v38M160 42v38M180 42v38" stroke="#cfd7de" stroke-width="2"/>` +
  `<path d="M208 38h12a4 4 0 0 1 4 4v50h-16Z" fill="#7d8a95"/>` +
  `<rect x="22" y="86" width="202" height="6" rx="2" fill="#57636e"/>` +
  `<path d="M24 90V58c0-5 2-9 6-12l12-10h32a4 4 0 0 1 4 4v50Z" fill="#f7f9fb" stroke="#c3ccd4" stroke-width="2"/>` +
  `<path d="M36 58 47 46h21v12Z" fill="#9fb3c6"/><rect x="25" y="74" width="8" height="5" rx="2" fill="#f4e3a6"/>` +
  `<circle cx="50" cy="94" r="11" fill="#26313a"/><circle cx="50" cy="94" r="4" fill="#8a97a3"/>` +
  `<circle cx="154" cy="94" r="11" fill="#26313a"/><circle cx="154" cy="94" r="4" fill="#8a97a3"/>` +
  `<circle cx="182" cy="94" r="11" fill="#26313a"/><circle cx="182" cy="94" r="4" fill="#8a97a3"/>` +
  `<rect x="50" y="28" width="18" height="8" rx="2.5" fill="#57636e"/><path d="M63 28v-8" stroke="#57636e" stroke-width="2" stroke-linecap="round"/>`;

// дуги сигнала над антенной модуля связи (кончик антенны — 63, 19)
const SIG = [5, 9.5, 14].map((r) => {
  const d = (r * Math.SQRT1_2).toFixed(2);
  return `M${(63 - +d).toFixed(2)} ${(19 - +d).toFixed(2)}A${r} ${r} 0 0 1 ${(63 + +d).toFixed(2)} ${(19 - +d).toFixed(2)}`;
});

// видео погрузок за смену: первое уже в облаке, два догружаются
const UPLOADS = [
  { place: SADOVAYA, time: '08:42', full: false },
  { place: LESNAYA, time: '08:57', full: false, t0: 0.35, t1: 1.6 },
  { place: SNT, time: '09:14', full: true, t0: 1.0, t1: 2.7 },
];
---

<section class="section tsys" id="o-sisteme" aria-labelledby="o-sisteme-title">
  <div class="container">
    <div class="tsys__row" data-acc-scope>
      <div class="tsys__text">
        <p class="tsys__label" data-reveal>
          <span class="plabel plabel--lg p-tracker">
            <span class="plabel__ico" aria-hidden="true"><Icon name="cctv" strokeWidth={2} /></span>
            О системе
          </span>
        </p>

        <h2 class="t-serif tsys__title" id="o-sisteme-title" data-reveal style="--d:1">
          Полный контроль выгрузки с&nbsp;помощью&nbsp;ИИ
        </h2>

        <p class="tsys__lead" data-reveal style="--d:2">
          QODEX&nbsp;Tracker — это система, которая использует 4&nbsp;камеры, установленные на мусоровозе, для фиксации
          каждой выгрузки.
        </p>

        <div class="tsys__steps" data-reveal style="--d:3">
          <FeatureAccordion id="tracker-system" items={items} color="var(--g-teal)" />
        </div>

        <p class="footnote tsys__note" data-reveal style="--d:4">Оборудование и монтаж камер — на QODEX.</p>

        <div class="tsys__cta" data-reveal style="--d:4">
          <a href="#forma" class="btn btn--primary" data-interest="tracker" data-goal="pilot_click">
            Запросить демо
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>

      <div class="tsys__visual" data-reveal style="--d:1">
        <GradientVisual preset="aqua" deco="bars">
          <div class="ts" data-ts data-idle data-panes>
            {/* 1. Камеры: мусоровоз сверху, четыре камеры по очереди снимают площадку до и после погрузки */}
            <div class="tsp is-active" data-pane>
              <div class="ui tc">
                <div class="th">
                  <span class="th__title">Мусоровоз 07</span>
                  <span class="th__sub">Маршрут 14</span>
                  <span class="tp tp--rec">
                    <i class="a-blink"></i>
                    Запись
                  </span>
                </div>

                <div class="sch">
                  <svg class="sch__svg" viewBox={`0 0 ${SW} ${SH}`}>
                    <rect x="186" width="88" height={SH} fill="#e7edf1"></rect>
                    <path d="M186 0V420M274 0V420" stroke="#fff" stroke-width="2" stroke-dasharray="10 10"></path>
                    {
                      CAMS.map((c, k) => (
                        <g style={`--k:${k}`}>
                          <path class="cone" d={c.cone} />
                          <path class="cone__hi" d={c.cone} />
                        </g>
                      ))
                    }
                    <g set:html={truckTop} />
                    {
                      CAMS.map((c, k) => (
                        <g style={`--k:${k}`}>
                          <circle class="cdot__ring" cx={c.dot[0]} cy={c.dot[1]} r="6" />
                          <circle class="cdot" cx={c.dot[0]} cy={c.dot[1]} r="6" />
                        </g>
                      ))
                    }
                  </svg>

                  {
                    CAMS.map((c, k) => (
                      <div
                        class="cf"
                        style={`--k:${k}; left:${pct(c.x, SW)}; top:${pct(c.y, SH)}; width:${pct(FW, SW)}; height:${pct(FH, SH)}`}
                      >
                        <svg
                          class="cf__img"
                          viewBox="0 0 160 100"
                          preserveAspectRatio="xMidYMid slice"
                          set:html={c.scene ? c.scene(false) : left}
                        />
                        {c.scene && (
                          <svg
                            class="cf__img cf__img--before"
                            viewBox="0 0 160 100"
                            preserveAspectRatio="xMidYMid slice"
                            set:html={c.scene(true)}
                          />
                        )}
                        <span class="cf__tag">
                          Кам.{NB}{c.n} · {c.side}
                        </span>
                        {c.n === 4 && (
                          <span class="cf__rec">
                            <i />
                          </span>
                        )}
                        <span class="cf__state">
                          <span class="cf__chip cf__chip--do">до</span>
                          <span class="cf__chip cf__chip--after">после</span>
                        </span>
                        <span class="cf__flash" />
                      </div>
                    ))
                  }
                </div>

                <div class="tf">
                  <span class="tf__place">
                    <Icon name="map-pin" size={15} strokeWidth={2} />
                    {SADOVAYA}
                  </span>
                  <span class="tp tp--mute">ID КП 3298</span>
                </div>
              </div>
            </div>

            {/* 2. ИИ: рамки вокруг контейнеров по одной, счётчик «Погружено», сверка с планом */}
            <div class="tsp" data-pane>
              <div class="ui tc">
                <div class="th">
                  <span class="th__title th__title--sm">Контроль качества погрузки мусора</span>
                </div>
                <div class="fr">
                  <svg class="fr__img" viewBox="0 0 320 190" preserveAspectRatio="xMidYMid slice" set:html={yard} />
                  <span class="scan">
                    <b></b>
                    <i></i>
                  </span>
                  {
                    DETS.map((x, k) => (
                      <span class="det a-pop" style={`left:${x}; --t:${(0.67 + k * 0.24).toFixed(2)}s`}>
                        <i>{k + 1}</i>
                      </span>
                    ))
                  }
                  <span class="fr__tag">Кам.{NB}3 · 08:42</span>
                  <span class="fr__count">
                    <span class="td td--ok"></span>
                    Погружено:
                    <span class="num">
                      <b class="a-blip" style="--t:0s; --dur:0.67s">0</b>
                      <b class="a-blip" style="--t:0.67s; --dur:0.24s">1</b>
                      <b class="a-blip" style="--t:0.91s; --dur:0.24s">2</b>
                      <b class="a-pop" style="--t:1.15s">3</b>
                    </span>
                  </span>
                </div>
                <ul class="trs">
                  <li class="tr a-in" style="--t:1.45s">
                    <span class="td td--ok"></span>
                    <span class="tr__main">
                      <b>{SADOVAYA}</b>
                      <small>план 3 · факт 3 · посчитал ИИ</small>
                    </span>
                    <span class="tp tp--ok a-pop" style="--t:1.75s">
                      <Icon name="check" size={12} strokeWidth={3} />
                      Корректно
                    </span>
                  </li>
                  <li class="tr a-in" style="--t:1.65s">
                    <span class="td td--bad"></span>
                    <span class="tr__main">
                      <b>{LESNAYA}</b>
                      <small>план 4 · факт 2</small>
                    </span>
                    <span class="tp tp--bad a-pop" style="--t:1.95s">Погружено меньше плана</span>
                  </li>
                </ul>
              </div>
            </div>

            {/* 3. Оповещения: машина съезжает с маршрута в СНТ — метка краснеет, всплывает оповещение */}
            <div class="tsp" data-pane>
              <div class="ui tc">
                <div class="th">
                  <span class="th__title">Маршрут 14</span>
                  <span class="tp tp--mute">
                    <Icon name="truck" size={13} strokeWidth={2.2} />
                    Мусоровоз 07
                  </span>
                </div>
                <div class="mpw">
                  <div class="mp">
                    <svg class="mp__svg" viewBox={`0 0 ${MW} ${MH}`}>
                      <rect x="14" y="8" width="92" height="30" rx="7" fill="#e3e9f1"></rect>
                      <rect x="134" y="8" width="182" height="30" rx="7" fill="#e3e9f1"></rect>
                      <rect x="344" y="8" width="86" height="30" rx="7" fill="#e3e9f1"></rect>
                      <rect x="14" y="64" width="30" height="206" rx="7" fill="#e3e9f1"></rect>
                      <rect x="344" y="64" width="86" height="98" rx="7" fill="#dcebe1"></rect>
                      <rect x="344" y="176" width="86" height="94" rx="7" fill="#e3e9f1"></rect>
                      <rect x="60" y="64" width="258" height="206" rx="10" fill="#d7ecdf"></rect>
                      <path d={PLOTS} fill="#c4e2cd"></path>
                      <path d="M0 50H440M52 50V280M331 50V280" stroke="#fff" stroke-width="11" fill="none"></path>
                      <path d={`M${TURN.x} ${TURN.y}V${PIN.y}H186`} stroke="#fff" stroke-width="8" fill="none" stroke-linejoin="round"></path>
                      <path d="M8 50H432" stroke="#006bff" stroke-width="3.5" stroke-linecap="round" stroke-opacity=".9"></path>
                    </svg>
                    <span class="mp__label">{SNT}</span>
                    {
                      [
                        { x: 84, c: 'ok' },
                        { x: 228, c: 'plan' },
                        { x: 384, c: 'plan' },
                      ].map((s) => (
