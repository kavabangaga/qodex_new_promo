---
// Раздел 5 страницы «QODEX Tracker» [#algoritm] — «Алгоритм работы».
// Подан как плеер: сверху широкая сцена, под ней шкала из шести отрезков (как главы ролика), под шкалой —
// подпись активного шага. Сцена: мусоровоз сбоку (рисунок в духе кадров с камер на главной) приезжает
// на площадку, четыре камеры снимают её до и после погрузки, подъёмник опорожняет контейнер под запись,
// видео уходят в облако, ИИ считает контейнеры и находит аномалию. Шаги идут сами, пока сцена на экране:
// отрезок активного шага заполняется, и включается следующий; нажатый отрезок сразу показывается в сцене.
// Сцену скринридер не читает (aria-hidden ставит GradientVisual) — смысл несут кнопки шкалы с полным
// названием шага и подпись. Без анимации («уменьшить движение») сцена показывает итог выбранного шага.
// Кадры «до» и «после», что всплывают над машиной, — настоящие снимки камер с прежнего лендинга.
import SectionIntro from '../../components/SectionIntro.astro';
import GradientVisual from '../../components/GradientVisual.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../config/site';

const NB = String.fromCharCode(160); // неразрывный пробел

// Шаги — с лендинга tracker.qodex.tech дословно: заголовок шага и, если есть, текст.
// short — подпись отрезка на шкале; ms — сколько шаг идёт при автопрокрутке: движение сцены и пауза после него
const STEPS: { title: string; short: string; text?: string; ms: number }[] = [
  { title: 'Машина прибывает на контейнерную площадку', short: 'Прибытие', ms: 4600 },
  { title: 'Фото до погрузки', short: 'Фото до', text: `Фотографируем на все 4${NB}камеры`, ms: 4200 },
  { title: 'Видеонаблюдение за процессом загрузки', short: 'Запись', text: 'Запись погрузки', ms: 5200 },
  { title: 'Фото после погрузки', short: 'Фото после', text: `Фотографируем на все 4${NB}камеры`, ms: 4200 },
  {
    title: 'Отправка видеозаписей всех опорожнений контейнеров в облако в процессе рабочего дня',
    short: 'В облако',
    ms: 4600,
  },
  { title: 'Видеоаналитика с помощью ИИ и поиск аномалий', short: 'Анализ ИИ', ms: 5600 },
];

// ── Сцена 1100×440 (рисунок, не фото). Площадка с машиной — x 248…904, слева дорога, по которой машина
//    въезжает. Широкий кадр показывает сцену целиком, узкий — её середину, а на телефоне над сценой ещё
//    остаётся небо под плашки (окно кадра задают --sw, --x0, --k у .tst-stage). ──
const POSTS = Array.from({ length: 24 }, (_, i) => `M${20 + i * 46} 206v56`).join('');

const BACKDROP =
  `<rect x="-40" y="-560" width="1180" height="1000" fill="#e2eaf0"/>` +
  // вдали, за забором: края зданий у краёв сцены (в узком кадре их не видно), деревья, два дома
  `<rect x="-20" y="140" width="138" height="8" rx="2" fill="#c8d3db"/><rect x="-14" y="148" width="126" height="62" fill="#d6dfe6"/>` +
  `<rect x="14" y="162" width="20" height="16" rx="2" fill="#c9d4dc"/><rect x="46" y="162" width="20" height="16" rx="2" fill="#c9d4dc"/>` +
  `<rect x="78" y="162" width="20" height="16" rx="2" fill="#c9d4dc"/>` +
  `<circle cx="176" cy="192" r="18" fill="#d6e0e6"/>` +
  `<circle cx="284" cy="184" r="30" fill="#d2dce3"/><circle cx="338" cy="196" r="22" fill="#d6e0e6"/>` +
  `<circle cx="628" cy="184" r="26" fill="#d2dce3"/>` +
  `<rect x="682" y="150" width="104" height="60" fill="#d6dfe6"/><path d="M670 154 734 114l64 40Z" fill="#c8d3db"/>` +
  `<rect x="722" y="164" width="22" height="20" rx="2" fill="#c9d4dc"/>` +
  `<rect x="818" y="164" width="98" height="46" fill="#d3dde4"/><path d="M806 168l61-36 61 36Z" fill="#c5d0d8"/>` +
  `<rect x="856" y="176" width="20" height="18" rx="2" fill="#c7d2da"/>` +
  `<circle cx="960" cy="186" r="24" fill="#d2dce3"/><circle cx="996" cy="198" r="16" fill="#d6e0e6"/>` +
  `<rect x="1030" y="160" width="90" height="50" fill="#d6dfe6"/><path d="M1020 164l52-34 52 34Z" fill="#c8d3db"/>` +
  // забор, дорога с разметкой, бордюр, тротуар с плитой площадки
  `<rect y="206" width="1100" height="56" fill="#ccd6dd"/><path d="M0 217H1100${POSTS}" stroke="#bac5cd" stroke-width="2"/>` +
  `<rect y="262" width="1100" height="126" fill="#c3ccd4"/>` +
  `<path d="M0 324H1100" stroke="#fff" stroke-opacity=".5" stroke-width="3" stroke-dasharray="28 24"/>` +
  `<rect y="386" width="1100" height="8" fill="#aab5be"/><rect y="394" width="1100" height="46" fill="#d1d9df"/>` +
  `<rect x="248" y="394" width="262" height="14" rx="3" fill="#bcc6cd"/>`;

// Мусоровоз сбоку, кабиной вправо. Свои координаты: задний борт — x 0, крыша кузова — y 0,
// низ колёс — y 172. На сцене стоит у площадки: translate(540 210).
const TRUCK =
  // задний борт со скошенной стенкой, бункер внизу, гидроцилиндр
  `<path d="M60 2H38q-8 0-11 7L4 90q-3 8 0 15l3 10q2 5 8 5h45Z" fill="#8f9ca7"/>` +
  `<path d="M33 16 12 88" stroke="#7f8c97" stroke-width="2"/>` +
  `<path d="M45 24 39 80" stroke="#6f7c88" stroke-width="4" stroke-linecap="round"/>` +
  `<path d="M6 98h24v22H14q-4 0-5-4l-4-11q-1-4 1-7Z" fill="#76838e"/>` +
  `<rect x="11" y="72" width="5" height="11" rx="1.5" fill="#e5484d"/>` +
  // кузов
  `<rect x="58" width="196" height="126" rx="12" fill="#eef2f5" stroke="#cdd5de" stroke-width="2"/>` +
  `<path d="M104 10v106M150 10v106M196 10v106" stroke="#dce3e9" stroke-width="3"/>` +
  `<rect x="59" y="78" width="194" height="13" fill="#a8ddd7"/>` +
  // кабина
  `<path d="M254 128V42q0-16 16-16h48q9 0 13 7l21 37q4 7 4 15v43Z" fill="#f4f6f9" stroke="#cdd5de" stroke-width="2"/>` +
  `<path d="M268 38h46q5 0 8 5l17 28q2 4-3 4h-68q-3 0-3-3V41q0-3 3-3Z" fill="#9fb3c6"/>` +
  `<path d="M282 72 302 40h12l-20 32Z" fill="#fff" fill-opacity=".3"/>` +
  `<path d="M300 84v38" stroke="#dbe2e8" stroke-width="2"/><rect x="306" y="90" width="12" height="3.5" rx="1.75" fill="#b9c4cc"/>` +
  `<path d="M347 58h11" stroke="#6f7c88" stroke-width="3"/><rect x="356" y="46" width="5" height="24" rx="2" fill="#6f7c88"/>` +
  `<rect x="350" y="98" width="8" height="12" rx="2" fill="#fff3c4"/>` +
  // рама, бак, арки колёс, ступенька, бампер
  `<rect x="6" y="122" width="350" height="14" rx="4" fill="#45505b"/>` +
  `<rect x="186" y="128" width="46" height="18" rx="5" fill="#6f7c88"/>` +
  `<path d="M67 150a27 27 0 0 1 54 0ZM119 150a27 27 0 0 1 54 0ZM279 150a27 27 0 0 1 54 0Z" fill="#45505b"/>` +
  `<rect x="250" y="132" width="24" height="6" rx="2" fill="#6f7c88"/>` +
  `<rect x="336" y="118" width="28" height="18" rx="4" fill="#57636e"/>`;

const WHEELS = [94, 146, 306];

// Четыре камеры слева направо: над подъёмником, на крыше кузова, на крыше кабины, над лобовым стеклом.
// n — номер камеры, как на всей странице: 1 спереди, 2 слева, 3 справа, 4 сзади (над подъёмником)
const CAMS = [
  { x: 10, y: 6, n: 4 },
  { x: 150, y: 0, n: 3 },
  { x: 268, y: 26, n: 2 },
  { x: 334, y: 38, n: 1 },
];

// Контейнеры на площадке: два зелёных и синий — его поднимает подъёмник. x — левый край, BIN_Y — верх
const BINS = [
  { x: 264, color: '#3f8a6c' },
  { x: 344, color: '#3f8a6c' },
  { x: 424, color: '#4a76ad' },
];
const BIN_Y = 340;

// Корпус контейнера с ободом и колёсами (крышка и мешки — отдельно: они меняются по шагам)
const binBody = (x: number, y: number, color: string) =>
  `<path d="M${x + 2} ${y + 6}h54l-4.4 40.2a4 4 0 0 1-4 3.6H${x + 10.4}a4 4 0 0 1-4-3.6Z" fill="${color}"/>` +
  `<rect x="${x}" y="${y + 3}" width="58" height="6" rx="2.5" fill="${color}"/>` +
  `<rect x="${x}" y="${y + 3}" width="58" height="6" rx="2.5" fill="#000" fill-opacity=".12"/>` +
  `<path d="M${x + 20} ${y + 15}v27M${x + 29} ${y + 15}v27M${x + 38} ${y + 15}v27" stroke="#000" stroke-opacity=".14" stroke-width="2.4" stroke-linecap="round"/>` +
  `<circle cx="${x + 15}" cy="${y + 54}" r="4.6" fill="#26313a"/><circle cx="${x + 43}" cy="${y + 54}" r="4.6" fill="#26313a"/>`;

// ── Кадры с камер «до» и «после» — снимки с прежнего лендинга (служебные надписи размыты, людей нет),
//    по номерам камер. Спереди и слева после погрузки вид тот же. Справа — площадка (машина стоит к ней
//    правым бортом; этот кадр — «Кам. 3 · 08:42» и в «О системе»), над подъёмником — контейнер: «после»
//    они пустые. Миниатюры 320×180: кадр на странице не шире 120 px ──
const SHOTS = [
  { before: 'thumb-cam-front', after: 'thumb-cam-front' },
  { before: 'thumb-cam-left', after: 'thumb-cam-left' },
  { before: 'thumb-cam-b-before', after: 'thumb-cam-b-after' },
  { before: 'thumb-cam-a-before', after: 'thumb-cam-a-after' },
];
const photo = (name: string) => withBase(`/media/tracker/${name}.webp`);

// Вспышки камер и кадры: вспышка — снимок сделан, следом всплывает кадр этой камеры.
// Кадры идут по номерам, поэтому вспышки бегут от кабины к подъёмнику
const flashAt = (k: number) => (0.35 + k * 0.45).toFixed(2);
const shotAt = (k: number) => (0.43 + k * 0.45).toFixed(2);
---

<section class="section panel tst" id="algoritm" aria-labelledby="algoritm-title">
  <div class="container">
    <SectionIntro eyebrow="Как это работает" titleId="algoritm-title">Алгоритм работы</SectionIntro>

    <div class="tst__player" data-tst data-idle>
      {/* Подпись активного шага — над шкалой (заказчик, 2026-10-08). В разметке все шесть: тексты остаются на странице, высота — по самой длинной */}
      <div class="tst-caps" data-reveal style="--d:1">
        {
          STEPS.map((s, i) => (
            <div class:list={['tst-cap', { 'is-on': i === 0 }]} data-tst-cap>
              <p class="tst-cap__n">{`Шаг${NB}${i + 1}`}</p>
              <h3 class="tst-cap__t">{s.title}</h3>
              {s.text && (
                <p class="tst-cap__d" id={`algoritm-d${i + 1}`}>
                  {s.text}
                </p>
              )}
            </div>
          ))
        }
      </div>

      {/* Шкала: отрезок на шаг, как главы ролика. Кнопка — отрезок с подписью; в aria-label сначала видимая подпись
          («1 Прибытие» — её можно назвать голосом), затем полное название шага */}
      <ol class="tst-tl" aria-label="Шаги алгоритма" data-tst-list data-reveal style="--d:2">
        {
          STEPS.map((s, i) => (
            <li class:list={['tst-tl__item', { 'is-on': i === 0 }]} style={`--ms:${s.ms}ms`}>
              <button
                class="tst-tl__btn"
                type="button"
                aria-label={`${i + 1} ${s.short}. ${s.title}`}
                aria-describedby={s.text ? `algoritm-d${i + 1}` : undefined}
                aria-current={i === 0 ? 'step' : undefined}
              >
                <span class="tst-tl__track">
                  <i data-tst-bar />
                </span>
                <span class="tst-tl__label">
                  <span class="tst-tl__n">{i + 1}</span>
                  <span class="tst-tl__t">{s.short}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ol>
      <div class="tst__visual" data-reveal style="--d:3">
        <GradientVisual preset="teal" deco="none">
          <div class="ui tst-ui">
            <div class="tst-stage is-run" data-tst-stage data-s="1">
              <svg class="sc" viewBox="0 0 1100 440" preserveAspectRatio="xMidYMax meet" focusable="false">
                <g set:html={BACKDROP} />

                {/* Облака стоят там, где плашки шагов 1–5 их не перекрывают */}
                <g class="sc-cloud" fill="#fff">
                  <rect x="372" y="138" width="88" height="18" rx="9" />
                  <circle cx="394" cy="140" r="12" />
                  <circle cx="420" cy="133" r="16" />
                  <circle cx="442" cy="143" r="10" />
                </g>
                <g class="sc-cloud" fill="#fff">
                  <rect x="808" y="132" width="100" height="18" rx="9" />
                  <circle cx="832" cy="134" r="12" />
                  <circle cx="860" cy="127" r="15" />
                  <circle cx="884" cy="136" r="10" />
                </g>

                {/* Мусоровоз: в шаге 1 въезжает слева, колёса крутятся */}
                <g transform="translate(540 210)">
                  <g class="sc-truck">
                    <g set:html={TRUCK} />
                    {/* каретка подъёмника внизу заднего борта */}
                    <rect class="sc-carriage" x="-7" y="112" width="12" height="24" rx="3" fill="#57636e" />
                    {
                      WHEELS.map((cx) => (
                        <g transform={`translate(${cx} 150)`}>
                          <g class="sc-wheel">
                            <circle r="22" fill="#222a31" />
                            <circle r="10" fill="#8b97a2" />
                            <path d="M0-6v12M-6 0h12" stroke="#5d6873" stroke-width="2.6" stroke-linecap="round" />
                          </g>
                        </g>
                      ))
                    }
                    {
                      CAMS.map((c) => (
                        <g transform={`translate(${c.x} ${c.y})`}>
                          <circle class="sc-flash" r="24" style={`--t:${flashAt(c.n - 1)}s`} />
                          <circle r="6.5" fill="#fff" stroke="#8d9aa5" stroke-width="1.5" />
                          <circle r="3.4" fill="#006bff" />
                        </g>
                      ))
                    }
                  </g>
                </g>

                {/* Контейнеры — перед дорогой. Синий (k = 2) поднимает подъёмник в шаге 3 */}
                {
                  BINS.map((b, k) => (
                    <g class:list={['sc-bin', `sc-bin--${k}`, { 'sc-lift': k === 2 }]}>
                      <g class="sc-bags">
                        <ellipse cx={b.x + 17} cy={BIN_Y + 2} rx="12" ry="8" fill="#4d5a66" />
                        <ellipse cx={b.x + 38} cy={BIN_Y + 1} rx="13" ry="9" fill="#6b7884" />
                        <ellipse cx={b.x + 27} cy={BIN_Y - 3} rx="8" ry="6" fill="#3e4954" />
                      </g>
                      {/* полный контейнер не закрывается: крышка лежит на мешках */}
                      <rect
                        class="sc-lid-open"
                        x={b.x + 1}
                        y={BIN_Y - 5}
                        width="56"
                        height="6"
                        rx="2.5"
                        fill="#2b3a33"
                        transform={`rotate(-12 ${b.x + 1} ${BIN_Y + 1})`}
                      />
                      <g set:html={binBody(b.x, BIN_Y, b.color)} />
                      <rect
                        class="sc-lid-shut"
                        x={b.x - 1}
                        y={BIN_Y - 1}
                        width="60"
                        height="6"
                        rx="2.5"
                        fill="#2b3a33"
                        fill-opacity=".6"
                      />
                    </g>
                  ))
                }

                {/* Шаг 6: ИИ обводит контейнеры рамками и считает их */}
                <g class="sc-dets">
                  {
                    BINS.map((b, k) => (
                      <g class="sc-det" style={`--t:${(0.85 + k * 0.4).toFixed(2)}s`}>
                        <rect
                          x={b.x - 7}
                          y={BIN_Y - 12}
                          width="72"
                          height="76"
                          rx="8"
                          fill="#0fa86f"
                          fill-opacity=".1"
                          stroke="#0fa86f"
                          stroke-width="2.5"
                        />
                        <rect class="sc-det__tag" x={b.x - 7} y={BIN_Y - 12} width="22" height="21" rx="5" fill="#087a52" />
                        <text x={b.x + 4} y={BIN_Y + 3.5} text-anchor="middle" font-size="14" font-weight="650" fill="#fff">
                          {k + 1}
                        </text>
                      </g>
                    ))
                  }
                </g>
              </svg>

              {/* Плашки: адрес площадки, «Запись» в шаге 3 */}
              <div class="tst-hud">
                <span class="tst-loc">
                  <span class="tst-loc__in">
                    <Icon name="map-pin" size={14} strokeWidth={2.2} />
                    <span>ул. Садовая, 21</span>
                    <span class="tst-loc__t">08:42</span>
                  </span>
                </span>
                <span class="tst-rec">
                  <i />
                  <span>Запись</span>
                </span>
              </div>

              {/* Шаги 2–4: кадры с четырёх камер — «до», затем «после» (сцена скрыта от скринридера, alt пустой) */}
              <div class="tst-shots">
                {
                  SHOTS.map((s, k) => (
                    <span class="tst-shot" style={`--t:${shotAt(k)}s`}>
                      <span class="tst-shot__pop">
                        <img
                          src={photo(s.before)}
                          width="320"
                          height="180"
                          alt=""
                          loading="lazy"
                          decoding="async"
                          draggable="false"
                        />
                        <span class="tst-tag tst-tag--state">до</span>
                        <span class="tst-shot__after">
                          <img
                            src={photo(s.after)}
                            width="320"
                            height="180"
                            alt=""
                            loading="lazy"
                            decoding="async"
                            draggable="false"
                          />
                          <span class="tst-tag tst-tag--state">после</span>
                        </span>
                        <span class="tst-tag tst-tag--cam"><span class="tst-tag__k">{`Кам.${NB}`}</span>{k + 1}</span>
                        <span class="tst-shot__flash" />
                      </span>
                    </span>
                  ))
                }
                {/* на телефоне «до» и «после» не помещаются на кадрах — одна подпись под ними */}
                <span class="tst-shots__cap">
                  <span>до погрузки</span>
                  <span class="tst-shots__after">после погрузки</span>
                </span>
              </div>

              {/* Шаг 5: видео погрузок летят от камеры над подъёмником в облако, счётчик растёт */}
              <span class="tst-link" />
              {
                [0, 1, 2].map((k) => (
                  <span class="tst-vid" style={`--t:${(0.75 + k * 0.6).toFixed(2)}s`}>
                    <Icon name="play" size={11} strokeWidth={2.6} />
                  </span>
                ))
              }
              <div class="tst-cloud">
                <div class="tst-cloud__in">
                  <span class="tst-cloud__ico">
                    <Icon name="cloud-upload" size={20} strokeWidth={2} />
                  </span>
                  <span class="tst-cloud__txt">
                    <span class="tst-cloud__label">
                      Видео погрузок:{' '}
                      <span class="tst-num">
                        <b class="a-blip" style="--t:0s; --dur:1.6s">0</b>
                        <b class="a-blip" style="--t:1.6s; --dur:0.6s">1</b>
                        <b class="a-blip" style="--t:2.2s; --dur:0.6s">2</b>
                        <b class="a-pop" style="--t:2.8s">3</b>
                      </span>
                    </span>
                    <span class="tst-cloud__bar">
                      {[1.6, 2.2, 2.8].map((t) => <i class="a-fill" style={`--t:${t}s`} />)}
                    </span>
                  </span>
                </div>
              </div>

              {/* Шаг 6: итог видеоаналитики по площадке — сколько погружено против плана; под карточкой —
                  отдельное уведомление об аномалии за день: погрузка в другом месте, не на этой площадке */}
              <div class="tst-ai">
                <div class="tst-ai__in">
                  <p class="tst-ai__head">
                    <span class="tst-ai__ico">
                      <Icon name="ai-scan" size={15} strokeWidth={2} />
                    </span>
                    <b>ул. Садовая, 21</b>
                    <span class="tst-ai__by">посчитал ИИ</span>
                  </p>
                  <p class="tst-ai__row">
                    <span class="tst-ai__count">
                      Погружено:{' '}
                      <span class="tst-num">
                        <b class="a-blip" style="--t:0s; --dur:0.9s">0</b>
                        <b class="a-blip" style="--t:0.9s; --dur:0.4s">1</b>
                        <b class="a-blip" style="--t:1.3s; --dur:0.4s">2</b>
                        <b class="a-pop" style="--t:1.7s">3</b>
                      </span>
                    </span>
                    <span class="tst-ai__plan a-fade" style="--t:2.1s">· план 3</span>
                    <span class="tst-pill a-pop" style="--t:2.35s">
                      <Icon name="check" size={12} strokeWidth={3} />
                      Корректно
                    </span>
                  </p>
                </div>
                <p class="tst-ai__alert a-in" style="--t:2.9s">
                  <i class="tst-ai__dot" />
                  <span>СНТ «Рассвет» — погрузка вне плана</span>
                </p>
              </div>
            </div>
          </div>
        </GradientVisual>
        <span class="tag tag--demo tst__demo" aria-hidden="true">демо-данные</span>
      </div>
    </div>

    <p class="tst__cta" data-reveal>
      <a href="#forma" class="btn btn--primary" data-interest="tracker" data-goal="pilot_click">
        Запросить демо
        <Icon name="arrow-right" />
      </a>
    </p>
  </div>
</section>

<style>
  /* ── Плеер: сверху подпись активного шага, под ней шкала шагов, ниже широкая сцена ── */
  .tst__visual {
    position: relative;
    margin-top: clamp(22px, calc(var(--vw) * 2.4), 36px);
  }

  /* сверху полоса под «демо-данные» */
  .tst__visual :global(.gv) {
    min-height: 0;
    padding: 54px 36px 36px;
  }

  .tst__demo {
    position: absolute;
    z-index: 1;
    top: 14px;
    left: clamp(16px, calc(var(--vw) * 1.6), 22px);
    pointer-events: none;
  }

  /* ── Шкала: шесть отрезков; пройденные залиты, активный заполняется (он же часы автопрокрутки).
       Кнопки стоят вплотную — нажатие между отрезками не пропадает; зазор между полосами — поля кнопок
       (--tl-x с каждой стороны), а шкала выступает на них за края колонки, чтобы полосы шли от края до края ── */
  .tst-tl {
    --tl-x: 5px;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: clamp(14px, calc(var(--vw) * 1.6), 22px) calc(var(--tl-x) * -1) 0;
  }

  .tst-tl__btn {
    display: grid;
    align-content: start;
    gap: 11px;
    width: 100%;
    height: 100%;
    min-height: 48px;
    padding: 12px var(--tl-x) 8px;
    border: 0;
    border-radius: calc(10px * var(--rk));
    corner-shape: var(--corner);
    background: none;
    color: var(--muted);
    text-align: left;
  }

  /* рамка фокуса — по краю кнопки: соседние полосы не задевает */
  .tst-tl__btn:focus-visible {
    outline-offset: 0;
  }

  .tst-tl__track {
    display: block;
    height: 4px;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(29 29 31 / 0.1);
    transition: background-color 0.25s;
  }

  /* цвет Tracker, как у полосы пунктов «О системе» */
  .tst-tl__track i {
    display: block;
    height: 100%;
    background: var(--g-teal);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .tst-tl__item.is-done .tst-tl__track i {
    transform: none;
  }

  /* дорожка активного отрезка темнее: на паузе в самом начале он не сливается со следующими */
  .tst-tl__item.is-on .tst-tl__track {
    background-color: rgb(29 29 31 / 0.16);
  }

  /* когда отрезок заполнился, скрипт включает следующий шаг */
  .tst-tl__item.is-on .tst-tl__track i {
    animation: algo-progress var(--ms) linear both;
  }

  .tst__player[data-paused] .tst-tl__track i,
  .tst__player[data-idle] .tst-tl__track i {
    animation-play-state: paused;
  }

  @keyframes algo-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: none;
    }
  }

  .tst-tl__label {
    display: flex;
    gap: 7px;
    font-size: 15px;
    font-weight: 560;
    line-height: 1.3;
  }

  .tst-tl__n {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .tst-tl__t {
    transition: color 0.25s;
  }

  .tst-tl__item.is-on .tst-tl__t {
    color: var(--ink);
  }

  @media (hover: hover) {
    .tst-tl__btn:hover .tst-tl__t {
      color: var(--ink);
    }

    .tst-tl__btn:hover .tst-tl__track {
      background-color: rgb(29 29 31 / 0.16);
    }
  }

  /* ── Подпись активного шага: все шесть в одной клетке, видна одна ── */
  .tst-caps {
    display: grid;
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }

  /* подпись прижата к шкале под ней: запас высоты под самую длинную подпись — сверху, а не между подписью и шкалой */
  .tst-cap {
    grid-area: 1 / 1;
    align-self: end;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0s linear 0.2s;
  }

  .tst-cap.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.45s var(--ease-out) 0.12s,
      transform 0.6s var(--ease-out) 0.12s,
      visibility 0s;
  }

  .tst-cap__n {
    font-size: 15px;
    font-weight: 560;
    line-height: 1.3;
    color: var(--muted);
  }

  .tst-cap__t {
    margin-top: 6px;
    font-size: 26px;
    font-weight: 560;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .tst-cap__d {
    margin-top: 8px;
    font-size: 17px;
    line-height: 1.45;
    color: var(--muted);
  }

  /* ── Карточка со сценой ─────────────────────────────── */
  .tst-ui {
    container: tst-ui / inline-size;
    width: 100%;
    padding: 10px;
    border-radius: 22px;
  }

  /* Кадр — окно на сцену 1100×440: --sw единиц сцены по ширине, начиная с x = --x0; --k — высота кадра
     к ширине. Сцена прижата к низу (--top — где её верх): кадр выше сцены — сверху остаётся небо под плашки,
     ниже — срезан край пустого неба.
     --u — единица сцены в пикселях кадра: точка сцены (x, y) — это left: (x − --x0) · --u, top: --top + y · --u. */
  .tst-stage {
    --sw: 1100;
    --x0: 0;
    --k: 0.39;
    --u: calc(100cqw / var(--sw));
    --top: calc(var(--k) * 100cqw - 440 * var(--u));
    --pad: clamp(10px, 2cqw, 22px);
    --cloud-top: calc(var(--pad) + 12px);
    --cloud-y: calc(var(--cloud-top) + 28px);
    /* камера над подъёмником — точка сцены (550, 216): от неё видео летят в облако */
    --cam-x: calc((550 - var(--x0)) * var(--u));
    --cam-y: calc(var(--top) + 216 * var(--u));
    position: relative;
    aspect-ratio: 1 / var(--k);
    overflow: hidden;
    isolation: isolate;
    container-type: inline-size;
    border-radius: 14px;
    background: #e2eaf0;
    color: var(--ink);
    line-height: 1.3;
    text-align: left;
    -webkit-user-select: none;
    user-select: none;
  }

  /* шире кадра, когда окно — середина сцены: общий max-width: 100% у svg снят */
  .sc {
    position: absolute;
    left: calc(var(--x0) * var(--u) * -1);
    bottom: 0;
    width: calc(1100 * var(--u));
    max-width: none;
    height: calc(440 * var(--u));
  }

  /* ── Что видно на каждом шаге (переходы — между шагами, движение — ниже) ── */
  .tst-loc,
  .tst-rec,
  .tst-shots,
  .tst-cloud,
  .tst-ai,
  .sc-dets {
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .tst-rec,
  .tst-shots,
  .tst-ai,
  .sc-dets {
    opacity: 0;
  }

  .tst-rec {
    transform: scale(0.9);
  }

  .tst-shots {
    transform: translateY(8px);
  }

  .tst-cloud {
    opacity: 0;
    transform: translate(-50%, 8px);
  }

  .tst-ai {
    transform: translateY(-8px);
  }

  .tst-stage[data-s='6'] .tst-loc {
    opacity: 0;
    transform: translateY(-6px);
  }

  .tst-stage[data-s='3'] .tst-rec {
    opacity: 1;
    transform: none;
  }

  .tst-stage[data-s='2'] .tst-shots,
  .tst-stage[data-s='4'] .tst-shots {
    opacity: 1;
    transform: none;
  }

  /* пока идёт запись погрузки, кадры «до» отходят на второй план */
  .tst-stage[data-s='3'] .tst-shots {
    opacity: 0.4;
    transform: none;
  }

  .tst-stage[data-s='5'] .tst-cloud {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .tst-stage[data-s='6'] .tst-ai,
  .tst-stage[data-s='6'] .sc-dets {
    opacity: 1;
    transform: none;
  }

  /* мешки в контейнерах и открытая крышка — до погрузки; после — закрытая крышка */
  .sc-bags,
  .sc-lid-open {
    opacity: 0;
  }

  .tst-stage[data-s='1'] :is(.sc-bags, .sc-lid-open),
  .tst-stage[data-s='2'] :is(.sc-bags, .sc-lid-open) {
    opacity: 1;
  }

  .tst-stage[data-s='1'] .sc-lid-shut,
  .tst-stage[data-s='2'] .sc-lid-shut {
    opacity: 0;
  }

  /* «после»: слой поверх кадра «до»; остаётся и на шаге 5, пока кадры тают */
  .tst-shot__after {
    opacity: 0;
  }

  .tst-stage:is([data-s='4'], [data-s='5'], [data-s='6']) .tst-shot__after {
    opacity: 1;
  }

  /* ── Небо, мусоровоз и контейнеры ──────────────────── */
  .sc-cloud {
    opacity: 0.55;
    transition: opacity 0.35s;
  }

  /* на шаге 6 облака уходят: итог ИИ на телефоне во всю ширину и закрыл бы их наполовину */
  .tst-stage[data-s='6'] .sc-cloud {
    opacity: 0;
  }

  .sc-wheel,
  .sc-flash,
  .sc-det {
    transform-box: fill-box;
    transform-origin: center;
  }

  .sc-flash {
    fill: #fff;
    stroke: #4f9bff;
    stroke-width: 3;
    opacity: 0;
  }

  /* синий контейнер опрокидывается вокруг правого верхнего угла (координаты сцены) */
  .sc-lift {
    transform-box: view-box;
    transform-origin: 482px 342px;
  }

  /* ── Плашки поверх сцены ───────────────────────────── */
  .tst-hud {
    position: absolute;
    z-index: 3;
    left: var(--pad);
    top: var(--pad);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .tst-loc__in,
  .tst-rec {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    border-radius: 999px;
    font-size: clamp(12px, 2.05cqw, 13px);
    font-weight: 560;
    white-space: nowrap;
  }

  .tst-loc {
    display: block;
  }

  .tst-loc__in {
    padding: 0 11px 0 8px;
    background: #fff;
    box-shadow: 0 6px 16px -10px rgb(29 29 31 / 0.45);
  }

  .tst-loc__t {
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .tst-rec {
    padding: 0 11px 0 9px;
    background: #fde8ea;
    color: #b8283a;
    transform-origin: left center;
  }

  .tst-rec i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  /* Кадры с камер над машиной */
  .tst-shots {
    position: absolute;
    z-index: 2;
    right: var(--pad);
    top: var(--pad);
    display: flex;
    gap: calc(12 * var(--u));
  }

  .tst-shot {
    display: block;
    width: calc(118 * var(--u));
    aspect-ratio: 16 / 10;
  }

  .tst-shot__pop {
    --r: 8px;
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: var(--r);
    background: #dbe5eb;
    box-shadow:
      0 0 0 2px #fff,
      0 10px 20px -12px rgb(29 29 31 / 0.5);
  }

  /* снимок камеры заполняет кадр без растяжения: края 16:9 чуть обрезаны до 16:10.
     Свой радиус у снимка и вспышки — на случай, если слой с анимацией прозрачности выйдет из-под обрезки */
  .tst-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r);
  }

  .tst-shot__after {
    position: absolute;
    inset: 0;
  }

  .tst-tag {
    position: absolute;
    left: 4px;
    padding: 1px 5px;
    border-radius: 4px;
    background: rgb(29 29 31 / 0.62);
    color: #fff;
    font-size: clamp(11px, 1.8cqw, 12px);
    font-weight: 500;
    line-height: 1.35;
    white-space: nowrap;
  }

  .tst-tag--cam {
    top: 4px;
  }

  .tst-tag--state {
    bottom: 4px;
  }

  /* подпись «до/после погрузки» под кадрами — только на телефоне */
  .tst-shots__cap {
    display: none;
  }

  .tst-shot__flash {
    position: absolute;
    inset: 0;
    border-radius: var(--r);
    background: #fff;
    opacity: 0;
  }

  /* Видео погрузок: от камеры над подъёмником вверх по пунктиру, под карточку облака */
  .tst-link {
    position: absolute;
    z-index: 1;
    left: calc(var(--cam-x) - 1px);
    top: var(--cloud-y);
    width: 2px;
    height: calc(var(--cam-y) - 9px - var(--cloud-y));
    background: repeating-linear-gradient(180deg, #6bb1ff 0 5px, transparent 5px 10px);
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }

  .tst-stage[data-s='5'] .tst-link {
    opacity: 1;
  }

  .tst-vid {
    --vy: calc(var(--cloud-y) - var(--cam-y));
    position: absolute;
    z-index: 2;
    left: calc(var(--cam-x) - 15px);
    top: calc(var(--cam-y) - 10px);
    display: grid;
    place-items: center;
    width: 30px;
    height: 20px;
    border-radius: 5px;
    background: #2b3640;
    color: #fff;
    opacity: 0;
  }

  .tst-cloud {
    position: absolute;
    z-index: 3;
    left: 50cqw;
    top: var(--cloud-top);
  }

  .tst-cloud__in {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px 9px 9px;
    border-radius: 15px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(29 29 31 / 0.04),
      0 14px 28px -14px rgb(29 29 31 / 0.45);
    white-space: nowrap;
  }

  .tst-cloud__ico {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 11px;
    background: #e8f1ff;
    color: #006bff;
  }

  .tst-cloud__txt {
    display: grid;
    gap: 6px;
  }

  .tst-cloud__label {
    font-size: clamp(12px, 2.2cqw, 14px);
    font-weight: 560;
  }

  .tst-cloud__bar {
    display: flex;
    gap: 4px;
  }

  /* три деления — по одному на видео; деление заливается, когда видео пришло */
  .tst-cloud__bar i {
    position: relative;
    width: 26px;
    height: 5px;
    overflow: hidden;
    border-radius: 3px;
    background: #e3e8ee;
  }

  .tst-cloud__bar i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #006bff;
    transform-origin: left center;
  }

  /* числа, которые сменяют друг друга в одной клетке; без движения видно последнее */
  .tst-num {
    display: inline-grid;
    font-variant-numeric: tabular-nums;
  }

  .tst-num > b {
    grid-area: 1 / 1;
    font-weight: 650;
  }

  .a-blip {
    opacity: 0;
  }

  /* Итог видеоаналитики: карточка площадки и под ней уведомление */
  .tst-ai {
    position: absolute;
    z-index: 3;
    left: var(--pad);
    top: var(--pad);
    display: grid;
    gap: 8px;
    width: min(340px, 58cqw);
    font-size: clamp(12px, 2.1cqw, 13px);
  }

  .tst-ai__in {
    display: grid;
    gap: 7px;
    padding: 11px;
    border-radius: 16px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(29 29 31 / 0.04),
      0 16px 32px -16px rgb(29 29 31 / 0.45);
  }

  .tst-ai__head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 2px 2px;
  }

  .tst-ai__head b {
    font-weight: 600;
    white-space: nowrap;
  }

  .tst-ai__ico {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 8px;
    background: #e8f1ff;
    color: #0b56c4;
  }

  .tst-ai__by {
    margin-left: auto;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .tst-ai__row {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 6px 8px 6px 10px;
    border-radius: 11px;
    background: #f5f6f8;
  }

  .tst-ai__count {
    font-weight: 560;
    white-space: nowrap;
  }

  .tst-ai__plan {
    color: var(--muted);
    white-space: nowrap;
  }

  .tst-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: none;
    height: 24px;
    margin-left: auto;
    padding: 0 9px;
    border-radius: 999px;
    background: #e1f5ec;
    color: #087a52;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  /* уведомление в духе оповещения на первом экране: белая плашка с красной обводкой */
  .tst-ai__alert {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 36px;
    padding: 7px 13px 7px 12px;
    border-radius: 12px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(229 72 77 / 0.26),
      0 14px 28px -14px rgb(29 29 31 / 0.45);
    color: #9e1f30;
    font-weight: 560;
  }

  .tst-ai__dot {
    position: relative;
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: #e5484d;
  }

  .tst-ai__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #e5484d;
    opacity: 0;
  }

  /* ── Движение шага: идёт, пока у кадра класс is-run (скрипт снимает и ставит его при смене шага).
       Без движения у каждого элемента виден итог шага. ── */

  /* 1. Машина въезжает слева через весь кадр и останавливается у площадки; колёса крутятся в такт */
  .is-run[data-s='1'] .sc-truck {
    animation: algo-drive 2.6s cubic-bezier(0.3, 0.55, 0.25, 1) 0.15s both;
  }

  .is-run[data-s='1'] .sc-wheel {
    animation: algo-roll 2.6s cubic-bezier(0.3, 0.55, 0.25, 1) 0.15s both;
  }

  .is-run[data-s='1'] :is(.sc-bags, .sc-lid-open) {
    animation: algo-fade 0.5s ease both;
  }

  .is-run[data-s='1'] .tst-loc__in {
    animation: algo-pop 0.45s cubic-bezier(0.2, 1.5, 0.4, 1) 2.65s both;
  }

  /* 2 и 4. Камеры по очереди делают снимок — вспышка, следом всплывает или меняется кадр */
  .is-run:is([data-s='2'], [data-s='4']) .sc-flash {
    animation: algo-flash 0.75s ease-out both;
    animation-delay: var(--t);
  }

  /* белеет только в момент снимка: до своей очереди кадр «до» виден целиком */
  .is-run:is([data-s='2'], [data-s='4']) .tst-shot__flash {
    animation: algo-shot-flash 0.5s ease-out;
    animation-delay: var(--t);
  }

  .is-run[data-s='2'] .tst-shot__pop {
    animation: algo-pop 0.45s cubic-bezier(0.2, 1.4, 0.4, 1) both;
    animation-delay: var(--t);
  }

  .is-run[data-s='4'] .tst-shot__after {
    animation: algo-fade 0.3s ease both;
    animation-delay: var(--t);
  }

  /* 3. Запись: подъёмник берёт синий контейнер, опрокидывает его в кузов и возвращает пустым;
        следом пустеют и два зелёных */
  .is-run[data-s='3'] .tst-rec i {
    animation: algo-blink 1.2s ease-in-out infinite;
  }

  .is-run[data-s='3'] .sc-lift {
    animation: algo-lift 2.6s ease-in-out 0.4s both;
  }

  .is-run[data-s='3'] .sc-carriage {
    animation: algo-carriage 2.6s ease-in-out 0.4s both;
  }

  .is-run[data-s='3'] .sc-lift .sc-bags {
    animation: algo-out 0.3s ease 1.75s both;
  }

  /* крышка откидывается, как только подъёмник взял контейнер, и закрывается, когда он вернулся */
  .is-run[data-s='3'] .sc-lift .sc-lid-open {
    animation: algo-out 0.2s ease 0.8s both;
  }

  .is-run[data-s='3'] .sc-lift .sc-lid-shut {
    animation: algo-fade 0.2s ease 2.9s both;
  }

  .is-run[data-s='3'] .sc-bin--1 :is(.sc-bags, .sc-lid-open) {
    animation: algo-out 0.35s ease 3.25s both;
  }

  .is-run[data-s='3'] .sc-bin--1 .sc-lid-shut {
    animation: algo-fade 0.35s ease 3.25s both;
  }

  .is-run[data-s='3'] .sc-bin--0 :is(.sc-bags, .sc-lid-open) {
    animation: algo-out 0.35s ease 3.55s both;
  }

  .is-run[data-s='3'] .sc-bin--0 .sc-lid-shut {
    animation: algo-fade 0.35s ease 3.55s both;
  }

  /* 5. Видео уходят в облако, счётчик и полоска растут по мере прихода */
  .is-run[data-s='5'] .tst-vid {
    animation: algo-vid 1s cubic-bezier(0.45, 0, 0.3, 1) both;
    animation-delay: var(--t);
  }

  .is-run[data-s='5'] .tst-cloud .a-fill::after {
    animation: algo-fill 0.35s var(--ease-out) both;
    animation-delay: var(--t);
  }

  /* 6. ИИ обводит контейнеры и считает их, сверяет с планом и находит погрузку вне плана */
  .is-run[data-s='6'] .sc-det {
    animation: algo-pop 0.5s cubic-bezier(0.2, 1.4, 0.4, 1) both;
    animation-delay: var(--t);
  }

  .is-run[data-s='6'] .tst-ai__dot::after {
    animation: algo-ping 1.2s ease-out 3.2s 2;
  }

  .is-run[data-s='5'] .tst-cloud .a-blip,
  .is-run[data-s='6'] .tst-ai .a-blip {
    animation: algo-blip var(--dur) linear forwards;
    animation-delay: var(--t);
  }

  .is-run[data-s='5'] .tst-cloud .a-pop,
  .is-run[data-s='6'] .tst-ai .a-pop {
    animation: algo-pop 0.45s cubic-bezier(0.2, 1.5, 0.4, 1) both;
    animation-delay: var(--t);
  }

  .is-run[data-s='6'] .tst-ai .a-fade {
    animation: algo-fade 0.4s ease both;
    animation-delay: var(--t);
  }

  .is-run[data-s='6'] .tst-ai .a-in {
    animation: algo-in 0.5s var(--ease-out) both;
    animation-delay: var(--t);
  }

  /* старт — за левым краем широкого кадра */
  @keyframes algo-drive {
    from {
      transform: translateX(-920px);
    }
  }

  /* 920 / (2π · 22) ≈ 6,66 оборота — колёса катятся, а не скользят */
  @keyframes algo-roll {
    from {
      transform: rotate(-2396deg);
    }
  }

  @keyframes algo-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes algo-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes algo-pop {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
  }

  @keyframes algo-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes algo-flash {
    0% {
      opacity: 0;
      transform: scale(0.25);
    }
    12% {
      opacity: 0.95;
    }
    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  @keyframes algo-shot-flash {
    from {
      opacity: 0.9;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes algo-blink {
    50% {
      opacity: 0.25;
    }
  }

  /* подкатить к подъёмнику → поднять вдоль скошенного борта → опрокинуть (с встряской) → опустить → откатить */
  @keyframes algo-lift {
    0% {
      transform: none;
    }
    14% {
      transform: translate(52px, -8px);
    }
    40% {
      transform: translate(68px, -76px);
    }
    52% {
      transform: translate(68px, -76px) rotate(125deg);
    }
    58% {
      transform: translate(68px, -76px) rotate(116deg);
    }
    64% {
      transform: translate(68px, -76px) rotate(125deg);
    }
    76% {
      transform: translate(68px, -76px) rotate(0deg);
    }
    90% {
      transform: translate(52px, -8px);
    }
    100% {
      transform: none;
    }
  }

  @keyframes algo-carriage {
    0%,
    14% {
      transform: none;
    }
    40%,
    76% {
      transform: translate(10px, -68px);
    }
    90%,
    100% {
      transform: none;
    }
  }

  @keyframes algo-vid {
    0% {
      opacity: 0;
      transform: translateY(0) scale(0.5);
    }
    14% {
      opacity: 1;
      transform: translateY(-2.5cqw) scale(1);
    }
    82% {
      opacity: 1;
      transform: translateY(var(--vy)) scale(0.85);
    }
    100% {
      opacity: 0;
      transform: translateY(var(--vy)) scale(0.6);
    }
  }

  @keyframes algo-fill {
    from {
      transform: scaleX(0);
    }
  }

  /* промежуточное число видно только во время своей анимации */
  @keyframes algo-blip {
    0%,
    99.9% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes algo-ping {
    from {
      opacity: 0.55;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  /* за экраном и на скрытой вкладке движение стоит (data-idle снимает скрипт) */
  .tst__player[data-idle] .tst-stage *,
  .tst__player[data-idle] .tst-stage *::after {
    animation-play-state: paused !important;
  }

  @media (scripting: none) {
    .tst__player[data-idle] .tst-stage *,
    .tst__player[data-idle] .tst-stage *::after,
    .tst__player[data-idle] .tst-tl__track i {
      animation-play-state: running !important;
    }
  }

  /* Без движения: шаги переключаются только нажатием, сцена сразу показывает итог шага, на шкале залиты
     пройденные шаги и активный. Шаг 3 — главный кадр погрузки: синий контейнер опрокинут над кузовом,
     зелёные ещё полные. */
  @media (prefers-reduced-motion: reduce) {
    .tst-stage *,
    .tst-stage *::after,
    .tst-tl__track i {
      animation: none !important;
    }

    .tst-tl__item.is-on .tst-tl__track i {
      transform: none;
    }

    .tst-cap {
      transform: none;
    }

    .tst-stage[data-s='3'] .sc-lift {
      transform: translate(68px, -76px) rotate(125deg);
    }

    .tst-stage[data-s='3'] .sc-carriage {
      transform: translate(10px, -68px);
    }

    .tst-stage[data-s='3'] :is(.sc-bin--0, .sc-bin--1) :is(.sc-bags, .sc-lid-open) {
      opacity: 1;
    }

    .tst-stage[data-s='3'] :is(.sc-bin--0, .sc-bin--1, .sc-lift) .sc-lid-shut {
      opacity: 0;
    }
  }

  /* ── Кадр уже 860 px: окно на середину сцены (площадка с машиной и немного улицы), сверху полоса неба ── */
  @container tst-ui (max-width: 860px) {
    .tst-stage {
      --sw: 860;
      --x0: 144;
      --k: 0.55;
    }
  }

  /* ── Узкая карточка: кадр — площадка с машиной, сверху небо под плашки. Адрес и «Запись» — в строку,
       кадры с камер и облако — под ними (у облака 56 px высоты, середина — на 28 px ниже верха) ── */
  @container tst-ui (max-width: 600px) {
    .tst-stage {
      --sw: 720;
      --x0: 214;
      --k: 0.74;
      --pad: 2.8cqw;
      --cloud-top: calc(var(--pad) + 36px);
    }

    .tst-hud {
      flex-direction: row;
    }

    .tst-loc__in,
    .tst-rec {
      height: 26px;
    }

    .tst-shots {
      left: var(--pad);
      top: calc(var(--pad) + 36px);
      gap: 1.5cqw;
    }

    .tst-shot {
      flex: 1 1 0;
      width: auto;
    }
  }

  @container tst-ui (max-width: 460px) {
    .tst-stage {
      --k: 0.84;
      --pad: 2.6cqw;
    }

    .tst-ai {
      right: var(--pad);
      width: auto;
    }

    /* итог ИИ плотнее: не заходит на крышу машины */
    .tst-ai__in {
      gap: 6px;
      padding: 9px;
    }

    .tst-ai__row {
      min-height: 30px;
      padding: 5px 7px 5px 9px;
    }

    .tst-ai__alert {
      min-height: 32px;
      padding: 6px 11px 6px 10px;
    }

    .tst-ai__ico {
      width: 24px;
      height: 24px;
    }

    /* на телефоне цифры в рамках ИИ мельче текста — оставляем одни рамки, без плашек номеров */
    .sc-det text,
    .sc-det__tag {
      display: none;
    }

    /* кадр с камеры не шире 105 px: на нём только номер камеры, «до» и «после» — подписью под кадрами */
    .tst-tag {
      font-size: 12px;
    }

    .tst-tag__k,
    .tst-tag--state {
      display: none;
    }

    .tst-shots__cap {
      position: absolute;
      left: 0;
      top: calc(100% + 6px);
      display: grid;
    }

    .tst-shots__cap > span {
      grid-area: 1 / 1;
      justify-self: start;
      padding: 1px 6px;
      border-radius: 4px;
      background: rgb(29 29 31 / 0.62);
      color: #fff;
      font-size: 12px;
      font-weight: 500;
      line-height: 1.35;
      white-space: nowrap;
      transition: opacity 0.3s;
    }

    .tst-shots__after,
    .tst-stage:is([data-s='4'], [data-s='5'], [data-s='6']) .tst-shots__cap > :first-child {
      opacity: 0;
    }

    .tst-stage:is([data-s='4'], [data-s='5'], [data-s='6']) .tst-shots__after {
      opacity: 1;
    }
  }

  /* ── Кнопка под сценой ─────────────────────────────── */
  .tst__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(28px, calc(var(--vw) * 2.8), 40px);
  }

  /* ── Уже 1200 px: всё то же, уже; поля градиента вокруг сцены — от ширины окна ── */
  @media (max-width: 1199.98px) {
    .tst__visual :global(.gv) {
      padding: 54px clamp(14px, calc(var(--vw) * 3.4), 36px) clamp(14px, calc(var(--vw) * 3.4), 36px);
    }

    .tst-tl {
      --tl-x: 4px;
    }

    .tst-tl__label {
      font-size: 14px;
    }

    .tst-cap__t {
      font-size: 24px;
    }
  }

  /* на узкой шкале подписи отрезков не помещаются — только номера; название шага — в подписи над шкалой */
  @media (max-width: 719.98px) {
    .tst-tl {
      --tl-x: 3px;
    }

    .tst-tl__t {
      display: none;
    }

    .tst-tl__item.is-on .tst-tl__n {
      color: var(--ink);
      font-weight: 600;
    }
  }

  @media (max-width: 560px) {
    .tst__visual :global(.gv) {
      padding: 46px 8px 10px;
    }

    .tst__demo {
      top: 13px;
      left: 14px;
    }

    .tst-ui {
      padding: 6px;
      border-radius: 18px;
      box-shadow:
        0 0 0 6px rgb(255 255 255 / 0.4),
        var(--shadow-card);
    }

    .tst-stage {
      border-radius: 12px;
    }

    .tst-tl__btn {
      padding: 14px var(--tl-x) 10px;
    }

    .tst-cap__n {
      font-size: 14px;
    }

    .tst-cap__t {
      font-size: 20px;
      line-height: 1.3;
    }

    .tst-cap__d {
      margin-top: 6px;
      font-size: 15px;
    }

    .tst__cta .btn {
      width: 100%;
    }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Шаги идут сами: следующий включается, когда отрезок активного шага на шкале заполнился.
  // Шкала и сцена стоят, пока сцена за экраном или вкладка скрыта; шкала стоит, пока курсор над плеером
  // (сцена, шкала, подпись) или в шкале фокус с клавиатуры. Нажатый отрезок сразу показывается в сцене;
  // стрелки влево и вправо, Home и End переходят по шагам. При «уменьшить движение» шаги переключаются
  // только нажатием.
  const root = document.querySelector<HTMLElement>('[data-tst]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-tst-stage]')!;
    const list = root.querySelector<HTMLElement>('[data-tst-list]')!;
    const items = [...list.querySelectorAll<HTMLElement>(':scope > li')];
    const buttons = items.map((li) => li.querySelector<HTMLButtonElement>('button')!);
    const bars = items.map((li) => li.querySelector<HTMLElement>('[data-tst-bar]')!);
    const caps = [...root.querySelectorAll<HTMLElement>('[data-tst-cap]')];
    let index = 0;
    let inView = false;
    let hover = false;
    let focus = false;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      items.forEach((li, k) => {
        li.classList.toggle('is-on', k === index);
        li.classList.toggle('is-done', k < index);
      });
      buttons.forEach((btn, k) => {
        if (k === index) btn.setAttribute('aria-current', 'step');
        else btn.removeAttribute('aria-current');
      });
      caps.forEach((cap, k) => cap.classList.toggle('is-on', k === index));
      // движение шага и отрезок начинаются заново, даже если нажат тот же шаг
      stage.classList.remove('is-run');
      stage.dataset.s = String(index + 1);
      bars[index].style.animation = 'none';
      void stage.offsetWidth;
      bars[index].style.animation = '';
      stage.classList.add('is-run');
    };

    const sync = () => {
      root.toggleAttribute('data-idle', !inView || document.hidden);
      root.toggleAttribute('data-paused', hover || focus);
    };

    // фокус после щелчка мышью паузу не ставит — только переход с клавиатуры
    const byKeyboard = (el: EventTarget | null) => {
      try {
        return el instanceof Element && el.matches(':focus-visible');
      } catch {
        return true;
      }
    };

    // шаг нажат, а сцена (она под шкалой) ушла под шапку или ниже края окна — подтягиваем её в окно
    // (отступ под шапку даёт scroll-padding-top у html, плавность — scroll-behavior: при «уменьшить движение» сразу)
    const visual = root.querySelector<HTMLElement>('.tst__visual')!;
    const header = document.querySelector<HTMLElement>('[data-hdr]');
    const reveal = () => {
      const top = header ? header.getBoundingClientRect().bottom : 0;
      const r = stage.getBoundingClientRect();
      if (r.top < top || r.bottom > innerHeight) visual.scrollIntoView({ block: 'nearest' });
    };

    buttons.forEach((btn, k) =>
      btn.addEventListener('click', () => {
        show(k);
        reveal();
      }),
    );
    list.addEventListener('keydown', (e) => {
      const k = buttons.indexOf(e.target as HTMLButtonElement);
      if (k < 0) return;
      const to =
        e.key === 'ArrowRight' ? k + 1
        : e.key === 'ArrowLeft' ? k - 1
        : e.key === 'Home' ? 0
        : e.key === 'End' ? items.length - 1
        : null;
      if (to === null) return;
      e.preventDefault();
      const next = (to + items.length) % items.length;
      buttons[next].focus();
      show(next);
      reveal();
    });
    bars.forEach((bar) =>
      bar.addEventListener('animationend', (e) => {
        if (e.target === bar && !reducedMotion()) show(index + 1);
      }),
    );
    root.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      hover = true;
      sync();
    });
    root.addEventListener('pointerleave', () => {
      hover = false;
      sync();
    });
    list.addEventListener('focusin', (e) => {
      focus = byKeyboard(e.target);
      sync();
    });
    list.addEventListener('focusout', (e) => {
      if (list.contains(e.relatedTarget as Node | null)) return;
      focus = false;
      sync();
    });
    document.addEventListener('visibilitychange', sync);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          sync();
        },
        { threshold: 0.35 },
      ).observe(stage);
    } else {
      inView = true;
      sync();
    }
  }
</script>
