---
// Раздел 5 страницы «QODEX Tracker» [#algoritm] — «Алгоритм работы».
// Физический процесс рассказан одной сценой, а не шестью карточками: мусоровоз сбоку (рисунок в духе
// кадров с камер на главной) приезжает на площадку, четыре камеры снимают её до и после погрузки,
// подъёмник опорожняет контейнер под запись, видео уходят в облако, ИИ считает контейнеры и находит
// аномалию. Слева шесть шагов с полосой прогресса: шаги идут сами, пока сцена на экране; нажатый шаг
// сразу показывается в сцене. Сцену скринридер не читает (aria-hidden ставит GradientVisual) — смысл
// несёт список. Без анимации («уменьшить движение») сцена показывает итог выбранного шага.
// Кадры «до» и «после», что всплывают над машиной, — настоящие снимки камер с прежнего лендинга.
import SectionIntro from '../../components/SectionIntro.astro';
import GradientVisual from '../../components/GradientVisual.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../config/site';

const NB = String.fromCharCode(160); // неразрывный пробел

// Шаги — с лендинга tracker.qodex.tech дословно: заголовок шага и, если есть, текст.
// ms — сколько шаг идёт при автопрокрутке: движение сцены и пауза после него
const STEPS: { title: string; text?: string; ms: number }[] = [
  { title: 'Машина прибывает на контейнерную площадку', ms: 4400 },
  { title: 'Фото до погрузки', text: `Фотографируем на все 4${NB}камеры`, ms: 4200 },
  { title: 'Видеонаблюдение за процессом загрузки', text: 'Запись погрузки', ms: 5200 },
  { title: 'Фото после погрузки', text: `Фотографируем на все 4${NB}камеры`, ms: 4200 },
  { title: 'Отправка видеозаписей всех опорожнений контейнеров в облако в процессе рабочего дня', ms: 4600 },
  { title: 'Видеоаналитика с помощью ИИ и поиск аномалий', ms: 5600 },
];

// ── Сцена 720×440 (рисунок, не фото). Небо уходит вверх с запасом: на телефоне кадр выше сцены,
//    сцена стоит внизу, а над ней — место для плашек. ──
const POSTS = Array.from({ length: 16 }, (_, i) => `M${20 + i * 46} 206v56`).join('');

const BACKDROP =
  `<rect x="-40" y="-560" width="800" height="1000" fill="#e2eaf0"/>` +
  // деревья и дома вдали, за забором
  `<circle cx="70" cy="184" r="30" fill="#d2dce3"/><circle cx="124" cy="196" r="22" fill="#d6e0e6"/>` +
  `<circle cx="414" cy="184" r="26" fill="#d2dce3"/>` +
  `<rect x="468" y="150" width="104" height="60" fill="#d6dfe6"/><path d="M456 154 520 114l64 40Z" fill="#c8d3db"/>` +
  `<rect x="508" y="164" width="22" height="20" rx="2" fill="#c9d4dc"/>` +
  `<rect x="604" y="164" width="98" height="46" fill="#d3dde4"/><path d="M592 168l61-36 61 36Z" fill="#c5d0d8"/>` +
  `<rect x="642" y="176" width="20" height="18" rx="2" fill="#c7d2da"/>` +
  // забор, дорога с разметкой, бордюр, тротуар с плитой площадки
  `<rect y="206" width="720" height="56" fill="#ccd6dd"/><path d="M0 217H720${POSTS}" stroke="#bac5cd" stroke-width="2"/>` +
  `<rect y="262" width="720" height="126" fill="#c3ccd4"/>` +
  `<path d="M0 324H720" stroke="#fff" stroke-opacity=".5" stroke-width="3" stroke-dasharray="28 24"/>` +
  `<rect y="386" width="720" height="8" fill="#aab5be"/><rect y="394" width="720" height="46" fill="#d1d9df"/>` +
  `<rect x="34" y="394" width="262" height="14" rx="3" fill="#bcc6cd"/>`;

// Мусоровоз сбоку, кабиной вправо. Свои координаты: задний борт — x 0, крыша кузова — y 0,
// низ колёс — y 172. На сцене стоит у площадки: translate(326 210).
const TRUCK =
  // задний борт со скошенной стенкой, бункер внизу, гидроцилиндр
  `<path d="M60 2H38q-8 0-11 7L4 90q-3 8 0 15l3 10q2 5 8 5h45Z" fill="#8f9ca7"/>` +
  `<path d="M33 16 12 88" stroke="#7f8c97" stroke-width="2"/>` +
  `<path d="M45 24 39 80" stroke="#6f7c88" stroke-width="4" stroke-linecap="round"/>` +
  `<path d="M6 98h24v22H14q-4 0-5-4l-4-11q-1-4 1-7Z" fill="#76838e"/>` +
  `<rect x="11" y="72" width="5" height="11" rx="1.5" fill="#e5484d"/>` +
  // кузов
  `<rect x="58" width="196" height="126" rx="12" fill="#eef2f5" stroke="#cdd5de" stroke-width="2"/>` +
  `<path d="M104 10v106M150 10v106M196 10v106" stroke="#dce3e9" stroke-width="3"/>` +
  `<rect x="59" y="78" width="194" height="13" fill="#a8ddd7"/>` +
  // кабина
  `<path d="M254 128V42q0-16 16-16h48q9 0 13 7l21 37q4 7 4 15v43Z" fill="#f4f6f9" stroke="#cdd5de" stroke-width="2"/>` +
  `<path d="M268 38h46q5 0 8 5l17 28q2 4-3 4h-68q-3 0-3-3V41q0-3 3-3Z" fill="#9fb3c6"/>` +
  `<path d="M282 72 302 40h12l-20 32Z" fill="#fff" fill-opacity=".3"/>` +
  `<path d="M300 84v38" stroke="#dbe2e8" stroke-width="2"/><rect x="306" y="90" width="12" height="3.5" rx="1.75" fill="#b9c4cc"/>` +
  `<path d="M347 58h11" stroke="#6f7c88" stroke-width="3"/><rect x="356" y="46" width="5" height="24" rx="2" fill="#6f7c88"/>` +
  `<rect x="350" y="98" width="8" height="12" rx="2" fill="#fff3c4"/>` +
  // рама, бак, арки колёс, ступенька, бампер
  `<rect x="6" y="122" width="350" height="14" rx="4" fill="#45505b"/>` +
  `<rect x="186" y="128" width="46" height="18" rx="5" fill="#6f7c88"/>` +
  `<path d="M67 150a27 27 0 0 1 54 0ZM119 150a27 27 0 0 1 54 0ZM279 150a27 27 0 0 1 54 0Z" fill="#45505b"/>` +
  `<rect x="250" y="132" width="24" height="6" rx="2" fill="#6f7c88"/>` +
  `<rect x="336" y="118" width="28" height="18" rx="4" fill="#57636e"/>`;

const WHEELS = [94, 146, 306];

// Четыре камеры слева направо: над подъёмником, на крыше кузова, на крыше кабины, над лобовым стеклом.
// n — номер камеры, как на всей странице: 1 спереди, 2 слева, 3 справа, 4 сзади (над подъёмником)
const CAMS = [
  { x: 10, y: 6, n: 4 },
  { x: 150, y: 0, n: 3 },
  { x: 268, y: 26, n: 2 },
  { x: 334, y: 38, n: 1 },
];

// Контейнеры на площадке: два зелёных и синий — его поднимает подъёмник. x — левый край, BIN_Y — верх
const BINS = [
  { x: 50, color: '#3f8a6c' },
  { x: 130, color: '#3f8a6c' },
  { x: 210, color: '#4a76ad' },
];
const BIN_Y = 340;

// Корпус контейнера с ободом и колёсами (крышка и мешки — отдельно: они меняются по шагам)
const binBody = (x: number, y: number, color: string) =>
  `<path d="M${x + 2} ${y + 6}h54l-4.4 40.2a4 4 0 0 1-4 3.6H${x + 10.4}a4 4 0 0 1-4-3.6Z" fill="${color}"/>` +
  `<rect x="${x}" y="${y + 3}" width="58" height="6" rx="2.5" fill="${color}"/>` +
  `<rect x="${x}" y="${y + 3}" width="58" height="6" rx="2.5" fill="#000" fill-opacity=".12"/>` +
  `<path d="M${x + 20} ${y + 15}v27M${x + 29} ${y + 15}v27M${x + 38} ${y + 15}v27" stroke="#000" stroke-opacity=".14" stroke-width="2.4" stroke-linecap="round"/>` +
  `<circle cx="${x + 15}" cy="${y + 54}" r="4.6" fill="#26313a"/><circle cx="${x + 43}" cy="${y + 54}" r="4.6" fill="#26313a"/>`;

// ── Кадры с камер «до» и «после» — снимки с прежнего лендинга (служебные надписи размыты, людей нет),
//    по номерам камер. Спереди и слева после погрузки вид тот же. Справа — площадка (машина стоит к ней
//    правым бортом; этот кадр — «Кам. 3 · 08:42» и в «О системе»), над подъёмником — контейнер: «после»
//    они пустые. Миниатюры 320×180: кадр на странице не шире 100 px ──
const SHOTS = [
  { before: 'thumb-cam-front', after: 'thumb-cam-front' },
  { before: 'thumb-cam-left', after: 'thumb-cam-left' },
  { before: 'thumb-cam-b-before', after: 'thumb-cam-b-after' },
  { before: 'thumb-cam-a-before', after: 'thumb-cam-a-after' },
];
const photo = (name: string) => withBase(`/media/tracker/${name}.webp`);

// Вспышки камер и кадры: вспышка — снимок сделан, следом всплывает кадр этой камеры.
// Кадры идут по номерам, поэтому вспышки бегут от кабины к подъёмнику
const flashAt = (k: number) => (0.35 + k * 0.45).toFixed(2);
const shotAt = (k: number) => (0.43 + k * 0.45).toFixed(2);
---

<section class="section panel tst" id="algoritm" aria-labelledby="algoritm-title">
  <div class="container">
    <SectionIntro eyebrow="Как это работает" titleId="algoritm-title">Алгоритм работы</SectionIntro>

    <div class="tst__row" data-tst data-idle>
      <ol class="tst__list" data-tst-list data-reveal style="--d:2">
        {
          STEPS.map((s, i) => (
            <li class:list={['tst-step', { 'is-on': i === 0 }]} style={`--ms:${s.ms}ms`}>
              <h3 class="tst-step__h">
                <button class="tst-step__btn" type="button" aria-current={i === 0 ? 'step' : undefined}>
                  <span class="tst-step__n">{`Шаг${NB}${i + 1}`}</span>
                  <span class="tst-step__t">{s.title}</span>
                </button>
              </h3>
              {s.text && <p class="tst-step__d">{s.text}</p>}
              <span class="tst-step__bar" aria-hidden="true">
                <i data-tst-bar />
              </span>
            </li>
          ))
        }
      </ol>

      <div class="tst__visual" data-reveal style="--d:1">
        <GradientVisual preset="teal" deco="none">
          <div class="ui tst-ui">
            <div class="tst-stage is-run" data-tst-stage data-s="1">
              <svg class="sc" viewBox="0 0 720 440" preserveAspectRatio="xMidYMax meet" focusable="false">
                <g set:html={BACKDROP} />

                {/* Облака стоят там, где плашки шагов 1–5 их не перекрывают */}
                <g class="sc-cloud" fill="#fff">
                  <rect x="158" y="138" width="88" height="18" rx="9" />
                  <circle cx="180" cy="140" r="12" />
                  <circle cx="206" cy="133" r="16" />
                  <circle cx="228" cy="143" r="10" />
                </g>
                <g class="sc-cloud" fill="#fff">
                  <rect x="594" y="112" width="100" height="18" rx="9" />
                  <circle cx="618" cy="114" r="12" />
                  <circle cx="646" cy="107" r="15" />
                  <circle cx="670" cy="116" r="10" />
                </g>

                {/* Мусоровоз: в шаге 1 въезжает слева, колёса крутятся */}
                <g transform="translate(326 210)">
                  <g class="sc-truck">
                    <g set:html={TRUCK} />
                    {/* каретка подъёмника внизу заднего борта */}
                    <rect class="sc-carriage" x="-7" y="112" width="12" height="24" rx="3" fill="#57636e" />
                    {
                      WHEELS.map((cx) => (
                        <g transform={`translate(${cx} 150)`}>
                          <g class="sc-wheel">
                            <circle r="22" fill="#222a31" />
                            <circle r="10" fill="#8b97a2" />
                            <path d="M0-6v12M-6 0h12" stroke="#5d6873" stroke-width="2.6" stroke-linecap="round" />
                          </g>
                        </g>
                      ))
                    }
                    {
                      CAMS.map((c) => (
                        <g transform={`translate(${c.x} ${c.y})`}>
                          <circle class="sc-flash" r="24" style={`--t:${flashAt(c.n - 1)}s`} />
                          <circle r="6.5" fill="#fff" stroke="#8d9aa5" stroke-width="1.5" />
                          <circle r="3.4" fill="#006bff" />
                        </g>
                      ))
                    }
                  </g>
                </g>

                {/* Контейнеры — перед дорогой. Синий (k = 2) поднимает подъёмник в шаге 3 */}
                {
                  BINS.map((b, k) => (
                    <g class:list={['sc-bin', `sc-bin--${k}`, { 'sc-lift': k === 2 }]}>
                      <g class="sc-bags">
                        <ellipse cx={b.x + 17} cy={BIN_Y + 2} rx="12" ry="8" fill="#4d5a66" />
                        <ellipse cx={b.x + 38} cy={BIN_Y + 1} rx="13" ry="9" fill="#6b7884" />
                        <ellipse cx={b.x + 27} cy={BIN_Y - 3} rx="8" ry="6" fill="#3e4954" />
                      </g>
                      {/* полный контейнер не закрывается: крышка лежит на мешках */}
                      <rect
                        class="sc-lid-open"
                        x={b.x + 1}
                        y={BIN_Y - 5}
                        width="56"
                        height="6"
                        rx="2.5"
                        fill="#2b3a33"
                        transform={`rotate(-12 ${b.x + 1} ${BIN_Y + 1})`}
                      />
                      <g set:html={binBody(b.x, BIN_Y, b.color)} />
                      <rect
                        class="sc-lid-shut"
                        x={b.x - 1}
                        y={BIN_Y - 1}
                        width="60"
                        height="6"
                        rx="2.5"
                        fill="#2b3a33"
                        fill-opacity=".6"
                      />
                    </g>
                  ))
                }

                {/* Шаг 6: ИИ обводит контейнеры рамками и считает их */}
                <g class="sc-dets">
                  {
                    BINS.map((b, k) => (
                      <g class="sc-det" style={`--t:${(0.85 + k * 0.4).toFixed(2)}s`}>
                        <rect
                          x={b.x - 7}
                          y={BIN_Y - 12}
                          width="72"
                          height="76"
                          rx="8"
                          fill="#0fa86f"
                          fill-opacity=".1"
                          stroke="#0fa86f"
                          stroke-width="2.5"
                        />
                        <rect class="sc-det__tag" x={b.x - 7} y={BIN_Y - 12} width="22" height="21" rx="5" fill="#087a52" />
                        <text x={b.x + 4} y={BIN_Y + 3.5} text-anchor="middle" font-size="14" font-weight="650" fill="#fff">
                          {k + 1}
                        </text>
                      </g>
                    ))
                  }
                </g>
              </svg>

              {/* Плашки: адрес площадки, «Запись» в шаге 3 */}
              <div class="tst-hud">
                <span class="tst-loc">
                  <span class="tst-loc__in">
                    <Icon name="map-pin" size={14} strokeWidth={2.2} />
                    <span>ул. Садовая, 21</span>
                    <span class="tst-loc__t">08:42</span>
                  </span>
                </span>
                <span class="tst-rec">
                  <i />
                  <span>Запись</span>
                </span>
              </div>

              {/* Шаги 2–4: кадры с четырёх камер — «до», затем «после» (сцена скрыта от скринридера, alt пустой) */}
              <div class="tst-shots">
                {
                  SHOTS.map((s, k) => (
                    <span class="tst-shot" style={`--t:${shotAt(k)}s`}>
                      <span class="tst-shot__pop">
                        <img
                          src={photo(s.before)}
                          width="320"
                          height="180"
                          alt=""
                          loading="lazy"
                          decoding="async"
                          draggable="false"
                        />
                        <span class="tst-tag tst-tag--state">до</span>
                        <span class="tst-shot__after">
                          <img
                            src={photo(s.after)}
                            width="320"
                            height="180"
                            alt=""
                            loading="lazy"
                            decoding="async"
                            draggable="false"
                          />
                          <span class="tst-tag tst-tag--state">после</span>
                        </span>
                        <span class="tst-tag tst-tag--cam"><span class="tst-tag__k">{`Кам.${NB}`}</span>{k + 1}</span>
                        <span class="tst-shot__flash" />
                      </span>
                    </span>
                  ))
                }
                {/* на телефоне «до» и «после» не помещаются на кадрах — одна подпись под ними */}
                <span class="tst-cap">
                  <span>до погрузки</span>
                  <span class="tst-cap__after">после погрузки</span>
                </span>
              </div>

              {/* Шаг 5: видео погрузок летят от камеры над подъёмником в облако, счётчик растёт */}
              <span class="tst-link" />
              {
                [0, 1, 2].map((k) => (
                  <span class="tst-vid" style={`--t:${(0.75 + k * 0.6).toFixed(2)}s`}>
                    <Icon name="play" size={11} strokeWidth={2.6} />
                  </span>
                ))
              }
              <div class="tst-cloud">
                <div class="tst-cloud__in">
                  <span class="tst-cloud__ico">
                    <Icon name="cloud-upload" size={20} strokeWidth={2} />
                  </span>
                  <span class="tst-cloud__txt">
                    <span class="tst-cloud__label">
                      Видео погрузок:{' '}
                      <span class="tst-num">
                        <b class="a-blip" style="--t:0s; --dur:1.6s">0</b>
                        <b class="a-blip" style="--t:1.6s; --dur:0.6s">1</b>
                        <b class="a-blip" style="--t:2.2s; --dur:0.6s">2</b>
                        <b class="a-pop" style="--t:2.8s">3</b>
                      </span>
                    </span>
                    <span class="tst-cloud__bar">
                      {[1.6, 2.2, 2.8].map((t) => <i class="a-fill" style={`--t:${t}s`} />)}
                    </span>
                  </span>
                </div>
              </div>

              {/* Шаг 6: итог видеоаналитики по площадке — сколько погружено против плана; под карточкой —
                  отдельное уведомление об аномалии за день: погрузка в другом месте, не на этой площадке */}
              <div class="tst-ai">
                <div class="tst-ai__in">
                  <p class="tst-ai__head">
                    <span class="tst-ai__ico">
                      <Icon name="ai-scan" size={15} strokeWidth={2} />
                    </span>
                    <b>ул. Садовая, 21</b>
                    <span class="tst-ai__by">посчитал ИИ</span>
                  </p>
                  <p class="tst-ai__row">
                    <span class="tst-ai__count">
                      Погружено:{' '}
                      <span class="tst-num">
                        <b class="a-blip" style="--t:0s; --dur:0.9s">0</b>
                        <b class="a-blip" style="--t:0.9s; --dur:0.4s">1</b>
                        <b class="a-blip" style="--t:1.3s; --dur:0.4s">2</b>
                        <b class="a-pop" style="--t:1.7s">3</b>
                      </span>
                    </span>
                    <span class="tst-ai__plan a-fade" style="--t:2.1s">· план 3</span>
                    <span class="tst-pill a-pop" style="--t:2.35s">
                      <Icon name="check" size={12} strokeWidth={3} />
                      Корректно
                    </span>
                  </p>
                </div>
                <p class="tst-ai__alert a-in" style="--t:2.9s">
                  <i class="tst-ai__dot" />
                  <span>СНТ «Рассвет» — погрузка вне плана</span>
                </p>
              </div>
            </div>
          </div>
        </GradientVisual>
        <span class="tag tag--demo tst__demo" aria-hidden="true">демо-данные</span>
      </div>
    </div>

    <p class="tst__cta" data-reveal>
      <a href="#forma" class="btn btn--primary" data-interest="tracker" data-goal="pilot_click">
        Запросить демо
        <Icon name="arrow-right" />
      </a>
    </p>
  </div>
</section>

<style>
  /* ── Ряд: шаги слева, сцена справа ───────────────────── */
  .tst__row {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr);
    grid-template-areas: 'list vis';
    align-items: center;
    column-gap: clamp(40px, calc(var(--vw) * 5), 72px);
  }

  .tst__list {
    grid-area: list;
  }

  .tst__visual {
    grid-area: vis;
    position: relative;
    min-width: 0;
  }

  .tst__visual :global(.gv) {
    padding: clamp(16px, calc(var(--vw) * 2.4), 40px);
  }

  /* «демо-данные» в углу градиентной карточки */
  .tst__demo {
    position: absolute;
    z-index: 1;
    top: clamp(14px, calc(var(--vw) * 1.6), 22px);
    left: clamp(14px, calc(var(--vw) * 1.6), 22px);
    pointer-events: none;
  }

  /* ── Шаги: «Шаг N», заголовок, текст; полоса прогресса под активным (как у FeatureAccordion) ── */
  .tst-step {
    position: relative;
    padding: 15px 0 16px;
    border-bottom: 1px solid var(--line-2);
  }

  .tst-step:first-child {
    border-top: 1px solid var(--line-2);
  }

  .tst-step__h {
    font: inherit;
  }

  .tst-step__btn {
    display: grid;
    gap: 3px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    text-align: left;
    transition: color 0.3s;
  }

  /* нажимается весь пункт, вместе с текстом шага */
  .tst-step__btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: calc(10px * var(--rk));
    corner-shape: var(--corner);
  }

  .tst-step__btn:focus-visible {
    outline: none;
  }

  .tst-step__btn:focus-visible::after {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .tst-step__btn:hover,
  .tst-step.is-on .tst-step__btn {
    color: var(--ink);
  }

  .tst-step__n {
    font-size: 14px;
    font-weight: 560;
    line-height: 1.3;
  }

  .tst-step__t {
    font-size: 19px;
    font-weight: 560;
    line-height: 1.3;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .tst-step__d {
    margin-top: 4px;
    font-size: 16px;
    line-height: 1.45;
    color: var(--muted);
  }

  .tst-step__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
  }

  /* цвет Tracker, как у полосы пунктов «О системе» и на главной */
  .tst-step__bar i {
    display: block;
    height: 100%;
    background: var(--g-teal);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* полоса и есть часы автопрокрутки: когда она дошла до конца, скрипт включает следующий шаг */
  .tst-step.is-on .tst-step__bar i {
    animation: algo-progress var(--ms) linear both;
  }

  .tst__row[data-paused] .tst-step__bar i,
  .tst__row[data-idle] .tst-step__bar i {
    animation-play-state: paused;
  }

  @keyframes algo-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: none;
    }
  }

  /* ── Карточка со сценой ─────────────────────────────── */
  .tst-ui {
    container: tst-ui / inline-size;
    width: 100%;
    padding: 10px;
    border-radius: 22px;
  }

  /* Кадр: сцена 720×440 прижата к низу. --k — высота кадра к ширине: на узких экранах кадр выше
     сцены, и сверху остаётся небо под плашки. Плашки стоят в долях ширины кадра (cqw), поэтому
     точка сцены (x, y) — это left: x / 7.2 cqw, top: --top + y / 7.2 cqw. */
  .tst-stage {
    --k: 0.6111;
    --top: calc((var(--k) - 0.6111) * 100cqw);
    --pad: 3cqw;
    --cloud-x: 50cqw;
    --cloud-y: calc(4cqw + 29px);
    position: relative;
    aspect-ratio: 1 / var(--k);
    overflow: hidden;
    isolation: isolate;
    container-type: inline-size;
    border-radius: 14px;
    background: #e2eaf0;
    color: var(--ink);
    line-height: 1.3;
    text-align: left;
    -webkit-user-select: none;
    user-select: none;
  }

  .sc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* ── Что видно на каждом шаге (переходы — между шагами, движение — ниже) ── */
  .tst-loc,
  .tst-rec,
  .tst-shots,
  .tst-cloud,
  .tst-ai,
  .sc-dets {
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .tst-rec,
  .tst-shots,
  .tst-ai,
  .sc-dets {
    opacity: 0;
  }

  .tst-rec {
    transform: scale(0.9);
  }

  .tst-shots {
    transform: translateY(8px);
  }

  .tst-cloud {
    opacity: 0;
    transform: translate(-50%, 8px);
  }

  .tst-ai {
    transform: translateY(-8px);
  }

  .tst-stage[data-s='6'] .tst-loc {
    opacity: 0;
    transform: translateY(-6px);
  }

  .tst-stage[data-s='3'] .tst-rec {
    opacity: 1;
    transform: none;
  }

  .tst-stage[data-s='2'] .tst-shots,
  .tst-stage[data-s='4'] .tst-shots {
    opacity: 1;
    transform: none;
  }

  /* пока идёт запись погрузки, кадры «до» отходят на второй план */
  .tst-stage[data-s='3'] .tst-shots {
    opacity: 0.4;
    transform: none;
  }

  .tst-stage[data-s='5'] .tst-cloud {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .tst-stage[data-s='6'] .tst-ai,
  .tst-stage[data-s='6'] .sc-dets {
    opacity: 1;
    transform: none;
  }

  /* мешки в контейнерах и открытая крышка — до погрузки; после — закрытая крышка */
  .sc-bags,
  .sc-lid-open {
    opacity: 0;
  }

  .tst-stage[data-s='1'] :is(.sc-bags, .sc-lid-open),
  .tst-stage[data-s='2'] :is(.sc-bags, .sc-lid-open) {
    opacity: 1;
  }

  .tst-stage[data-s='1'] .sc-lid-shut,
  .tst-stage[data-s='2'] .sc-lid-shut {
    opacity: 0;
  }

  /* «после»: слой поверх кадра «до»; остаётся и на шаге 5, пока кадры тают */
  .tst-shot__after {
    opacity: 0;
  }

  .tst-stage:is([data-s='4'], [data-s='5'], [data-s='6']) .tst-shot__after {
    opacity: 1;
  }

  /* ── Небо, мусоровоз и контейнеры ──────────────────── */
  .sc-cloud {
    opacity: 0.55;
    transition: opacity 0.35s;
  }

  /* на шаге 6 облака уходят: итог ИИ на телефоне во всю ширину и закрыл бы их наполовину */
  .tst-stage[data-s='6'] .sc-cloud {
    opacity: 0;
  }

  .sc-wheel,
  .sc-flash,
  .sc-det {
    transform-box: fill-box;
    transform-origin: center;
  }

  .sc-flash {
    fill: #fff;
    stroke: #4f9bff;
    stroke-width: 3;
    opacity: 0;
  }

  /* синий контейнер опрокидывается вокруг правого верхнего угла (координаты сцены) */
  .sc-lift {
    transform-box: view-box;
    transform-origin: 268px 342px;
  }

  /* ── Плашки поверх сцены ───────────────────────────── */
  .tst-hud {
    position: absolute;
    z-index: 3;
    left: var(--pad);
    top: var(--pad);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .tst-loc__in,
  .tst-rec {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    border-radius: 999px;
    font-size: clamp(12px, 2.05cqw, 13px);
    font-weight: 560;
    white-space: nowrap;
  }

  .tst-loc {
    display: block;
  }

  .tst-loc__in {
    padding: 0 11px 0 8px;
    background: #fff;
    box-shadow: 0 6px 16px -10px rgb(29 29 31 / 0.45);
  }

  .tst-loc__t {
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .tst-rec {
    padding: 0 11px 0 9px;
    background: #fde8ea;
    color: #b8283a;
    transform-origin: left center;
  }

  .tst-rec i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  /* Кадры с камер над машиной */
  .tst-shots {
    position: absolute;
    z-index: 2;
    right: var(--pad);
    top: var(--pad);
    display: flex;
    gap: 1.3cqw;
  }

  .tst-shot {
    display: block;
    width: 14.6cqw;
    aspect-ratio: 16 / 10;
  }

  .tst-shot__pop {
    --r: 8px;
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: var(--r);
    background: #dbe5eb;
    box-shadow:
      0 0 0 2px #fff,
      0 10px 20px -12px rgb(29 29 31 / 0.5);
  }

  /* снимок камеры заполняет кадр без растяжения: края 16:9 чуть обрезаны до 16:10.
     Свой радиус у снимка и вспышки — на случай, если слой с анимацией прозрачности выйдет из-под обрезки */
  .tst-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r);
  }

  .tst-shot__after {
    position: absolute;
    inset: 0;
  }

  .tst-tag {
    position: absolute;
    left: 4px;
    padding: 1px 5px;
    border-radius: 4px;
    background: rgb(29 29 31 / 0.62);
    color: #fff;
    font-size: clamp(11px, 1.8cqw, 12px);
    font-weight: 500;
    line-height: 1.35;
    white-space: nowrap;
  }

  .tst-tag--cam {
    top: 4px;
  }

  .tst-tag--state {
    bottom: 4px;
  }

  /* подпись «до/после погрузки» под кадрами — только на телефоне */
  .tst-cap {
    display: none;
  }

  .tst-shot__flash {
    position: absolute;
    inset: 0;
    border-radius: var(--r);
    background: #fff;
    opacity: 0;
  }

  /* Видео погрузок: от камеры над подъёмником (точка сцены 336, 216) вверх по пунктиру, под карточку облака */
  .tst-link {
    position: absolute;
    z-index: 1;
    left: calc(336cqw / 7.2 - 1px);
    top: var(--cloud-y);
    width: 2px;
    height: calc(var(--top) + 216cqw / 7.2 - 9px - var(--cloud-y));
    background: repeating-linear-gradient(180deg, #6bb1ff 0 5px, transparent 5px 10px);
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }

  .tst-stage[data-s='5'] .tst-link {
    opacity: 1;
  }

  .tst-vid {
    --vy: calc(var(--cloud-y) - var(--top) - 216cqw / 7.2);
    position: absolute;
    z-index: 2;
    left: calc(336cqw / 7.2 - 15px);
    top: calc(var(--top) + 216cqw / 7.2 - 10px);
    display: grid;
    place-items: center;
    width: 30px;
    height: 20px;
    border-radius: 5px;
    background: #2b3640;
    color: #fff;
    opacity: 0;
  }

  .tst-cloud {
    position: absolute;
    z-index: 3;
    left: var(--cloud-x);
    top: 4cqw;
  }

  .tst-cloud__in {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px 9px 9px;
    border-radius: 15px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(29 29 31 / 0.04),
      0 14px 28px -14px rgb(29 29 31 / 0.45);
    white-space: nowrap;
  }

  .tst-cloud__ico {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 11px;
    background: #e8f1ff;
    color: #006bff;
  }

  .tst-cloud__txt {
    display: grid;
    gap: 6px;
  }

  .tst-cloud__label {
    font-size: clamp(12px, 2.2cqw, 14px);
    font-weight: 560;
  }

  .tst-cloud__bar {
    display: flex;
    gap: 4px;
  }

  /* три деления — по одному на видео; деление заливается, когда видео пришло */
  .tst-cloud__bar i {
    position: relative;
    width: 26px;
    height: 5px;
    overflow: hidden;
    border-radius: 3px;
    background: #e3e8ee;
  }

  .tst-cloud__bar i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #006bff;
    transform-origin: left center;
  }

  /* числа, которые сменяют друг друга в одной клетке; без движения видно последнее */
  .tst-num {
    display: inline-grid;
    font-variant-numeric: tabular-nums;
  }

  .tst-num > b {
    grid-area: 1 / 1;
    font-weight: 650;
  }

  .a-blip {
    opacity: 0;
  }

  /* Итог видеоаналитики: карточка площадки и под ней уведомление */
  .tst-ai {
    position: absolute;
    z-index: 3;
    left: var(--pad);
    top: var(--pad);
    display: grid;
    gap: 8px;
    width: min(340px, 58cqw);
    font-size: clamp(12px, 2.1cqw, 13px);
  }

  .tst-ai__in {
    display: grid;
    gap: 7px;
    padding: 11px;
    border-radius: 16px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(29 29 31 / 0.04),
      0 16px 32px -16px rgb(29 29 31 / 0.45);
  }

  .tst-ai__head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 2px 2px;
  }

  .tst-ai__head b {
    font-weight: 600;
    white-space: nowrap;
  }

  .tst-ai__ico {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 8px;
    background: #e8f1ff;
    color: #0b56c4;
  }

  .tst-ai__by {
    margin-left: auto;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .tst-ai__row {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 6px 8px 6px 10px;
    border-radius: 11px;
    background: #f5f6f8;
  }

  .tst-ai__count {
    font-weight: 560;
    white-space: nowrap;
  }

  .tst-ai__plan {
    color: var(--muted);
    white-space: nowrap;
  }

  .tst-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: none;
    height: 24px;
    margin-left: auto;
    padding: 0 9px;
    border-radius: 999px;
    background: #e1f5ec;
    color: #087a52;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  /* уведомление в духе оповещения на первом экране: белая плашка с красной обводкой */
  .tst-ai__alert {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 36px;
    padding: 7px 13px 7px 12px;
    border-radius: 12px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(229 72 77 / 0.26),
      0 14px 28px -14px rgb(29 29 31 / 0.45);
    color: #9e1f30;
    font-weight: 560;
  }

  .tst-ai__dot {
    position: relative;
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: #e5484d;
  }

  .tst-ai__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #e5484d;
    opacity: 0;
  }

  /* ── Движение шага: идёт, пока у кадра класс is-run (скрипт снимает и ставит его при смене шага).
       Без движения у каждого элемента виден итог шага. ── */

  /* 1. Машина въезжает слева и останавливается у площадки; колёса крутятся в такт */
  .is-run[data-s='1'] .sc-truck {
    animation: algo-drive 2.3s cubic-bezier(0.3, 0.55, 0.25, 1) 0.15s both;
  }

  .is-run[data-s='1'] .sc-wheel {
    animation: algo-roll 2.3s cubic-bezier(0.3, 0.55, 0.25, 1) 0.15s both;
  }

  .is-run[data-s='1'] :is(.sc-bags, .sc-lid-open) {
    animation: algo-fade 0.5s ease both;
  }

  .is-run[data-s='1'] .tst-loc__in {
    animation: algo-pop 0.45s cubic-bezier(0.2, 1.5, 0.4, 1) 2.35s both;
  }

  /* 2 и 4. Камеры по очереди делают снимок — вспышка, следом всплывает или меняется кадр */
  .is-run:is([data-s='2'], [data-s='4']) .sc-flash {
    animation: algo-flash 0.75s ease-out both;
    animation-delay: var(--t);
  }

  /* белеет только в момент снимка: до своей очереди кадр «до» виден целиком */
  .is-run:is([data-s='2'], [data-s='4']) .tst-shot__flash {
    animation: algo-shot-flash 0.5s ease-out;
    animation-delay: var(--t);
  }

  .is-run[data-s='2'] .tst-shot__pop {
    animation: algo-pop 0.45s cubic-bezier(0.2, 1.4, 0.4, 1) both;
    animation-delay: var(--t);
  }

  .is-run[data-s='4'] .tst-shot__after {
    animation: algo-fade 0.3s ease both;
    animation-delay: var(--t);
  }

  /* 3. Запись: подъёмник берёт синий контейнер, опрокидывает его в кузов и возвращает пустым;
        следом пустеют и два зелёных */
  .is-run[data-s='3'] .tst-rec i {
    animation: algo-blink 1.2s ease-in-out infinite;
  }

  .is-run[data-s='3'] .sc-lift {
    animation: algo-lift 2.6s ease-in-out 0.4s both;
  }

  .is-run[data-s='3'] .sc-carriage {
    animation: algo-carriage 2.6s ease-in-out 0.4s both;
  }

  .is-run[data-s='3'] .sc-lift .sc-bags {
    animation: algo-out 0.3s ease 1.75s both;
  }

  /* крышка откидывается, как только подъёмник взял контейнер, и закрывается, когда он вернулся */
  .is-run[data-s='3'] .sc-lift .sc-lid-open {
    animation: algo-out 0.2s ease 0.8s both;
  }

  .is-run[data-s='3'] .sc-lift .sc-lid-shut {
    animation: algo-fade 0.2s ease 2.9s both;
  }

  .is-run[data-s='3'] .sc-bin--1 :is(.sc-bags, .sc-lid-open) {
    animation: algo-out 0.35s ease 3.25s both;
  }

  .is-run[data-s='3'] .sc-bin--1 .sc-lid-shut {
    animation: algo-fade 0.35s ease 3.25s both;
  }

  .is-run[data-s='3'] .sc-bin--0 :is(.sc-bags, .sc-lid-open) {
    animation: algo-out 0.35s ease 3.55s both;
  }

  .is-run[data-s='3'] .sc-bin--0 .sc-lid-shut {
    animation: algo-fade 0.35s ease 3.55s both;
  }

  /* 5. Видео уходят в облако, счётчик и полоска растут по мере прихода */
  .is-run[data-s='5'] .tst-vid {
    animation: algo-vid 1s cubic-bezier(0.45, 0, 0.3, 1) both;
    animation-delay: var(--t);
  }

  .is-run[data-s='5'] .tst-cloud .a-fill::after {
    animation: algo-fill 0.35s var(--ease-out) both;
    animation-delay: var(--t);
  }

  /* 6. ИИ обводит контейнеры и считает их, сверяет с планом и находит погрузку вне плана */
  .is-run[data-s='6'] .sc-det {
    animation: algo-pop 0.5s cubic-bezier(0.2, 1.4, 0.4, 1) both;
    animation-delay: var(--t);
  }

  .is-run[data-s='6'] .tst-ai__dot::after {
    animation: algo-ping 1.2s ease-out 3.2s 2;
  }

  .is-run[data-s='5'] .tst-cloud .a-blip,
  .is-run[data-s='6'] .tst-ai .a-blip {
    animation: algo-blip var(--dur) linear forwards;
    animation-delay: var(--t);
  }

  .is-run[data-s='5'] .tst-cloud .a-pop,
  .is-run[data-s='6'] .tst-ai .a-pop {
    animation: algo-pop 0.45s cubic-bezier(0.2, 1.5, 0.4, 1) both;
    animation-delay: var(--t);
  }

  .is-run[data-s='6'] .tst-ai .a-fade {
    animation: algo-fade 0.4s ease both;
    animation-delay: var(--t);
  }

  .is-run[data-s='6'] .tst-ai .a-in {
    animation: algo-in 0.5s var(--ease-out) both;
    animation-delay: var(--t);
  }

  @keyframes algo-drive {
    from {
      transform: translateX(-700px);
    }
  }

  /* 700 / (2π · 22) ≈ 5,06 оборота — колёса катятся, а не скользят */
  @keyframes algo-roll {
    from {
      transform: rotate(-1823deg);
    }
  }

  @keyframes algo-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes algo-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes algo-pop {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
  }

  @keyframes algo-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes algo-flash {
    0% {
      opacity: 0;
      transform: scale(0.25);
    }
    12% {
      opacity: 0.95;
    }
    100% {
      opacity: 0;
      transform: scale(1.5);
    }
  }

  @keyframes algo-shot-flash {
    from {
      opacity: 0.9;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes algo-blink {
    50% {
      opacity: 0.25;
    }
  }

  /* подкатить к подъёмнику → поднять вдоль скошенного борта → опрокинуть (с встряской) → опустить → откатить */
  @keyframes algo-lift {
    0% {
      transform: none;
    }
    14% {
      transform: translate(52px, -8px);
    }
    40% {
      transform: translate(68px, -76px);
    }
    52% {
      transform: translate(68px, -76px) rotate(125deg);
    }
    58% {
      transform: translate(68px, -76px) rotate(116deg);
    }
    64% {
      transform: translate(68px, -76px) rotate(125deg);
    }
    76% {
      transform: translate(68px, -76px) rotate(0deg);
    }
    90% {
      transform: translate(52px, -8px);
    }
    100% {
      transform: none;
    }
  }

  @keyframes algo-carriage {
    0%,
    14% {
      transform: none;
    }
    40%,
    76% {
      transform: translate(10px, -68px);
    }
    90%,
    100% {
      transform: none;
    }
  }

  @keyframes algo-vid {
    0% {
      opacity: 0;
      transform: translateY(0) scale(0.5);
    }
    14% {
      opacity: 1;
      transform: translateY(-2.5cqw) scale(1);
    }
    82% {
      opacity: 1;
      transform: translateY(var(--vy)) scale(0.85);
    }
    100% {
      opacity: 0;
      transform: translateY(var(--vy)) scale(0.6);
    }
  }

  @keyframes algo-fill {
    from {
      transform: scaleX(0);
    }
  }

  /* промежуточное число видно только во время своей анимации */
  @keyframes algo-blip {
    0%,
    99.9% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes algo-ping {
    from {
      opacity: 0.55;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  /* за экраном и на скрытой вкладке движение стоит (data-idle снимает скрипт) */
  .tst__row[data-idle] .tst-stage *,
  .tst__row[data-idle] .tst-stage *::after {
    animation-play-state: paused !important;
  }

  @media (scripting: none) {
    .tst__row[data-idle] .tst-stage *,
    .tst__row[data-idle] .tst-stage *::after,
    .tst__row[data-idle] .tst-step__bar i {
      animation-play-state: running !important;
    }
  }

  /* Без движения: шаги переключаются только нажатием, сцена сразу показывает итог шага.
     Шаг 3 — главный кадр погрузки: синий контейнер опрокинут над кузовом, зелёные ещё полные. */
  @media (prefers-reduced-motion: reduce) {
    .tst-stage *,
    .tst-stage *::after,
    .tst-step__bar i {
      animation: none !important;
    }

    .tst-step.is-on .tst-step__bar i {
      transform: none;
    }

    .tst-stage[data-s='3'] .sc-lift {
      transform: translate(68px, -76px) rotate(125deg);
    }

    .tst-stage[data-s='3'] .sc-carriage {
      transform: translate(10px, -68px);
    }

    .tst-stage[data-s='3'] :is(.sc-bin--0, .sc-bin--1) :is(.sc-bags, .sc-lid-open) {
      opacity: 1;
    }

    .tst-stage[data-s='3'] :is(.sc-bin--0, .sc-bin--1, .sc-lift) .sc-lid-shut {
      opacity: 0;
    }
  }

  /* ── Узкая карточка: кадр выше сцены, плашки — в небе над ней. Адрес и «Запись» — в строку,
       кадры с камер и облако — под ними (у облака 56 px высоты, середина — на 28 px ниже верха) ── */
  @container tst-ui (max-width: 600px) {
    .tst-stage {
      --k: 0.74;
      --pad: 2.8cqw;
      --cloud-y: calc(var(--pad) + 64px);
    }

    .tst-hud {
      flex-direction: row;
    }

    .tst-loc__in,
    .tst-rec {
      height: 26px;
    }

    .tst-shots {
      left: var(--pad);
      top: calc(var(--pad) + 36px);
      gap: 1.5cqw;
    }

    .tst-shot {
      flex: 1 1 0;
      width: auto;
    }

    .tst-cloud {
      top: calc(var(--pad) + 36px);
    }
  }

  @container tst-ui (max-width: 460px) {
    .tst-stage {
      --k: 0.84;
      --pad: 2.6cqw;
    }

    .tst-ai {
      right: var(--pad);
      width: auto;
    }

    /* итог ИИ плотнее: не заходит на крышу машины */
    .tst-ai__in {
      gap: 6px;
      padding: 9px;
    }

    .tst-ai__row {
      min-height: 30px;
      padding: 5px 7px 5px 9px;
    }

    .tst-ai__alert {
      min-height: 32px;
      padding: 6px 11px 6px 10px;
    }

    .tst-ai__ico {
      width: 24px;
      height: 24px;
    }

    /* на телефоне цифры в рамках ИИ мельче текста — оставляем одни рамки, без плашек номеров */
    .sc-det text,
    .sc-det__tag {
      display: none;
    }

    /* кадр с камеры не шире 105 px: на нём только номер камеры, «до» и «после» — подписью под кадрами */
    .tst-tag {
      font-size: 12px;
    }

    .tst-tag__k,
    .tst-tag--state {
      display: none;
    }

    .tst-cap {
      position: absolute;
      left: 0;
      top: calc(100% + 6px);
      display: grid;
    }

    .tst-cap > span {
      grid-area: 1 / 1;
      justify-self: start;
      padding: 1px 6px;
      border-radius: 4px;
      background: rgb(29 29 31 / 0.62);
      color: #fff;
      font-size: 12px;
      font-weight: 500;
      line-height: 1.35;
      white-space: nowrap;
      transition: opacity 0.3s;
    }

    .tst-cap__after,
    .tst-stage:is([data-s='4'], [data-s='5'], [data-s='6']) .tst-cap > :first-child {
      opacity: 0;
    }

    .tst-stage:is([data-s='4'], [data-s='5'], [data-s='6']) .tst-cap__after {
      opacity: 1;
    }
  }

  /* ── Кнопка под шагами ─────────────────────────────── */
  .tst__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(32px, calc(var(--vw) * 3.6), 52px);
  }

  /* ── Уже 1200 px: сцена сверху во всю ширину, шаги под ней ── */
  @media (max-width: 1199.98px) {
    .tst__row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'vis'
        'list';
      row-gap: 28px;
    }

    /* сверху место под «демо-данные»; карточка не шире 760 px, по бокам градиент */
    .tst__visual :global(.gv) {
      min-height: 0;
      padding: 54px clamp(14px, calc(var(--vw) * 4), 48px) clamp(16px, calc(var(--vw) * 4), 48px);
    }

    .tst-ui {
      max-width: 760px;
    }
  }

  /* планшет: шаги в две колонки по три — линии между шагами идут через обе колонки */
  @media (min-width: 621px) and (max-width: 1199.98px) {
    .tst__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(3, auto);
      grid-auto-flow: column;
      column-gap: 32px;
    }

    .tst-step:nth-child(4) {
      border-top: 1px solid var(--line-2);
    }
  }

  @media (max-width: 560px) {
    .tst__visual :global(.gv) {
      padding: 46px 8px 10px;
    }

    .tst-ui {
      padding: 6px;
      border-radius: 18px;
      box-shadow:
        0 0 0 6px rgb(255 255 255 / 0.4),
        var(--shadow-card);
    }

    .tst-stage {
      border-radius: 12px;
    }

    .tst-step {
      padding: 12px 0 13px;
    }

    .tst-step__n {
      font-size: 13px;
    }

    .tst-step__t {
      font-size: 17px;
    }

    .tst-step__d {
      margin-top: 2px;
      font-size: 15px;
    }

    .tst__cta .btn {
      width: 100%;
    }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Шаги идут сами: следующий включается, когда полоса прогресса активного шага дошла до конца.
  // Полоса и сцена стоят, пока сцена за экраном или вкладка скрыта; полоса стоит, пока курсор над списком
  // или в нём фокус с клавиатуры. Нажатый шаг сразу показывается в сцене. При «уменьшить движение»
  // шаги переключаются только нажатием.
  const root = document.querySelector<HTMLElement>('[data-tst]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-tst-stage]')!;
    const list = root.querySelector<HTMLElement>('[data-tst-list]')!;
    const items = [...list.querySelectorAll<HTMLElement>(':scope > li')];
    const buttons = items.map((li) => li.querySelector<HTMLButtonElement>('button')!);
    const bars = items.map((li) => li.querySelector<HTMLElement>('[data-tst-bar]')!);
    let index = 0;
    let inView = false;
    let hover = false;
    let focus = false;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      items.forEach((li, k) => li.classList.toggle('is-on', k === index));
      buttons.forEach((btn, k) => {
        if (k === index) btn.setAttribute('aria-current', 'step');
        else btn.removeAttribute('aria-current');
      });
      // движение шага и полоса начинаются заново, даже если нажат тот же шаг
      stage.classList.remove('is-run');
      stage.dataset.s = String(index + 1);
      bars[index].style.animation = 'none';
      void stage.offsetWidth;
      bars[index].style.animation = '';
      stage.classList.add('is-run');
    };

    const sync = () => {
      root.toggleAttribute('data-idle', !inView || document.hidden);
      root.toggleAttribute('data-paused', hover || focus);
    };

    // фокус после щелчка мышью паузу не ставит — только переход с клавиатуры
    const byKeyboard = (el: EventTarget | null) => {
      try {
        return el instanceof Element && el.matches(':focus-visible');
      } catch {
        return true;
      }
    };

    // уже 1200 px сцена стоит над списком: шаг, нажатый внизу списка, показывается в сцене под шапкой или
    // за верхом окна — подтягиваем карточку в окно (отступ под шапку даёт scroll-padding-top у html,
    // плавность — scroll-behavior: при «уменьшить движение» сразу). Шире сцена рядом со списком.
    const stacked = window.matchMedia('(max-width: 1199.98px)');
    const visual = root.querySelector<HTMLElement>('.tst__visual')!;
    const header = document.querySelector<HTMLElement>('[data-hdr]');
    const reveal = () => {
      if (!stacked.matches) return;
      const top = header ? header.getBoundingClientRect().bottom : 0;
      if (stage.getBoundingClientRect().top < top) visual.scrollIntoView({ block: 'nearest' });
    };

    buttons.forEach((btn, k) =>
      btn.addEventListener('click', () => {
        show(k);
        reveal();
      }),
    );
    bars.forEach((bar) =>
      bar.addEventListener('animationend', (e) => {
        if (e.target === bar && !reducedMotion()) show(index + 1);
      }),
    );
    list.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      hover = true;
      sync();
    });
    list.addEventListener('pointerleave', () => {
      hover = false;
      sync();
    });
    list.addEventListener('focusin', (e) => {
      focus = byKeyboard(e.target);
      sync();
    });
    list.addEventListener('focusout', (e) => {
      if (list.contains(e.relatedTarget as Node | null)) return;
      focus = false;
      sync();
    });
    document.addEventListener('visibilitychange', sync);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          sync();
        },
        { threshold: 0.35 },
      ).observe(stage);
    } else {
      inView = true;
      sync();
    }
  }
</script>
