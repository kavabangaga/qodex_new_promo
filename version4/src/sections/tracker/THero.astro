---
// Первый экран страницы «QODEX Tracker» [#tracker]. Устроен как первый экран «Кодекса ТКО» и главной:
// большая тёплая панель, по центру — метка продукта, заголовок, подзаголовок, две кнопки и три факта.
// Ниже в той же панели — градиентная карточка с экраном «Контроль качества погрузки мусора»
// (перерисован с кадров продукта): список погрузок, итоги дня, кадры до и после погрузки
// с рамками ИИ и уведомление о несанкционированной погрузке.
import Icon from '../../components/Icon.astro';
import ProductLabel from '../../components/ProductLabel.astro';
import GradientVisual from '../../components/GradientVisual.astro';

const NB = '\u00a0';

// Три факта под кнопками. Длинные на компьютере стоят в две строки: место переноса задано,
// чтобы плашка была шириной ровно по тексту и ряд стоял по центру.
const FACTS = [
  { icon: 'touch', lines: ['Водитель ничего не нажимает'] },
  { icon: 'cctv', lines: ['Оборудование и монтаж', `камер${NB}— на${NB}QODEX`] },
  { icon: 'chart-line', lines: [`+17% контейнеров сверх плана${NB}—`, `пилот у${NB}РО${NB}«Эко-Сити»`] },
];

// ── Демо-данные (как в разделе Tracker на главной: ул. Садовая, 21 в 08:42–08:43); список — все машины за день ──
// Первая строка — новая погрузка: во время анимации она приезжает сверху, остальные сдвигаются вниз,
// а последняя уходит за нижний край списка.
type Status = 'ok' | 'less' | 'more';
const STATUS: Record<Status, string> = {
  ok: 'Корректно',
  less: 'Погружено меньше плана',
  more: 'Погружено больше плана',
};
const LOADS: { time: string; plate: string; id: string; addr: string; st: Status; scene: string; flip?: boolean }[] = [
  { time: '08:42', plate: 'В 214 ОК 102', id: '3298', addr: 'ул. Садовая, 21', st: 'ok', scene: 'empty' },
  { time: '08:36', plate: 'Н 375 РТ 02', id: '3307', addr: 'ул. Полевая, 12', st: 'more', scene: 'empty', flip: true },
  { time: '08:31', plate: 'С 548 ЕМ 102', id: '124', addr: 'ул. Лесная, 3', st: 'less', scene: 'mixed' },
  { time: '08:24', plate: 'М 091 ТВ 702', id: '9345', addr: 'ул. Школьная, 8', st: 'ok', scene: 'empty', flip: true },
  { time: '08:12', plate: 'В 214 ОК 102', id: '3266', addr: 'пер. Мирный, 5', st: 'ok', scene: 'empty' },
];

// Мусорный контейнер — тот же рисунок, что в кадрах камер на главной (Shot.astro): x, y — левый верх, w — ширина
function bin(x: number, y: number, w: number, color: string, full: boolean): string {
  const s = w / 40;
  const bags = full
    ? '<ellipse cx="13" cy="7" rx="9" ry="6" fill="#4d5a66"/><ellipse cx="26" cy="6" rx="10" ry="7" fill="#6b7884"/><ellipse cx="20" cy="4" rx="6" ry="4" fill="#3e4954"/>'
    : '';
  const lid = full
    ? '<rect x="2" y="2" width="36" height="5" rx="2" fill="#2b3a33" transform="rotate(-24 2 7)"/>'
    : '<rect x="1" y="5" width="38" height="6" rx="2" fill="#2b3a33" fill-opacity=".55"/>';
  return `<g transform="translate(${x} ${y}) scale(${s})">${bags}<path d="M3.5 10h33l-3 28a3 3 0 0 1-3 2.7H9.5a3 3 0 0 1-3-2.7Z" fill="${color}"/>${lid}<path d="M13 16v17M20 16v17M27 16v17" stroke="#000" stroke-opacity=".14" stroke-width="2" stroke-linecap="round"/><circle cx="11" cy="43" r="3.2" fill="#26313a"/><circle cx="29" cy="43" r="3.2" fill="#26313a"/></g>`;
}

// Контейнерная площадка под навесом (кадр 160×100): full — какие из трёх контейнеров полные.
// Рамки ИИ стоят поверх рисунка в процентах кадра — см. BOXES, их место считается от KP_BINS.
const KP_BINS = [
  { x: 20, color: '#3f8a6c' },
  { x: 62, color: '#3f8a6c' },
  { x: 104, color: '#4a76ad' },
];
const kp = (full: boolean[]) =>
  '<rect width="160" height="100" fill="#dde7ed"/>' +
  '<rect y="26" width="160" height="36" fill="#ccd6dd"/>' +
  '<path d="M0 33h160M6 26v36M38 26v36M70 26v36M102 26v36M134 26v36" stroke="#b9c4cc" stroke-width="1.5"/>' +
  '<rect y="74" width="160" height="26" fill="#b3bfc7"/>' +
  '<rect x="10" y="77" width="140" height="13" rx="3" fill="#c5cdd3"/>' +
  '<path d="M13 23v55M147 23v55" stroke="#8d9ba6" stroke-width="3"/>' +
  '<path d="M6 22C30 12 130 12 154 22v4C130 16 30 16 6 26Z" fill="#93a3af"/>' +
  KP_BINS.map((b, k) => bin(b.x, 38, 36, b.color, full[k])).join('');

// рамка вокруг контейнера: на 1,5 единицы шире бака с каждой стороны
const BOXES = KP_BINS.map((b) => `left:${((b.x - 1.5) / 160) * 100}%`);

// Фон кнопки «карта» в строке погрузки: кусочек схемы города
const MAP =
  '<rect width="40" height="40" fill="#e4ede5"/><path d="M26 3h11v9H26z" fill="#d2e4d0"/>' +
  '<path d="M-2 28c10-5 19 3 44-10" stroke="#fff" stroke-width="3.5" fill="none"/><path d="M12-2l9 44" stroke="#fff" stroke-width="2.5"/>';
---

<section class="section panel trh" id="tracker" aria-labelledby="tracker-title">
  <div class="trh__intro container">
    <div class="trh__label" data-reveal>
      <ProductLabel id="tracker" size="lg" />
    </div>
    <h1 class="t-display trh__title" id="tracker-title" data-reveal style="--d:1">
      Новый стандарт контроля вывоза&nbsp;ТКО
    </h1>
    <p class="t-lead trh__sub" data-reveal style="--d:2">
      Полное переосмысление работы мусоровозов. Камеры на мусоровозе снимают сами, ИИ считает контейнеры и сверяет
      с&nbsp;планом маршрута.
    </p>
    <div class="trh__cta" data-reveal style="--d:3">
      <a href="#forma" class="btn btn--primary" data-interest="tracker" data-goal="pilot_click">
        Запросить демо
        <Icon name="arrow-right" />
      </a>
      <a href="#video" class="btn btn--outline">
        <Icon name="play" />
        Смотреть видео
        <span class="trh__dur">3&nbsp;мин</span>
      </a>
    </div>
    <ul class="trh__facts" data-reveal style="--d:4">
      {
        FACTS.map((f) => (
          <li class="trh__fact">
            <span class="trh__fact-ico" aria-hidden="true">
              <Icon name={f.icon} size={17} strokeWidth={1.9} />
            </span>
            <span class="trh__fact-text">
              {f.lines.map((line, k) => (k ? [' ', <br class="trh__br" />, line] : line))}
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container trh__stage">
    <div class="trh__vis">
      <GradientVisual
        preset="sky"
        deco="bars"
        class="trh__gv"
        label="Экран «Контроль качества погрузки мусора» QODEX Tracker: погрузки со статусами, кадры до и после погрузки, ИИ посчитал контейнеры, уведомление о несанкционированной погрузке"
      >
        <div class="trh-wrap" data-trh-mock data-idle>
          <!-- рисунки для кадров: площадка до погрузки, после, частично вывезенная; схема города -->
          <svg class="trh-defs" aria-hidden="true" focusable="false">
            <symbol id="trh-kp-full" viewBox="0 0 160 100" set:html={kp([true, true, true])} />
            <symbol id="trh-kp-empty" viewBox="0 0 160 100" set:html={kp([false, false, false])} />
            <symbol id="trh-kp-mixed" viewBox="0 0 160 100" set:html={kp([true, false, true])} />
            <symbol id="trh-map" viewBox="0 0 40 40" set:html={MAP} />
          </svg>

          <div class="ui trh-ui">
            <!-- заголовок экрана -->
            <div class="trh-head">
              <span class="trh-head__ico">
                <Icon name="cctv" size={18} strokeWidth={1.9} />
              </span>
              <span class="trh-head__title">Контроль качества погрузки мусора</span>
              <span class="trh-chips">
                {
                  [
                    { icon: 'truck', text: 'Все машины' },
                    { icon: 'calendar', text: '06.10.2026' },
                  ].map((c) => (
                    <span class="trh-chip">
                      <span class="trh-chip__ico">
                        <Icon name={c.icon} size={15} strokeWidth={2} />
                      </span>
                      {c.text}
                    </span>
                  ))
                }
              </span>
            </div>

            <!-- итоги дня: «Корректно» прибавляет новую погрузку, полоса плана подрастает -->
            <div class="trh-stats">
              <div class="trh-stat">
                <b class="trh-num"><span class="trh-num__old">88</span><span class="trh-num__cur">89</span></b>
                <span class="trh-stat__lab"><i class="trh-sq trh-sq--ok"></i>Корректно</span>
              </div>
              <div class="trh-stat">
                <b class="trh-num"><span>6</span></b>
                <span class="trh-stat__lab"><i class="trh-sq trh-sq--bad"></i>С ошибками</span>
              </div>
              <div class="trh-plan">
                <span class="trh-plan__lab">Выполнение общего плана</span>
                <span class="trh-bar">
                  <i class="trh-bar__fill"></i>
                  <b class="trh-bar__val"><span class="trh-num__old">83%</span><span class="trh-num__cur">84%</span></b>
                </span>
              </div>
            </div>

            <div class="trh-main">
              <!-- погрузки: кадр, карта, время и номер, площадка, статус -->
              <div class="trh-list">
                <ul class="trh-rows">
                  {
                    LOADS.map((l, i) => (
                      <li class:list={['trh-row', `trh-row--${i + 1}`, `trh-row--${l.st}`, { 'is-sel': i === 0 }]}>
                        <span class:list={['trh-thumb', { 'is-flip': l.flip }]}>
                          <svg viewBox="0 0 160 100" preserveAspectRatio="xMidYMid slice">
                            <use href={`#trh-kp-${l.scene}`} width="160" height="100" />
                          </svg>
                        </span>
                        <span class="trh-maptile">
                          <svg viewBox="0 0 40 40" preserveAspectRatio="xMidYMid slice">
                            <use href="#trh-map" width="40" height="40" />
                          </svg>
                          <span class="trh-maptile__ico">
                            <Icon name="map" size={17} strokeWidth={2} />
                          </span>
                        </span>
                        <span class="trh-when">
                          <span class="trh-time">{l.time}</span>
                          <span class="trh-plate">{l.plate}</span>
                        </span>
                        <span class="trh-kp">
                          <small>ID{NB}КП {l.id}</small>
                          <b>{l.addr}</b>
                        </span>
                        <span class="trh-st">
                          <small>Статус погрузки</small>
                          {i === 0 ? (
                            <span class="trh-st__val trh-flip">
                              <span class="trh-flip__wait">
                                <span class="trh-spin">
                                  <Icon name="loader-circle" size={16} strokeWidth={2.4} />
                                </span>
                              </span>
                              <span class="trh-flip__ok">{STATUS[l.st]}</span>
                            </span>
                          ) : (
                            <span class="trh-st__val">{STATUS[l.st]}</span>
                          )}
                        </span>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <!-- выбранная погрузка: кадры до и после, ИИ считает контейнеры -->
              <div class="trh-det">
                <div class="trh-det__head">
                  <span class="trh-det__pin">
                    <Icon name="map-pin" size={16} strokeWidth={2} />
                  </span>
                  <span class="trh-det__name">
                    <b>ул. Садовая, 21</b>
                    <small>ID{NB}КП 3298 · 08:42</small>
                  </span>
                </div>
                <div class="trh-frames">
                  <div class="trh-frame">
                    <svg viewBox="0 0 160 100" preserveAspectRatio="xMidYMid slice">
                      <use href="#trh-kp-full" width="160" height="100" />
                    </svg>
                    {BOXES.map((left) => <span class="trh-box trh-box--red" style={left} />)}
                    <span class="trh-frame__tag">до погрузки</span>
                    <span class="trh-frame__time">08:42</span>
                  </div>
                  <div class="trh-frame trh-frame--after">
                    <svg viewBox="0 0 160 100" preserveAspectRatio="xMidYMid slice">
                      <use href="#trh-kp-empty" width="160" height="100" />
                    </svg>
                    {BOXES.map((left, k) => <span class="trh-box trh-box--red trh-box--scan" style={`${left}; --k:${k}`} />)}
                    {
                      BOXES.map((left, k) => (
                        <span class="trh-box trh-box--green" style={`${left}; --k:${k}`}>
                          <i>{k + 1}</i>
                        </span>
                      ))
                    }
                    <span class="trh-frame__veil">
                      <Icon name="camera" size={22} strokeWidth={1.8} />
                    </span>
                    <span class="trh-frame__flash"></span>
                    <span class="trh-frame__tag">после погрузки</span>
                    <span class="trh-frame__time">08:43</span>
                  </div>
                </div>
                <div class="trh-res">
                  <span class="trh-count">
                    <span class="trh-count__ico">
                      <Icon name="ai-scan" size={16} strokeWidth={2} />
                    </span>
                    <span>
                      Погружено: <span class="trh-digits"
                        ><b class="trh-d0">0</b><b class="trh-d1">1</b><b class="trh-d2">2</b><b class="trh-d3">3</b></span
                      >
                    </span>
                  </span>
                  <span class="trh-res__plan">план 3</span>
                  <Icon name="arrow-right" size={15} strokeWidth={2} />
                  <span class="trh-flip trh-res__st">
                    <span class="trh-flip__wait trh-pill trh-pill--wait">
                      <span class="trh-spin">
                        <Icon name="loader-circle" size={15} strokeWidth={2.4} />
                      </span>
                    </span>
                    <span class="trh-flip__ok trh-pill">
                      <Icon name="check" size={13} strokeWidth={3} />
                      Корректно
                    </span>
                  </span>
                </div>
              </div>
            </div>

            <!-- видео погрузок уходят в облако -->
            <div class="trh-foot">
              <span class="trh-foot__ico">
                <Icon name="cloud-done" size={17} strokeWidth={2} />
              </span>
              <span>Видео погрузок за смену: <b>47</b></span>
            </div>
          </div>

          <!-- уведомление: погрузка вне плана маршрута -->
          <div class="trh-alert">
            <span class="trh-alert__ico">
              <span class="trh-alert__ring"></span>
              <Icon name="truck" size={20} strokeWidth={2} />
            </span>
            <span class="trh-alert__text">
              <b>Несанкционированная погрузка!</b>
              <small>
                <span class="trh-alert__place">СНТ «Рассвет»</span><span class="trh-alert__sep"> · </span><span
                  class="trh-alert__geo">Координаты 54.7432, 55.9671</span
                >
              </small>
            </span>
            <span class="trh-alert__btn">Внимание!</span>
          </div>
        </div>
      </GradientVisual>
      <span class="tag tag--demo trh__demo" aria-hidden="true">демо-данные</span>
    </div>
  </div>
</section>

<style>
  /* Отступы панели — как у первого экрана «Кодекса ТКО» */
  .trh.panel {
    padding-top: clamp(48px, calc(var(--vw) * 7), 104px);
    padding-bottom: clamp(8px, calc(var(--vw) * 4.2), 72px);
  }

  .trh__intro {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .trh__label {
    margin-bottom: 22px;
  }

  .trh__title {
    max-width: 1120px;
    font-size: clamp(2.4rem, calc(var(--vw) * 4.7), 4.25rem);
  }

  .trh__sub {
    max-width: 690px;
    margin-top: 24px;
  }

  .trh__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  /* «3 мин» — длительность ролика, тише надписи кнопки */
  .trh__dur {
    padding-left: 10px;
    border-left: 1px solid var(--line-2);
    font-size: 14.5px;
    font-weight: 500;
    color: var(--muted);
  }

  /* Три факта: значок в белом кружке и текст, одна спокойная строка */
  .trh__facts {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px 44px;
    margin-top: 26px;
  }

  .trh__fact {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: 14.5px;
    line-height: 1.4;
    color: var(--ink-2);
    text-align: left;
  }

  .trh__fact-ico {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
    color: var(--ink);
  }

  /* переносы на компьютере заданы в разметке (.trh__br) */
  .trh__fact-text {
    white-space: nowrap;
  }

  /* ── Градиентная карточка с экраном продукта ─────────────── */
  .trh__stage {
    margin-top: clamp(32px, calc(var(--vw) * 3), 48px);
    animation: trh-in 0.9s var(--ease-out) 0.4s backwards;
  }

  /* карточка всегда видна на первом экране, поэтому появляется сразу при загрузке, а не по прокрутке */
  @keyframes trh-in {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
  }

  .trh__vis {
    position: relative;
  }

  /* снизу место для уведомления, которое выезжает на угол карточки */
  .trh__gv {
    min-height: 0;
    padding: 64px clamp(10px, calc(var(--vw) * 3), 48px) clamp(40px, calc(var(--vw) * 4.6), 80px);
  }

  /* «демо-данные» в углу градиентной карточки */
  .trh__demo {
    position: absolute;
    z-index: 1;
    top: 20px;
    left: 22px;
    pointer-events: none;
  }

  /* ── Экран «Контроль качества погрузки мусора» ─────────────
     Раскладку задаёт ширина самой карточки (@container), а не окна. */
  .trh-wrap {
    --t-row: #f5f6f8;
    --t-line: #e6e8ec;
    --t-chip: #f0f2f5;
    --t-blue: #006bff;
    --t-blue-soft: #e8f1ff;
    --t-sel: #edf4ff;
    --t-ok: #087a52;
    --t-ok-bg: #0fa86f;
    --t-ok-soft: #e1f5ec;
    --t-warn: #9a5800;
    --t-bad: #b8283a;
    --t-bad-bg: #e5484d;
    --t-bad-soft: #fde8ea;
    container: trhw / inline-size;
    position: relative;
    width: min(100%, 1072px);
    font-size: 13.5px;
    line-height: 1.3;
    color: var(--ink);
    text-align: left;
    -webkit-user-select: none;
    user-select: none;
  }

  .trh-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .trh-ui {
    width: 100%;
    padding: 0;
    overflow: hidden;
  }

  /* Заголовок экрана */
  .trh-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    padding: 18px 22px 0;
  }

  .trh-head__ico {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 10px;
    background: color-mix(in oklab, var(--c-tracker) 11%, white);
    color: var(--c-tracker);
  }

  .trh-head__title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .trh-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-left: auto;
  }

  .trh-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 11px;
    border-radius: 999px;
    background: var(--t-chip);
    font-size: 12.5px;
    font-weight: 560;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .trh-chip__ico {
    display: grid;
    color: var(--muted);
  }

  /* Итоги дня */
  .trh-stats {
    display: grid;
    grid-template-columns: 136px 136px minmax(0, 1fr);
    gap: 8px;
    padding: 16px 22px 0;
  }

  .trh-stat,
  .trh-plan {
    padding: 11px 14px 12px;
    border-radius: 14px;
    background: var(--t-row);
  }

  .trh-stat {
    display: grid;
    align-content: center;
    gap: 3px;
  }

  /* число: старое и новое значение стоят стопкой, видно одно */
  .trh-num {
    display: inline-grid;
    justify-items: start;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.1;
    /* теснее нельзя: табличные «88» и «84» слипаются (см. DESIGN.md, слипшиеся буквы) */
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .trh-num > span,
  .trh-bar__val > span {
    grid-area: 1 / 1;
  }

  .trh-num__old {
    opacity: 0;
  }

  .trh-stat__lab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: var(--muted);
  }

  .trh-sq {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 3px;
  }

  .trh-sq--ok {
    background: var(--t-ok-bg);
  }

  .trh-sq--bad {
    background: var(--t-bad-bg);
  }

  .trh-plan {
    display: grid;
    align-content: center;
    gap: 8px;
  }

  .trh-plan__lab {
    font-size: 13px;
    color: var(--muted);
  }

  /* полоса плана: выполнено — зелёным, остаток — мягким красным */
  .trh-bar {
    position: relative;
    display: block;
    height: 30px;
    overflow: hidden;
    border-radius: 9px;
    background: #f8d5d8;
  }

  .trh-bar__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 84%;
    border-radius: 9px;
    background: #4cc792;
    transform-origin: left center;
  }

  .trh-bar__val {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 12px;
    display: inline-grid;
    align-items: center;
    font-size: 15px;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  /* Список погрузок и выбранная погрузка */
  .trh-main {
    display: grid;
    grid-template-columns: minmax(0, 1.38fr) minmax(0, 1fr);
    align-items: stretch;
    gap: 18px;
    padding: 14px 22px 0;
  }

  /* за нижний край списка уходит самая старая строка */
  .trh-list {
    position: relative;
    overflow: hidden;
  }

  .trh-rows {
    --row-gap: 8px;
    position: relative;
    display: grid;
    gap: var(--row-gap);
  }

  /* колонки по самым длинным значениям: номер «С 548 ЕМ 102», статус «Погружено меньше плана» */
  .trh-row {
    position: relative;
    display: grid;
    grid-template-columns: 56px 40px 100px minmax(0, 1fr) 180px;
    align-items: center;
    column-gap: 14px;
    padding: 9px 12px;
    border-radius: 14px;
    background: var(--t-row);
  }

  .trh-row.is-sel {
    background: var(--t-sel);
    box-shadow: inset 0 0 0 1.5px rgb(0 107 255 / 0.28);
  }

  /* недовывоз — вся строка подсвечена, как в продукте */
  .trh-row--less {
    background: var(--t-bad-soft);
  }

  .trh-row--5 {
    position: absolute;
    top: calc(100% + var(--row-gap));
    left: 0;
    right: 0;
    opacity: 0;
  }

  .trh-thumb,
  .trh-maptile {
    position: relative;
    height: 40px;
    overflow: hidden;
    border-radius: 8px;
  }

  .trh-thumb {
    background: #dde7ed;
  }

  .trh-thumb svg,
  .trh-frame svg {
    width: 100%;
    height: 100%;
  }

  .trh-thumb.is-flip svg {
    transform: scaleX(-1);
  }

  .trh-maptile {
    display: grid;
    place-items: center;
    background: #e4ede5;
    color: #46544c;
  }

  .trh-maptile svg:first-child {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .trh-maptile__ico {
    position: relative;
    display: grid;
  }

  .trh-when {
    display: grid;
    justify-items: start;
    gap: 3px;
  }

  .trh-time {
    font-size: 12.5px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* госномер — как табличка на машине */
  .trh-plate {
    padding: 1px 6px;
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    background: #fff;
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .trh-kp,
  .trh-st {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .trh-kp small,
  .trh-st small {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .trh-kp b {
    overflow: hidden;
    font-size: 14px;
    font-weight: 560;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .trh-st__val {
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
  }

  .trh-row--ok .trh-st__val {
    color: var(--t-ok);
  }

  .trh-row--less .trh-st__val {
    color: var(--t-bad);
  }

  .trh-row--more .trh-st__val {
    color: var(--t-warn);
  }

  /* статус новой погрузки: пока ИИ считает — значок ожидания, потом «Корректно» */
  .trh-flip {
    display: inline-grid;
    align-items: center;
    justify-items: start;
  }

  .trh-flip > * {
    grid-area: 1 / 1;
  }

  .trh-flip__wait {
    display: inline-flex;
    align-items: center;
    color: var(--t-blue);
    opacity: 0;
  }

  .trh-spin {
    display: grid;
  }

  /* Выбранная погрузка */
  .trh-det {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
    border-radius: 16px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--t-line);
  }

  .trh-det__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .trh-det__pin {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border-radius: 50%;
    background: var(--t-blue-soft);
    color: var(--t-blue);
  }

  .trh-det__name {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .trh-det__name b {
    font-size: 15px;
    font-weight: 600;
  }

  .trh-det__name small {
    font-size: 12.5px;
    color: var(--muted);
  }

  .trh-frames {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .trh-frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 10px;
    background: #dde7ed;
    isolation: isolate;
  }

  .trh-frame__tag,
  .trh-frame__time {
    position: absolute;
    z-index: 5;
    padding: 2px 6px;
    border-radius: 5px;
    background: rgb(29 29 31 / 0.62);
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
  }

  .trh-frame__tag {
    left: 6px;
    top: 6px;
  }

  .trh-frame__time {
    right: 6px;
    top: 6px;
    font-variant-numeric: tabular-nums;
  }

  /* рамки ИИ вокруг контейнеров: красная — полный, зелёная — вывезен */
  .trh-box {
    position: absolute;
    z-index: 2;
    top: 36%;
    width: 24.4%;
    height: 44%;
    border: 2px solid;
    border-radius: 6px;
  }

  .trh-box--red {
    border-color: var(--t-bad-bg);
    background: rgb(229 72 77 / 0.1);
  }

  .trh-box--green {
    border-color: var(--t-ok-bg);
    background: rgb(15 168 111 / 0.12);
  }

  .trh-box--scan {
    opacity: 0;
  }

  .trh-box i {
    position: absolute;
    top: -2px;
    left: -2px;
    display: grid;
    place-items: center;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 5px 0 5px 0;
    background: var(--t-ok);
    color: #fff;
    font-size: 11px;
    font-style: normal;
    font-weight: 650;
    line-height: 1;
  }

  /* «после погрузки» до снимка: камера ждёт; снимок — короткая вспышка */
  .trh-frame__veil {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    background: #e6ecf0;
    color: #7f8e9a;
    opacity: 0;
  }

  .trh-frame__flash {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }

  /* итог: ИИ посчитал контейнеры и сверил с планом */
  .trh-res {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    color: var(--subtle);
  }

  .trh-count {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 0 12px 0 10px;
    border-radius: 999px;
    background: var(--t-chip);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  .trh-count__ico {
    display: grid;
    color: var(--t-blue);
  }

  .trh-digits {
    display: inline-grid;
    font-variant-numeric: tabular-nums;
  }

  .trh-digits > b {
    grid-area: 1 / 1;
    font-weight: inherit;
  }

  .trh-digits > b:not(:last-child) {
    opacity: 0;
  }

  .trh-res__plan {
    margin-left: auto;
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }

  .trh-res__st {
    justify-items: end;
  }

  .trh-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    padding: 0 12px 0 10px;
    border-radius: 999px;
    background: var(--t-ok-soft);
    color: var(--t-ok);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  .trh-pill--wait {
    width: 100%;
    justify-content: center;
    background: var(--t-chip);
    color: var(--t-blue);
  }

  /* Видео погрузок в облаке */
  .trh-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 12px 22px 14px;
    border-top: 1px solid var(--t-line);
    font-size: 13px;
    color: var(--muted);
  }

  .trh-foot__ico {
    display: grid;
    color: var(--t-ok-bg);
  }

  .trh-foot b {
    font-weight: 600;
    color: var(--ink);
  }

  /* Уведомление о погрузке вне маршрута — на нижнем правом углу карточки */
  .trh-alert {
    --ax: 22px;
    --ay: 0px;
    position: absolute;
    z-index: 2;
    right: -24px;
    bottom: -22px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 12px 14px 12px 12px;
    border-radius: 18px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(229 72 77 / 0.26),
      0 18px 40px -16px rgb(29 29 31 / 0.45);
  }

  .trh-alert__ico {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--t-bad-soft);
    color: #d6293b;
  }

  .trh-alert__ring {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 2px rgb(229 72 77 / 0.55);
    opacity: 0;
  }

  .trh-alert__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .trh-alert__text b {
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }

  .trh-alert__text small {
    font-size: 12.5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .trh-alert__place {
    font-weight: 560;
    color: var(--ink-2);
  }

  .trh-alert__geo {
    font-variant-numeric: tabular-nums;
  }

  .trh-alert__btn {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 14px;
    border-radius: 999px;
    background: #d6293b;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  /* ── Движение: цикл 9 с ───────────────────────────────────
     0,4 с — новая погрузка приезжает в начало списка (статус ещё считается), остальные сдвигаются вниз;
     1,4 с — камера «после погрузки» делает снимок (вспышка); с 1,6 с ИИ по очереди находит контейнеры
     (красная рамка) и видит, что они вывезены (зелёная), «Погружено» считает 1 → 2 → 3;
     3,6 с — «Корректно»; 3,9 с — в итогах дня 88 → 89 и 83 % → 84 %; 4,6–7,5 с — уведомление
     о несанкционированной погрузке; с 7,7 с всё мягко возвращается к началу.
     Без анимации (и при «уменьшить движение») виден итог: погрузка посчитана, уведомление на месте. */
  @media (prefers-reduced-motion: no-preference) {
    .trh-row {
      animation: trh-shift 9s var(--ease-in-out) infinite both;
    }

    .trh-row--1 {
      animation:
        trh-shift 9s var(--ease-in-out) infinite both,
        trh-new 9s ease infinite both;
    }

    .trh-row--5 {
      animation:
        trh-shift 9s var(--ease-in-out) infinite both,
        trh-out 9s ease infinite both;
    }

    .trh-flip__wait {
      animation: trh-wait 9s ease infinite both;
    }

    .trh-flip__ok {
      animation: trh-ok 9s var(--ease-out) infinite both;
    }

    .trh-spin {
      animation: trh-spin 1s linear infinite;
    }

    .trh-det {
      animation: trh-dim 9s ease infinite both;
    }

    .trh-frame__veil {
      animation: trh-veil 9s ease infinite both;
    }

    .trh-frame__flash {
      animation: trh-flash 9s ease-out infinite both;
    }

    .trh-box--scan {
      animation: trh-red 9s var(--ease-out) infinite both;
      animation-delay: calc(var(--k) * 0.54s);
    }

    .trh-box--green {
      animation: trh-green 9s var(--ease-out) infinite both;
      animation-delay: calc(var(--k) * 0.54s);
    }

    .trh-d0 {
      animation: trh-d0 9s linear infinite both;
    }

    .trh-d1 {
      animation: trh-d1 9s linear infinite both;
    }

    .trh-d2 {
      animation: trh-d2 9s linear infinite both;
    }

    .trh-d3 {
      animation: trh-d3 9s linear infinite both;
    }

    .trh-num__old {
      animation: trh-old 9s var(--ease-out) infinite both;
    }

    .trh-num__cur {
      animation: trh-cur 9s var(--ease-out) infinite both;
    }

    .trh-bar__fill {
      animation: trh-grow 9s var(--ease-out) infinite both;
    }

    .trh-alert {
      animation: trh-alert 9s var(--ease-out) infinite both;
    }

    .trh-alert__ring {
      animation: trh-ring 9s ease-out infinite both;
    }

    /* за экраном и в скрытой вкладке анимации стоят: data-idle снимает и ставит скрипт ниже */
    .trh-wrap[data-idle] * {
      animation-play-state: paused !important;
    }

    /* на телефоне за край уходит четвёртая строка */
    @container trhw (max-width: 599.98px) {
      .trh-row--4 {
        animation:
          trh-shift 9s var(--ease-in-out) infinite both,
          trh-out 9s ease infinite both;
      }
    }
  }

  @media (scripting: none) {
    .trh-wrap[data-idle] * {
      animation-play-state: running !important;
    }
  }

  /* строки сдвигаются на одну вниз, когда приходит новая погрузка, и обратно в конце цикла */
  @keyframes trh-shift {
    0%,
    4% {
      transform: translateY(calc(-100% - var(--row-gap)));
    }
    12%,
    86% {
      transform: none;
    }
    95%,
    100% {
      transform: translateY(calc(-100% - var(--row-gap)));
    }
  }

  @keyframes trh-new {
    0%,
    5% {
      opacity: 0;
    }
    11%,
    86% {
      opacity: 1;
    }
    90%,
    100% {
      opacity: 0;
    }
  }

  @keyframes trh-out {
    0%,
    4% {
      opacity: 1;
    }
    10%,
    88% {
      opacity: 0;
    }
    95%,
    100% {
      opacity: 1;
    }
  }

  @keyframes trh-wait {
    0%,
    40% {
      opacity: 1;
    }
    41.5%,
    89% {
      opacity: 0;
    }
    91%,
    100% {
      opacity: 1;
    }
  }

  @keyframes trh-ok {
    0%,
    40% {
      opacity: 0;
      transform: translateY(5px);
    }
    42.5%,
    88% {
      opacity: 1;
      transform: none;
    }
    90%,
    100% {
      opacity: 0;
    }
  }

  @keyframes trh-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* подробности приглушены, пока новая погрузка не пришла в список */
  @keyframes trh-dim {
    0%,
    5% {
      opacity: 0.5;
    }
    11%,
    87% {
      opacity: 1;
    }
    93%,
    100% {
      opacity: 0.5;
    }
  }

  @keyframes trh-veil {
    0%,
    15.5% {
      opacity: 1;
    }
    16.5%,
    86% {
      opacity: 0;
    }
    91%,
    100% {
      opacity: 1;
    }
  }

  @keyframes trh-flash {
    0%,
    15.8% {
      opacity: 0;
    }
    16.4% {
      opacity: 0.92;
    }
    21%,
    100% {
      opacity: 0;
    }
  }

  /* ИИ находит контейнер (красная рамка) и видит, что он вывезен (зелёная); у каждой рамки сдвиг 0,54 с */
  @keyframes trh-red {
    0%,
    17.5% {
      opacity: 0;
      transform: scale(1.12);
    }
    19.5%,
    23.5% {
      opacity: 1;
      transform: none;
    }
    24.5%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes trh-green {
    0%,
    23.5% {
      opacity: 0;
    }
    24.5%,
    85% {
      opacity: 1;
    }
    88%,
    100% {
      opacity: 0;
    }
  }

  /* «Погружено»: 0 → 1 → 2 → 3 вместе с зелёными рамками */
  @keyframes trh-d0 {
    0%,
    23.99% {
      opacity: 1;
    }
    24%,
    89.99% {
      opacity: 0;
    }
    90%,
    100% {
      opacity: 1;
    }
  }

  @keyframes trh-d1 {
    0%,
    23.99% {
      opacity: 0;
    }
    24%,
    29.99% {
      opacity: 1;
    }
    30%,
    100% {
      opacity: 0;
    }
  }

  @keyframes trh-d2 {
    0%,
    29.99% {
      opacity: 0;
    }
    30%,
    35.99% {
      opacity: 1;
    }
    36%,
    100% {
      opacity: 0;
    }
  }

  @keyframes trh-d3 {
    0%,
    35.99% {
      opacity: 0;
    }
    36%,
    89.99% {
      opacity: 1;
    }
    90%,
    100% {
      opacity: 0;
    }
  }

  /* итоги дня: прежнее число уходит вверх, новое приходит снизу */
  @keyframes trh-old {
    0%,
    43% {
      opacity: 1;
      transform: none;
    }
    45%,
    88% {
      opacity: 0;
      transform: translateY(-6px);
    }
    91%,
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes trh-cur {
    0%,
    43% {
      opacity: 0;
      transform: translateY(6px);
    }
    45.5%,
    88% {
      opacity: 1;
      transform: none;
    }
    91%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  /* полоса плана: 83 % → 84 % */
  @keyframes trh-grow {
    0%,
    43% {
      transform: scaleX(0.988);
    }
    48%,
    88% {
      transform: none;
    }
    93%,
    100% {
      transform: scaleX(0.988);
    }
  }

  @keyframes trh-alert {
    0%,
    51% {
      opacity: 0;
      transform: translate(var(--ax), var(--ay)) scale(0.98);
    }
    55%,
    79% {
      opacity: 1;
      transform: none;
    }
    83%,
    100% {
      opacity: 0;
      transform: translate(0, 8px);
    }
  }

  @keyframes trh-ring {
    0%,
    55% {
      opacity: 0;
      transform: none;
    }
    56% {
      opacity: 1;
      transform: none;
    }
    66%,
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  /* ── Карточка уже 1040 px (планшет; на компьютере она всегда 1072 px): подробности погрузки —
     под списком. Уведомление садится на нижний край по центру: угол занят подписью. Оно стоит
     в потоке (с отрицательным отступом сверху), поэтому место под ним карточка держит сама. ── */
  @container trhw (max-width: 1039.98px) {
    .trh-main {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .trh-frames {
      gap: 12px;
    }

    .trh-foot {
      padding-bottom: 44px;
    }

    .trh-alert {
      --ax: 0px;
      --ay: 14px;
      position: relative;
      inset: auto;
      width: fit-content;
      max-width: calc(100% - 24px);
      margin: -30px auto 0;
    }
  }

  /* метки экрана не помещаются рядом с заголовком — они встают строкой ниже, от левого края */
  @container trhw (max-width: 759.98px) {
    .trh-chips {
      margin-left: 0;
    }
  }

  /* ── Карточка уже 600 px (телефон): итоги, три погрузки в две строки и уведомление ── */
  @container trhw (max-width: 599.98px) {
    .trh-head {
      gap: 10px;
      padding: 14px 14px 0;
    }

    .trh-head__title {
      flex: 1;
      min-width: 0;
      font-size: 15.5px;
      line-height: 1.25;
    }

    .trh-chips {
      gap: 5px;
    }

    .trh-chip {
      height: 28px;
      padding: 0 9px;
      font-size: 12px;
    }

    .trh-chip__ico {
      display: none;
    }

    .trh-stats {
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      padding: 12px 14px 0;
    }

    .trh-stat,
    .trh-plan {
      padding: 9px 12px 10px;
      border-radius: 12px;
    }

    .trh-plan {
      grid-column: 1 / -1;
      gap: 7px;
    }

    .trh-num {
      font-size: 22px;
    }

    .trh-stat__lab,
    .trh-plan__lab {
      font-size: 12.5px;
    }

    .trh-bar {
      height: 26px;
      border-radius: 8px;
    }

    .trh-bar__fill {
      border-radius: 8px;
    }

    .trh-bar__val {
      left: 10px;
      font-size: 13.5px;
    }

    .trh-main {
      padding: 12px 14px 0;
    }

    .trh-det,
    .trh-maptile,
    .trh-kp small,
    .trh-st small,
    .trh-row--5 {
      display: none;
    }

    .trh-rows {
      --row-gap: 6px;
    }

    /* строка: кадр слева, справа адрес и номер, ниже статус и время.
       Статус занимает обе колонки (время короткое и стоит справа поверх той же строки сетки):
       иначе ширину второй колонки задавал бы номер, и «Погружено меньше плана» не помещалось бы. */
    .trh-row {
      grid-template-columns: 44px minmax(0, 1fr) auto;
      align-items: center;
      gap: 4px 10px;
      padding: 9px 10px;
      border-radius: 12px;
    }

    .trh-row--4 {
      position: absolute;
      top: calc(100% + var(--row-gap));
      left: 0;
      right: 0;
      opacity: 0;
    }

    .trh-thumb {
      grid-column: 1;
      grid-row: 1 / 3;
      height: 44px;
    }

    .trh-when,
    .trh-kp,
    .trh-st {
      display: contents;
    }

    .trh-kp b {
      grid-column: 2;
      grid-row: 1;
      font-size: 13.5px;
    }

    .trh-plate {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
    }

    .trh-st__val {
      grid-column: 2 / 4;
      grid-row: 2;
      font-size: 12.5px;
    }

    .trh-time {
      grid-column: 3;
      grid-row: 2;
      justify-self: end;
      font-size: 12px;
    }

    .trh-foot {
      margin-top: 12px;
      padding: 12px 14px 16px;
      font-size: 12.5px;
    }

    /* уведомление во всю ширину выезжает поверх подписи внизу карточки:
       заголовок, место, кнопка — столбиком */
    .trh-alert {
      width: auto;
      max-width: none;
      margin: -50px 8px 0;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      gap: 6px 10px;
      padding: 12px;
      border-radius: 16px;
    }

    .trh-alert__ico {
      grid-row: span 2;
      width: 36px;
      height: 36px;
      border-radius: 11px;
    }

    .trh-alert__text b {
      font-size: 13.5px;
      white-space: normal;
    }

    .trh-alert__text small {
      display: grid;
      white-space: normal;
    }

    .trh-alert__sep {
      display: none;
    }

    .trh-alert__btn {
      grid-column: 2;
      justify-self: start;
      height: 30px;
      font-size: 12.5px;
    }
  }

  /* совсем узкая карточка (телефон 360 px): номер рядом с адресом не помещается */
  @container trhw (max-width: 319.98px) {
    .trh-plate {
      display: none;
    }

    .trh-kp b {
      grid-column: 2 / 4;
    }
  }

  /* ── Планшет и телефон ─────────────────────────────────── */
  @media (max-width: 1199.98px) {
    /* факты переносятся сами */
    .trh__br {
      display: none;
    }

    /* факты столбиком: значок слева, текст по левому краю, сам столбик по центру */
    .trh__facts {
      display: grid;
      justify-content: center;
      gap: 12px;
    }

    .trh__fact-text {
      white-space: normal;
      text-wrap: pretty;
    }
  }

  @media (max-width: 640px) {
    .trh__title {
      font-size: clamp(2.05rem, calc(var(--vw) * 9), 2.6rem);
    }

    .trh__cta {
      display: grid;
      width: 100%;
    }

    .trh__stage {
      padding-inline: 8px;
    }

    .trh__gv {
      --gv-r: 22px;
      padding: 54px 10px 18px;
    }

    .trh__demo {
      top: 14px;
      left: 14px;
    }

    /* полупрозрачная рамка карточки уже, чтобы по бокам оставался градиент */
    .trh-ui {
      box-shadow:
        0 0 0 6px rgb(255 255 255 / 0.4),
        var(--shadow-card);
    }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Анимация экрана идёт, только пока он на экране и вкладка открыта (в разметке она стоит: data-idle).
  // Первый цикл начинается, когда карточка уже появилась (её появление при загрузке — 1,3 с).
  // При «уменьшить движение» анимации выключены в CSS — следить не нужно.
  const mock = document.querySelector<HTMLElement>('[data-trh-mock]');
  if (mock && !reducedMotion()) {
    let inView = !('IntersectionObserver' in window);
    let ready = false;
    const sync = () => {
      if (ready && inView && !document.hidden) delete mock.dataset.idle;
      else mock.dataset.idle = '';
    };
    window.setTimeout(() => {
      ready = true;
      sync();
    }, 1300);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          sync();
        },
        { threshold: 0.3 },
      ).observe(mock);
    }
    document.addEventListener('visibilitychange', sync);
    sync();
  }
</script>
