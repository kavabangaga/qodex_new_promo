</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Кадр камеры: погрузка третьего контейнера, когда кадр на экране; за экраном сцена возвращается в начало.
  // Начинается, только когда оба кадра загружены и готовы к показу: иначе второй кадр проявится с задержкой.
  // Рисунок «100 → 60»: полосы вырастают один раз. При «уменьшить движение» классы не ставятся —
  // видно итоговое состояние.
  if (!reducedMotion() && 'IntersectionObserver' in window) {
    const cam = document.querySelector<HTMLElement>('[data-ef-cam]');
    if (cam) {
      // кадр не загрузился или не раскодирован — всё равно начинаем, сцена не должна застрять на «0»
      const ready = Promise.all(
        [...cam.querySelectorAll('img')].map((img) =>
          (img.complete
            ? Promise.resolve()
            : new Promise<void>((done) => {
                img.addEventListener('load', () => done(), { once: true });
                img.addEventListener('error', () => done(), { once: true });
              })
          )
            .then(() => img.decode())
            .catch(() => {}),
        ),
      );
      let shown = false;
      cam.classList.add('is-armed');
      new IntersectionObserver(
        ([entry]) => {
          // начинаем, когда видна заметная часть кадра, а сбрасываем — только когда он ушёл целиком
          if (entry.intersectionRatio >= 0.45) {
            shown = true;
            ready.then(() => shown && cam.classList.add('is-live'));
          } else if (!entry.isIntersecting) {
            shown = false;
            cam.classList.remove('is-live');
          }
        },
        { threshold: [0, 0.45] },
      ).observe(cam);
    }

    const diff = document.querySelector<HTMLElement>('[data-ef-diff]');
    if (diff) {
      diff.classList.add('is-armed');
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          diff.classList.add('is-live');
          io.disconnect();
        },
        { threshold: 0.5 },
      );
      io.observe(diff);
    }
  }
</script>
