---
// Раздел страницы «QODEX Tracker» — «Эффект от внедрения» [#effekt]. Бенто на бежевой панели: лавандовая
// плитка с настоящим кадром задней камеры над подъёмником (ИИ обводит поднятый контейнер рамкой и считает
// погрузку: «Погружено: 3» — демо-данные) и пять белых плиток с эффектами.
// Ниже — широкая плитка о связке с QODEX TONN (тексты — из «Единого баланса» на главной) с рисунком «100 → 60».
import SectionIntro from '../../components/SectionIntro.astro';
import ProductLabel from '../../components/ProductLabel.astro';
import GradientVisual from '../../components/GradientVisual.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import { productHref, withBase } from '../../config/site';
import fs from 'node:fs';
import path from 'node:path';

// Презентация Tracker — файл с прежнего сайта (решение заказчика 2026-10-08: пока выкладываем ту, что есть).
// Размер — при сборке; нет файла — сборка останавливается.
const DECK = 'tracker.pdf';
const deckPath = path.join(process.cwd(), 'public', 'files', DECK);
if (!fs.existsSync(deckPath)) throw new Error(`Нет файла презентации public/files/${DECK}`);
const DECK_META = `PDF, ${(fs.statSync(deckPath).size / 1024 / 1024).toFixed(1).replace('.', ',')}${String.fromCharCode(160)}МБ`;

// Пять эффектов — с лендинга, дословно
const EFFECTS: { text: string; icon: IconName }[] = [
  { text: 'Полная замена ручной фотофиксации', icon: 'camera' },
  { text: 'Исключена подмена фото', icon: 'shield-check' },
  { text: 'Больше контроля — меньше работы', icon: 'check-check' },
  { text: 'Контроль на основе данных, а не доверия', icon: 'chart-line' },
  { text: 'Цифровая доказательная база для тарифного комитета', icon: 'file-check' },
];

// ── Кадры задней камеры над подъёмником: настоящие, служебные надписи размыты, людей нет ──
// Контейнер с коробками поднят на подъёмнике — и он же опрокинут в бункер. Площадка — ул. Школьная, 8
// с первого экрана (тот же бак в строке 08:24): план 3, два контейнера уже погружены, в кадре третий.
// Бак на кадрах один — и погрузка одна: к полному контейнеру сцена не возвращается.
// Ширина кадра на странице — до 532 px, на телефоне около 300.
const photo = (name: string, w: number) => withBase(`/media/tracker/${name}-${w}.webp`);
const srcset = (name: string) => `${photo(name, 720)} 720w, ${photo(name, 1200)} 1200w`;
const SIZES = '(max-width: 699.98px) 320px, 540px';
const SHOTS = [
  { name: 'lift-full', cls: '' },
  { name: 'lift-tip', cls: 'ef-cam__photo--tip' },
];
---

<section class="section panel" id="effekt" aria-labelledby="effekt-title">
  <div class="container ef-wrap">
    <SectionIntro eyebrow="Что даёт" titleId="effekt-title">Эффект от внедрения</SectionIntro>

    <div class="ef">
      <!-- Кадр с камеры над подъёмником: ИИ считает погруженные контейнеры -->
      <GradientVisual preset="lavender" deco="none" class="ef__vis" data-ef-cam data-reveal>
        <span class="tag tag--demo ef__demo">демо-данные</span>
        <div class="ui ef-cam">
          <div class="ef-cam__frame">
            {
              SHOTS.map((s) => (
                <img
                  class:list={['ef-cam__photo', s.cls]}
                  src={photo(s.name, 1200)}
                  srcset={srcset(s.name)}
                  sizes={SIZES}
                  width="1200"
                  height="675"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
              ))
            }
            {/* рамка распознавания с номером погрузки — вокруг контейнера на подъёмнике */}
            <span class="ef-cam__det"><i>3</i></span>
            <span class="ef-cam__tag">Кам. 4 · 08:24</span>
            <span class="ef-cam__count">
              <span class="ef-cam__dot" />
              Погружено:
              <span class="ef-cam__num"><b>2</b><b>3</b></span>
            </span>
          </div>
          <div class="ef-cam__row">
            <span class="ef-cam__place">
              <b>ул. Школьная, 8</b>
              <small>ID КП 9345 · план 3</small>
            </span>
            <span class="ef-cam__ok">
              <Icon name="check" size={12} strokeWidth={3} />
              Корректно
            </span>
          </div>
        </div>
      </GradientVisual>

      {
        EFFECTS.map((e, i) => (
          <div class="ef__tile" style={`--d:${i + 1}`} data-reveal>
            <span class="ef__ico" aria-hidden="true">
              <Icon name={e.icon} size={24} />
            </span>
            <h3 class="ef__text">{e.text}</h3>
          </div>
        ))
      }
    </div>

    <!-- Связка с QODEX TONN: вывезено ≠ взвешено -->
    <article class="ef__next" aria-labelledby="effekt-tonn-title" data-reveal>
      <div class="ef__next-text">
        <p class="ef__labels">
          <ProductLabel id="tracker" />
          <span class="ef__pair">
            <span class="ef__plus" aria-hidden="true"><Icon name="plus" size={14} strokeWidth={2.4} /></span>
            <ProductLabel id="tonn" />
          </span>
        </p>
        <h3 class="ef__next-title" id="effekt-tonn-title">
          Вывезли 100&nbsp;контейнеров — а&nbsp;до&nbsp;полигона доехало&nbsp;60?
        </h3>
        <p class="ef__next-p">
          Tracker и TONN покажут разницу между вывезенным и взвешенным. Разница — это приписки или слив на свалку.
        </p>
      </div>

      <div class="ef-diff" data-ef-diff aria-hidden="true">
        <span class="ef-diff__label"><ProductLabel id="tracker" text="Вывезено" /></span>
        <span class="ef-diff__bar"><i class="ef-diff__fill"></i></span>
        <b class="ef-diff__n">100</b>
        <span class="ef-diff__label"><ProductLabel id="tonn" text="Взвешено" /></span>
        <span class="ef-diff__bar"><i class="ef-diff__fill ef-diff__fill--60"></i><i class="ef-diff__lost"></i></span>
        <b class="ef-diff__n">60</b>
        <span class="ef-diff__gap">разница</span>
      </div>

      <p class="ef__next-more">
        <a href={productHref('tonn', 'tracker')} class="link-arrow" data-goal="product_landing" data-goal-product="tonn">
          Подробнее о QODEX&nbsp;TONN
          <Icon name="arrow-up-right" />
        </a>
      </p>
    </article>

    <p class="ef__deck" data-reveal>
      <a class="btn btn--outline" href={withBase(`/files/${DECK}`)} download="QODEX Tracker Презентация.pdf" aria-describedby="ef-deck-meta">
        <Icon name="download" />
        Скачать презентацию
      </a>
      <span class="ef__deck-meta" id="ef-deck-meta">{DECK_META}</span>
    </p>
  </div>
</section>

<style>
  /* бенто и широкая плитка под ним — с одним зазором */
  .ef-wrap {
    --ef-gap: clamp(12px, calc(var(--vw) * 1.4), 20px);
  }

  /* ── Бенто: кадр камеры в два столбца и два ряда, пять плиток вокруг ── */
  .ef {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--ef-gap);
  }

  .ef__tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-width: 0;
    min-height: 200px;
    padding: clamp(22px, calc(var(--vw) * 2.2), 28px);
    border-radius: calc(var(--r-lg) * var(--rk));
    corner-shape: var(--corner);
    background: var(--card);
  }

  .ef__ico {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: calc(14px * var(--rk));
    corner-shape: var(--corner);
    background: var(--panel);
    color: var(--ink);
  }

  .ef__text {
    font-size: clamp(1.15rem, calc(var(--vw) * 1.6), 1.3125rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 560;
    text-wrap: balance;
  }

  /* ── Кадр камеры на лавандовой подложке ─────────────────── */
  /* сверху место под метку «демо-данные», снизу поле такое же: карточка стоит посередине плитки */
  .ef__vis {
    --gv-r: var(--r-lg);
    grid-column: span 2;
    grid-row: span 2;
    min-height: 0;
    padding: clamp(46px, calc(var(--vw) * 3.4), 52px) clamp(16px, calc(var(--vw) * 3), 48px);
  }

  .ef__demo {
    position: absolute;
    top: 16px;
    left: 16px;
  }

  .ef-cam {
    width: min(100%, 560px);
    padding: clamp(10px, calc(var(--vw) * 1), 14px);
    border-radius: 22px;
    font-size: 14px;
    line-height: 1.35;
    -webkit-user-select: none;
    user-select: none;
  }

  /* кадры сменяют друг друга прозрачностью: Safari на iPhone может не обрезать такой слой по скруглению —
     обрезка продублирована; фон — средний цвет кадра, пока он грузится */
  .ef-cam__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    background: #6f6d60;
    isolation: isolate;
    clip-path: inset(0 round 12px);
  }

  /* кадр 16 : 9, как и рамка, — ничего не обрезается, и рамка распознавания стоит по процентам кадра */
  .ef-cam__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* контейнер опрокинут в бункер — проявляется в конце сцены */
  .ef-cam__photo--tip {
    opacity: 0;
  }

  /* рамка распознавания: место контейнера измерено по кадру 1200 × 675 (x 421–797, y 140–446); цвета —
     как у рамок ИИ в «О системе». Обводка — внутренней тенью: рамку border при дробном масштабе экрана
     Safari не рисует */
  .ef-cam__det {
    position: absolute;
    z-index: 1;
    left: 35.08%;
    top: 20.74%;
    width: 31.33%;
    height: 45.33%;
    border-radius: 8px;
    background: rgb(79 155 255 / 0.12);
    box-shadow: inset 0 0 0 2px #4f9bff;
  }

  .ef-cam__det i {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 6px 0 6px 0;
    background: #1d6ae0;
    color: #fff;
    font-size: 12px;
    font-style: normal;
    font-weight: 600;
  }

  /* камера и время — в правом нижнем углу: сверху их перекрыла бы рамка контейнера */
  .ef-cam__tag {
    position: absolute;
    z-index: 4;
    right: 10px;
    bottom: 14px;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgb(29 29 31 / 0.62);
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.35;
    white-space: nowrap;
  }

  /* счётчик погрузок */
  .ef-cam__count {
    position: absolute;
    z-index: 4;
    left: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px 7px 10px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 6px 18px -8px rgb(29 29 31 / 0.45);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    transform-origin: 0 50%;
  }

  .ef-cam__dot {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: #0fa86f;
  }

  /* числа сменяют друг друга в одной клетке */
  .ef-cam__num {
    display: inline-grid;
  }

  .ef-cam__num > b {
    grid-area: 1 / 1;
    font-weight: inherit;
    font-variant-numeric: tabular-nums;
  }

  .ef-cam__num > b:not(:last-child) {
    opacity: 0;
  }

  .ef-cam__row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 14px;
    background: #f5f6f8;
  }

  .ef-cam__place {
    display: grid;
    gap: 1px;
    flex: 1;
    min-width: 0;
  }

  .ef-cam__place b {
    font-weight: 560;
  }

  .ef-cam__place small {
    font-size: 12.5px;
    color: var(--muted);
  }

  .ef-cam__ok {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
    height: 26px;
    padding: 0 10px 0 8px;
    border-radius: 999px;
    background: #e1f5ec;
    color: #087a52;
    font-size: 12.5px;
    font-weight: 560;
    white-space: nowrap;
  }

  /* Движение — когда кадр на экране: на подъёмнике третий контейнер площадки (погружено уже 2), ИИ обводит
     его рамкой, счёт 2 → 3; контейнер опрокидывается в бункер, сцена остаётся на этом кадре, затем статус
     «Корректно» (план 3, факт 3). За экраном кадр возвращается в начало. Классы is-armed и is-live ставит
     скрипт; без них (нет скриптов, «уменьшить движение») сразу видно итоговое состояние: контейнер в рамке,
     «Погружено: 3», «Корректно». */
  .ef__vis.is-armed:not(.is-live) .ef-cam__det,
  .ef__vis.is-armed:not(.is-live) .ef-cam__num > b:last-child,
  .ef__vis.is-armed:not(.is-live) .ef-cam__ok {
    opacity: 0;
  }

  .ef__vis.is-armed:not(.is-live) .ef-cam__num > b:first-child {
    opacity: 1;
  }

  /* Расписание (с): рамка — в 0,95, счёт — в 1,05; контейнер опрокидывается 2,2–2,55, рамка гаснет вместе
     с ним; «Корректно» — в 2,85 */
  .ef__vis.is-live .ef-cam__det {
    animation: ef-det-pass 1.6s var(--ease-out) 0.95s both;
  }

  .ef__vis.is-live .ef-cam__photo--tip {
    animation: ef-tip 0.35s var(--ease-in-out) 2.2s both;
  }

  .ef__vis.is-live .ef-cam__num > b:first-child {
    animation: ef-hold 1.05s linear both;
  }

  .ef__vis.is-live .ef-cam__num > b:last-child {
    animation: ef-in 0.3s var(--ease-out) 1.05s both;
  }

  /* счётчик чуть вздрагивает, когда растёт */
  .ef__vis.is-live .ef-cam__count {
    animation: ef-bump 0.32s linear 0.89s both;
  }

  .ef__vis.is-live .ef-cam__ok {
    animation: ef-pop 0.45s cubic-bezier(0.2, 1.5, 0.4, 1) 2.85s both;
  }

  /* рамка ложится на контейнер (0,35 с), держится, пока ИИ его считает, и гаснет, когда контейнер опрокидывают */
  @keyframes ef-det-pass {
    0% {
      opacity: 0;
      transform: scale(1.1);
    }
    22%,
    78% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: none;
    }
  }

  /* кадр «контейнер опрокинут» проявляется поверх и остаётся */
  @keyframes ef-tip {
    to {
      opacity: 1;
    }
  }

  @keyframes ef-hold {
    0%,
    99% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes ef-in {
    from {
      opacity: 0;
      transform: translateY(45%);
    }
  }

  @keyframes ef-bump {
    50% {
      transform: scale(1.08);
    }
  }

  @keyframes ef-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ef__vis *,
    .ef-diff * {
      animation: none !important;
      transition: none !important;
    }
  }

  /* ── Связка с QODEX TONN: широкая плитка под бенто ─────── */
  .ef__next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'text diff'
      'more diff';
    align-items: center;
    gap: 24px clamp(28px, calc(var(--vw) * 4.4), 72px);
    margin-top: var(--ef-gap);
    padding: clamp(24px, calc(var(--vw) * 2.8), 40px);
    border-radius: calc(var(--r-lg) * var(--rk));
    corner-shape: var(--corner);
    background: var(--card);
  }

  .ef__next-text {
    grid-area: text;
    align-self: end;
  }

  /* «+» держится за меткой TONN: если меткам тесно в строке, на новую строку уходят вместе */
  .ef__labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }

  .ef__pair {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .ef__plus {
    display: inline-flex;
    color: var(--subtle);
  }

  .ef__next-title {
    margin-top: 20px;
    font-size: clamp(1.35rem, calc(var(--vw) * 2), 1.75rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 560;
    text-wrap: balance;
  }

  .ef__next-p {
    max-width: 52ch;
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  .ef__next-more {
    grid-area: more;
    align-self: start;
  }

  /* презентация — под плиткой связки с TONN, по центру */
  .ef__deck {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 16px;
    margin-top: clamp(28px, calc(var(--vw) * 3), 44px);
  }

  .ef__deck-meta {
    font-size: 14px;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ссылка невысокая: область нажатия больше её самой — не меньше 44 px */
  .ef__next-more a {
    position: relative;
  }

  .ef__next-more a::after {
    content: '';
    position: absolute;
    inset: -10px -8px -8px;
  }

  /* 100 → 60: две полосы, недостающая часть — пунктиром */
  .ef-diff {
    grid-area: diff;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr) max-content;
    align-items: center;
    gap: 14px 16px;
    padding: clamp(20px, calc(var(--vw) * 2.2), 28px) clamp(18px, calc(var(--vw) * 2.2), 28px)
      clamp(14px, calc(var(--vw) * 1.6), 20px);
    border-radius: calc(var(--r) * var(--rk));
    corner-shape: var(--corner);
    background: var(--bg);
  }

  .ef-diff__bar {
    position: relative;
    height: 10px;
  }

  .ef-diff__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    border-radius: 999px;
    background: var(--ink);
    transform-origin: 0 50%;
  }

  .ef-diff__fill--60 {
    width: 60%;
  }

  /* недостающая часть — пустая красная полоса (обводка и скобка ниже — внутренней тенью:
     рамку border при дробном масштабе экрана Safari не рисует) */
  .ef-diff__lost {
    position: absolute;
    inset: 0 0 0 calc(60% + 4px);
    border-radius: 999px;
    background: rgb(214 41 59 / 0.1);
    box-shadow: inset 0 0 0 1.5px rgb(196 43 60 / 0.8);
  }

  .ef-diff__n {
    min-width: 2.2ch;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: right;
  }

  /* ширина, а не отступ слева: проценты отступа у элемента сетки Safari считает от всего блока,
     и скобка уезжала за край (iPhone, 2026-10-08); ширина в % считается от колонки — как у полосы */
  .ef-diff__gap {
    grid-column: 2;
    justify-self: end;
    position: relative;
    width: calc(40% - 4px);
    padding-top: 9px;
    font-size: 13px;
    font-weight: 560;
    text-align: center;
    color: #b81f30;
  }

  /* скобка над «разницей»: обводка со всех сторон, верхняя срезана */
  .ef-diff__gap::before {
    content: '';
    position: absolute;
    inset: -3px 1px auto;
    height: 10px;
    border-radius: 0 0 5px 5px;
    box-shadow: inset 0 0 0 1.5px currentColor;
    clip-path: inset(3px 0 0 0);
  }

  /* полосы вырастают, когда рисунок на экране; потом проявляется недостающая часть */
  .ef-diff.is-armed .ef-diff__fill {
    transform: scaleX(0);
  }

  .ef-diff.is-armed .ef-diff__lost,
  .ef-diff.is-armed .ef-diff__gap {
    opacity: 0;
  }

  .ef-diff.is-live .ef-diff__fill {
    transform: none;
    transition: transform 1s var(--ease-out);
  }

  .ef-diff.is-live .ef-diff__fill--60 {
    transition-delay: 0.2s;
  }

  .ef-diff.is-live .ef-diff__lost,
  .ef-diff.is-live .ef-diff__gap {
    opacity: 1;
    transition: opacity 0.5s ease 1.1s;
  }

  /* ── Планшет: кадр во всю ширину, под ним плитки рядами 3 + 2 ── */
  @media (max-width: 1199.98px) {
    .ef {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-rows: auto;
    }

    /* поле сверху: метка «демо-данные» и зазор до белого ореола карточки */
    .ef__vis {
      grid-column: 1 / -1;
      grid-row: auto;
      padding-top: 60px;
    }

    .ef__tile {
      grid-column: span 2;
      min-height: 172px;
    }

    .ef__tile:nth-last-child(-n + 2) {
      grid-column: span 3;
    }
  }

  @media (max-width: 899.98px) {
    .ef__next {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'text'
        'diff'
        'more';
    }
  }

  /* ── Телефон: один столбец, у плиток значок слева, текст справа ── */
  @media (max-width: 699.98px) {
    .ef {
      grid-template-columns: minmax(0, 1fr);
    }

    .ef__vis {
      padding-bottom: 18px;
    }

    .ef__tile,
    .ef__tile:nth-last-child(-n + 2) {
      grid-column: auto;
    }

    .ef__tile {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 14px;
      min-height: 0;
      padding: 16px 18px 16px 16px;
    }

    .ef__ico {
      width: 44px;
