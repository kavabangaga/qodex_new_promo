---
// Раздел страницы «QODEX Tracker» — «Эффект от внедрения» [#effekt]. Бенто на бежевой панели: лавандовая
// плитка с кадром камеры над подъёмником (контейнеры по одному проходят через подъёмник, ИИ обводит каждый
// рамкой и считает: «Погружено: 3» — демо-данные) и пять белых плиток с эффектами. Ниже — широкая плитка
// о связке с QODEX TONN (тексты — из «Единого баланса» на главной) с рисунком «100 → 60».
import SectionIntro from '../../components/SectionIntro.astro';
import ProductLabel from '../../components/ProductLabel.astro';
import GradientVisual from '../../components/GradientVisual.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import { productHref } from '../../config/site';

// Пять эффектов — с лендинга, дословно
const EFFECTS: { text: string; icon: IconName }[] = [
  { text: 'Полная замена ручной фотофиксации', icon: 'camera' },
  { text: 'Исключена подмена фото', icon: 'shield-check' },
  { text: 'Больше контроля — меньше работы', icon: 'check-check' },
  { text: 'Контроль на основе данных, а не доверия', icon: 'chart-line' },
  { text: 'Цифровая доказательная база для тарифного комитета', icon: 'file-check' },
];

// ── Кадр камеры над подъёмником (рисунок, не фото; цвета — как у кадров на главной) ──
// Фон: грунт за машиной, газон, боковые рычаги подъёмника с цепями
const back =
  `<rect width="320" height="180" fill="#dbe3e8"/>` +
  `<path d="M0 0h116c-10 46-22 104-36 180H0Z" fill="#ccd8d1"/>` +
  `<path d="M210 0h110v180h-72c-12-76-24-134-38-180Z" fill="#ccd8d1"/>` +
  `<path d="M140 0h40l18 180h-76Z" fill="#e2e8ec"/>` +
  `<path d="M0 22l36 9 18 149H0Z" fill="#8995a0"/><path d="M36 31l12 3 18 146H54Z" fill="#aab5be"/>` +
  `<path d="M320 22l-36 9-18 149h54Z" fill="#8995a0"/><path d="M284 31l-12 3-18 146h12Z" fill="#aab5be"/>` +
  `<path d="M15 38l9 116M305 38l-9 116" stroke="#5f6b76" stroke-width="4" stroke-linecap="round" stroke-dasharray="1 7"/>`;

// Передний план: край приёмного бункера и гребёнка захвата — погруженный контейнер уходит под них
const front =
  `<path d="M0 148h320v32H0Z" fill="#7a8792"/><path d="M0 148h320v5H0Z" fill="#9aa6b0"/>` +
  `<rect x="98" y="139" width="124" height="16" rx="4" fill="#64717c"/>` +
  `<path d="M110 143v8M124 143v8M138 143v8M152 143v8M166 143v8M180 143v8M194 143v8M208 143v8" stroke="#4e5a64" stroke-width="2.5" stroke-linecap="round"/>`;

// Контейнер сверху: откинутая крышка у дальнего края, в проёме — мешки, у ближнего края — захват
const binTop = (body: string, inner: string) =>
  `<rect x="4" y="0" width="132" height="15" rx="5" fill="#2b3a33"/>` +
  `<rect x="8" y="10" width="124" height="104" rx="10" fill="${body}"/>` +
  `<rect x="17" y="19" width="106" height="84" rx="6" fill="${inner}"/>` +
  `<ellipse cx="46" cy="50" rx="21" ry="15" fill="#6b7884"/>` +
  `<ellipse cx="86" cy="44" rx="19" ry="14" fill="#d6c48c"/>` +
  `<ellipse cx="62" cy="76" rx="24" ry="16" fill="#4d5a66"/>` +
  `<ellipse cx="101" cy="78" rx="15" ry="12" fill="#e9eef2"/>` +
  `<ellipse cx="32" cy="84" rx="11" ry="9" fill="#3e4954"/>` +
  `<rect x="34" y="106" width="72" height="12" rx="4" fill="#26313a"/>`;

// Три контейнера площадки ул. Садовая, 21 (план 3): проходят через подъёмник по одному
const BINS = [
  { k: 1, svg: binTop('#3f8a6c', '#2f6b53') },
  { k: 2, svg: binTop('#4a76ad', '#375c8c') },
  { k: 3, svg: binTop('#3f8a6c', '#2f6b53') },
];
---

<section class="section panel" id="effekt" aria-labelledby="effekt-title">
  <div class="container ef-wrap">
    <SectionIntro eyebrow="Что даёт" titleId="effekt-title">Эффект от внедрения</SectionIntro>

    <div class="ef">
      <!-- Кадр с камеры над подъёмником: ИИ считает погруженные контейнеры -->
      <GradientVisual preset="lavender" deco="none" class="ef__vis" data-ef-cam data-reveal>
        <span class="tag tag--demo ef__demo">демо-данные</span>
        <div class="ui ef-cam">
          <div class="ef-cam__frame">
            <svg class="ef-cam__scene" viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" set:html={back} />
            {
              BINS.map((b) => (
                <span class:list={['ef-cam__bin', `ef-cam__bin--${b.k}`]}>
                  <svg viewBox="0 0 140 124" set:html={b.svg} />
                  <span class="ef-cam__det">
                    <i>{b.k}</i>
                  </span>
                </span>
              ))
            }
            <svg
              class="ef-cam__scene ef-cam__front"
              viewBox="0 0 320 180"
              preserveAspectRatio="xMidYMid slice"
              set:html={front}
            />
            <span class="ef-cam__tag">Кам. 4 · 08:43</span>
            <span class="ef-cam__count">
              <span class="ef-cam__dot" />
              Погружено:
              <span class="ef-cam__num"><b>0</b><b>1</b><b>2</b><b>3</b></span>
            </span>
          </div>
          <div class="ef-cam__row">
            <span class="ef-cam__place">
              <b>ул. Садовая, 21</b>
              <small>ID КП 3298 · план 3</small>
            </span>
            <span class="ef-cam__ok">
              <Icon name="check" size={12} strokeWidth={3} />
              Корректно
            </span>
          </div>
        </div>
      </GradientVisual>

      {
        EFFECTS.map((e, i) => (
          <div class="ef__tile" style={`--d:${i + 1}`} data-reveal>
            <span class="ef__ico" aria-hidden="true">
              <Icon name={e.icon} size={24} />
            </span>
            <h3 class="ef__text">{e.text}</h3>
          </div>
        ))
      }
    </div>

    <!-- Связка с QODEX TONN: вывезено ≠ взвешено -->
    <article class="ef__next" aria-labelledby="effekt-tonn-title" data-reveal>
      <div class="ef__next-text">
        <p class="ef__labels">
          <ProductLabel id="tracker" />
          <span class="ef__pair">
            <span class="ef__plus" aria-hidden="true"><Icon name="plus" size={14} strokeWidth={2.4} /></span>
            <ProductLabel id="tonn" />
          </span>
        </p>
        <h3 class="ef__next-title" id="effekt-tonn-title">
          Вывезли 100&nbsp;контейнеров — а&nbsp;до&nbsp;полигона доехало&nbsp;60?
        </h3>
        <p class="ef__next-p">
          Tracker и TONN покажут разницу между вывезенным и взвешенным. Разница — это приписки или слив на свалку.
        </p>
      </div>

      <div class="ef-diff" data-ef-diff aria-hidden="true">
        <span class="ef-diff__label"><ProductLabel id="tracker" text="Вывезено" /></span>
        <span class="ef-diff__bar"><i class="ef-diff__fill"></i></span>
        <b class="ef-diff__n">100</b>
        <span class="ef-diff__label"><ProductLabel id="tonn" text="Взвешено" /></span>
        <span class="ef-diff__bar"><i class="ef-diff__fill ef-diff__fill--60"></i><i class="ef-diff__lost"></i></span>
        <b class="ef-diff__n">60</b>
        <span class="ef-diff__gap">разница</span>
      </div>

      <p class="ef__next-more">
        <a href={productHref('tonn', 'tracker')} class="link-arrow" data-goal="product_landing" data-goal-product="tonn">
          Подробнее о QODEX&nbsp;TONN
          <Icon name="arrow-up-right" />
        </a>
      </p>
    </article>
  </div>
</section>

<style>
  /* бенто и широкая плитка под ним — с одним зазором */
  .ef-wrap {
    --ef-gap: clamp(12px, calc(var(--vw) * 1.4), 20px);
  }

  /* ── Бенто: кадр камеры в два столбца и два ряда, пять плиток вокруг ── */
  .ef {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--ef-gap);
  }

  .ef__tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-width: 0;
    min-height: 200px;
    padding: clamp(22px, calc(var(--vw) * 2.2), 28px);
    border-radius: calc(var(--r-lg) * var(--rk));
    corner-shape: var(--corner);
    background: var(--card);
  }

  .ef__ico {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: calc(14px * var(--rk));
    corner-shape: var(--corner);
    background: var(--panel);
    color: var(--ink);
  }

  .ef__text {
    font-size: clamp(1.15rem, calc(var(--vw) * 1.6), 1.3125rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 560;
    text-wrap: balance;
  }

  /* ── Кадр камеры на лавандовой подложке ─────────────────── */
  /* сверху место под метку «демо-данные» */
  .ef__vis {
    --gv-r: var(--r-lg);
    grid-column: span 2;
    grid-row: span 2;
    min-height: 0;
    padding: clamp(46px, calc(var(--vw) * 3.4), 52px) clamp(16px, calc(var(--vw) * 3), 48px)
      clamp(18px, calc(var(--vw) * 1.8), 28px);
  }

  .ef__demo {
    position: absolute;
    top: 16px;
    left: 16px;
  }

  .ef-cam {
    width: min(100%, 560px);
    padding: clamp(10px, calc(var(--vw) * 1), 14px);
    border-radius: 22px;
    font-size: 14px;
    line-height: 1.35;
    -webkit-user-select: none;
    user-select: none;
  }

  /* внутри движутся контейнеры: Safari на iPhone может не обрезать их по скруглению — обрезка продублирована */
  .ef-cam__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    background: #dbe3e8;
    isolation: isolate;
    clip-path: inset(0 round 12px);
  }

  .ef-cam__scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ef-cam__front {
    z-index: 2;
  }

  /* лёгкая «камера»: виньетка, как у кадров на главной */
  .ef-cam__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(120% 90% at 50% 45%, transparent 55%, rgb(29 29 31 / 0.22));
    pointer-events: none;
  }

  .ef-cam__bin {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 43%;
    width: 40%;
    aspect-ratio: 140 / 124;
    transform: translate(-50%, -50%);
  }

  .ef-cam__bin svg {
    width: 100%;
    height: 100%;
  }

  /* рамка распознавания с номером контейнера (обводка — внутренней тенью: рамку border при дробном
     масштабе экрана Safari не рисует) */
  .ef-cam__det {
    position: absolute;
    inset: -6% -5%;
    border-radius: 10px;
    background: rgb(107 177 255 / 0.12);
    box-shadow: inset 0 0 0 2px #6bb1ff;
  }

  .ef-cam__det i {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 8px 0 8px 0;
    background: #6bb1ff;
    color: var(--ink);
    font-size: 12px;
    font-style: normal;
    font-weight: 600;
  }

  /* камера и время — в правом нижнем углу: сверху их перекрыла бы рамка контейнера */
  .ef-cam__tag {
    position: absolute;
    z-index: 4;
    right: 10px;
    bottom: 14px;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgb(29 29 31 / 0.62);
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.35;
    white-space: nowrap;
  }

  /* счётчик погрузок */
  .ef-cam__count {
    position: absolute;
    z-index: 4;
    left: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px 7px 10px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 6px 18px -8px rgb(29 29 31 / 0.45);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    transform-origin: 0 50%;
  }

  .ef-cam__dot {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: #0fa86f;
  }

  /* числа сменяют друг друга в одной клетке */
  .ef-cam__num {
    display: inline-grid;
  }

  .ef-cam__num > b {
    grid-area: 1 / 1;
    font-weight: inherit;
    font-variant-numeric: tabular-nums;
  }

  .ef-cam__num > b:not(:last-child) {
    opacity: 0;
  }

  .ef-cam__row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 14px;
    background: #f5f6f8;
  }

  .ef-cam__place {
    display: grid;
    gap: 1px;
    flex: 1;
    min-width: 0;
  }

  .ef-cam__place b {
    font-weight: 560;
  }

  .ef-cam__place small {
    font-size: 12.5px;
    color: var(--muted);
  }

  .ef-cam__ok {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: none;
    height: 26px;
    padding: 0 10px 0 8px;
    border-radius: 999px;
    background: #e1f5ec;
    color: #087a52;
    font-size: 12.5px;
    font-weight: 560;
    white-space: nowrap;
  }

  /* Движение — когда кадр на экране: контейнеры по одному проходят через подъёмник, ИИ обводит
     каждый рамкой, счётчик растёт 1 → 2 → 3, затем статус «Корректно» (план 3, факт 3). За экраном кадр
     возвращается в начало. Классы is-armed и is-live ставит скрипт; без них (нет скриптов,
     «уменьшить движение») сразу видно итоговое состояние. */
  .ef-cam__bin--1,
  .ef-cam__bin--2 {
    opacity: 0;
  }

  .ef__vis.is-armed:not(.is-live) .ef-cam__bin--3,
  .ef__vis.is-armed:not(.is-live) .ef-cam__num > b:last-child,
  .ef__vis.is-armed:not(.is-live) .ef-cam__ok {
    opacity: 0;
  }

  .ef__vis.is-armed:not(.is-live) .ef-cam__num > b:first-child {
    opacity: 1;
  }

  /* Расписание (с): контейнер 1 — 0,3–2,2, счёт «1» в 1,05; контейнер 2 — 2,15–4,05, «2» в 2,95;
     контейнер 3 подъезжает в 4,0 и остаётся, «3» в 4,75; «Корректно» — в 5,2 */
  .ef__vis.is-live .ef-cam__bin--1 {
    animation: ef-pass 1.9s var(--ease-in-out) 0.3s both;
  }

  .ef__vis.is-live .ef-cam__bin--2 {
    animation: ef-pass 1.9s var(--ease-in-out) 2.15s both;
  }

  .ef__vis.is-live .ef-cam__bin--3 {
    animation: ef-arrive 0.6s var(--ease-out) 4s both;
  }

  .ef__vis.is-live .ef-cam__bin--1 .ef-cam__det {
    animation: ef-det 0.35s var(--ease-out) 0.95s both;
  }

  .ef__vis.is-live .ef-cam__bin--2 .ef-cam__det {
    animation: ef-det 0.35s var(--ease-out) 2.85s both;
  }

  .ef__vis.is-live .ef-cam__bin--3 .ef-cam__det {
    animation: ef-det 0.35s var(--ease-out) 4.65s both;
  }

  .ef__vis.is-live .ef-cam__num > b:nth-child(1) {
    animation: ef-hold 1.05s linear both;
  }

  .ef__vis.is-live .ef-cam__num > b:nth-child(2) {
    animation: ef-tick 1.9s linear 1.05s both;
  }

  .ef__vis.is-live .ef-cam__num > b:nth-child(3) {
    animation: ef-tick 1.8s linear 2.95s both;
  }

  .ef__vis.is-live .ef-cam__num > b:nth-child(4) {
    animation: ef-in 0.3s var(--ease-out) 4.75s both;
  }

  /* счётчик чуть вздрагивает на каждой погрузке */
  .ef__vis.is-live .ef-cam__count {
    animation: ef-bump 5s linear both;
  }

  .ef__vis.is-live .ef-cam__ok {
    animation: ef-pop 0.45s cubic-bezier(0.2, 1.5, 0.4, 1) 5.2s both;
  }

  /* контейнер подъезжает на подъёмнике, стоит, пока ИИ его считает, и уходит в бункер */
  @keyframes ef-pass {
    0% {
      opacity: 0;
      transform: translate(-50%, -92%) scale(0.88);
    }
    10% {
      opacity: 1;
    }
    30%,
    74% {
      opacity: 1;
      transform: translate(-50%, -50%);
    }
    86% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -2%) scale(1.16);
    }
  }

  @keyframes ef-arrive {
    from {
      opacity: 0;
      transform: translate(-50%, -92%) scale(0.88);
    }
    35% {
      opacity: 1;
    }
  }

  @keyframes ef-det {
    from {
      opacity: 0;
      transform: scale(1.1);
    }
  }

  @keyframes ef-hold {
    0%,
    99% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes ef-tick {
    0% {
      opacity: 0;
      transform: translateY(45%);
    }
    12%,
    96% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes ef-in {
    from {
      opacity: 0;
      transform: translateY(45%);
    }
  }

  @keyframes ef-bump {
    0%,
    18%,
    25%,
    56%,
    63%,
    92%,
    99%,
    100% {
      transform: none;
    }
    21%,
    59%,
    95% {
      transform: scale(1.08);
    }
  }

  @keyframes ef-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ef__vis *,
    .ef-diff * {
      animation: none !important;
      transition: none !important;
    }
  }

  /* ── Связка с QODEX TONN: широкая плитка под бенто ─────── */
  .ef__next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'text diff'
      'more diff';
    align-items: center;
    gap: 24px clamp(28px, calc(var(--vw) * 4.4), 72px);
    margin-top: var(--ef-gap);
    padding: clamp(24px, calc(var(--vw) * 2.8), 40px);
    border-radius: calc(var(--r-lg) * var(--rk));
    corner-shape: var(--corner);
    background: var(--card);
  }

  .ef__next-text {
    grid-area: text;
    align-self: end;
  }

  /* «+» держится за меткой TONN: если меткам тесно в строке, на новую строку уходят вместе */
  .ef__labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }

  .ef__pair {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .ef__plus {
    display: inline-flex;
    color: var(--subtle);
  }

  .ef__next-title {
    margin-top: 20px;
    font-size: clamp(1.35rem, calc(var(--vw) * 2), 1.75rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 560;
    text-wrap: balance;
  }

  .ef__next-p {
    max-width: 52ch;
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  .ef__next-more {
    grid-area: more;
    align-self: start;
  }

  /* ссылка невысокая: область нажатия больше её самой — не меньше 44 px */
  .ef__next-more a {
    position: relative;
  }

  .ef__next-more a::after {
    content: '';
    position: absolute;
    inset: -10px -8px -8px;
  }

  /* 100 → 60: две полосы, недостающая часть — пунктиром */
  .ef-diff {
    grid-area: diff;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr) max-content;
    align-items: center;
    gap: 14px 16px;
    padding: clamp(20px, calc(var(--vw) * 2.2), 28px) clamp(18px, calc(var(--vw) * 2.2), 28px)
      clamp(14px, calc(var(--vw) * 1.6), 20px);
    border-radius: calc(var(--r) * var(--rk));
    corner-shape: var(--corner);
    background: var(--bg);
  }

  .ef-diff__bar {
    position: relative;
    height: 10px;
  }

  .ef-diff__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    border-radius: 999px;
    background: var(--ink);
    transform-origin: 0 50%;
  }

  .ef-diff__fill--60 {
    width: 60%;
  }

  /* недостающая часть — пустая красная полоса (обводка и скобка ниже — внутренней тенью:
     рамку border при дробном масштабе экрана Safari не рисует) */
  .ef-diff__lost {
    position: absolute;
    inset: 0 0 0 calc(60% + 4px);
    border-radius: 999px;
    background: rgb(214 41 59 / 0.1);
    box-shadow: inset 0 0 0 1.5px rgb(196 43 60 / 0.8);
  }

  .ef-diff__n {
    min-width: 2.2ch;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: right;
  }

  .ef-diff__gap {
    grid-column: 2;
    position: relative;
    margin-left: calc(60% + 4px);
    padding-top: 9px;
    font-size: 13px;
    font-weight: 560;
    text-align: center;
    color: #b81f30;
  }

  /* скобка над «разницей»: обводка со всех сторон, верхняя срезана */
  .ef-diff__gap::before {
    content: '';
    position: absolute;
    inset: -3px 1px auto;
    height: 10px;
    border-radius: 0 0 5px 5px;
    box-shadow: inset 0 0 0 1.5px currentColor;
    clip-path: inset(3px 0 0 0);
  }

  /* полосы вырастают, когда рисунок на экране; потом проявляется недостающая часть */
  .ef-diff.is-armed .ef-diff__fill {
    transform: scaleX(0);
  }

  .ef-diff.is-armed .ef-diff__lost,
  .ef-diff.is-armed .ef-diff__gap {
    opacity: 0;
  }

  .ef-diff.is-live .ef-diff__fill {
    transform: none;
    transition: transform 1s var(--ease-out);
  }

  .ef-diff.is-live .ef-diff__fill--60 {
    transition-delay: 0.2s;
  }

  .ef-diff.is-live .ef-diff__lost,
  .ef-diff.is-live .ef-diff__gap {
    opacity: 1;
    transition: opacity 0.5s ease 1.1s;
  }

  /* ── Планшет: два столбца, кадр во всю ширину ────────────── */
  @media (max-width: 1199.98px) {
    .ef {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
    }

    .ef__vis {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .ef__tile {
      min-height: 172px;
    }

    .ef__tile:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 899.98px) {
    .ef__next {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'text'
        'diff'
        'more';
    }
  }

  /* ── Телефон: один столбец, у плиток значок слева, текст справа ── */
  @media (max-width: 699.98px) {
    .ef {
      grid-template-columns: minmax(0, 1fr);
    }

    .ef__tile {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 14px;
      min-height: 0;
      padding: 16px 18px 16px 16px;
    }

    .ef__ico {
      width: 44px;
      height: 44px;
      border-radius: calc(13px * var(--rk));
      corner-shape: var(--corner);
    }

    .ef__text {
      font-size: 1.0625rem;
      text-wrap: pretty;
    }

    .ef__demo {
      top: 12px;
      left: 12px;
    }

    .ef-cam__tag {
      right: 8px;
      bottom: 11px;
      font-size: 11px;
    }

    .ef-cam__count {
      left: 8px;
      bottom: 8px;
      padding: 5px 11px 5px 8px;
      font-size: 13px;
    }

    .ef-cam__det i {
      width: 18px;
      height: 18px;
      font-size: 11px;
    }

    .ef__next {
      padding: 22px 20px;
    }

    .ef__labels {
      gap: 8px;
    }

    /* подписи — над полосами: полосам нужна длина */
    .ef-diff {
      grid-template-columns: minmax(0, 1fr) max-content;
      gap: 8px 14px;
      padding: 18px 18px 14px;
    }

    .ef-diff__label {
      grid-column: 1 / -1;
      margin-top: 8px;
    }

    .ef-diff__label:first-child {
      margin-top: 0;
    }

    .ef-diff__gap {
      grid-column: 1;
    }

    .ef-diff__n {
      font-size: 1.3rem;
    }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Кадр камеры: контейнеры проходят через подъёмник, когда кадр на экране; за экраном сцена
  // возвращается в начало. Рисунок «100 → 60»: полосы вырастают один раз. При «уменьшить движение»
  // классы не ставятся — видно итоговое состояние.
  if (!reducedMotion() && 'IntersectionObserver' in window) {
    const cam = document.querySelector<HTMLElement>('[data-ef-cam]');
    if (cam) {
      cam.classList.add('is-armed');
      new IntersectionObserver(
        ([entry]) => {
          // начинаем, когда видна заметная часть кадра, а сбрасываем — только когда он ушёл целиком
          if (entry.intersectionRatio >= 0.45) cam.classList.add('is-live');
          else if (!entry.isIntersecting) cam.classList.remove('is-live');
        },
        { threshold: [0, 0.45] },
      ).observe(cam);
    }

    const diff = document.querySelector<HTMLElement>('[data-ef-diff]');
    if (diff) {
      diff.classList.add('is-armed');
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          diff.classList.add('is-live');
          io.disconnect();
        },
        { threshold: 0.5 },
      );
      io.observe(diff);
    }
  }
</script>
