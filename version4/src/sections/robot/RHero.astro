</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Выноски на снимке появляются по одной, когда он на экране (один раз). Первый показ — после того,
  // как карточка проявилась при загрузке (1,3 с). При «уменьшить движение» всё видно сразу.
  const vis = document.querySelector<HTMLElement>('[data-rh-vis]');
  if (vis) {
    if (reducedMotion() || !('IntersectionObserver' in window)) {
      delete vis.dataset.rhWait;
    } else {
      let ready = false;
      let seen = false;
      const io = new IntersectionObserver(
        ([entry]) => {
          seen = entry.isIntersecting;
          start();
        },
        { threshold: 0.45 },
      );
      const start = () => {
        if (!ready || !seen || document.hidden) return;
        delete vis.dataset.rhWait;
        io.disconnect();
        document.removeEventListener('visibilitychange', start);
      };
      io.observe(vis);
      document.addEventListener('visibilitychange', start);
      window.setTimeout(() => {
        ready = true;
        start();
      }, 1300);
    }
  }
</script>
