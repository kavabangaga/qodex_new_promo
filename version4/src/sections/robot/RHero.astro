---
// Первый экран страницы «РО-БОТ» [#ro-bot]. Устроен как первые экраны «Кодекса ТКО» и QODEX Tracker:
// большая тёплая панель, по центру — метка продукта, заголовок, подзаголовок, две кнопки, условия пилота
// и три цифры модулей (каждая ведёт к своему разделу).
// Ниже в той же панели — градиентная карточка с настоящим снимком экрана дома в разделе «ГИС ЖКХ» (сверка
// жильцов по ГИС ЖКХ с биллингом; отдельного «Рабочего места» в продукте больше нет — решения принимают здесь же,
// заказчик, 13.10.2026) и две выноски на нём: дельта (главная, цвета РО-БОТа: сколько жильцов оператор не учитывает
// и не начисляет им — заказчик, 13.10.2026, вместо выносок «источник» и «дата») и решение за сотрудником.
// Поверх угла — карточка расхождения кв. 4: её дельта +1 — в рамке дельты, её «обработать →» — в рамке решения.
// Когда окно снимка уже 800 px (телефон и планшет до ~980 px), снимок тоже целиком: выноски — номера 1–2 рядом
// с рамками и легенда под снимком, карточка — под легендой.
import Icon from '../../components/Icon.astro';
import ProductLabel from '../../components/ProductLabel.astro';
import GradientVisual from '../../components/GradientVisual.astro';
import { withBase } from '../../config/site';

const NB = ' ';

// Цифры модулей (тексты с лендинга). Число досчитывается от нуля (data-count), знаки — вне счётчика.
const FIGS = [
  { href: '#gis', pre: '+', num: 10, suf: '%', text: `жильцов в${NB}базе за${NB}один день сверки`, mod: `Модуль${NB}01 · Жильцы` },
  { href: '#obekty', pre: '', num: 480, suf: '', text: `домов вне базы найдено в${NB}одном сельском районе`, mod: `Модуль${NB}02 · Объекты` },
  { href: '#yurlica', pre: '+', num: 26, suf: '%', text: `к${NB}базе договоров с${NB}юрлицами за${NB}одну итерацию`, mod: `Модуль${NB}03 · Юрлица` },
];

// Снимки нового дизайна (3200×1800, заказчик, 13.10.2026), нарезка 800–3200 px: на iPhone и Retina — резкие
const shot = (name: string) => ({
  src: withBase(`/media/robot/${name}-1600.webp`),
  srcset: [800, 1600, 2400, 3200].map((w) => `${withBase(`/media/robot/${name}-${w}.webp`)} ${w}w`).join(', '),
});
const HOUSE = shot('ui-house');
const CARD = shot('ui-card');

// Выноски: рамка вокруг ячеек снимка и подпись под ней, координаты — в пикселях снимка 1600×900.
// Строки таблицы идут через 36 px (кв. 1 — с y 293, кв. 4 — с 401, кв. 7 — с 509), плашки значений в строке —
// от +9 до +28 px от её верха. Подпись стоит на 15 px снимка ниже рамки, строка подписи — 25 px снимка
// (кегль в cqi, поэтому на любом окне с подписями одинаково). Низ рамки — на 29 px ниже верха своей строки:
// тогда подпись из двух строк (70 px) закрывает две следующие строки таблицы целиком, из трёх (95 px) — три,
// и не срезает буквы над собой и под собой.
// «Дельта» — весь столбец Δ от заголовка до кв. 7 (y 266–538), подпись — на кв. 8–9, чуть левее середины
// (tx), чтобы угол не сходился с подписью решения. «Решение» — плашка «обработать →» кв. 4 (y 409–430),
// подпись в три строки на кв. 5–7, шириной 9,5 em (tw): её левый край — между датами ФМС и биллинга
// (x ≈ 1371), а не поперёк плашек дат. Так подписи не встречаются, не наезжают на рамки и не режут значения.
// На узком окне снимка (уже 800 px) вместо подписей — кружок с номером, прикреплённый к рамке снаружи, а не
// на том, на что она указывает: точка (bx, by) на рамке, nt — куда от неё сдвинут кружок (в долях его размера).
// У дельты — над заголовком «Δ» (нижний край кружка — на верхнем крае рамки), у решения — слева от плашки
// «обработать →» (правый край — на левом крае рамки); так на любой ширине телефона кружок не закрывает цель.
// Слова — легендой под снимком.
const MARKS = [
  { lines: ['дельта —', 'неучтённые жильцы'], key: true, x: 1230, y: 266, w: 45, h: 272, tx: '-55%', bx: 1252, by: 266, nt: '0 -50%', end: false }, // столбец Δ
  { lines: ['решение', 'принимает', 'сотрудник'], key: false, x: 1477, y: 409, w: 88, h: 21, tw: '9.5em', bx: 1477, by: 419.5, nt: '-50% 0', end: true }, // «обработать →», кв. 4
];
---

<section class="section panel rh" id="ro-bot" aria-labelledby="ro-bot-title">
  <div class="rh__intro container">
    <div class="rh__label" data-reveal>
      <ProductLabel id="robot" size="lg" />
    </div>
    <h1 class="t-display rh__title" id="ro-bot-title" data-reveal style="--d:1">
      РО-БОТ увеличивает начисления и&nbsp;сбор регионального оператора&nbsp;ТКО
    </h1>
    <p class="t-lead rh__sub" data-reveal style="--d:2">
      Три модуля находят то, что не попало в&nbsp;вашу базу: неучтённых жильцов, объекты жилфонда и&nbsp;юрлица без
      договора. Рост начислений&nbsp;— без роста тарифа и&nbsp;без нагрузки на&nbsp;штат.
    </p>
    <div class="rh__cta" data-reveal style="--d:3">
      <a href="#forma" class="btn btn--primary" data-interest="robot" data-goal="pilot_click">
        Запустить бесплатный пилот
        <Icon name="arrow-right" />
      </a>
      <a href="#kak-eto-rabotaet" class="btn btn--outline">
        Как это работает
        <Icon name="arrow-down" />
      </a>
    </div>
    <p class="rh__note" data-reveal style="--d:3">
      <span>Бесплатно сверим один район в&nbsp;качестве теста</span><span class="rh__note-sep"> · </span><span>Работаем после подписания NDA</span>
    </p>

    <ul class="rh-figs" data-reveal style="--d:4">
      {
        FIGS.map((f) => (
          <li class="rh-figs__item">
            <a class="rh-fig" href={f.href}>
              <span class="rh-fig__num">{f.pre}<span data-count={f.num}>{f.num}</span>{f.suf}</span>
              <span class="rh-fig__text">{f.text}</span>
              <span class="rh-fig__mod">
                <i class="rh-fig__dot" aria-hidden="true" />
                {f.mod}
                <span class="rh-fig__arrow" aria-hidden="true">
                  <Icon name="arrow-down" size={14} strokeWidth={2.2} />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container rh__stage">
    <div class="rh__vis" data-rh-vis data-rh-wait>
      <GradientVisual
        preset="sky"
        deco="bars"
        class="rh__gv"
        label="Экран дома в разделе «ГИС ЖКХ» РО-БОТа (демо-данные): сверка числа жильцов в ГИС ЖКХ с данными биллинга. Ул. Ленина, д. 90 в Уфе: 81 квартира, 325 жильцов по ГИС ЖКХ и 201 по биллингу, дельта +121. По каждой квартире видны число жильцов по ГИС ЖКХ и по биллингу, дельта — неучтённые жильцы, которым не начисляется плата, — даты ФМС и биллинга и статус; решение по расхождению принимает сотрудник. Карточка кв. 4: ГИС 3, биллинг 2, дельта +1, кнопки «Отклонить» и «Обновить в биллинге»."
      >
        <div class="rh-win">
          <!-- окно приложения: снимок и выноски поверх него -->
          <div class="rh-win__screen">
            <div class="rh-win__clip">
              <img
                class="rh-win__img"
                src={HOUSE.src}
                srcset={HOUSE.srcset}
                sizes="(max-width: 640px) calc(100vw - 36px), 1040px"
                width="1600"
                height="900"
                alt="Экран дома в разделе «ГИС ЖКХ» РО-БОТа: ул. Ленина, д. 90 в Уфе — 81 квартира, 325 жильцов по ГИС ЖКХ, 201 по биллингу, дельта +121; к обработке 30, внесено 42, отклонено 9. Таблица квартир: лицевой счёт, площадь, жильцы по ГИС ЖКХ (граждане РФ и иностранцы, проживающие и пребывающие) и по биллингу, дельта, даты ФМС и биллинга, статус «Обновлено», «Отклонено» или «обработать»"
                loading="eager"
                decoding="async"
                draggable="false"
              />
            </div>
            <div class="rh-marks" aria-hidden="true">
              {
                MARKS.map((m, i) => (
                  <span
                    class:list={['rh-mark', { 'rh-mark--end': m.end, 'rh-mark--key': m.key }]}
                    style={`--x:${m.x};--y:${m.y};--w:${m.w};--h:${m.h};--ax:${m.x + m.w / 2};--bx:${m.bx};--by:${m.by};--i:${i}${m.tx ? `;--tip-x:${m.tx}` : ''}${m.tw ? `;--tip-w:${m.tw}` : ''};--nt:${m.nt}`}
                  >
                    <span class="rh-mark__ring" />
                    <span class="rh-mark__caret" />
                    <span class="rh-mark__tip">{m.lines.map((line, j) => (j ? [<br />, line] : line))}</span>
                    <span class="rh-mark__num">{i + 1}</span>
                  </span>
                ))
              }
            </div>
          </div>

          <!-- легенда к номерам на снимке — только на узком окне снимка (уже 800 px) -->
          <ol class="rh-legend" aria-hidden="true">
            {
              MARKS.map((m, i) => (
                <li class:list={['rh-legend__item', { 'rh-legend__item--key': m.key }]} style={`--i:${i}`}>
                  <span class="rh-legend__num">{i + 1}</span>
                  <span>{m.lines.join(' ')}</span>
                </li>
              ))
            }
          </ol>

          <!-- карточка расхождения: правая панель снимка «Карточка», та же кв. 4, что в строке с выноской «решение» -->
          <div class="rh-card">
            <div class="rh-card__clip">
              <img
                class="rh-card__img"
                src={CARD.src}
                srcset={CARD.srcset}
                sizes="1450px"
                width="1600"
                height="900"
                alt="Карточка расхождения: Уфа, ул. Ленина, д. 90, кв. 4 — ГИС 3, биллинг 2, дельта +1; кнопки «Посмотреть в биллинге», «Отклонить» и «Обновить в биллинге», отмечено автоматическое скачивание скриншота при обновлении"
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </div>
          </div>
        </div>
      </GradientVisual>
      <span class="tag tag--demo rh__demo" aria-hidden="true">демо-данные</span>
    </div>
  </div>
</section>

<style>
  /* Отступы панели — как у первых экранов «Кодекса ТКО» и Tracker */
  .rh.panel {
    padding-top: clamp(48px, calc(var(--vw) * 7), 104px);
    padding-bottom: clamp(8px, calc(var(--vw) * 4.2), 72px);
  }

  .rh__intro {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .rh__label {
    margin-bottom: 22px;
  }

  /* заголовок длиннее, чем у соседних страниц: на компьютере кегль чуть меньше — две строки, и весь первый
     экран (с цифрами модулей) помещается в окно 1766×880 */
  .rh__title {
    max-width: 1200px;
    font-size: clamp(2.4rem, calc(var(--vw) * 4.4), 4rem);
  }

  .rh__sub {
    max-width: 860px;
    margin-top: 24px;
    text-wrap: balance;
  }

  .rh__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  /* условия пилота — тихая строка под кнопками */
  .rh__note {
    margin-top: 18px;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--muted);
    text-wrap: balance;
  }

  .rh__note-sep {
    padding-inline: 4px;
    white-space: pre;
  }

  /* ── Три цифры модулей: число, подпись, модуль; каждая — ссылка на раздел модуля ── */
  .rh-figs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: min(100%, 1000px);
    margin-top: 40px;
  }

  .rh-figs__item {
    position: relative;
    display: flex;
  }

  /* тонкий разделитель между цифрами */
  .rh-figs__item + .rh-figs__item::before {
    content: '';
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: 0;
    width: 1px;
    background: var(--line-2);
  }

  /* модуль — по нижнему краю: подписи бывают в две и в три строки */
  .rh-fig {
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 28px 10px;
    border-radius: calc(16px * var(--rk));
    corner-shape: var(--corner);
    text-align: center;
  }

  .rh-fig__num {
    font-size: clamp(2.4rem, calc(var(--vw) * 3), 3rem);
    font-weight: 600;
    line-height: 1;
    /* не теснее −0,025em: у табличных «48» в «480» иначе слипаются (DESIGN.md) */
    letter-spacing: -0.025em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .rh-fig__text {
    max-width: 250px;
    font-size: 15px;
    line-height: 1.42;
    color: var(--ink-2);
    text-wrap: balance;
  }

  .rh-fig__mod {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 2px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.2s;
  }

  /* точка цвета продукта */
  .rh-fig__dot {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--c-robot);
  }

  .rh-fig__arrow {
    display: grid;
    transition: transform 0.25s var(--ease-out);
  }

  .rh-fig:hover .rh-fig__mod {
    color: var(--ink);
  }

  .rh-fig:hover .rh-fig__arrow {
    transform: translateY(2px);
  }

  /* ── Градиентная карточка со снимком экрана дома ─────── */
  .rh__stage {
    margin-top: clamp(32px, calc(var(--vw) * 3), 48px);
    animation: rh-in 0.9s var(--ease-out) 0.4s backwards;
  }

  /* карточка стоит у первого экрана, поэтому появляется сразу при загрузке, а не по прокрутке */
  @keyframes rh-in {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
  }

  .rh__vis {
    position: relative;
  }

  /* снизу и слева — место для карточки расхождения, которая выходит за угол снимка */
  .rh__gv {
    min-height: 0;
    padding: 64px 48px 88px;
  }

  /* «демо-данные» в углу градиентной карточки */
  .rh__demo {
    position: absolute;
    z-index: 1;
    top: 20px;
    left: 22px;
    pointer-events: none;
  }

  /* ── Окно приложения: снимок 1600×900 целиком на всех ширинах (кадрировать нельзя — заказчик, 2026-10-08).
     --x0, --y0, --cw, --ch — какая часть снимка видна, в его пикселях; выноски считают место от них же.
     Окно — контейнер (rh-win): от его ширины зависят кегль выносок (cqi) и то, подписи на снимке
     или номера с легендой (@container ниже), как у снимка в «Пилоте» на главной. ── */
  .rh-win {
    --x0: 0;
    --y0: 0;
    --cw: 1600;
    --ch: 900;
    --win-r: 18px;
    container: rh-win / inline-size;
    position: relative;
    width: min(100%, 1040px);
  }

  /* Автомасштаб (окно браузера 1200–1760 px, zoom < 1): окно снимка всегда 1040 px — кегль 13,5 px и без
     контейнера. Safari внутри контейнера применяет zoom к кеглю дважды (то же у «Пилота» на главной) */
  :global(html.is-autoscale) .rh-win {
    container-type: normal;
  }

  :global(html.is-autoscale) .rh-mark {
    font-size: 13.5px;
  }

  .rh-win__screen {
    position: relative;
    aspect-ratio: var(--cw) / var(--ch);
    border-radius: var(--win-r);
    background: #fff;
    box-shadow:
      0 0 0 8px rgb(255 255 255 / 0.4),
      var(--shadow-card);
  }

  .rh-win__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    /* страховка для Safari на iPhone: скругление обрезает и слой снимка */
    clip-path: inset(0 round var(--win-r));
  }

  .rh-win__img {
    position: absolute;
    top: calc(var(--y0) / var(--ch) * -100%);
    left: calc(var(--x0) / var(--cw) * -100%);
    width: calc(1600 / var(--cw) * 100%);
    max-width: none;
    height: auto;
    -webkit-user-select: none;
    user-select: none;
  }

  /* Выноски: рамка вокруг ячеек и подпись под ней. Кегль растёт с окном (1,298cqi: 13,5 px при окне 1040 px,
     12 px при 922 px), отступы и размеры подписи — в em, поэтому на любом окне подпись в пикселях снимка
     одинакова (на 15 px ниже рамки, 70 px высотой) и ложится на те же строки таблицы, ничего не срезая. */
  .rh-marks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .rh-mark {
    --tip-x: -50%;
    --mc: var(--ink);
    --mt: rgb(29 29 31 / 0.035);
    position: absolute;
    left: calc((var(--x) - var(--x0)) / var(--cw) * 100%);
    top: calc((var(--y) - var(--y0)) / var(--ch) * 100%);
    width: calc(var(--w) / var(--cw) * 100%);
    height: calc(var(--h) / var(--ch) * 100%);
    font-size: 13.5px;
    font-size: 1.298cqi;
  }

  .rh-mark__ring {
    position: absolute;
    inset: 0;
    border-radius: 0.74em;
    background: var(--mt);
    box-shadow: 0 0 0 2px var(--mc);
  }

  .rh-mark__caret {
    position: absolute;
    top: calc(100% + 0.296em);
    left: calc((var(--ax) - var(--x)) / var(--w) * 100%);
    width: 0.74em;
    height: 0.444em;
    margin-left: -0.37em;
    background: var(--mc);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .rh-mark__tip {
    position: absolute;
    top: calc(100% + 0.74em);
    left: calc((var(--ax) - var(--x)) / var(--w) * 100%);
    display: block;
    width: var(--tip-w, auto);
    padding: 0.444em 0.815em 0.519em;
    border-radius: 0.667em;
    background: var(--mc);
    box-shadow: 0 8px 20px -10px rgb(29 29 31 / 0.6);
    color: #fff;
    font-weight: 560;
    line-height: 1.2;
    white-space: nowrap;
    transform: translateX(var(--tip-x));
  }

  /* главная выноска — дельта, цветом РО-БОТа */
  .rh-mark--key {
    --mc: var(--c-robot);
    --mt: rgb(107 77 255 / 0.08);
  }

  .rh-mark--key .rh-mark__tip {
    box-shadow: 0 8px 20px -10px rgb(107 77 255 / 0.7);
  }

  /* у правого края снимка подпись прижата к правому краю рамки */
  .rh-mark--end {
    --tip-x: 0;
  }

  .rh-mark--end .rh-mark__tip {
    left: auto;
    right: -2px;
  }

  /* номер выноски и легенда к номерам — только на узком окне снимка (@container ниже) */
  .rh-mark__num,
  .rh-legend {
    display: none;
  }

  /* Карточка расхождения — правая панель снимка «Карточка» (x 1234–1600, y 0–412: до подписи под кнопками) */
  .rh-card {
    position: absolute;
    z-index: 1;
    left: -58px;
    bottom: -52px;
    width: 330px;
    border-radius: 16px;
    background: #fff;
    box-shadow:
      0 0 0 6px rgb(255 255 255 / 0.5),
      var(--shadow-float);
  }

  .rh-card__clip {
    position: relative;
    aspect-ratio: 366 / 412;
    overflow: hidden;
    border-radius: inherit;
    clip-path: inset(0 round 16px);
  }

  .rh-card__img {
    position: absolute;
    top: 0;
    left: calc(1234 / 366 * -100%);
    width: calc(1600 / 366 * 100%);
    max-width: none;
    height: auto;
    -webkit-user-select: none;
    user-select: none;
  }

  /* ── Движение: когда снимок на экране, выноски появляются по одной (0 и 0,7 с; подпись второй готова к 1,5 с),
     затем снизу выезжает карточка расхождения. Один раз; без анимации всё видно сразу. ── */
  @media (prefers-reduced-motion: no-preference) {
    .rh-mark__ring {
      transition:
        opacity 0.5s ease,
        transform 0.7s var(--ease-out);
      transition-delay: calc(var(--i) * 0.7s);
    }

    .rh-mark__caret,
    .rh-mark__tip,
    .rh-mark__num,
    .rh-legend__item {
      transition:
        opacity 0.5s ease,
        transform 0.6s var(--ease-out);
      transition-delay: calc(var(--i) * 0.7s + 0.2s);
    }

    .rh-card {
      transition:
        opacity 0.7s ease,
        transform 0.9s var(--ease-out);
      transition-delay: 1.5s;
    }

    /* до показа: data-rh-wait снимает скрипт ниже */
    .rh__vis[data-rh-wait] .rh-mark__ring {
      opacity: 0;
      transform: scale(1.18);
    }

    .rh__vis[data-rh-wait] .rh-mark__caret {
      opacity: 0;
      transform: translateY(6px);
    }

    .rh__vis[data-rh-wait] .rh-mark__tip {
      opacity: 0;
      transform: translate(var(--tip-x), 6px);
    }

    .rh__vis[data-rh-wait] .rh-mark__num {
      opacity: 0;
      transform: scale(0.5);
    }

    .rh__vis[data-rh-wait] .rh-legend__item {
      opacity: 0;
      transform: translateY(6px);
    }

    .rh__vis[data-rh-wait] .rh-card {
      opacity: 0;
      transform: translateY(28px) scale(0.98);
    }
  }

  @media (scripting: none) {
    .rh__vis[data-rh-wait] .rh-mark__ring,
    .rh__vis[data-rh-wait] .rh-mark__caret,
    .rh__vis[data-rh-wait] .rh-mark__tip,
    .rh__vis[data-rh-wait] .rh-mark__num,
    .rh__vis[data-rh-wait] .rh-legend__item,
    .rh__vis[data-rh-wait] .rh-card {
      opacity: 1;
      transform: none;
    }

    .rh__vis[data-rh-wait] .rh-mark__tip {
      transform: translateX(var(--tip-x));
    }
  }

  /* ── Планшет: карточка расхождения — под снимком, с заходом на его нижний край. Когда окно снимка уже 800 px
     (планшет до ~980 px и телефон), она под легендой номеров, без захода — см. @container rh-win ниже ── */
  @media (max-width: 1199.98px) {
    .rh-figs {
      margin-top: 36px;
    }

    .rh-fig {
      padding-inline: 18px;
    }

    .rh__gv {
      padding: 64px clamp(10px, calc(var(--vw) * 3), 40px) clamp(18px, calc(var(--vw) * 3.6), 40px);
    }

    .rh-card {
      position: relative;
      left: auto;
      bottom: auto;
      width: min(320px, 56%);
      margin: -40px 0 0 -12px;
    }
  }

  @media (max-width: 760px) {
    /* цифры столбиком: число слева, подпись и модуль справа */
    .rh-figs {
      grid-template-columns: minmax(0, 1fr);
      width: min(100%, 460px);
      margin-top: 32px;
      border-top: 1px solid var(--line-2);
    }

    .rh-figs__item {
      border-bottom: 1px solid var(--line-2);
    }

    .rh-figs__item + .rh-figs__item::before {
      display: none;
    }

    .rh-fig {
      grid-template-columns: 104px minmax(0, 1fr);
      grid-template-rows: auto auto;
      justify-items: start;
      align-items: center;
      gap: 4px 16px;
      padding: 16px 4px;
      text-align: left;
    }

    .rh-fig__num {
      grid-row: span 2;
      font-size: 2.25rem;
    }

    .rh-fig__text {
      max-width: none;
      text-wrap: pretty;
    }

    .rh-fig__mod {
      margin-top: 0;
      font-size: 13px;
    }
  }

  @media (max-width: 640px) {
    /* кегль по ширине телефона: от 360 px заголовок в четыре строки, «РО-БОТ увеличивает» — первой строкой
       (при 9vw на 360–375 px он рвался на пять строк, «РО-БОТ» и «увеличивает» — по одному слову в строке) */
    .rh__title {
      font-size: clamp(1.85rem, calc(var(--vw) * 8.5), 2.6rem);
    }

    .rh__cta {
      display: grid;
      width: 100%;
    }

    /* условия — две строки без точки */
    .rh__note {
      display: grid;
      gap: 2px;
      font-size: 14px;
    }

    .rh__note-sep {
      display: none;
    }

    .rh__stage {
      padding-inline: 8px;
    }

    .rh__gv {
      --gv-r: 22px;
      padding: 54px 10px 18px;
    }

    .rh__demo {
      top: 14px;
      left: 14px;
    }

    /* снимок целиком, во всю ширину карточки */
    .rh-win {
      --win-r: 12px;
    }

    .rh-win__screen {
      box-shadow:
        0 0 0 5px rgb(255 255 255 / 0.4),
        var(--shadow-card);
    }

    /* карточка расхождения — под легендой, снимок не закрывает */
    .rh-card {
      width: min(296px, 86%);
      margin: 14px auto 0;
      border-radius: 14px;
      box-shadow:
        0 0 0 5px rgb(255 255 255 / 0.5),
        var(--shadow-float);
    }

    .rh-card__clip {
      clip-path: inset(0 round 14px);
    }
  }

  /* ── Узкое окно снимка (уже 800 px: телефон и планшет до ~980 px): подписи были бы мельче 10,4 px — вместо них
     тонкая рамка вокруг ячеек и кружок с номером, слова — легендой под снимком; карточка расхождения — под
     легендой, по центру ── */
  @container rh-win (max-width: 799.98px) {
    .rh-mark__ring {
      border-radius: 3px;
      box-shadow: 0 0 0 1.5px var(--mc);
    }

    .rh-mark__caret,
    .rh-mark__tip {
      display: none;
    }

    .rh-mark__num {
      position: absolute;
      left: calc((var(--bx) - var(--x)) / var(--w) * 100%);
      top: calc((var(--by) - var(--y)) / var(--h) * 100%);
      display: grid;
      place-items: center;
      width: 14px;
      height: 14px;
      margin: -7px 0 0 -7px;
      border-radius: 50%;
      translate: var(--nt, 0 0);
      background: var(--mc);
      box-shadow:
        0 0 0 1.5px #fff,
        0 3px 8px -3px rgb(29 29 31 / 0.6);
      color: #fff;
      font-size: 9.5px;
      font-weight: 600;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    /* легенда под снимком: те же номера и слова выносок */
    .rh-legend {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
      margin-top: 16px;
    }

    .rh-legend__item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 9px 4px 5px;
      border-radius: calc(8px * var(--rk));
      corner-shape: var(--corner);
      background: rgb(255 255 255 / 0.85);
      color: var(--ink);
      font-size: 13px;
      font-weight: 500;
      line-height: 1.25;
    }

    .rh-legend__num {
      display: grid;
      flex: none;
      place-items: center;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--ink);
      color: #fff;
      font-size: 9.5px;
      font-weight: 600;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    .rh-legend__item--key .rh-legend__num {
      background: var(--c-robot);
    }

    .rh-card {
      margin: 14px auto 0;
    }
  }

  /* на узком телефоне снимок меньше — кружок на 2 px меньше */
  @container rh-win (max-width: 399.98px) {
    .rh-mark__num {
      width: 12px;
      height: 12px;
      margin: -6px 0 0 -6px;
      font-size: 8.5px;
    }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Выноски на снимке появляются по одной, когда он на экране (один раз). Первый показ — после того,
  // как карточка проявилась при загрузке (1,3 с). При «уменьшить движение» всё видно сразу.
  const vis = document.querySelector<HTMLElement>('[data-rh-vis]');
  if (vis) {
    if (reducedMotion() || !('IntersectionObserver' in window)) {
      delete vis.dataset.rhWait;
    } else {
      let ready = false;
      let seen = false;
      const io = new IntersectionObserver(
        ([entry]) => {
          seen = entry.isIntersecting;
          start();
        },
        { threshold: 0.45 },
      );
      const start = () => {
        if (!ready || !seen || document.hidden) return;
        delete vis.dataset.rhWait;
        io.disconnect();
        document.removeEventListener('visibilitychange', start);
      };
      io.observe(vis);
      document.addEventListener('visibilitychange', start);
      window.setTimeout(() => {
        ready = true;
        start();
      }, 1300);
    }
  }
</script>
