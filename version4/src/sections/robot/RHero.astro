  }

  @media (max-width: 640px) {
    /* кегль по ширине телефона: от 360 px заголовок в четыре строки, «РО-БОТ увеличивает» — первой строкой
       (при 9vw на 360–375 px он рвался на пять строк, «РО-БОТ» и «увеличивает» — по одному слову в строке) */
    .rh__title {
