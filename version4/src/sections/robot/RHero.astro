    /* условия — две строки без точки */
    .rh__note {
      display: grid;
      gap: 2px;
      font-size: 14px;
    }

    .rh__note-sep {
      display: none;
    }

    .rh__stage {
      padding-inline: 8px;
    }

    .rh__gv {
      --gv-r: 22px;
      padding: 54px 10px 18px;
    }

    .rh__demo {
      top: 14px;
      left: 14px;
    }

    /* снимок целиком, во всю ширину карточки; выноски — тонкая рамка вокруг ячеек и кружок с номером */
    .rh-win {
      --win-r: 12px;
    }

    .rh-win__screen {
      box-shadow:
        0 0 0 5px rgb(255 255 255 / 0.4),
