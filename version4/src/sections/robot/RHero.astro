      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    /* на узком телефоне снимок меньше: кружок на 2 px меньше — встаёт между «5» и «3», не закрывая их */
    @media (max-width: 420px) {
      .rh-mark__num {
