---
// Раздел страницы «РО-БОТ» [#interfeys] — «Интерфейс РО-БОТа». Тур по семи настоящим экранам продукта
// нового дизайна (снимки 3200×1800 от заказчика, 13.10.2026; данные на них — демо): отчёты, «ГИС ЖКХ» — регион,
// улица, дом и карточка квартиры (отдельного «Рабочего места» больше нет, решения принимают в «ГИС ЖКХ»),
// затем экраны модулей 02 и 03 — «Новые помещения» и «Поиск юрлиц».
// Снимок экрана — главный в разделе, поэтому он крупный, но не шире 920 px: вместе со шкалой над ним
// помещается в окно под шапкой на 2K и FHD (переключение пункта видно рядом со снимком).
// Над ним — семь пунктов в ряд (FeatureAccordion): полоса прогресса сверху и заголовок экрана, а текст открытого
// пункта — одной строкой под рядом, как подпись над сценой в «Алгоритме работы» QODEX Tracker (в колонке
// шириной 140 px текст занял бы шесть строк). Пункты переключаются сами (6 с), снимок меняется вместе с ними
// ([data-acc-scope]). Уже 1200 px: снимок сверху во всю ширину, под ним пункты обычным списком.
// Подложка — пресет dusk, собрана классами .gv, а не компонентом GradientVisual: компонент прячет
// содержимое от скринридера, а у настоящих снимков экрана есть смысловые подписи (alt).
import SectionIntro from '../../components/SectionIntro.astro';
import FeatureAccordion, { type AccItem } from '../../components/FeatureAccordion.astro';
import { withBase } from '../../config/site';
import GvBlobs from '../../components/GvBlobs.astro';

const NB = String.fromCharCode(160); // неразрывный пробел

interface Screen extends AccItem {
  file: string;
  alt: string;
}

// Заголовки и тексты первых пяти пунктов — с лендинга дословно; пункты модулей 02 и 03 написаны по их экранам
const SCREENS: Screen[] = [
  {
    icon: 'banknote',
    title: 'Видно, сколько денег приносит сверка',
    text: 'Не отчёт ради отчёта — вы видите потенциал доначислений в рублях.',
    file: 'ui-reports',
    alt:
      'Экран «Отчёты и аналитика» за июнь 2026 по Республике Башкортостан: потенциальный прирост начислений ' +
      '+464 тыс. ₽ в месяц (5,6 млн ₽ в год), прирост по внесённым записям +234 тыс. ₽ в месяц; найдено ' +
      '604 лицевых счёта с расхождениями, обработано оператором 392, внесено в биллинг 305, отклонено 87; ' +
      'причины отклонений и динамика за период',
  },
  {
    icon: 'map',
    title: `Весь регион как на${NB}ладони`,
    text: 'Сразу понятно, где работа идёт, а где встала.',
    file: 'ui-regions',
    alt:
      'Экран «ГИС ЖКХ» по Башкортостану: 8 городов, 174 дома, 5789 квартир, 23 197 жильцов по ГИС ЖКХ ' +
      'и 14 346 по биллингу, дельта +8659; по каждому городу — сколько адресов к обработке, ход выгрузки, ' +
      'сверки и обработки, квартиры, жильцы по ГИС и по биллингу и дельта',
  },
  {
    icon: 'table',
    title: `Неделя ручной${NB}работы — за${NB}пару часов`,
    text: `Сверка ГИС${NB}ЖКХ и вашего биллинга в${NB}одном месте, чтобы сразу увидеть разницу.`,
    file: 'ui-street',
    alt:
      'Экран «ГИС ЖКХ» по улице: ул. Ленина в Уфе — 8 домов, 258 квартир, 1034 жильца по ГИС ЖКХ и 642 ' +
      'по биллингу, дельта +389; кнопки «Выгрузка из ГИС ЖКХ», «Сверить с биллингом» и «Экспорт Excel»; ' +
      'по каждому дому — сколько квартир к обработке, ход выгрузки, сверки и обработки и дельта',
  },
  {
    icon: 'building-2',
    title: `Разница в${NB}жильцах — до${NB}каждой квартиры`,
    text: 'Точность, до которой вручную никто не доходит.',
    file: 'ui-house',
    alt:
      'Экран дома: ул. Ленина, д. 90 — 81 квартира, 325 жильцов по ГИС ЖКХ, 201 по биллингу, дельта +121; ' +
      'вкладки «Все», «К обработке», «Обработанные»; по каждой квартире — лицевой счёт, площадь, жильцы ' +
      'по ГИС ЖКХ (граждане РФ и иностранцы, проживающие и пребывающие) и по биллингу, дельта, даты ФМС ' +
      'и биллинга и статус',
  },
  {
    icon: 'refresh',
    title: `Одна кнопка — и${NB}биллинг обновлён`,
    text: `Скриншот из${NB}ГИС прикладывается сам, как доказательство.`,
    file: 'ui-card',
    alt:
      'Карточка расхождения по квартире: ул. Ленина, д. 90, кв. 4 — по ГИС 3 жильца, в биллинге 2, ' +
      'разница +1; кнопки «Посмотреть в биллинге», «Отклонить» и «Обновить в биллинге», отмечено ' +
      'автоматическое скачивание скриншота при обновлении',
  },
  {
    icon: 'map-pin',
    title: `Дома вне базы — с${NB}кадастром и${NB}картой`,
    text: `ФИАС, кадастр, ГИС${NB}ЖКХ и${NB}биллинг в${NB}одной карточке: у${NB}каждого значения виден источник.`,
    file: 'ui-premises',
    alt:
      'Экран «Новые помещения»: поиск объектов без начислений из ФИАС, КПТ, ГИС ЖКХ и Excel; очереди ' +
      '«На проверку», «В работе», «К начислению», «Отклонено»; карточка ул. Волочаевская, д. 18 в Ишимбае — ' +
      'кадастровый номер, площадь 3937,4 м², управляющая организация, 127 проживающих по ГИС ЖКХ, лицевой ' +
      'счёт в биллинге не найден; карта: Яндекс, 2ГИС и кадастр',
  },
  {
    icon: 'store',
    title: `Юрлица без${NB}договора — с${NB}ИНН и${NB}ОКВЭД`,
    text: `Сведения из${NB}ЕГРЮЛ и${NB}точки с${NB}Яндекс${NB}Карт и${NB}2ГИС — всё, что нужно для${NB}договора.`,
    file: 'ui-legal',
    alt:
      'Экран «Поиск юрлиц»: точки юрлиц и ИП по адресам из ЕГРЮЛ, Яндекс Карт и 2ГИС; очереди «На проверке», ' +
      '«В работе», «К договору», «Отклонено»; карточка индивидуального предпринимателя на ул. Губкина, д. 65 ' +
      'в Ишимбае — ИНН, ОГРН, состояние, вид деятельности по ОКВЭД, категория норматива; договор не заключён',
  },
];

const items: AccItem[] = SCREENS.map(({ icon, title, text }) => ({ icon, title, text }));
const src = (file: string, w: number) => withBase(`/media/robot/${file}-${w}.webp`);
---

<section class="section rif" id="interfeys" aria-labelledby="interfeys-title">
  <div class="container">
    <SectionIntro eyebrow="Как это выглядит" titleId="interfeys-title">Интерфейс РО-БОТа</SectionIntro>

    <div class="rif__tour" data-acc-scope>
      <div class="rif__steps" data-reveal style="--d:2">
        <FeatureAccordion id="robot-ui" items={items} ms={6000} color="var(--g-blue)" />
      </div>

      <div class="rif__visual" data-reveal style="--d:3">
        <div class="gv gv--dusk gv--blobs rif__gv">
          <GvBlobs preset="dusk" />
          <div class="rif-panes" data-panes>
            {
              SCREENS.map((s, i) => (
                <div class:list={['rif-pane', { 'is-active': i === 0 }]} data-pane aria-hidden={i === 0 ? 'false' : 'true'}>
                  <div class="rif-frame">
                    <img
                      class="rif-frame__img"
                      src={src(s.file, 1600)}
                      srcset={[800, 1600, 2400, 3200].map((w) => `${src(s.file, w)} ${w}w`).join(', ')}
                      sizes="(max-width: 1199.98px) calc(100vw - 48px), 920px"
                      width="1600"
                      height="900"
                      alt={`Демо-данные. ${s.alt}`}
                      loading="lazy"
                      decoding="async"
                      draggable="false"
                    />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        {/* скринридеру пометку читает начало alt каждого снимка: плашка вне панелей прозвучала бы после снимка */}
        <span class="tag tag--demo rif__demo" aria-hidden="true">демо-данные</span>
      </div>
    </div>
  </div>
</section>

<style>
  .rif__tour {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .rif__visual {
    position: relative;
    min-width: 0;
  }

  /* подложка по размеру снимка: верхнее поле выше остальных — в нём плашка «демо-данные»
     и 8–12 px воздуха до белого кольца рамки */
  .rif__gv {
    min-height: 0;
    padding: clamp(14px, calc(var(--vw) * 3), 52px);
    padding-top: 58px;
  }

  /* 920 px: шкала и снимок с рамкой целиком помещаются в окно под шапкой — на 2K (800 px) и на FHD
     (758 px раскладки; там за краем окна остаётся только часть нижнего поля подложки) */
  .rif-panes {
    width: min(100%, 920px);
  }

  /* снимок экрана в белой рамке, как карточки .ui на градиенте */
  .rif-frame {
    overflow: hidden;
    border-radius: 16px;
    background: #fff;
    box-shadow:
      0 0 0 8px rgb(255 255 255 / 0.4),
      var(--shadow-card);
  }

  .rif-frame__img {
    display: block;
    width: 100%;
    height: auto;
    -webkit-user-select: none;
    user-select: none;
  }

  /* заголовки пунктов без «висящего» последнего слова */
  .rif__steps :global(.acc__head > span) {
    text-wrap: balance;
  }

  .rif__demo {
    position: absolute;
    z-index: 1;
    top: clamp(14px, calc(var(--vw) * 1.3), 18px);
    left: clamp(14px, calc(var(--vw) * 1.3), 18px);
    pointer-events: none;
  }

  /* ── Широкий экран: семь пунктов в ряд над снимком ─────────
     Полоса прогресса — сверху пункта, как отрезок шкалы. Пункты (.acc__item) раскрыты в сетку ряда
     (display: contents): заголовки — в своих колонках первой строки, тексты всех пунктов — в одной ячейке
     второй строки во всю ширину, друг под другом; виден текст открытого. Высота ячейки — по самому длинному
     тексту, поэтому ряд не меняет высоту при переключении и снимок под ним не прыгает. ── */
  @media (min-width: 1200px) {
    .rif__steps :global(.acc) {
      position: relative;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      column-gap: 18px;
      border-top: 0;
    }

    .rif__steps :global(.acc__item) {
      display: contents;
    }

    .rif__steps :global(.acc__head) {
      grid-row: 1;
      align-items: flex-start;
      gap: 10px;
      padding: 14px 0 0;
      border-top: 2px solid var(--line-2);
      font-size: 1rem;
      line-height: 1.3;
      color: var(--muted);
    }

    .rif__steps :global(.acc__head:hover),
    .rif__steps :global(.acc__item.is-open .acc__head) {
      color: var(--ink);
    }

    /* в узкой колонке значок отнимал бы место у заголовка — в ряду только текст, как на шкале шагов */
    .rif__steps :global(.acc__head svg) {
      display: none;
    }

    /* полоса прогресса — поверх серой линии над заголовком своего пункта: колонку задаёт ячейка сетки.
       Конец ячейки — явно (span 1): у абсолютно позиционированного элемента auto — это край всей сетки */
    .rif__steps :global(.acc__progress) {
      grid-row: 1 / span 1;
      top: 0;
      bottom: auto;
      height: 2px;
    }

    .rif__steps :global(.acc__item:nth-child(1) > *) {
      grid-column: 1 / span 1;
    }

    .rif__steps :global(.acc__item:nth-child(2) > *) {
      grid-column: 2 / span 1;
    }

    .rif__steps :global(.acc__item:nth-child(3) > *) {
      grid-column: 3 / span 1;
    }

    .rif__steps :global(.acc__item:nth-child(4) > *) {
      grid-column: 4 / span 1;
    }

    .rif__steps :global(.acc__item:nth-child(5) > *) {
      grid-column: 5 / span 1;
    }

    .rif__steps :global(.acc__item:nth-child(6) > *) {
      grid-column: 6 / span 1;
    }

    .rif__steps :global(.acc__item:nth-child(7) > *) {
      grid-column: 7 / span 1;
    }

    .rif__steps :global(.acc__item > .acc__body) {
      grid-row: 2;
      grid-column: 1 / -1;
      grid-template-rows: 1fr;
      margin-top: 14px;
      opacity: 0;
      transition:
        opacity 0.4s var(--ease-out),
        visibility 0s linear 0.4s;
    }

    .rif__steps :global(.acc__item.is-open .acc__body) {
      opacity: 1;
      transition-delay: 0s;
    }

    .rif__steps :global(.acc__inner > p) {
      padding: 0;
      font-size: 1.0625rem;
      line-height: 1.5;
      text-wrap: pretty;
    }
  }

  /* ── Уже 1200 px: снимок сверху во всю ширину, под ним пункты списком ── */
  @media (max-width: 1199.98px) {
    .rif__visual {
      order: -1;
    }
  }

  @media (max-width: 620px) {
    .rif__gv {
      padding: 52px 14px 14px;
    }

    /* снимок целиком, в своих пропорциях (без обрезки рамкой 4:3 — заказчик, 2026-10-08) */
    .rif-frame {
      border-radius: 12px;
      box-shadow:
        0 0 0 5px rgb(255 255 255 / 0.4),
        var(--shadow-card);
    }
  }
</style>
