<script>
  import { reducedMotion } from '../../scripts/motion';

  // Макет «Юрлица без договора»: сцена идёт, когда карточка на экране, и сбрасывается, когда она ушла целиком.
  // Счётчик «Найдено» растёт от 0 до 247 вместе со строками. При «уменьшить движение» классы не ставятся —
  // видно итоговое состояние.
  if (!reducedMotion() && 'IntersectionObserver' in window) {
    const scene = document.querySelector<HTMLElement>('[data-rlg-scene]');
    const num = scene?.querySelector<HTMLElement>('[data-rlg-count]');
    if (scene && num) {
      const target = Number(num.dataset.rlgCount);
      const T0 = 800;
      const T1 = 2600;
      let raf = 0;
      const show = (v: number) => {
        num.textContent = String(Math.round(v));
      };
      const run = () => {
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min(1, Math.max(0, (now - start - T0) / (T1 - T0)));
          show(target * (1 - Math.pow(1 - t, 3)));
          if (t < 1) raf = requestAnimationFrame(tick);
        };
        raf = requestAnimationFrame(tick);
      };

      scene.classList.add('is-armed');
      show(0);
      new IntersectionObserver(
        ([entry]) => {
          if (entry.intersectionRatio >= 0.45) {
            if (scene.classList.contains('is-live')) return;
            scene.classList.add('is-live');
            run();
          } else if (!entry.isIntersecting) {
            cancelAnimationFrame(raf);
            scene.classList.remove('is-live');
            show(0);
          }
        },
        { threshold: [0, 0.45] },
      ).observe(scene);
    }
  }
</script>
