---
// Блок 14. О компании: заголовок и текст по центру, хронология — цепочка карточек со «звеньями»
// в горизонтальной ленте со scroll-snap (без закрепления экрана), ниже — плитки клиентов,
// соединённые перемычками, как плитки интеграций у Calendly (пока вместо логотипов — названия).
import SectionIntro from '../components/SectionIntro.astro';
import Icon from '../components/Icon.astro';
import { TIMELINE } from '../data/timeline';

const clients: { name: string; partner?: boolean }[] = [
  { name: 'РО «Эко-Сити»' },
  { name: 'Башкирская содовая компания' },
  { name: 'ООО «НУР»' },
  { name: 'ЭкоВторИндустрия' },
  { name: 'Управление отходами Мелеуз' },
  { name: 'ЭКОИндустрия' },
  { name: 'Альянс групп' },
  { name: 'Экотех Мелеуз' },
  { name: 'Грин Сити' },
  { name: 'Ростелеком', partner: true },
];

// Названия продуктов и «РО «…»» не разрываем переносом (сами тексты — без изменений)
const nb = (t: string) =>
  t.replace(/(QODEX|Кодекс) (TONN|Tracker|ТКО)/g, '$1\u00a0$2').replace(/(^|\s)(РО|ООО) «/g, '$1$2\u00a0«');
---

<section class="section panel about" id="o-kompanii" aria-labelledby="o-kompanii-title">
  <div class="container">
    <SectionIntro eyebrow="О компании" titleId="o-kompanii-title">
      QODEX — IT-компания из Уфы, 73 клиента работают с нашими продуктами
      <Fragment slot="lead">
        QODEX (ООО «Кодекс Технологии») с 2020 года автоматизирует учёт отходов: от базы начислений регоператора до
        весовой на полигоне и передачи данных во ФГИС УТКО. Резидент Сколково, аккредитованная IT-компания.
      </Fragment>
    </SectionIntro>
  </div>

  <!-- Хронология: лента карточек со «звеньями» -->
  <div class="tl" data-tl>
    <div class="container tl__head">
      <h3 class="tl__title" id="tl-title" data-reveal>Хронология</h3>
      <div class="tl__arrows">
        <button type="button" class="tl__arrow" data-tl-prev aria-label="Назад по хронологии" disabled>
          <Icon name="arrow-left" size={20} />
        </button>
        <button type="button" class="tl__arrow" data-tl-next aria-label="Вперёд по хронологии">
          <Icon name="arrow-right" size={20} />
        </button>
      </div>
    </div>

    <ol class="tl__list" data-tl-list tabindex="0" aria-labelledby="tl-title">
      {
        TIMELINE.map((e, i) => (
          <li class:list={['tl__item', { 'is-pending': e.pending }]} style={`--d:${Math.min(i, 4)}`} data-reveal>
            <p class="tl__year">{e.year}</p>
            {e.when && <p class="tl__when">{e.when}</p>}
            <p class="tl__text">{nb(e.text)}</p>
            {e.pending && (
              <span class="tl__clock" aria-hidden="true">
                <Icon name="clock" size={18} />
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Клиенты: плитки с перемычками -->
  <div class="container">
    <div class="trust">
      <h3 class="trust__title" data-reveal>Нам доверяют:</h3>
      <ul class="logos">
        {
          clients.map((c, i) => (
            <li class="logo" style={`--d:${i % 5}`} data-reveal>
              <span class="logo__name">{nb(c.name)}</span>
              {c.partner && <span class="tag logo__tag">партнёр</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* ── Хронология ───────────────────────────────────────── */
  .tl {
    margin-top: clamp(8px, 1vw, 16px);
  }

  .tl__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .tl__title {
    font-size: 1.25rem;
    font-weight: 560;
    letter-spacing: -0.012em;
  }

  .tl__arrows {
    display: flex;
    gap: 8px;
  }

  .tl__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    transition:
      border-color 0.2s,
      opacity 0.2s,
      transform 0.3s var(--ease-out);
  }

  .tl__arrow:hover:not(:disabled) {
    border-color: var(--ink);
  }

  .tl__arrow:active:not(:disabled) {
    transform: scale(0.95);
  }

  .tl__arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* Лента: первая карточка — по краю контента, справа виден край следующей */
  .tl__list {
    --tl-gap: 24px;
    --tl-pad: max(var(--gutter), (100% - var(--container)) / 2);
    display: flex;
    gap: var(--tl-gap);
    padding: 6px var(--tl-pad) 26px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--tl-pad);
    scrollbar-width: none;
    isolation: isolate;
  }

  .tl__list::-webkit-scrollbar {
    display: none;
  }

  .tl__list:focus-visible {
    outline-offset: -4px;
    border-radius: var(--r);
  }

  .tl__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 0 0 clamp(240px, 19vw, 272px);
    min-height: 240px;
    padding: 24px;
    border-radius: var(--r);
    background: var(--card);
    scroll-snap-align: start;
  }

  /* «звенья» между карточками, как в цепочке Calendly */
  .tl__item + .tl__item::before,
  .tl__item + .tl__item::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: calc(var(--tl-gap) * -1 - 6px);
    width: calc(var(--tl-gap) + 12px);
    height: 20px;
    border-radius: 10px;
    background: var(--line);
  }

  .tl__item + .tl__item::before {
    top: 34px;
  }

  .tl__item + .tl__item::after {
    top: 70px;
  }

  .tl__year {
    font-size: clamp(2.6rem, 3.6vw, 3.4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .tl__when {
    align-self: flex-start;
    padding: 4px 9px;
    border-radius: 7px;
    background: var(--panel-2);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink-2);
  }

  .tl__text {
    font-size: 16.5px;
    line-height: 1.45;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* События 2024–2026 ещё не заполнены — аккуратная пунктирная заглушка */
  .tl__item.is-pending {
    border: 1.5px dashed var(--line-2);
    background: transparent;
  }

  .tl__item.is-pending .tl__year {
    color: var(--subtle);
  }

  .tl__item.is-pending .tl__text {
    color: var(--muted);
  }

  .tl__clock {
    margin-top: auto;
    color: var(--subtle);
  }

  /* ── Клиенты: плитки с перемычками ────────────────────── */
  .trust {
    margin-top: clamp(56px, 7vw, 104px);
    text-align: center;
  }

  .trust__title {
    margin-bottom: 24px;
    font-size: 1.25rem;
    font-weight: 560;
    letter-spacing: -0.012em;
  }

  .logos {
    --lg-gap: clamp(12px, 1.6vw, 20px);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--lg-gap);
    isolation: isolate;
  }

  .logo {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    min-height: clamp(96px, 9vw, 120px);
    padding: 14px 12px;
    border-radius: clamp(18px, 1.8vw, 24px);
    background: var(--card);
    transition: transform 0.4s var(--ease-out);
  }

  .logo:hover {
    transform: translateY(-3px);
  }

  /* перемычки к соседней плитке слева (кроме первой в строке) */
  .logo:not(:nth-child(5n + 1))::before,
  .logo:not(:nth-child(5n + 1))::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: calc(var(--lg-gap) * -1 - 10px);
    width: calc(var(--lg-gap) + 20px);
    height: 14px;
    border-radius: 7px;
    background: var(--card);
  }

  .logo:not(:nth-child(5n + 1))::before {
    top: calc(50% - 17px);
  }

  .logo:not(:nth-child(5n + 1))::after {
    top: calc(50% + 3px);
  }

  .logo__name {
    font-size: clamp(14.5px, 1.25vw, 17px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--ink-2);
    text-wrap: balance;
  }

  .logo__tag {
    font-size: 12px;
  }

  @media (max-width: 699px) {
    .logos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .logo:not(:nth-child(5n + 1))::before,
    .logo:not(:nth-child(5n + 1))::after {
      content: none;
    }

    .logo:nth-child(2n)::before,
    .logo:nth-child(2n)::after {
      content: '';
    }

    .tl__arrows {
      display: none;
    }
  }
</style>

<script>
  import { reducedMotion } from '../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-tl]');

  if (root) {
    const list = root.querySelector<HTMLElement>('[data-tl-list]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-tl-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-tl-next]')!;

    const step = () => {
      const item = list.querySelector<HTMLElement>('.tl__item');
      const gap = parseFloat(getComputedStyle(list).columnGap) || 0;
      return item ? item.offsetWidth + gap : list.clientWidth * 0.8;
    };

    const update = () => {
      const max = list.scrollWidth - list.clientWidth;
      prev.disabled = list.scrollLeft <= 2;
      next.disabled = list.scrollLeft >= max - 2;
    };

    const go = (dir: 1 | -1) =>
      list.scrollBy({ left: dir * step(), behavior: reducedMotion() ? 'auto' : 'smooth' });

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));

    let raf = 0;
    list.addEventListener(
      'scroll',
      () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          update();
        });
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    update();
  }
</script>
