    deco: 'bars',
    accent: 'var(--g-blue)',
    steps: [
      {
        icon: 'file-spreadsheet',
        title: 'Выгрузка базы в Excel',
        text: 'Вы выгружаете базу начислений в Excel — интеграция не нужна.',
      },
      {
        icon: 'scan-search',
        title: `Сверка базы с ГИС${NB}ЖКХ`,
