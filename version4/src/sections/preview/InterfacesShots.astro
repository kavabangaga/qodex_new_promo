];
---

<section class="section ifx" id="interfeysy" aria-labelledby="interfeysy-title">
  <div class="container">
    <SectionIntro eyebrow="Как работают продукты" titleId="interfeysy-title">
      Работающие системы, а не концепция
    </SectionIntro>

    <div class="ifx__list">
      {items.map((it, i) => <ProductHow {...it} flip={i % 2 === 1} from="interfaces" />)}
    </div>
  </div>
</section>

<style>
  .ifx__list {
    display: grid;
    gap: clamp(88px, calc(var(--vw) * 10), 152px);
  }
</style>
