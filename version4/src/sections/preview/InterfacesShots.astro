  {
    id: 'tonn',
    title: 'Кабинет регоператора — начисления площадкам, выполнение терсхемы, акты с фото',
    preset: 'dusk',
    deco: 'bars',
    accent: 'var(--g-lav)',
    steps: [
      {
        icon: 'scan-line',
        title: 'Номер на въезде',
        text: 'Номер машины распознаётся на въезде.',
