      {
        icon: 'scale',
        title: 'Вес и фото кузова',
        text: 'Вес и фото кузова записываются без ручного ввода.',
      },
      {
        icon: 'cloud',
        title: 'Акт сразу в облаке',
        text: 'Акт сразу попадает в облако — задним числом его не исправить.',
      },
      {
        icon: 'bell-ring',
        title: 'Подозрительное взвешивание',
