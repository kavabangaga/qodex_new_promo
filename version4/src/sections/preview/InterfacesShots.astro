---
// Блок 7 «Работающие системы, а не концепция» — главный продуктовый блок v4.
// Как четыре раздела продуктов Calendly (Scheduling → Callie → Notetaker → Payments):
// вступление по центру, затем РО-БОТ, QODEX Tracker, QODEX TONN, Кодекс ТКО подряд,
// текст и картинка чередуются. Якоря #robot, #tracker, #tonn, #kodeks — для «Подробнее» с первого экрана.
import SectionIntro from '../../components/SectionIntro.astro';
import ProductHow from '../../components/preview/ProductHowShots.astro';
import type { AccItem } from '../../components/FeatureAccordion.astro';
import type { ProductId } from '../../config/site';

const NB = ' ';

type Item = {
  id: ProductId;
  /** Подпись к экрану продукта из ТЗ — заголовок раздела. */
  title: string;
  preset: 'sky' | 'aqua' | 'dusk' | 'mint';
  deco: 'bars' | 'stripes';
  accent: string;
  /** «Как работает»: короткое название пункта + шаг из ТЗ дословно. */
  steps: AccItem[];
  benefits: string[];
  note: string;
};

const items: Item[] = [
  {
    id: 'robot',
    title: `Сверка базы начислений с ГИС${NB}ЖКХ — список расхождений с источником и датой`,
