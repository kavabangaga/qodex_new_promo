  }

  @media (max-width: 700px) {
    .pilot__more {
      grid-template-columns: 1fr;
    }
  }

  /* Окно уже ~600 px (телефон и узкий планшет): подписи закрывали бы полснимка — вместо них кружки
     с номерами, слова — легендой под снимком */
  @media (max-width: 760px) {
    .ps-p-win {
      --win-r: 11px;
    }

    .ps-p-win__screen {
      box-shadow:
        0 0 0 5px rgb(255 255 255 / 0.45),
        var(--shadow-card);
    }

    .ps-p-mark__ring {
      border-radius: 3px;
      box-shadow: 0 0 0 1.5px var(--ink);
    }

    .ps-p-mark__caret {
      display: none;
    }

    /* подпись не видна, но остаётся в списке «Обозначения на скриншоте» для чтения с экрана */
    .ps-p-mark__tip {
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      box-shadow: none;
    }

    .ps-p-mark__num {
      position: absolute;
