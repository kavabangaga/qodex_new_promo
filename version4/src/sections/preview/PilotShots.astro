      width: 12px;
      height: 12px;
      margin: -6px 0 0 -6px;
      font-size: 8.5px;
    }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Выноски на снимке появляются по одной, когда он на экране (один раз), — после того как карточка проявилась.
  // При «уменьшить движение» всё видно сразу.
  document.querySelectorAll<HTMLElement>('[data-ps-p-vis]').forEach((vis) => {
    if (reducedMotion() || !('IntersectionObserver' in window)) {
      delete vis.dataset.psPWait;
      return;
    }
    let seen = false;
    const start = () => {
      if (!seen || document.hidden) return;
      io.disconnect();
      document.removeEventListener('visibilitychange', start);
      window.setTimeout(() => delete vis.dataset.psPWait, 500);
    };
    const io = new IntersectionObserver(
      ([entry]) => {
        seen = entry.isIntersecting;
        start();
      },
      { threshold: 0.5 },
    );
    io.observe(vis);
    document.addEventListener('visibilitychange', start);
  });
</script>
