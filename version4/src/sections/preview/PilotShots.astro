      top: calc((var(--by) - var(--y)) / var(--h) * 100%);
      display: grid;
      place-items: center;
      width: 14px;
      height: 14px;
      margin: -7px 0 0 -7px;
      border-radius: 50%;
      background: var(--ink);
      box-shadow:
        0 0 0 1.5px #fff,
