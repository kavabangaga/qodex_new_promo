---
// Блок 9. Истории клиентов — приём Calendly «Real customers. Real results.»:
// градиентная панель во всю ширину, белый заголовок, карусель — в центре большая карточка истории,
// по бокам маленькие карточки соседних историй, соединённые «звеньями». Стрелки и точки,
// автопереключение с паузой при наведении; на телефоне — лента со scroll-snap.
import StoryCard from '../components/StoryCard.astro';
import Icon from '../components/Icon.astro';
import { PRODUCT_ICON } from '../components/ProductLabel.astro';
import type { ProductId } from '../config/site';

const NB = '\u00a0';

type Preset = 'sky' | 'aqua' | 'dusk' | 'mint' | 'lavender' | 'teal';

const STORIES: {
  client: string;
  product: ProductId;
  task: string;
  solution: string;
  resultLead: string;
  resultRest: string;
  preset: Preset;
}[] = [
  {
    client: 'РО «Эко-Сити»',
    product: 'tonn',
    task: 'платить объектам приёма ТКО за реальный вес.',
    solution: 'QODEX TONN на весовых объектов — номер, фото и вес без ручного ввода, акты в облаке.',
    resultLead: `28${NB}млн${NB}₽`,
    resultRest: ` экономии за июнь–декабрь 2021, подключено 10 объектов; более 60${NB}млн${NB}₽ экономии за год.`,
    preset: 'mint',
  },
  {
    client: 'Регоператор',
    product: 'robot',
    task: 'найти юрлица, которые работают без договора на вывоз ТКО, не поднимая тариф.',
    solution: 'сверка базы начислений РО-БОТом.',
    resultLead: '+247',
    resultRest: ` договоров с юрлицами, база выросла с 966 до 1${NB}213. Годовой платёж 9 из 247 найденных юрлиц окупает РО-БОТ.`,
    preset: 'lavender',
  },
  {
    client: 'РО «Эко-Сити»',
    product: 'tracker',
    task: 'видеть, сколько контейнеров реально вывозят на маршрутах.',
    solution: 'камеры на мусоровозах, ИИ считает контейнеры и сверяет с планом маршрута.',
    resultLead: '+17%',
    resultRest: ' контейнеров сверх плана — в среднем 10 на маршруте, которых нет в реестре: левак или клиенты без договора.',
    preset: 'sky',
  },
];

const N = STORIES.length;
---

<section class="section stories" id="istorii" aria-labelledby="istorii-title">
  <div class="stories__band" aria-hidden="true"></div>

  <div class="container">
    <header class="intro stories__intro">
      <h2 class="t-h2" id="istorii-title" data-reveal style="--d:1">Истории клиентов: задача, решение, результат</h2>
    </header>

    <div class="sc" data-stories role="region" aria-roledescription="карусель" aria-label="Истории клиентов" data-reveal style="--d:2">
      <div class="sc__stage">
        {
          (['prev', 'next'] as const).map((side) => (
            <button
              type="button"
              class:list={['sc__side', `sc__side--${side}`]}
              data-sc-side={side}
              tabindex="-1"
              aria-hidden="true"
            >
              {STORIES.map((s, i) => (
                <span
                  class:list={[
                    'sc__mini',
                    'gv',
                    `gv--${s.preset}`,
                    { 'is-shown': side === 'prev' ? i === N - 1 : i === 1 },
                  ]}
                  data-mini={i}
                >
                  <span class="sc__mini-chip">
                    <span class:list={['plabel__ico', `p-${s.product}`]}>
                      <Icon name={PRODUCT_ICON[s.product]} strokeWidth={2} />
                    </span>
                    {s.resultLead}
                  </span>
                </span>
              ))}
            </button>
          ))
        }

        <div class="sc__track" data-sc-track aria-live="off">
          {
            STORIES.map((s, i) => (
              <StoryCard
                class={i === 0 ? 'sc__slide is-active' : 'sc__slide'}
                data-sc-slide
                slideLabel={`${i + 1} из ${N}`}
                client={s.client}
                product={s.product}
                task={s.task}
                solution={s.solution}
                resultLead={s.resultLead}
                resultRest={s.resultRest}
                preset={s.preset}
              >
                <Fragment slot="visual">
                  {s.product === 'tonn' && (
                    <>
                      <div class="sv ui">
                        <p class="sv__head">
                          <span class="sv__ico p-tonn">
                            <Icon name="scale" size={16} strokeWidth={2} />
                          </span>
                          Весовая объекта
                        </p>
                        <p class="sv__label">Номер распознан</p>
                        <p class="sv__plate">
                          <span>А&thinsp;983&thinsp;ВВ</span>
                          <small>102</small>
                        </p>
                        <div class="sv__rows">
                          <div class="ui-row" style="--i:0">
                            <span>Вес нетто</span>
                            <b>9&nbsp;240 кг</b>
                          </div>
                          <div class="ui-row" style="--i:1">
                            <span>Фото</span>
                            <span class="sv__ok">
                              <Icon name="check" size={14} strokeWidth={2.4} />3 кадра
                            </span>
                          </div>
                          <div class="ui-row" style="--i:2">
                            <span>Акт</span>
                            <span class="sv__ok">
                              <Icon name="cloud-upload" size={14} strokeWidth={2.2} />в облаке
                            </span>
                          </div>
                        </div>
                      </div>
                      <span class="sv__chip">Подключено объектов: 10</span>
                    </>
                  )}
                  {s.product === 'robot' && (
                    <>
                      <div class="sv ui">
                        <p class="sv__head">
                          <span class="sv__ico p-robot">
                            <Icon name="user-search" size={16} strokeWidth={2} />
                          </span>
                          Сверка базы начислений
                        </p>
                        <p class="sv__big">
                          Найдено: 247<small>юрлиц без договора</small>
                        </p>
                        <div class="sv__rows">
                          <div class="ui-row" style="--i:0">
                            <span>Магазин, ул. Ленина, 12</span>
                            <span class="tag">нет договора</span>
                          </div>
                          <div class="ui-row" style="--i:1">
                            <span>Кафе, пр. Октября, 5</span>
                            <span class="tag">нет договора</span>
                          </div>
                          <div class="ui-row" style="--i:2">
                            <span>Склад, ул. Заводская, 3</span>
                            <span class="tag">нет договора</span>
                          </div>
                        </div>
                      </div>
                      <span class="sv__chip">База: 966 → 1&nbsp;213</span>
                    </>
                  )}
                  {s.product === 'tracker' && (
                    <>
                      <div class="sv ui">
                        <p class="sv__head">
                          <span class="sv__ico p-tracker">
                            <Icon name="truck" size={16} strokeWidth={2} />
                          </span>
                          Маршрут №&nbsp;14 · камера 2
                        </p>
                        <div class="sv__cam">
                          <span class="sv__bin" style="--x:12%">
                            <i />
                          </span>
                          <span class="sv__bin" style="--x:40%">
                            <i />
                          </span>
                          <span class="sv__bin" style="--x:68%">
                            <i />
                          </span>
                          <span class="sv__cam-tag">Погружено: 3</span>
                        </div>
                        <div class="sv__rows">
                          <div class="ui-row" style="--i:0">
                            <span>План / факт</span>
                            <b>58 / 68</b>
                          </div>
                          <div class="ui-row" style="--i:1">
                            <span>Нет в реестре</span>
                            <span class="tag">10 контейнеров</span>
                          </div>
                        </div>
                      </div>
                      <span class="sv__chip">+17% сверх плана</span>
                    </>
                  )}
                </Fragment>
              </StoryCard>
            ))
          }
        </div>
      </div>

      <div class="sc__nav">
        <button type="button" class="sc__arrow" data-sc-prev aria-label="Предыдущая история">
          <Icon name="arrow-left" size={20} />
        </button>
        <div class="sc__dots">
          {
            STORIES.map((s, i) => (
              <button
                type="button"
                class:list={['sc__dot', { 'is-active': i === 0 }]}
                data-sc-dot={i}
                aria-label={`История ${i + 1} из ${N}: ${s.client}`}
                aria-current={i === 0 ? 'true' : undefined}
              >
                <span class="sc__dot-fill" />
              </button>
            ))
          }
        </div>
        <button type="button" class="sc__arrow" data-sc-next aria-label="Следующая история">
          <Icon name="arrow-right" size={20} />
        </button>
      </div>
    </div>

    <p class="footnote stories__note" data-reveal>
      Кейсы РО-БОТа — разные проекты. Регионы и операторы не раскрываются по условиям соглашений.
    </p>
  </div>
</section>

<style>
  .stories {
    isolation: isolate;
  }

  /* Градиентная панель во всю ширину, как у Calendly: синий сверху (под белым заголовком контраст
     не ниже 3:1) → лавандовый и розовый за карточками → цвет фона внизу. Только цвета палитры. */
  .stories__band {
    position: absolute;
    z-index: -1;
    /* отступ сверху, как поля по бокам: соседняя панель не прилипает */
    top: var(--page-pad);
    left: var(--page-pad);
    right: var(--page-pad);
    height: clamp(760px, 64vw, 940px);
    border-radius: var(--r-2xl);
    overflow: hidden;
    background: var(--g-blue);
  }

  .stories__band::before {
    content: '';
    position: absolute;
    inset: -8%;
    background:
      radial-gradient(34% 30% at 100% 22%, var(--g-lav) 0%, transparent 70%),
      radial-gradient(45% 26% at 88% 62%, var(--g-lav) 0%, transparent 72%),
      radial-gradient(42% 24% at 8% 62%, var(--g-pink-soft) 0%, transparent 72%),
      radial-gradient(30% 20% at 26% 70%, var(--g-pink) 0%, transparent 70%),
      linear-gradient(
        180deg,
        var(--g-deep) 0%,
        var(--g-deep) 8%,
        var(--g-blue) 34%,
        var(--g-lav-2) 56%,
        var(--g-lav-soft) 74%,
        var(--bg) 92%
      );
    filter: blur(40px);
  }

  .stories__band::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, transparent 62%, var(--bg) 92%);
  }

  .stories__intro {
    color: #fff;
  }

  /* ── Карусель ─────────────────────────────────────────── */
  .sc {
    --sc-gap: 24px;
    --sc-ms: 7000ms;
  }

  .sc__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 800px) minmax(0, 1fr);
    align-items: center;
    column-gap: var(--sc-gap);
    isolation: isolate;
  }

  .sc__track {
    position: relative;
    display: grid;
    grid-column: 2;
    grid-row: 1;
  }

  /* Слайды лежат друг на друге, виден активный; уходящий сдвигается в сторону */
  .sc__slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateX(calc(var(--sc-dir, 1) * 36px)) scale(0.985);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.7s var(--ease-out),
      visibility 0s linear 0.5s;
  }

  .sc__slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .sc__slide.is-leaving {
    transform: translateX(calc(var(--sc-dir, 1) * -36px)) scale(0.985);
  }

  /* Боковые карточки соседних историй — белая рамка с градиентом внутри */
  .sc__side {
    position: relative;
    grid-row: 1;
    display: grid;
    width: min(100%, 176px);
    height: clamp(300px, 25vw, 350px);
    padding: 10px;
    border: 0;
    border-radius: 30px;
    background: #fff;
    transition: transform 0.4s var(--ease-out);
  }

  .sc__side:hover {
    transform: translateY(-4px);
  }

  .sc__side--prev {
    grid-column: 1;
    justify-self: end;
  }

  .sc__side--next {
    grid-column: 3;
    justify-self: start;
  }

  /* «Звенья»: две короткие перемычки между боковой и центральной карточкой */
  .sc__side::before,
  .sc__side::after {
    content: '';
    position: absolute;
    z-index: -1;
    width: calc(var(--sc-gap) + 32px);
    height: 18px;
    border-radius: 9px;
    background: #fff;
  }

  .sc__side::before {
    top: calc(50% - 22px);
  }

  .sc__side::after {
    top: calc(50% + 4px);
  }

  .sc__side--prev::before,
  .sc__side--prev::after {
    right: calc((var(--sc-gap) + 16px) * -1);
  }

  .sc__side--next::before,
  .sc__side--next::after {
    left: calc((var(--sc-gap) + 16px) * -1);
  }

  .sc__mini {
    --gv-r: 22px;
    grid-area: 1 / 1;
    min-height: 0;
    align-content: end;
    padding: 12px;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }

  .sc__mini.is-shown {
    opacity: 1;
  }

  .sc__mini-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border-radius: 12px;
    background: #fff;
    box-shadow: var(--shadow-soft);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: var(--ink);
  }

  /* ── Стрелки и точки ──────────────────────────────────── */
  .sc__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: clamp(24px, 3vw, 36px);
  }

  .sc__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    transition:
      background-color 0.2s,
      border-color 0.2s,
      transform 0.3s var(--ease-out);
  }

  .sc__arrow:hover {
    border-color: var(--ink);
  }

  .sc__arrow:active {
    transform: scale(0.95);
  }

  .sc__dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .sc__dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
  }

  /* сама точка — 8 px, у активной — полоса с заполнением по времени */
  .sc__dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: var(--line-2);
    transition: background-color 0.3s;
  }

  .sc__dot:hover::before {
    background: var(--subtle);
  }

  .sc__dot.is-active {
    width: 44px;
  }

  .sc__dot.is-active::before {
    width: 36px;
    background: var(--line-2);
  }

  .sc__dot-fill {
    position: absolute;
    left: 4px;
    top: 8px;
    width: 36px;
    height: 8px;
    border-radius: 4px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }

  .sc__dot.is-active .sc__dot-fill {
    transform: scaleX(1);
  }

  .sc[data-auto] .sc__dot.is-active .sc__dot-fill {
    animation: sc-fill var(--sc-ms) linear both;
  }

  .sc[data-paused] .sc__dot.is-active .sc__dot-fill {
    animation-play-state: paused;
  }

  @keyframes sc-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .stories__note {
    max-width: 640px;
    margin: clamp(20px, 2.4vw, 28px) auto 0;
    text-align: center;
  }

  /* ── Иллюстрации интерфейсов в карточках (содержимое слота) ── */
  .sv {
    width: min(100%, 340px);
    display: grid;
    gap: 12px;
    padding: 20px;
    border-radius: 20px;
  }

  .sv__head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .sv__ico {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: 8px;
    background: var(--pc);
    color: #fff;
  }

  .sv__label {
    margin-bottom: -6px;
    font-size: 13px;
    color: var(--muted);
  }

  /* госномер — демо */
  .sv__plate {
    display: inline-flex;
    align-items: stretch;
    justify-self: start;
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 8px;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .sv__plate span {
    padding: 7px 10px;
  }

  .sv__plate small {
    display: grid;
    place-items: center;
    padding: 0 8px;
    border-left: 2px solid var(--ink);
    font-size: 15px;
  }

  .sv__big {
    display: grid;
    gap: 2px;
    font-size: 28px;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .sv__big small {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }

  .sv__rows {
    display: grid;
    gap: 6px;
  }

  .sv .ui-row {
    padding: 9px 12px;
    font-size: 13.5px;
  }

  .sv .ui-row b {
    font-weight: 600;
    white-space: nowrap;
  }

  .sv .ui-row .tag {
    font-size: 12px;
  }

  .sv__ok {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 560;
    color: var(--ok);
    white-space: nowrap;
  }

  /* кадр с камеры: схематично, контейнеры в рамках распознавания */
  .sv__cam {
    position: relative;
    height: 96px;
    overflow: hidden;
    border-radius: 12px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0) 55%, rgb(7 26 49 / 0.18) 100%),
      linear-gradient(160deg, #cfe0f4 0%, #9fb9d8 60%, #7f9bbd 100%);
  }

  .sv__bin {
    position: absolute;
    left: var(--x);
    bottom: 14px;
    width: 18%;
    height: 54%;
    border: 2px solid var(--blue);
    border-radius: 6px;
  }

  .sv__bin i {
    position: absolute;
    inset: 22% 14% 0;
    border-radius: 4px 4px 2px 2px;
    background: rgb(7 26 49 / 0.55);
  }

  .sv__cam-tag {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 4px 8px;
    border-radius: 7px;
    background: #fff;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
  }

  /* плашка поверх края карточки */
  .sv__chip {
    position: relative;
    z-index: 1;
    justify-self: end;
    margin-top: -16px;
    margin-right: clamp(-8px, -1vw, 0px);
    padding: 9px 14px;
    border-radius: 12px;
    background: #fff;
    box-shadow: var(--shadow-float);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--ink);
  }

  /* у активной истории строки и плашка появляются по очереди */
  .sc__slide.is-active .sv .ui-row {
    animation: sv-in 0.6s var(--ease-out) both;
    animation-delay: calc(0.25s + var(--i, 0) * 0.12s);
  }

  .sc__slide.is-active .sv__chip {
    animation: sv-pop 0.6s var(--ease-out) 0.65s both;
  }

  @keyframes sv-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes sv-pop {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.92);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc__slide.is-active .sv .ui-row,
    .sc__slide.is-active .sv__chip {
      animation: none;
    }
  }

  /* ── Без боковых карточек: ноутбук поуже ──────────────── */
  @media (max-width: 1179px) {
    .sc__stage {
      grid-template-columns: minmax(0, 1fr);
    }

    .sc__track {
      grid-column: 1;
      width: min(100%, 860px);
      justify-self: center;
    }

    .sc__side {
      display: none;
    }
  }

  /* ── Телефон и планшет: лента со scroll-snap ──────────── */
  @media (max-width: 979px) {
    .stories__band {
      height: clamp(640px, 150vw, 820px);
    }

    .sc__track {
      display: flex;
      gap: 12px;
      width: auto;
      justify-self: stretch;
      margin-inline: calc(var(--gutter) * -1);
      padding: 4px var(--gutter) 30px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .sc__track::-webkit-scrollbar {
      display: none;
    }

    .sc__slide,
    .sc__slide.is-leaving {
      flex: 0 0 min(86%, 560px);
      opacity: 1;
      visibility: visible;
      transform: none;
      scroll-snap-align: start;
    }

    /* лента обрезает всё, что за её краем, — тень делаем короткой, чтобы не было видно среза */
    .sc__track .sc__slide {
      box-shadow:
        0 1px 2px rgb(7 26 49 / 0.05),
        0 10px 22px -12px rgb(7 26 49 / 0.22);
    }

    .sc__nav {
      margin-top: 4px;
    }
  }
</style>

<script>
  import { reducedMotion } from '../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-stories]');

  if (root) {
    const track = root.querySelector<HTMLElement>('[data-sc-track]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-sc-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-sc-dot]')];
    const sides = [...root.querySelectorAll<HTMLButtonElement>('[data-sc-side]')];
    const n = slides.length;
    const ms = 7000;
    // карусель с перелистыванием — на широком экране; на узком — лента со scroll-snap
    const strip = window.matchMedia('(max-width: 979px)');

    let index = 0;
    let inView = false;
    let hover = false;
    let focus = false;
    let timer = 0;
    let startedAt = 0;
    let left = ms;

    const canAuto = () => !reducedMotion() && !strip.matches;
    const mod = (i: number) => ((i % n) + n) % n;

    const markDots = () => {
      dots.forEach((d, k) => {
        d.classList.toggle('is-active', k === index);
        if (k === index) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    };

    // перезапуск полосы времени у активной точки
    const restartFill = () => {
      const fill = dots[index]?.querySelector<HTMLElement>('.sc__dot-fill');
      if (!fill) return;
      fill.style.animation = 'none';
      void fill.offsetWidth;
      fill.style.animation = '';
    };

    const stopTimer = () => {
      if (timer) {
        clearTimeout(timer);
        timer = 0;
        left = Math.max(0, left - (performance.now() - startedAt));
      }
    };

    const runTimer = () => {
      if (timer) return;
      startedAt = performance.now();
      timer = window.setTimeout(() => {
        timer = 0;
        go(index + 1, 1, false);
      }, left);
    };

    const sync = () => {
      const active = canAuto() && inView && !hover && !focus;
      root.toggleAttribute('data-auto', canAuto());
      root.toggleAttribute('data-paused', !active);
      if (active) runTimer();
      else stopTimer();
    };

    function go(i: number, dir: 1 | -1, user: boolean) {
      const next = mod(i);
      track.setAttribute('aria-live', user ? 'polite' : 'off');

      if (strip.matches) {
        // лента: просто прокручиваем к карточке
        const s = slides[next];
        track.scrollTo({
          left: s.offsetLeft - parseFloat(getComputedStyle(track).paddingLeft),
          behavior: reducedMotion() ? 'auto' : 'smooth',
        });
        return;
      }

      const prev = index;
      index = next;
      root.style.setProperty('--sc-dir', String(dir));
      void root.offsetWidth; // спрятанные слайды встают с нужной стороны до начала перехода
      slides.forEach((s, k) => {
        s.classList.toggle('is-active', k === index);
        s.classList.toggle('is-leaving', k === prev && prev !== index);
      });
      window.setTimeout(() => slides[prev]?.classList.remove('is-leaving'), 700);
      sides.forEach((side) => {
        const show = side.dataset.scSide === 'prev' ? mod(index - 1) : mod(index + 1);
        side.querySelectorAll<HTMLElement>('[data-mini]').forEach((m) => {
          m.classList.toggle('is-shown', Number(m.dataset.mini) === show);
        });
      });
      markDots();
      restartFill();
      stopTimer();
      left = ms;
      sync();
    }

    root.querySelector('[data-sc-prev]')!.addEventListener('click', () => go(index - 1, -1, true));
    root.querySelector('[data-sc-next]')!.addEventListener('click', () => go(index + 1, 1, true));
    dots.forEach((d, k) => d.addEventListener('click', () => go(k, k >= index ? 1 : -1, true)));
    sides.forEach((side) =>
      side.addEventListener('click', () =>
        side.dataset.scSide === 'prev' ? go(index - 1, -1, true) : go(index + 1, 1, true),
      ),
    );

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(index - 1, -1, true);
      if (e.key === 'ArrowRight') go(index + 1, 1, true);
    });

    root.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      hover = true;
      sync();
    });
    root.addEventListener('pointerleave', () => {
      hover = false;
      sync();
    });
    root.addEventListener('focusin', () => {
      focus = true;
      sync();
    });
    root.addEventListener('focusout', (e) => {
      if (root.contains(e.relatedTarget as Node | null)) return;
      focus = false;
      sync();
    });

    // лента: активная точка — карточка, ближайшая к левому краю
    let raf = 0;
    track.addEventListener(
      'scroll',
      () => {
        if (!strip.matches || raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const pad = parseFloat(getComputedStyle(track).paddingLeft);
          const x = track.scrollLeft + pad;
          let best = 0;
          slides.forEach((s, k) => {
            if (Math.abs(s.offsetLeft - x) < Math.abs(slides[best].offsetLeft - x)) best = k;
          });
          if (best !== index) {
            index = best;
            slides.forEach((s, k) => s.classList.toggle('is-active', k === index));
            markDots();
          }
        });
      },
      { passive: true },
    );

    strip.addEventListener('change', () => {
      slides.forEach((s, k) => {
        s.classList.toggle('is-active', k === index);
        s.classList.remove('is-leaving');
      });
      stopTimer();
      left = ms;
      sync();
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          sync();
        },
        { threshold: 0.35 },
      ).observe(root);
    } else {
      inView = true;
    }
    sync();
  }
</script>
