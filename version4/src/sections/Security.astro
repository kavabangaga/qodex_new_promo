---
// Блок 11. Безопасность, данные и интеграции — приём Calendly «интеграции»: плитки со значками,
// соединённые перемычками (системы — названиями, без гербов и эмблем ведомств), и ниже большие
// карточки с кнопкой ↗ для главных пунктов.
import SectionIntro from '../components/SectionIntro.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { SKOLKOVO_URL } from '../config/site';
import { FAQ } from '../data/faq';

// Пункты «Интеграций» (тексты ТЗ) и системы из них — плитками.
// tone — цвет ленты цепочки: те же три семьи палитры, что у карточек в «Контактах».
const CHAINS: { text: string; tone: 'sky' | 'lav' | 'teal'; systems: { name: string; icon: IconName }[] }[] = [
  {
    text: 'ГИС ЖКХ, Росреестр, ФИАС, ФНС',
    tone: 'sky',
    systems: [
      { name: 'ГИС ЖКХ', icon: 'house' },
      { name: 'Росреестр', icon: 'map' },
      { name: 'ФИАС', icon: 'map-pin' },
      { name: 'ФНС', icon: 'landmark' },
    ],
  },
  {
    text: 'Биллинг и 1С: выгрузка в Excel, запись одной кнопкой',
    tone: 'lav',
    systems: [
      { name: 'Биллинг', icon: 'receipt' },
      { name: '1С', icon: 'calculator' },
      { name: 'Excel', icon: 'file-spreadsheet' },
    ],
  },
  {
    text: 'ФГИС УТКО по API; любые автовесы',
    tone: 'teal',
    systems: [
      { name: 'ФГИС УТКО', icon: 'server' },
      { name: 'Автовесы', icon: 'scale' },
    ],
  },
];

// Ответ в частых вопросах «Где хранятся наши данные?» — якорь вопроса (см. components/Faq.astro)
const dataQ = FAQ.findIndex((f) => f.q === 'Где хранятся наши данные?');
const dataHref = `#faq-${dataQ + 1}`;
const dataLabel = `Ответ в частых вопросах: ${FAQ[dataQ]?.q ?? ''}`;

const CARDS: {
  title: string;
  icon: IconName;
  items: string[];
  href: string;
  label: string;
  external?: boolean;
}[] = [
  {
    title: 'Данные и доступы',
    icon: 'lock',
    items: [
      'Вся чувствительная информация хранится внутри контура вашей организации',
      'Решение по расхождениям принимает ваш сотрудник',
      'NDA, серверы в России',
    ],
    href: dataHref,
    label: dataLabel,
  },
  {
    title: 'Персональные данные',
    icon: 'user-x',
    items: ['Персональные данные не храним', 'Доступы к госсистемам остаются у ваших сотрудников'],
    href: dataHref,
    label: dataLabel,
  },
  {
    title: 'Статус компании',
    icon: 'badge-check',
    items: ['Аккредитованная IT-компания', 'Резидент Сколково'],
    href: SKOLKOVO_URL,
    label: 'Резидент Сколково — открыть на сайте Сколково',
    external: true,
  },
];
---

<section class="section" id="bezopasnost" aria-labelledby="bezopasnost-title">
  <div class="container">
    <SectionIntro eyebrow="Безопасность" titleId="bezopasnost-title">
      Безопасность, данные и интеграции
      <Fragment slot="lead">Ответы на вопросы юриста, службы безопасности и ИТ — до первой встречи.</Fragment>
    </SectionIntro>

    <!-- Интеграции: цепочки плиток, под каждой — пункт ТЗ -->
    <div class="integr">
      <h3 class="integr__title" data-reveal>
        <Icon name="plug" size={20} />
        Интеграции
      </h3>
      <ul class="integr__list">
        {
          CHAINS.map((c, ci) => (
            <li class="integr__item" data-tone={c.tone} style={`--n:${c.systems.length}; --d:${ci + 1}`} data-reveal>
              <div class="tiles bridged" aria-hidden="true">
                {c.systems.map((s, si) => (
                  <span class="tile" style={`--i:${si}`}>
                    <span class="tile__ico">
                      <Icon name={s.icon} size={22} />
                    </span>
                    <span class="tile__name">{s.name}</span>
                  </span>
                ))}
              </div>
              <p class="integr__text">{c.text}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Большие карточки с кнопкой ↗ -->
    <div class="cards">
      {
        CARDS.map((c, i) => (
          <article class="card" style={`--d:${i + 1}`} data-reveal>
            <div class="card__top">
              <span class="card__ico" aria-hidden="true">
                <Icon name={c.icon} size={22} />
              </span>
              <a
                class="arrow-btn card__btn"
                href={c.href}
                aria-label={c.label}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener' : undefined}
              >
                <Icon name="arrow-up-right" />
              </a>
            </div>
            <h3 class="card__title">{c.title}</h3>
            <ul class="card__list">
              {c.items.map((it) => (
                <li>
                  <span class="card__check" aria-hidden="true">
                    <Icon name="check" size={18} strokeWidth={2} />
                  </span>
                  <span>{it}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ── Интеграции: плитки, соединённые перемычками ─────── */
  .integr {
    display: grid;
    justify-items: center;
    gap: clamp(22px, calc(var(--vw) * 2.6), 32px);
  }

  .integr__title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.25rem;
    font-weight: 560;
    letter-spacing: -0.012em;
  }

  .integr__list {
    --tile: clamp(86px, calc(var(--vw) * 7.4), 106px);
    --tile-gap: clamp(10px, calc(var(--vw) * 1.2), 16px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: start;
    gap: 28px clamp(22px, calc(var(--vw) * 3.4), 48px);
  }

  /* Цепочка — одна цветная лента, разрезанная на плитки и мостики: сверху цвет гуще,
     слева направо лента светлеет, в правом нижнем углу мягкий свет. Цвета — у семьи (data-tone). */
  .integr__item {
    --ribbon-w: calc(var(--n) * var(--tile) + (var(--n) - 1) * var(--tile-gap));
    --ribbon:
      linear-gradient(180deg, rgb(var(--deep) / 0.55) 0%, rgb(var(--deep) / 0) 72%),
      radial-gradient(55% 150% at 100% 100%, rgb(var(--glow)) 0%, rgb(var(--glow) / 0) 75%),
      linear-gradient(90deg, var(--from) 0%, var(--to) 100%);
    display: grid;
    justify-items: center;
    gap: 16px;
    width: var(--ribbon-w);
  }

  .integr__item[data-tone='sky'] {
    --deep: 107 177 255; /* --g-sky */
    --glow: 179 220 252;
    --from: #74b6fe;
    --to: #a0cffd;
    --chip-shadow: rgb(30 94 167 / 0.3);
  }

  .integr__item[data-tone='lav'] {
    --deep: 184 159 250; /* --g-lav */
    --glow: 219 205 253;
    --from: #bda6fa;
    --to: #d0befc;
    --chip-shadow: rgb(94 62 190 / 0.28);
  }

  .integr__item[data-tone='teal'] {
    --deep: 93 223 215; /* --g-teal */
    --glow: 178 239 234;
    --from: #6be1da;
    --to: #9ceae4;
    --chip-shadow: rgb(22 120 118 / 0.3);
  }

  .tiles {
    display: flex;
    gap: var(--tile-gap);
    isolation: isolate;
  }

  /* плитка — окно в ленту: рисунок шириной в цепочку сдвинут на место плитки (--i — её номер) */
  .tile {
    --ribbon-x: calc(var(--i) * -1 * (var(--tile) + var(--tile-gap)));
    position: relative;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 9px;
    width: var(--tile);
    aspect-ratio: 1;
    padding: 10px 4px;
    border-radius: calc(clamp(20px, calc(var(--vw) * 2), 26px) * var(--rk));
    corner-shape: var(--corner);
    background-color: var(--to);
    background-image: var(--ribbon);
    background-size: var(--ribbon-w) 100%;
    background-position: var(--ribbon-x) 0;
    background-repeat: no-repeat;
  }

  /* мостик к соседней плитке (маски — .bridged в global.css) */
  .tiles {
    --gap: var(--tile-gap);
  }

  /* у мостика тот же рисунок ленты: он начинается на (зазор + 2px) левее плитки и ниже её верха.
     На плитки мостик заходит на 2px с каждой стороны — на цветном фоне шов в 1px был бы заметен. */
  .tile + .tile::before {
    content: '';
    position: absolute;
    top: calc(50% - (var(--gap) + 12px) / 2);
    left: calc(var(--gap) * -1 - 2px);
    width: calc(var(--gap) + 4px);
    height: calc(var(--gap) + 12px);
    background-color: var(--to);
    background-image: var(--ribbon);
    background-size: var(--ribbon-w) var(--tile);
    background-position: calc(var(--ribbon-x) + var(--gap) + 2px) calc((var(--gap) + 12px - var(--tile)) / 2);
    background-repeat: no-repeat;
    -webkit-mask: var(--bridge-mask-row);
    mask: var(--bridge-mask-row);
  }

  .tile__ico {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: calc(12px * var(--rk));
    corner-shape: var(--corner);
    background: #fff;
    color: var(--ink);
    box-shadow:
      0 1px 2px rgb(29 29 31 / 0.06),
      0 8px 16px -8px var(--chip-shadow);
    transition: transform 0.4s var(--ease-out);
  }

  /* тень приподнятой плашки — отдельным слоем, проявляется через opacity */
  .tile__ico::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    corner-shape: inherit;
    box-shadow: 0 12px 18px -8px var(--chip-shadow);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
    pointer-events: none;
  }

  /* при наведении приподнимается плашка значка, а не плитка: стыки с мостиками остаются на месте */
  .tile:hover .tile__ico {
    transform: translateY(-2px) scale(1.06);
  }

  .tile:hover .tile__ico::after {
    opacity: 1;
  }

  .tile__name {
    font-size: clamp(12px, calc(var(--vw) * 1.05), 13.5px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-align: center;
    white-space: nowrap;
    color: var(--ink);
  }

  .integr__text {
    max-width: 34ch;
    font-size: 15px;
    line-height: 1.45;
    text-align: center;
    color: var(--muted);
    text-wrap: balance;
  }

  /* ── Большие карточки ─────────────────────────────────── */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, calc(var(--vw) * 1.6), 24px);
    margin-top: clamp(48px, calc(var(--vw) * 6), 80px);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(22px, calc(var(--vw) * 2.4), 30px);
    border-radius: calc(var(--r) * var(--rk));
    corner-shape: var(--corner);
    background: var(--panel);
  }

  .card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }

  .card__ico {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: calc(14px * var(--rk));
    corner-shape: var(--corner);
    background: #fff;
    color: var(--ink);
  }

  .card__btn {
    background: #fff;
  }

  .card__btn:hover {
    background: var(--line);
  }

  .card__title {
    font-size: clamp(1.3rem, calc(var(--vw) * 1.7), 1.5rem);
    font-weight: 560;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .card__list {
    display: grid;
    gap: 10px;
  }

  .card__list li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 10px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .card__check {
    display: grid;
    margin-top: 3px;
    color: var(--ink);
  }

  @media (max-width: 899px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 599px) {
    .integr__list {
      --tile: calc((calc(var(--vw) * 100) - 2 * var(--gutter) - 3 * var(--tile-gap)) / 4);
      --tile-gap: 10px;
      flex-direction: column;
      align-items: center;
      gap: 26px;
    }

    .tile {
      padding: 8px 4px;
      gap: 7px;
    }

    .tile__ico {
      width: 38px;
      height: 38px;
      border-radius: calc(11px * var(--rk));
      corner-shape: var(--corner);
    }

    .tile__name {
      font-size: 12px;
    }
  }
</style>
