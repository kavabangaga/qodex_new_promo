</style>

<script>
  import { reducedMotion } from '../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const track = hero.querySelector<HTMLElement>('[data-hero-track]')!;
    const stage = hero.querySelector<HTMLElement>('[data-stage]')!;
    const bg = stage.querySelector<HTMLElement>('.stage__bg')!;
    const tabs = [...stage.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panes = [...stage.querySelectorAll<HTMLElement>('[data-pane-hero]')];
    const wide = window.matchMedia('(min-width: 1024px) and (min-height: 660px)');

    let active = 0;
    let scrollMode = false;
    let autoTimer = 0;
    let autoStopped = false;
    let inView = false;

    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      stage.style.setProperty('--i', String(i));
      tabs.forEach((tab, k) => {
        const on = k === i;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      panes.forEach((pane, k) => {
        const on = k === i;
        pane.classList.toggle('is-active', on);
        pane.setAttribute('aria-hidden', String(!on));
        pane.querySelectorAll<HTMLElement>('a').forEach((a) => (a.tabIndex = on ? 0 : -1));
      });
    };

    // ── Режим прокрутки: прогресс по высоте трека → раскрытие панели и номер вкладки
    const EXPAND = 0.14;
    // после нажатия на вкладку страница плавно едет к её отрезку — пока едет, вкладку не трогаем
    let lockTarget = -1;
    let lockUntil = 0;
    let lastScale = '';
    let ticking = false;

    const indexAt = (p: number) =>
      p <= EXPAND ? 0 : Math.min(3, Math.max(0, Math.floor(((p - EXPAND) / (1 - EXPAND)) * 4)));

    const update = () => {
      ticking = false;
      if (!scrollMode) return;
      // всё в пикселях окна (getBoundingClientRect, innerHeight): так верно и при CSS-масштабе страницы
      const rect = track.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const p = Math.min(1, Math.max(0, -rect.top / total));
      // раскрытие начинается чуть раньше, пока сцена въезжает снизу
      const enter = Math.min(1, Math.max(0, 1 - rect.top / (window.innerHeight * 0.6)));
      const e = Math.min(1, Math.max(0, p / EXPAND)) * 0.75 + enter * 0.25;
      // видимая ширина панели: от ширины контейнера (1240 px) до краёв сцены
      const w = bg.offsetWidth;
      const inset = Math.max(24, (w - 1240) / 2) * (1 - e);
      const scale = ((w - 2 * inset) / w).toFixed(4);
      if (scale !== lastScale) {
        bg.style.transform = `scaleX(${scale})`;
        lastScale = scale;
      }

      const k = indexAt(p);
      if (lockTarget >= 0) {
        if (k === lockTarget || performance.now() > lockUntil) lockTarget = -1;
        else return;
      }
      setActive(k);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    // ── Без режима прокрутки: вкладки сами переключаются, пока сцена на экране
    const stopAuto = () => {
      autoStopped = true;
      window.clearInterval(autoTimer);
    };
    const syncAuto = () => {
      window.clearInterval(autoTimer);
      if (scrollMode || autoStopped || !inView || reducedMotion()) return;
      autoTimer = window.setInterval(() => setActive((active + 1) % tabs.length), 7000);
    };

    const applyMode = () => {
      scrollMode = wide.matches && !reducedMotion();
      hero.classList.toggle('is-scroll', scrollMode);
      if (scrollMode) {
        lastScale = '';
        update();
      } else {
        bg.style.transform = '';
      }
      syncAuto();
    };

    // переход к вкладке: в режиме прокрутки — плавно едем к её отрезку трека
    const goTo = (i: number) => {
      if (scrollMode) {
        const r = track.getBoundingClientRect();
        const top = r.top + window.scrollY;
        const total = r.height - window.innerHeight;
        const p = EXPAND + ((i + 0.5) / tabs.length) * (1 - EXPAND);
        const smooth = !reducedMotion();
        lockTarget = i;
        lockUntil = performance.now() + (smooth ? 1500 : 200);
        window.scrollTo({ top: top + total * p, behavior: smooth ? 'smooth' : 'auto' });
      }
      setActive(i);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        stopAuto();
        goTo(i);
      });
      tab.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        const edge = e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -1;
        if (!dir && edge < 0) return;
        e.preventDefault();
        stopAuto();
        const next = edge >= 0 ? edge : (active + dir + tabs.length) % tabs.length;
        goTo(next);
        tabs[next].focus();
      });
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          syncAuto();
        },
        { threshold: 0.35 },
      ).observe(stage);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('scrollend', () => {
      lockTarget = -1;
      onScroll();
    });
    window.addEventListener('resize', () => {
      lastScale = '';
      onScroll();
    });
    wide.addEventListener('change', applyMode);
    applyMode();
  }
</script>
