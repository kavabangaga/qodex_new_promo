  }

  /* на телефоне снимок ≈ 290–330 px: кружок на 2 px меньше */
  @container pilot-win (max-width: 359.98px) {
    .pilot__mark-num {
      width: 12px;
      height: 12px;
      margin: -6px 0 0 -6px;
      font-size: 8.5px;
    }
  }

  /* Выноски появляются по одной (дельта, источник, дата — через 0,7 с), когда снимок на экране. Один раз;
     без анимации видны сразу. */
  @media (prefers-reduced-motion: no-preference) {
    .pilot__mark-ring {
      transition:
        opacity 0.5s ease,
        transform 0.7s var(--ease-out);
      transition-delay: calc(var(--i) * 0.7s);
    }

    .pilot__mark-caret,
    .pilot__mark-tip,
    .pilot__mark-num,
    .pilot__legend-item {
      transition:
        opacity 0.5s ease,
        transform 0.6s var(--ease-out);
      transition-delay: calc(var(--i) * 0.7s + 0.2s);
    }

    /* до показа: data-pilot-wait снимает скрипт ниже */
    .pilot__shot[data-pilot-wait] .pilot__mark-ring {
      opacity: 0;
      transform: scale(1.18);
    }

    .pilot__shot[data-pilot-wait] .pilot__mark-caret,
    .pilot__shot[data-pilot-wait] .pilot__legend-item {
      opacity: 0;
      transform: translateY(var(--rise, 6px));
    }

    .pilot__shot[data-pilot-wait] .pilot__mark-tip {
      opacity: 0;
      transform: translate(var(--tx), var(--rise));
    }

    .pilot__shot[data-pilot-wait] .pilot__mark-num {
      opacity: 0;
      transform: scale(0.5);
    }
  }

  /* без скриптов и при печати выноски видны сразу */
  @media (scripting: none), print {
    .pilot__shot[data-pilot-wait] .pilot__mark-ring,
    .pilot__shot[data-pilot-wait] .pilot__mark-caret,
    .pilot__shot[data-pilot-wait] .pilot__mark-num,
    .pilot__shot[data-pilot-wait] .pilot__legend-item {
      opacity: 1;
      transform: none;
    }

    .pilot__shot[data-pilot-wait] .pilot__mark-tip {
      opacity: 1;
      transform: translateX(var(--tx));
    }
  }

  .pilot__demo {
