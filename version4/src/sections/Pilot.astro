      align-items: center;
      gap: 6px;
      padding: 4px 9px 4px 5px;
      border-radius: calc(8px * var(--rk));
      corner-shape: var(--corner);
      background: rgb(255 255 255 / 0.85);
      color: var(--ink);
      font-size: 13px;
      font-weight: 500;
