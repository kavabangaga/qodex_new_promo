---
// Блок 12 «Пилот» — как раскрытая панель первого экрана Calendly: большая градиентная панель,
// внутри белая карточка: слева факты пилота РО-БОТа и кнопка, справа — настоящий снимок экрана «ГИС ЖКХ»
// РО-БОТа в окне приложения и пояснение «Так выглядит результат первого дня». Ниже в той же панели —
// пилоты QODEX TONN и Кодекса ТКО (строки таблицы пилотов из ТЗ).
// Снимок 1600×900 — экран дома в «ГИС ЖКХ» — показан целиком (заказчик, 2026-10-08) и по ширине колонки:
// карточка остаётся в сетке 1120 px. Три выноски, как на первом экране /ro-bot/: дельта (главная, цвета РО-БОТа),
// источник и дата. На узком окне снимка (телефон; окно браузера 961–1170 px) — номера 1–3 на снимке и легенда под ним.
import SectionIntro from '../components/SectionIntro.astro';
import ProductLabel from '../components/ProductLabel.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { withBase, type ProductId } from '../config/site';
import GvBlobs from '../components/GvBlobs.astro';

const NB = ' ';

const steps: { icon: IconName; text: string }[] = [
  { icon: 'lock', text: 'NDA' },
  { icon: 'file-spreadsheet', text: 'Выгрузка биллинга по одному району' },
  { icon: 'list-checks', text: `Реестр неплательщиков в рублях — за 1${NB}день` },
];

// Экран дома в разделе «ГИС ЖКХ» из демо-доступа РО-БОТа (тот же снимок, что в «Интерфейсе» на /ro-bot/)
const SHOT = {
  src: withBase('/media/robot/shot-house-1600.webp'),
  srcset: `${withBase('/media/robot/shot-house-800.webp')} 800w, ${withBase('/media/robot/shot-house-1600.webp')} 1600w`,
  alt:
    `Демо-данные. Экран «ГИС${NB}ЖКХ» РО-БОТа по дому: МКД, д.${NB}1 на ул.${NB}Достоевского в Уфе, ` +
    `84${NB}квартиры и 227${NB}жильцов. В таблице квартир — лицевой счёт, тип дома, число жильцов по ГИС${NB}ЖКХ ` +
    `и по биллингу, столбец «Дельта» с разницей между ними (+2, +3, +1…), дата обновления ФМС и дата биллинга`,
};

// Выноски: рамка вокруг столбца (заголовок и первые три квартиры), координаты — в пикселях снимка 1600×900.
// Подпись дельты — над таблицей, на пустом поле между кнопками «Выгрузка…» и «Сортировка»; подписи источника
// и даты — под рамкой, на строках 5–6 своего столбца (дельты всех строк остаются открыты).
// ax — где стрелка: там, где в строке 4 под рамкой пусто; tx — сдвиг подписи от стрелки. bx, by — кружок
// с номером на узком снимке: по центру верхнего края рамки, на заголовке столбца, значения не закрывает.
const MARKS = [
  { lines: ['дельта —', 'неучтённые жильцы'], key: true, up: true, x: 1170, y: 372, w: 62, h: 147, ax: 1201, tx: '-69%', bx: 1201, by: 372 },
  { lines: ['источник'], x: 879, y: 372, w: 94, h: 147, ax: 926, tx: '-69%', bx: 926, by: 372 },
  { lines: ['дата'], x: 1257, y: 372, w: 126, h: 147, ax: 1358, tx: '-77%', bx: 1320, by: 372 },
];

const others: { id: ProductId; first: string; payback: string; need: string; pilot: string }[] = [
  {
    id: 'tonn',
    first: 'Акты с фото с первого дня',
    payback: `45${NB}дней — кейс объекта`,
    need: 'Доступ к весовой',
    pilot: `Монтаж от 3${NB}дней`, // акции «месяц бесплатно после запуска» у TONN нет (заказчик, 09.10.2026)
  },
  {
    id: 'kodeks',
    first: `Подключение за 15${NB}минут`,
    payback: 'Сразу',
    need: 'Ключ доступа к ФГИС',
    pilot: 'Неделя бесплатно',
  },
];
---

<section class="section pilot" id="pilot" aria-labelledby="pilot-title">
  <div class="container">
    <SectionIntro eyebrow="Пилот" titleId="pilot-title">Первый результат — в первый же день пилота</SectionIntro>
  </div>

  <div class="pilot__stage">
    <div class="gv gv--aqua gv--blobs pilot__bg" aria-hidden="true"><GvBlobs preset="aqua" /></div>

    <div class="pilot__in">
      <!-- РО-БОТ: белая карточка, как раскрытая вкладка первого экрана Calendly -->
      <article class="pilot__card" aria-labelledby="pilot-robot" data-reveal>
        <div class="pilot__info">
          <h3 class="pilot__product" id="pilot-robot">
            <ProductLabel id="robot" size="lg" />
            <span class="tag">Бесплатно</span>
          </h3>

          <dl class="pilot__facts">
            <div class="pilot__first">
              <dt>Первый результат</dt>
              <dd>Реестр неплательщиков за 1&nbsp;день</dd>
            </div>
            <div>
              <dt>Окупаемость</dt>
              <dd>9 из 247 найденных юрлиц окупают внедрение</dd>
            </div>
            <div>
              <dt>Что нужно от вас</dt>
              <dd>Выгрузка биллинга по одному району</dd>
            </div>
          </dl>

          <div class="pilot__plan">
            <p class="pilot__plan-title">Начнём с РО-БОТа: пилот бесплатный.</p>
            <ol class="pilot__steps">
              {
                steps.map((s) => (
                  <li>
                    <span class="pilot__step-ico" aria-hidden="true">
                      <Icon name={s.icon} size={15} strokeWidth={2} />
                    </span>
                    <span>{s.text}</span>
                  </li>
                ))
              }
            </ol>
            <a href="#forma" class="btn btn--primary pilot__cta" data-interest="robot" data-goal="pilot_click">
              Запустить пилот
              <Icon name="arrow-right" />
            </a>
          </div>
        </div>

        <figure class="pilot__example">
          <div class="pilot__shot" data-pilot-vis data-pilot-wait>
            <div class="pilot__win">
              <!-- окно приложения: снимок «ГИС ЖКХ» целиком, в своих пропорциях, и выноски поверх -->
              <div class="pilot__screen">
                <div class="pilot__clip">
                  <img
                    class="pilot__win-img"
                    src={SHOT.src}
                    srcset={SHOT.srcset}
                    sizes="(max-width: 520px) calc(100vw - 66px), (max-width: 960px) calc(100vw - 150px), 470px"
                    width="1600"
                    height="900"
                    alt={SHOT.alt}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                </div>
                <ol class="pilot__marks" aria-label="Обозначения на скриншоте">
                  {
                    MARKS.map((m, i) => (
                      <li
                        class:list={['pilot__mark', { 'pilot__mark--key': m.key, 'pilot__mark--up': m.up }]}
                        style={`--x:${m.x};--y:${m.y};--w:${m.w};--h:${m.h};--ax:${m.ax};--bx:${m.bx};--by:${m.by};--i:${i}${m.tx ? `;--tx:${m.tx}` : ''}`}
                      >
                        <span class="pilot__mark-ring" aria-hidden="true" />
                        <span class="pilot__mark-caret" aria-hidden="true" />
                        <span class="pilot__mark-num" aria-hidden="true">{i + 1}</span>
                        <span class="pilot__mark-tip">
                          {m.lines.map((line, j) => (j ? [<br />, line] : line))}
                        </span>
                      </li>
                    ))
                  }
                </ol>
              </div>

              <!-- легенда к номерам на снимке — только на узком снимке -->
              <ol class="pilot__legend" aria-hidden="true">
                {
                  MARKS.map((m, i) => (
                    <li class:list={['pilot__legend-item', { 'pilot__legend-item--key': m.key }]} style={`--i:${i}`}>
                      <span class="pilot__legend-num">{i + 1}</span>
                      <span>{m.lines.join(' ')}</span>
                    </li>
                  ))
                }
              </ol>
            </div>
            <span class="tag tag--demo pilot__demo" aria-hidden="true">демо-данные</span>
          </div>
          <figcaption class="pilot__caption">
            <p class="pilot__text">
              <strong>Так выглядит результат первого дня:</strong> реестр расхождений по району с источником и датой. Ваш
              сотрудник проверяет расхождения и отправляет подтверждённые в биллинг или 1С одной кнопкой. Ничего не
              начисляется автоматически.
            </p>
          </figcaption>
        </figure>
      </article>

      <!-- QODEX TONN и Кодекс ТКО -->
      <div class="pilot__more">
        {
          others.map((o, i) => (
            <article class="pilot__mini" aria-labelledby={`pilot-${o.id}`} data-reveal style={`--d:${i + 1}`}>
              <h3 class="pilot__product" id={`pilot-${o.id}`}>
                <ProductLabel id={o.id} />
                <span class="tag">{o.pilot}</span>
              </h3>
              <dl class="pilot__facts pilot__facts--mini">
                <div class="pilot__first">
                  <dt>Первый результат</dt>
                  <dd>{o.first}</dd>
                </div>
                <div>
                  <dt>Окупаемость</dt>
                  <dd>{o.payback}</dd>
                </div>
                <div>
                  <dt>Что нужно от вас</dt>
                  <dd>{o.need}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Большая градиентная панель во всю ширину (с отступом от края экрана) */
  .pilot__stage {
    position: relative;
    margin-inline: var(--page-pad);
    padding: clamp(16px, calc(var(--vw) * 5), 80px) 0;
    border-radius: calc(var(--r-2xl) * var(--rk));
    corner-shape: var(--corner);
    overflow: hidden;
    isolation: isolate;
  }

  .pilot__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    --gv-r: var(--r-2xl);
    min-height: 0;
    padding: 0;
  }

  .pilot__in {
    display: grid;
    gap: clamp(12px, calc(var(--vw) * 1.4), 18px);
    width: min(1120px, 100% - var(--gutter) * 2);
    margin-inline: auto;
  }

  /* Белая карточка: факты слева, реестр справа */
  .pilot__card {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(28px, calc(var(--vw) * 4), 56px);
    padding: clamp(22px, calc(var(--vw) * 3.4), 48px);
    border-radius: calc(clamp(24px, calc(var(--vw) * 2.6), 36px) * var(--rk));
    corner-shape: var(--corner);
    background: var(--card-warm);
    box-shadow: var(--shadow-card);
  }

  /* метка продукта и плашка срока пилота; на узком экране плашка уходит на новую строку */
  .pilot__product {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    font-size: inherit;
    font-weight: inherit;
  }

  .pilot__card,
  .pilot__mini,
  .pilot__info,
  .pilot__example {
    min-width: 0;
  }

  .pilot__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 24px;
    margin-top: 22px;
  }

  .pilot__facts > div {
    display: grid;
    align-content: start;
    gap: 6px;
  }

  .pilot__facts dt {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--muted);
  }

  .pilot__facts dd {
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink);
    text-wrap: pretty;
  }

  .pilot__first {
    grid-column: 1 / -1;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }

  .pilot__first dd {
    font-size: clamp(1.6rem, calc(var(--vw) * 2.5), 2.3rem);
    font-weight: 560;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* План пилота: шаги цепочкой, как список у Calendly в карточке Capture */
  .pilot__plan {
    display: grid;
    gap: 16px;
    margin-top: 26px;
    padding: clamp(18px, calc(var(--vw) * 2), 24px);
    border-radius: calc(var(--r) * var(--rk));
    corner-shape: var(--corner);
    background: var(--panel);
  }

  .pilot__plan-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }

  .pilot__steps {
    display: grid;
    gap: 12px;
  }

  .pilot__steps li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15.5px;
    line-height: 1.35;
    color: var(--ink);
  }

  .pilot__steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 14px;
    top: 30px;
    width: 1px;
    height: 10px;
    background: var(--line-2);
  }

  .pilot__step-ico {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: calc(8px * var(--rk));
    corner-shape: var(--corner);
    background: #fff;
    color: var(--blue);
    box-shadow: 0 1px 2px rgb(29 29 31 / 0.08);
  }

  .pilot__cta {
    justify-self: start;
    margin-top: 4px;
  }

  /* Снимок экрана на мягкой подложке (как интерфейс в раскрытой вкладке Calendly) */
  .pilot__example {
    display: grid;
    gap: 20px;
  }

  .pilot__shot {
    position: relative;
    display: grid;
    place-items: center;
    /* сверху место под «демо-данные»: метка не заходит на белое кольцо окна */
    padding: clamp(48px, calc(var(--vw) * 4), 52px) clamp(12px, calc(var(--vw) * 2.4), 28px) clamp(16px, calc(var(--vw) * 2.4), 28px);
    border-radius: calc(clamp(20px, calc(var(--vw) * 2), 28px) * var(--rk));
    corner-shape: var(--corner);
    background: linear-gradient(160deg, #dcebff 0%, #e6f1fb 55%, #e9e4fb 100%);
  }

  /* ── Окно приложения, как на /ro-bot/: белая рамка с мягким кольцом и тенью, снимок 1600×900 целиком
     по ширине колонки (на компьютере ≈470 px, файл 800 или 1600 px — не растягивается). От ширины окна
     зависят кегль выносок (cqi) и то, подписи на снимке или номера с легендой (@container). ── */
  .pilot__win {
    --win-r: 12px;
    container: pilot-win / inline-size;
    width: 100%;
  }

  .pilot__screen {
    position: relative;
    aspect-ratio: 1600 / 900;
    border-radius: var(--win-r);
    background: #fff;
    box-shadow:
      0 0 0 6px rgb(255 255 255 / 0.45),
      var(--shadow-card);
  }

  .pilot__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    /* страховка для Safari на iPhone: скругление обрезает и слой снимка */
    clip-path: inset(0 round var(--win-r));
  }

  .pilot__win-img {
    display: block;
    width: 100%;
    height: 100%;
    -webkit-user-select: none;
    user-select: none;
  }

  /* Выноски: рамка вокруг столбца и подпись со стрелкой. Кегль растёт с окном (2,25cqi: 10,5 px при окне 467 px,
     17 px при 750 px), отступы и стрелка — в em, поэтому подписи на любом окне ложатся на те же ячейки снимка:
     подпись под рамкой закрывает строки 5–6 целиком, без срезанных букв над и под ней. */
  .pilot__marks {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .pilot__mark {
    --tx: -50%;
    --rise: 6px;
    --mc: var(--ink);
    --mt: rgb(29 29 31 / 0.04);
    --ring-w: 2px;
    position: absolute;
    left: calc(var(--x) / 1600 * 100%);
    top: calc(var(--y) / 900 * 100%);
    width: calc(var(--w) / 1600 * 100%);
    height: calc(var(--h) / 900 * 100%);
    font-size: 10.5px;
    font-size: 2.25cqi;
  }

  /* Автомасштаб (окно 1200–1760 px, zoom < 1): окно снимка всегда 466,7 px — кегль 10,5 px и без контейнера.
     Safari внутри контейнера применяет zoom к кеглю дважды: подписи мельче и съезжают на строку 4 */
  :global(html.is-autoscale) .pilot__win {
    container-type: normal;
  }

  :global(html.is-autoscale) .pilot__mark {
    font-size: 10.5px;
  }

  /* главная выноска — дельта, цветом РО-БОТа */
  .pilot__mark--key {
    --mc: var(--c-robot);
    --mt: rgb(107 77 255 / 0.08);
  }

  /* подпись над рамкой, стрелка вниз */
  .pilot__mark--up {
    --rise: -6px;
  }

  .pilot__mark-ring {
    position: absolute;
    inset: 0;
    border-radius: 0.5em;
    background: var(--mt);
    box-shadow: 0 0 0 var(--ring-w) var(--mc);
  }

  .pilot__mark-caret {
    position: absolute;
    top: calc(100% + 0.4em);
    left: calc((var(--ax) - var(--x)) / var(--w) * 100%);
    width: 0.84em;
    height: 0.5em;
    margin-left: -0.42em;
    background: var(--mc);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  /* основание стрелки чуть заходит под подпись — без щели между ними */
  .pilot__mark-tip {
    position: absolute;
    top: calc(100% + 0.86em);
    left: calc((var(--ax) - var(--x)) / var(--w) * 100%);
    display: block;
    padding: 0.52em 0.62em 0.6em;
    border-radius: 0.66em;
    background: var(--mc);
    box-shadow: 0 8px 20px -10px rgb(29 29 31 / 0.6);
    color: #fff;
    font-weight: 560;
    line-height: 1.2;
    white-space: nowrap;
    transform: translateX(var(--tx));
  }

  .pilot__mark--key .pilot__mark-tip {
    box-shadow: 0 8px 20px -10px rgb(107 77 255 / 0.7);
  }

  .pilot__mark--up .pilot__mark-caret {
    top: auto;
    bottom: calc(100% + 0.3em);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  .pilot__mark--up .pilot__mark-tip {
    top: auto;
    bottom: calc(100% + 0.76em);
    padding-block: 0.4em 0.48em;
    line-height: 1.16;
  }

  /* номер выноски и легенда к номерам — только на узком снимке */
  .pilot__mark-num,
  .pilot__legend {
    display: none;
  }

  /* Узкое окно снимка (телефон; окно браузера 961–1170 px): подписи закрыли бы полснимка — вместо них кружки
     с номерами по центру верхнего края рамок, слова — легендой под снимком */
  @container pilot-win (max-width: 444.98px) {
    .pilot__mark {
      --ring-w: 1.5px;
    }

    .pilot__mark-ring {
      border-radius: 3px;
    }

    .pilot__mark-caret {
      display: none;
    }

    /* подпись не видна, но остаётся в списке «Обозначения на скриншоте» для чтения с экрана */
    .pilot__mark-tip {
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      box-shadow: none;
    }

    .pilot__mark-num {
      position: absolute;
      left: calc((var(--bx) - var(--x)) / var(--w) * 100%);
      top: calc((var(--by) - var(--y)) / var(--h) * 100%);
      display: grid;
      place-items: center;
      width: 14px;
      height: 14px;
      margin: -7px 0 0 -7px;
      border-radius: 50%;
      background: var(--mc);
      box-shadow:
        0 0 0 1.5px #fff,
        0 3px 8px -3px rgb(29 29 31 / 0.6);
      color: #fff;
      font-size: 9.5px;
      font-weight: 600;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    /* дельта — первой строкой, источник и дата — второй (перенос — пустой ::after во всю ширину) */
    .pilot__legend {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 3px 6px;
      margin: 16px 0 0;
      padding: 0;
      list-style: none;
    }

    .pilot__legend::after {
      content: '';
      flex-basis: 100%;
      order: 1;
    }

    .pilot__legend-item {
      order: 2;
