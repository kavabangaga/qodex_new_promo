    'Серверная часть',
    'Хранение и обработка данных, выполнение сверки, программный интерфейс (API). Развёрнута на инфраструктуре правообладателя на территории Российской Федерации.',
  ],
  [
    'Личный кабинет оператора',
    'Веб-приложение для работы пользователей: настройка территории, просмотр данных, обработка расхождений, отчётность.',
  ],
  [
    'Модуль сбора данных (агент)',
    'Программа, устанавливаемая на рабочее место сотрудника организации. Выполняет выгрузку сведений из ГИС ЖКХ под учётной записью сотрудника организации. Управление агентами ведётся из личного кабинета.',
  ],
];

const SERVER = [
  ['Операционная система', 'Linux. Подтверждена работоспособность на российских операционных системах Astra Linux и РЕД ОС'],
  ['Среда выполнения', 'Python 3.11 и выше'],
  ['СУБД', 'PostgreSQL 14 и выше'],
  ['Веб-сервер', 'nginx с поддержкой TLS'],
];

const SECTIONS = [
  [
    'Отчёты и аналитика',
    'Сводные показатели по территории: объём проверенных объектов, выявленные расхождения, оценка потенциальных доначислений по тарифу из настроек, динамика за период, разбивка по причинам отклонения и охват по территориям.',
  ],
  [
    'ГИС ЖКХ',
    'Просмотр данных по территории в виде иерархии: субъект, населённый пункт, улица, дом. В карточке дома отображаются число помещений и проживающих, идентификатор дома и дата последней выгрузки. Доступны выгрузка сведений, сверка с биллингом и экспорт результата в файл электронной таблицы. По каждому помещению выводятся число проживающих по данным ГИС ЖКХ и биллинга, разница между ними и даты обновления сведений.',
  ],
  [
    'Рабочее место',
    'Основной раздел работы с выявленными расхождениями. Оператор принимает решение по каждой позиции: обновить запись в биллинге или отклонить с указанием причины из справочника. Если источник данных биллинга ещё не подключён, раздел предлагает подключить его загрузкой файла или по API.',
  ],
  [
    'Настройки',
    'Параметры рабочего пространства и управление организацией: территория работы, тариф, справочник причин отклонения, источник данных биллинга, агенты, организации, баланс и счета, смена пароля.',
  ],
];

// Функциональные возможности (раздел 1): подзаголовок и пункты
const FEATURES: { title: string; items: string[] }[] = [
  {
    title: 'Личный кабинет оператора',
    items: [
      'Регистрация организации по ИНН с подтверждением адреса электронной почты.',
      'Разграничение доступа по ролям: администратор и сотрудник.',
      'Настройка территории обслуживания и тарифа, используемого при расчёте показателей.',
    ],
  },
  {
    title: 'Сбор и хранение данных',
    items: [
      'Сбор сведений о домах, помещениях и числе проживающих по выбранной территории из ГИС ЖКХ.',
      'Дедупликация и хранение реестра объектов жилищного фонда.',
      'Просмотр данных по территории в виде иерархии: регион, населённый пункт, улица, дом, помещения.',
      'Управление модулями сбора данных: статус, создание, получение установщика, команды.',
    ],
  },
  {
    title: 'Сверка с расчётной системой',
    items: [
      'Автоматическое сопоставление числа проживающих по данным ГИС ЖКХ и расчётной системы.',
      'Выявление расхождений по лицевым счетам с расчётом разницы.',
      'Ведение списков расхождений «К обработке» и «Обработанные».',
      'Контроль актуальности: более свежие сведения расчётной системы не перезаписываются устаревшими.',
    ],
  },
  {
    title: 'Обработка расхождений',
    items: [
      'Внесение изменений в биллинг по решению оператора.',
      'Отклонение расхождения с указанием причины из справочника.',
      'Массовая обработка выбранных позиций и отмена ранее принятых решений.',
    ],
  },
  {
    title: 'Отчётность и аналитика',
    items: [
      'Ключевые показатели: объём проверенных объектов, выявленные расхождения, оценка потенциала доначислений.',
      'Динамика за период, разбивка по причинам отклонения, охват по территориям.',
      'Выгрузка результатов сверки файлом в формате электронной таблицы.',
    ],
  },
  {
    title: 'Информационная безопасность',
    items: [
      'Учётные записи сотрудников для работы с государственными системами остаются у организации.',
      'Персональные данные за пределы контура обработки не передаются.',
      'Серверная инфраструктура размещена на территории Российской Федерации.',
      'По запросу заключается соглашение о неразглашении (NDA); техническое описание для служб ИБ и ИТ направляется комплектом с NDA.',
    ],
  },
];

// Контакты из текста документации — как на лендинге и в PDF
const MAIL = 'info@qodex.tech';
const MAIL_HREF = `mailto:${MAIL}`;
const PHONE = '+7 937 500 06 65';
const PHONE_HREF = 'tel:+79375000665';
---

<Legal
  title="Документация программного обеспечения «Кодекс Ро-бот»"
  subtitle="Функциональные характеристики, установка, эксплуатация"
  description="Документация ПО «Кодекс Ро-бот»: описание функциональных характеристик, инструкция по установке, руководство пользователя и описание процессов поддержания жизненного цикла."
  path="/documents/ro-bot/"
>
  <div class="legal__intro">
    <p>
      На этой странице размещена документация, содержащая описание функциональных характеристик программного
      обеспечения «Кодекс{NB}Ро-бот» и информацию, необходимую для установки и эксплуатации программного обеспечения.
      Правообладатель — {nbName(COMPANY.shortName)} (ОГРН{NB}{COMPANY.ogrn}, ИНН{NB}{COMPANY.inn}).
    </p>
  </div>

  <!-- Документы: четыре PDF -->
  <section class="rdoc-sec" id="dokumenty" aria-labelledby="rdoc-files-title">
    <h2 id="rdoc-files-title">Документы</h2>
    <ul class="legal__points rdoc-files">
      {
        FILES.map((d) => (
          <li class="rdoc-file">
            <div class="rdoc-file__head">
              <span class="rdoc-file__ico" aria-hidden="true">
                <Icon name="file-pdf" size={20} />
              </span>
              <h3 class="rdoc-file__title">{d.title}</h3>
            </div>
            <p class="rdoc-file__text">{d.text}</p>
            <div class="rdoc-file__foot">
              <a class="rdoc-file__dl" href={d.href} target="_blank" rel="noopener">
                <Icon name="download" size={18} strokeWidth={2} />
                Скачать PDF
                <span class="visually-hidden">
                  {' '}
                  «{d.title}», {d.size} (откроется в новой вкладке)
                </span>
              </a>
              <span class="rdoc-file__meta" aria-hidden="true">
                PDF · {d.size}
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Раздел 1 -->
  <section class="rdoc-sec" id="funkcionalnye-harakteristiki" aria-labelledby="rdoc-s1-title">
    <h2 id="rdoc-s1-title">
      <span class="rdoc-kicker">Раздел 1</span>{' '}
      Описание функциональных характеристик программного обеспечения
    </h2>
    <p>
      «Кодекс{NB}Ро-бот» — программная платформа для сбора, дедупликации и сверки данных о жилом фонде из государственной
      информационной системы жилищно-коммунального хозяйства (ГИС{NB}ЖКХ) с расчётной (биллинговой) системой организации.
      Система выявляет расхождения в числе проживающих, помогает оператору обработать их через личный кабинет и формирует
      отчётность.
    </p>
    <p>
      Назначение — выявление ранее не учтённых плательщиков и повышение полноты начислений за коммунальные услуги. Область
      применения: региональные операторы по обращению с ТКО, ресурсоснабжающие и управляющие организации, расчётно-кассовые
      центры.
    </p>

    <h3>Состав программного обеспечения</h3>
    <div class="table-wrap rdoc-table">
      <table class="table" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader">Компонент</th>
            <th scope="col" role="columnheader">Назначение</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            COMPOSITION.map(([k, v]) => (
              <tr role="row">
                <th scope="row" role="rowheader">{k}</th>
                <td role="cell">{v}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    {
      FEATURES.map((g) => (
        <>
          <h3>{g.title}</h3>
          <ul>
            {g.items.map((it) => (
              <li>{it}</li>
            ))}
          </ul>
        </>
      ))
    }
  </section>

  <!-- Раздел 2 -->
  <section class="rdoc-sec" id="ustanovka" aria-labelledby="rdoc-s2-title">
    <h2 id="rdoc-s2-title">
      <span class="rdoc-kicker">Раздел 2</span>{' '}
      Информация, необходимая для установки программного обеспечения
    </h2>

    <h3>Модель поставки</h3>
    <p>
      «Кодекс{NB}Ро-бот» предоставляется как интернет-сервис (SaaS). Установка серверной части на оборудование пользователя
      не требуется: работа ведётся через веб-браузер, серверная часть развёрнута на инфраструктуре правообладателя на
      территории Российской Федерации. Для выгрузки сведений из ГИС{NB}ЖКХ по решению организации на рабочее место
      сотрудника устанавливается модуль сбора данных (агент).
    </p>

    <h3>Требования к рабочему месту пользователя</h3>
    <ul>
      <li>Персональный компьютер с доступом в сеть Интернет.</li>
      <li>Веб-браузер актуальной версии: Яндекс Браузер, Google Chrome, Mozilla Firefox или совместимый.</li>
      <li>Разрешение экрана от 1280{NB}×{NB}720.</li>
      <li>Дополнительное программное обеспечение для работы в личном кабинете не требуется.</li>
    </ul>

    <h3>Порядок подключения организации</h3>
    <ol class="rdoc-steps">
      <li>
        Направить заявку через <a href="#forma" data-interest="robot">форму на сайте</a> или по адресу{' '}
        <a href={MAIL_HREF}>{MAIL}</a>.
      </li>
      <li>Подписать соглашение о неразглашении (NDA). Проект соглашения направляется в день обращения.</li>
      <li>Зарегистрировать организацию в личном кабинете: указать ИНН и подтвердить адрес электронной почты.</li>
      <li>Дождаться подтверждения регистрации организации правообладателем.</li>
      <li>Пригласить сотрудников и назначить им роли: администратор или сотрудник.</li>
      <li>Указать территорию обслуживания и тариф в разделе «Настройки».</li>
    </ol>

    <h3>Установка модуля сбора данных (агента)</h3>
    <p>
      Требования к рабочему месту: ОС Microsoft Windows 10 или 11 (64-разрядная), оперативная память от 8 ГБ, свободное
      место на диске от 10 ГБ, канал доступа в Интернет от 10 Мбит/с.
    </p>
    <ol class="rdoc-steps">
      <li>Войти в личный кабинет под учётной записью администратора организации.</li>
      <li>Открыть раздел «Настройки»{NB}→ «Агенты» и создать агента.</li>
      <li>Скачать установщик агента на рабочее место сотрудника.</li>
      <li>Запустить установщик и следовать указаниям мастера установки.</li>
      <li>После установки запустить агент: статус отобразится в разделе «Агенты» личного кабинета.</li>
    </ol>
    <p>
      Удаление агента выполняется штатными средствами операционной системы. Учётные записи для работы с государственными
      системами остаются у организации и правообладателю не передаются.
    </p>

    <h3>Системные требования серверной части</h3>
    <p>Приводятся справочно: серверная часть разворачивается и обслуживается правообладателем.</p>
    <div class="table-wrap rdoc-table">
      <table class="table" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader">Компонент</th>
            <th scope="col" role="columnheader">Требование</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            SERVER.map(([k, v]) => (
              <tr role="row">
                <th scope="row" role="rowheader">{k}</th>
                <td role="cell">{v}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h3>Обновление</h3>
    <p>
      Обновления серверной части и личного кабинета устанавливаются централизованно, действий пользователя не требуется.
      При выпуске новой версии модуля сбора данных обновлённый установщик доступен в личном кабинете. По вопросам
      подключения: <a href={MAIL_HREF}>{MAIL}</a>, <a href={PHONE_HREF}><span class="nobr">{PHONE}</span></a>.
    </p>
  </section>

  <!-- Раздел 3 -->
  <section class="rdoc-sec" id="ekspluataciya" aria-labelledby="rdoc-s3-title">
    <h2 id="rdoc-s3-title">
      <span class="rdoc-kicker">Раздел 3</span>{' '}
      Информация, необходимая для эксплуатации программного обеспечения
    </h2>

    <h3>Начало работы</h3>
    <p>
      Открыть адрес сервиса в браузере, ввести логин и пароль учётной записи и нажать «Вход в систему». После авторизации
      открывается личный кабинет оператора. Навигация по разделам — в меню слева.
    </p>

    <h3>Разделы системы</h3>
    <div class="table-wrap rdoc-table">
      <table class="table" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader">Раздел</th>
            <th scope="col" role="columnheader">Порядок работы</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            SECTIONS.map(([k, v]) => (
              <tr role="row">
                <th scope="row" role="rowheader">{k}</th>
                <td role="cell">{v}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h3>Подключение источника данных биллинга</h3>
    <ul>
      <li>
        <b>Загрузка файлом.</b> Скачать шаблон электронной таблицы, заполнить его выгрузкой из своей учётной системы и загрузить.
        Система проверяет файл и показывает ошибки.
      </li>
      <li>
        <b>Подключение по API.</b> Учётная система обменивается данными автоматически: передаёт лицевые счета и получает
        решения операторов. Токен и инструкция выдаются правообладателем.
      </li>
    </ul>

    <h3>Типовой сценарий работы</h3>
    <ol class="rdoc-steps">
      <li>Указать территорию обслуживания и тариф в разделе «Настройки».</li>
      <li>Подключить источник данных биллинга: файлом или по API.</li>
      <li>В разделе «ГИС ЖКХ» выполнить выгрузку сведений по территории.</li>
      <li>Запустить сверку с биллингом: система сформирует список расхождений по лицевым счетам.</li>
      <li>
        Обработать расхождения в «Рабочем месте»: обновить запись в биллинге или отклонить с указанием причины. Доступны
        массовая обработка и отмена решений.
      </li>
      <li>Проконтролировать показатели в разделе «Отчёты и аналитика» и выгрузить результат файлом электронной таблицы.</li>
    </ol>

    <h3>Завершение работы и поддержка</h3>
