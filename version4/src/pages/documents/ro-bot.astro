---
// Документация ПО «Кодекс Ро-бот» (официальное название программы — так и пишем на этой странице; продукт
// на сайте — РО-БОТ). Перенесена с лендинга romoney.qodex.tech/docs дословно: вступление, четыре документа,
// разделы 1–3 со списками и таблицами. Изменено только то, что разрешено: строка о правообладателе собрана
// из COMPANY (config/site.ts; ОГРН и ИНН совпадают с лендингом), «–» стали «—». Страницу и PDF проверяет
// Минцифры: тексты не сокращать и не переписывать. PDF лежат в public/files/ro-bot/ и не меняются ни на байт.
import fs from 'node:fs';
import path from 'node:path';
import Legal from '../../layouts/Legal.astro';
import Icon from '../../components/Icon.astro';
import { COMPANY, nbName, withBase } from '../../config/site';

const NB = String.fromCharCode(160);

// Размер файла считается при сборке, как в DocList; нет файла — сборка останавливается
const DIR = path.join(process.cwd(), 'public', 'files', 'ro-bot');
function size(file: string): string {
  const p = path.join(DIR, file);
  if (!fs.existsSync(p)) throw new Error(`Нет файла документа public/files/ro-bot/${file}`);
  const bytes = fs.statSync(p).size;
  if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))}${NB}КБ`;
  return `${(bytes / 1024 / 1024).toFixed(1).replace('.', ',')}${NB}МБ`;
}

const FILES = [
  {
    file: 'funkcionalnye-harakteristiki.pdf',
    title: 'Функциональные характеристики',
    text: 'Назначение, состав и функциональные возможности программного обеспечения.',
  },
  {
    file: 'instrukciya-po-ustanovke.pdf',
    title: 'Инструкция по установке',
    text: 'Модель поставки, требования к рабочему месту, порядок подключения, установка модуля сбора данных.',
  },
  {
    file: 'rukovodstvo-polzovatelya.pdf',
    title: 'Руководство пользователя',
    text: 'Порядок эксплуатации: вход, разделы системы, сверка, обработка расхождений, выгрузка результатов.',
  },
  {
    file: 'zhiznennyj-cikl-po.pdf',
    title: 'Описание жизненного цикла',
    text: 'Процессы поддержания жизненного цикла ПО, устранение неисправностей, совершенствование, персонал.',
  },
].map((d) => ({ ...d, href: withBase(`/files/ro-bot/${d.file}`), size: size(d.file) }));

// Таблицы: первая колонка — заголовок строки
const COMPOSITION = [
