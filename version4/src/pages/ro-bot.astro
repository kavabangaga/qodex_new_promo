---
// Страница продукта «РО-БОТ» (этап 2): сверка базы начислений регоператора с ГИС ЖКХ, поиск неучтённых домов и юрлиц.
// Содержание — с прежнего лендинга romoney.qodex.tech; где он расходится с главной — как на главной
// (пилот на одном районе, без «65 542 за неделю»). Оформление — дизайн-система v4. Документация ПО — /documents/ro-bot/.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Floating from '../components/Floating.astro';
import LeadModal from '../components/LeadModal.astro';
import RHero from '../sections/robot/RHero.astro';
import RModules from '../sections/robot/RModules.astro';
import RSteps from '../sections/robot/RSteps.astro';
import RCalc from '../sections/robot/RCalc.astro';
import RGis from '../sections/robot/RGis.astro';
import RWeek from '../sections/robot/RWeek.astro';
import RInterface from '../sections/robot/RInterface.astro';
import RCases from '../sections/robot/RCases.astro';
import RObjects from '../sections/robot/RObjects.astro';
import RLegal from '../sections/robot/RLegal.astro';
import RSecurity from '../sections/robot/RSecurity.astro';
import Questions from '../sections/Questions.astro';
import Contact from '../sections/Contact.astro';
import { faqJsonLd } from '../data/faq';
import { FAQ_ROBOT } from '../data/faq-robot';
import { SITE, withBase } from '../config/site';

const NB = ' ';

const title = 'РО-БОТ — рост начислений и сбора регионального оператора ТКО | QODEX';
const description =
  'Три модуля находят то, что не попало в базу начислений: неучтённых жильцов по ГИС ЖКХ, объекты жилфонда и юрлица без договора. Рост начислений без роста тарифа. Бесплатный пилот на одном районе.';

// Тексты формы заявки на этой странице
const leadTitle = `Запишитесь на демо — покажем РО-БОТ на${NB}ваших данных`;
const leadText = `Сверим один район бесплатно — увидите недосбор в${NB}своей базе.`;
const leadProof = 'Работаем после подписания NDA';

// Меню страницы: «Продукты» и главные разделы этой страницы (по порядку на странице)
const nav = [
  { href: '#moduli', label: 'Модули' },
  { href: '#kak-eto-rabotaet', label: 'Как это работает' },
  { href: '#kalkulyator', label: 'Калькулятор' },
  { href: '#bezopasnost', label: 'Безопасность' },
];

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'QODEX', item: new URL(withBase('/'), SITE.url).href },
    { '@type': 'ListItem', position: 2, name: 'РО-БОТ', item: new URL(withBase('/ro-bot/'), SITE.url).href },
  ],
};
---

<Base title={title} description={description} jsonLd={[faqJsonLd(FAQ_ROBOT), breadcrumbs]}>
  <Floating />
  <Header home={false} cta="Запустить пилот" current="robot" nav={nav} />
  <main id="main">
    <RHero />
    <RModules />
    <RSteps />
    <RCalc />
    <RGis />
    <RWeek />
    <RInterface />
    <RCases />
    <RObjects />
    <RLegal />
    <RSecurity />
    <Questions items={FAQ_ROBOT} />
    <Contact title={leadTitle} lead={leadText} proof={leadProof} personLabel="Ваш контакт по пилоту" />
  </main>
  <Footer />
  <LeadModal title={leadTitle} proof={leadProof} personLabel="Ваш контакт по пилоту" />
</Base>

<script>
  import { initReveal, initCounters } from '../scripts/motion';
  import { initAccordions, initChains } from '../scripts/kit';
  import { initGoals } from '../scripts/goals';
  import { setInterest, initInterestLinks } from '../scripts/interest';

  initReveal();
  initCounters();
  initAccordions();
  initChains();
  initGoals();
  initInterestLinks();

  // на странице продукта в поле «Что интересно» формы заявки отмечен только он
  setInterest(['robot']);
</script>
