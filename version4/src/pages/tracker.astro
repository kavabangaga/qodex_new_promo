---
// Страница продукта «QODEX Tracker» (этап 2): камеры на мусоровозе, ИИ считает контейнеры и сверяет с планом маршрута.
// Содержание — с прежнего лендинга tracker.qodex.tech и раздела Tracker на главной, оформление — дизайн-система v4.
// Пилот по Tracker не предлагаем: кнопки ведут на заявку, по ней показываем демо.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Floating from '../components/Floating.astro';
import LeadModal from '../components/LeadModal.astro';
import THero from '../sections/tracker/THero.astro';
import TVideo from '../sections/tracker/TVideo.astro';
import TWhy from '../sections/tracker/TWhy.astro';
import TSystem from '../sections/tracker/TSystem.astro';
import TSteps from '../sections/tracker/TSteps.astro';
import TPhoto from '../sections/tracker/TPhoto.astro';
import TResults from '../sections/tracker/TResults.astro';
import TEffect from '../sections/tracker/TEffect.astro';
import Questions from '../sections/Questions.astro';
import Contact from '../sections/Contact.astro';
import { faqJsonLd } from '../data/faq';
import { FAQ_TRACKER } from '../data/faq-tracker';
import { SITE, withBase } from '../config/site';

const NB = ' ';

const title = 'QODEX Tracker — новый стандарт контроля вывоза ТКО | QODEX';
const description =
  'Четыре камеры снимают мусоровоз со всех сторон до и после погрузки. ИИ считает контейнеры и сверяет с планом маршрута: норма, недовывоз или левак.';

// Тексты формы заявки на этой странице
const leadTitle = `Оставьте свои контакты, и${NB}мы покажем вам больше`;
const leadText = `Покажем демо QODEX${NB}Tracker. Мы можем показывать работу от контейнера до полигона.`;
const leadProof = `+17% контейнеров сверх плана — пилот у${NB}РО «Эко-Сити»`;

// Меню страницы: «Продукты» и главные разделы этой страницы (по порядку на странице); видео — кнопкой на первом экране
const nav = [
  { href: '#o-sisteme', label: 'О системе' },
  { href: '#algoritm', label: 'Как это работает' },
  { href: '#foto', label: 'Фотофиксация' },
  { href: '#rezultaty', label: 'Результаты' },
];

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'QODEX', item: new URL(withBase('/'), SITE.url).href },
    { '@type': 'ListItem', position: 2, name: 'QODEX Tracker', item: new URL(withBase('/tracker/'), SITE.url).href },
  ],
};
---

<Base title={title} description={description} jsonLd={[faqJsonLd(FAQ_TRACKER), breadcrumbs]}>
  <Floating />
  <Header home={false} cta="Запросить демо" current="tracker" nav={nav} />
  <main id="main">
    <THero />
    <TVideo />
    <TWhy />
    <TSystem />
    <TSteps />
    <TPhoto />
    <TResults />
    <TEffect />
    <Questions items={FAQ_TRACKER} />
    <Contact title={leadTitle} lead={leadText} proof={leadProof} personLabel="Ваш контакт" />
  </main>
  <Footer cta="Запросить демо" />
  <LeadModal title={leadTitle} proof={leadProof} personLabel="Ваш контакт" />
</Base>

<script>
  import { initReveal, initCounters } from '../scripts/motion';
  import { initAccordions, initChains } from '../scripts/kit';
  import { initGoals } from '../scripts/goals';
  import { setInterest, initInterestLinks } from '../scripts/interest';

  initReveal();
  initCounters();
  initAccordions();
  initChains();
  initGoals();
  initInterestLinks();

  // на странице продукта в поле «Что интересно» формы заявки отмечен только он
  setInterest(['tracker']);
</script>
