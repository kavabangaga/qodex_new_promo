---
// Служебный просмотр одного раздела: /s/<имя> (и образец дизайн-системы /s/kit).
// Работает только при разработке (npm run dev): в сборку для сайта эти страницы не попадают.
import Base from '../../layouts/Base.astro';
import LeadModal from '../../components/LeadModal.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../sections/Hero.astro';
import Losses from '../../sections/Losses.astro';
import Why2026 from '../../sections/Why2026.astro';
import Objects from '../../sections/Objects.astro';
import Balance from '../../sections/Balance.astro';
import Interfaces from '../../sections/Interfaces.astro';
import Numbers from '../../sections/Numbers.astro';
import Stories from '../../sections/Stories.astro';
import Compare from '../../sections/Compare.astro';
import Security from '../../sections/Security.astro';
import Pilot from '../../sections/Pilot.astro';
import Questions from '../../sections/Questions.astro';
import About from '../../sections/About.astro';
import Contact from '../../sections/Contact.astro';
import KitDemo from '../../components/dev/KitDemo.astro';

// Разделы страницы «Кодекс ТКО»: /s/k-hero, /s/k-why … Загружаются по одному, по запросу:
// ошибка в одном разделе не ломает просмотр остальных.
const KODEKS = import.meta.glob('../../sections/kodeks/*.astro');
const K = {
  'k-hero': 'KHero',
  'k-why': 'KWhy',
  'k-service': 'KService',
  'k-steps': 'KSteps',
  'k-excel': 'KExcel',
  'k-features': 'KFeatures',
  'k-fit': 'KFit',
  'k-trust': 'KTrust',
} as const;

// Разделы страницы «QODEX Tracker»: /s/t-hero, /s/t-video …
const TRACKER = import.meta.glob('../../sections/tracker/*.astro');
const T = {
  't-hero': 'THero',
  't-video': 'TVideo',
  't-why': 'TWhy',
  't-system': 'TSystem',
  't-steps': 'TSteps',
  't-photo': 'TPhoto',
  't-results': 'TResults',
  't-effect': 'TEffect',
} as const;

// Разделы страницы «РО-БОТ»: /s/r-hero, /s/r-modules …
const ROBOT = import.meta.glob('../../sections/robot/*.astro');
const R = {
  'r-hero': 'RHero',
  'r-modules': 'RModules',
  'r-steps': 'RSteps',
  'r-calc': 'RCalc',
  'r-gis': 'RGis',
  'r-week': 'RWeek',
  'r-interface': 'RInterface',
  'r-cases': 'RCases',
  'r-objects': 'RObjects',
  'r-legal': 'RLegal',
  'r-security': 'RSecurity',
} as const;

// Разделы страницы «QODEX TONN»: /s/n-hero, /s/n-fit …
const TONN = import.meta.glob('../../sections/tonn/*.astro');
const N = {
  'n-hero': 'NHero',
  'n-fit': 'NFit',
  'n-pains': 'NPains',
  'n-schemes': 'NSchemes',
  'n-law': 'NLaw',
  'n-how': 'NHow',
  'n-kit': 'NKit',
  'n-gallery': 'NGallery',
  'n-cabinet': 'NCabinet',
  'n-calc': 'NCalc',
  'n-results': 'NResults',
  'n-both': 'NBoth',
  'n-trust': 'NTrust',
} as const;

// Разделы копии главной с живыми скриншотами (на согласование): /s/p-hero …
const PREVIEW = import.meta.glob('../../sections/preview/*.astro');
const P = {
  'p-hero': 'HeroShots',
  'p-interfaces': 'InterfacesShots',
  'p-pilot': 'PilotShots',
} as const;

const MAP = {
  header: Header,
  hero: Hero,
  losses: Losses,
  why2026: Why2026,
  objects: Objects,
  balance: Balance,
  interfaces: Interfaces,
  numbers: Numbers,
  stories: Stories,
  compare: Compare,
  security: Security,
  pilot: Pilot,
  questions: Questions,
  about: About,
  contact: Contact,
  footer: Footer,
  kit: KitDemo,
} as const;

export function getStaticPaths() {
  if (import.meta.env.PROD) return [];
  return [
    'header',
    'hero',
    'losses',
    'why2026',
    'objects',
    'balance',
    'interfaces',
    'numbers',
    'stories',
    'compare',
    'security',
    'pilot',
    'questions',
    'about',
    'contact',
    'footer',
    'kit',
    // те же имена, что в K (сюда его не подставить: getStaticPaths видит только импорты)
    'k-hero',
    'k-why',
    'k-service',
    'k-steps',
    'k-excel',
    'k-features',
    'k-fit',
    'k-trust',
    // те же имена, что в T
    't-hero',
    't-video',
    't-why',
    't-system',
    't-steps',
    't-photo',
    't-results',
    't-effect',
    // те же имена, что в R
    'r-hero',
    'r-modules',
    'r-steps',
    'r-calc',
    'r-gis',
    'r-week',
    'r-interface',
    'r-cases',
    'r-objects',
    'r-legal',
    'r-security',
    // те же имена, что в N
    'n-hero',
    'n-fit',
    'n-pains',
    'n-schemes',
    'n-law',
    'n-how',
    'n-kit',
    'n-gallery',
    'n-cabinet',
    'n-calc',
    'n-results',
    'n-both',
    'n-trust',
    // те же имена, что в P
    'p-hero',
    'p-interfaces',
    'p-pilot',
  ].map((name) => ({ params: { name } }));
}

const { name } = Astro.params as {
  name: keyof typeof MAP | keyof typeof K | keyof typeof T | keyof typeof R | keyof typeof N | keyof typeof P;
};
const Section =
  name in K
    ? ((await KODEKS[`../../sections/kodeks/${K[name as keyof typeof K]}.astro`]()) as { default: typeof Header }).default
    : name in T
      ? ((await TRACKER[`../../sections/tracker/${T[name as keyof typeof T]}.astro`]()) as { default: typeof Header }).default
      : name in R
        ? ((await ROBOT[`../../sections/robot/${R[name as keyof typeof R]}.astro`]()) as { default: typeof Header }).default
        : name in N
          ? ((await TONN[`../../sections/tonn/${N[name as keyof typeof N]}.astro`]()) as { default: typeof Header }).default
          : name in P
            ? ((await PREVIEW[`../../sections/preview/${P[name as keyof typeof P]}.astro`]()) as { default: typeof Header }).default
            : MAP[name as keyof typeof MAP];
---

<Base title={`Раздел: ${name}`}>
  <main id="main">
    <Section />
  </main>
  <LeadModal />
</Base>

<script>
  import { initReveal, initCounters } from '../../scripts/motion';
  import { initAccordions, initChains } from '../../scripts/kit';
  import { initInterestLinks } from '../../scripts/interest';
  initReveal();
  initCounters();
  initAccordions();
  initChains();
  initInterestLinks();
</script>
