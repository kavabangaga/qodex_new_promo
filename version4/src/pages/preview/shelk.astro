---
// Служебная страница: варианты фона плашек — заказчику для сравнения (закрыта от поисковиков). Удалить после выбора.
// Шёлк поверх градиента — на плашке «Импорт из Excel» (Кодекс ТКО) стоят «два цвета палитры».
// Плавающий градиент — на главной, в блоке «Почему 2026» (пресет dusk), стоит обычный вариант.
import Base from '../../layouts/Base.astro';
import GradientVisual from '../../components/GradientVisual.astro';

const VARIANTS = [
  { name: 'Два цвета палитры — мягко', note: 'градиент подложки просвечивает сильнее', silk: { mode: 'duo', color: '#79b0ea', color2: '#eef8dc', strength: 0.7 } },
  { name: 'Два цвета палитры — стоит на сайте', note: 'голубой и светло-мятный шёлк поверх градиента подложки', silk: { mode: 'duo', color: '#79b0ea', color2: '#eef8dc' } },
  { name: 'Два цвета палитры — плотно', note: 'шёлк заметнее, градиент тише', silk: { mode: 'duo', color: '#79b0ea', color2: '#eef8dc', strength: 1.3 } },
  { name: 'Белый шёлк', note: 'молочная ткань поверх градиента подложки', silk: { mode: 'white', color: '#bcd9f2' } },
] as const;

const BLOB_VARIANTS = [
  { preset: 'dusk', name: 'Плавающий градиент — спокойнее', note: 'как было в первой версии: круг меньше, оборот за 30–40 с', blobs: { orbit: 14, speed: 1 } },
  { preset: 'dusk', name: 'Плавающий градиент — средне', note: 'круг 26%, оборот за 14–18 с', blobs: { orbit: 26, speed: 2.2 } },
  { preset: 'dusk', name: 'Плавающий градиент — ещё заметнее (выбран, стоит на сайте)', note: 'круг больше, быстрее («Почему 2026»)', blobs: {} },
  { preset: 'mint', name: 'Плавающий градиент на другой палитре', note: 'голубая подложка, как у Кодекса ТКО', blobs: {} },
] as const;
---

<Base title="Фон плашек — варианты | QODEX" noindex>
  <main class="container sh">
    <h1 class="t-h2">Плавающий градиент</h1>
    <div class="sh__grid">
      {
        BLOB_VARIANTS.map((v) => (
          <figure class="sh__item">
            <GradientVisual preset={v.preset} deco="blobs" blobs={v.blobs}>
              <div class="ui sh__card">
                <b>{v.name}</b>
                <span>{v.note}</span>
              </div>
            </GradientVisual>
          </figure>
        ))
      }
    </div>

    <h2 class="t-h2 sh__h">Шёлк на подложке</h2>
    <div class="sh__grid">
      {
        VARIANTS.map((v) => (
          <figure class="sh__item">
            <GradientVisual preset="mint" deco="silk" silk={v.silk}>
              <div class="ui sh__card">
                <b>{v.name}</b>
                <span>{v.note}</span>
              </div>
            </GradientVisual>
          </figure>
        ))
      }
    </div>
  </main>
</Base>

<style>
  .sh {
    padding-block: 48px 80px;
  }

  .sh__h {
    margin-top: 64px;
  }

  .sh__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 28px;
  }

  .sh__card {
    display: grid;
    gap: 6px;
    font-size: 15px;
    color: var(--muted);
  }

  .sh__card b {
    color: var(--ink);
    font-size: 17px;
  }

  @media (max-width: 760px) {
    .sh__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
