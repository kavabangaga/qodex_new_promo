---
// КОПИЯ components/ProductHow.astro для главной с живыми скриншотами (/preview/zhivye-skrinshoty/).
// Тексты, аккордеон «Как работает», ссылки и раскладка — как в оригинале; вместо нарисованных макетов (Shot)
// справа — настоящие экраны продуктов в рамке окна приложения на той же градиентной карточке, как на страницах
// продуктов (RInterface, NCabinet): РО-БОТ — дом в «ГИС ЖКХ» (жильцы по ГИС и биллингу), QODEX Tracker —
// кадры с четырёх камер, QODEX TONN — «Аналитика» кабинета, Кодекс ТКО — список актов «Не отправлено».
// Снимок один на продукт: пункты аккордеона переключаются, картинка остаётся.
// Снимок — целиком и в своих пропорциях на всех ширинах, телефон тоже (кадрировать нельзя — заказчик,
// 2026-10-08): окно повторяет пропорции снимка, у РО-БОТа 16:9, у TONN 4:3. Срезать можно только пустые
// поля фона вокруг интерфейса: у «Кодекса ТКО» — белые поля по бокам (окно 4:3). Чтобы снимок был крупнее,
// столбец картинки шире столбца текста. Окно не шире исходника на 2K (×1.45): 1000 px — не больше 690 px.
// Подложка собрана классами .gv, а не компонентом GradientVisual: компонент прячет содержимое
// от скринридера, а у снимков есть смысловые подписи (alt).
import ProductLabel from '../ProductLabel.astro';
import FeatureAccordion, { type AccItem } from '../FeatureAccordion.astro';
import Icon from '../Icon.astro';
import { PRODUCTS, productHref, withBase, type ProductId } from '../../config/site';

interface Props {
  id: ProductId;
  /** Заголовок — подпись к экрану продукта из ТЗ. */
  title: string;
  /** Шаги «Как работает»: короткое название пункта + текст шага из ТЗ. */
  steps: AccItem[];
  /** «Что это даёт». */
  benefits: string[];
  /** Мелкая сноска. */
  note: string;
  preset: 'sky' | 'aqua' | 'dusk' | 'mint' | 'lavender' | 'teal';
  /** Декор подложки — на сайте выключен (global.css), у снимков не нужен. */
  deco?: 'bars' | 'stripes' | 'none';
  /** Цвет полосы прогресса у пунктов (из палитры градиента). */
  accent?: string;
  /** Картинка слева, текст справа. */
  flip?: boolean;
  /** utm_content ссылки на лендинг. */
  from?: string;
}

const { id, title, steps, benefits, note, preset, accent, flip = false, from = 'interfaces' } = Astro.props;
const p = PRODUCTS[id];
const NB = String.fromCharCode(160); // неразрывный пробел

// ── Экраны продуктов: файл, размер снимка, подпись; trim — видимая часть без пустых полей ──
interface Screen {
  dir: string;
  file: string;
  /** Ширины файлов: большая — основная, малая — для srcset. */
  big: number;
  small: number;
  w: number;
  h: number;
  /** [x, y, ширина, высота] в пикселях снимка — только пустые поля фона за краем. Без него — снимок целиком. */
  trim?: [number, number, number, number];
  alt: string;
}

const SCREENS: Partial<Record<ProductId, Screen>> = {
  // экран «ГИС ЖКХ» целиком, 16:9: меню, дома улицы, карточка дома и таблица квартир
  robot: {
    dir: 'robot',
    file: 'shot-house',
    big: 1600,
    small: 800,
    w: 1600,
    h: 900,
    alt:
      'Демо-данные. Экран «ГИС ЖКХ» в РО-БОТе: слева меню и дома улицы Достоевского; карточка дома — 84 квартиры, ' +
      '227 жильцов, кнопка «Выгрузка из ГИС ЖКХ и сверка с Биллингом»; по каждой квартире — лицевой счёт, жильцы ' +
      'по ГИС ЖКХ и по биллингу, разница (+2, +3, +1) и даты обновления',
  },
  // экран «Аналитика» целиком, 4:3: итог начислений, прогноз, терсхема, график, меню кабинета
  tonn: {
    dir: 'tonn',
    file: 'cab-analytica',
    big: 1000,
    small: 600,
    w: 1000,
    h: 750,
    alt:
      'Демо-данные. Кабинет QODEX TONN, экран «Аналитика»: суммарный объём начислений площадкам на 18 февраля — ' +
      '29 082 234 ₽, прогноз начислений на конец месяца — 44 684 312 ₽, выполнение терсхемы — 12 465 т из 55 665 т, ' +
      'график тоннажа и начислений по дням; меню: аналитика, акты, контрагенты, районы, транспорт',
  },
  // экран «Взвешивания» целиком по высоте. Интерфейс занимает x 265–1415 из 1680, по бокам — пустой фон
  // (каждый столбец поля повторяет край снимка; справа в поле ещё и курсор мыши, x 1565–1583).
  // Поля срезаны до 55 px с каждой стороны: окно 1260 × 945 = 4:3, как у TONN
  kodeks: {
    dir: 'kodeks',
    file: 'ui-vzveshivaniya',
    big: 1680,
    small: 840,
    w: 1680,
    h: 945,
    trim: [210, 0, 1260, 945],
    alt:
      'Демо-данные. Кодекс ТКО, экран «Взвешивания»: кнопки «Добавить акт», «Выбрать неотправленные», ' +
      '«Отправить во ФГИС», «Скачать шаблон» и «Загрузить»; пять актов со статусом «Не отправлено» — дата и время, ' +
      'госномер, вес до и после выгрузки и вес груза; внизу меню: взвешивания, транспорт, клиенты, настройки',
  },
};

const screen = SCREENS[id];
const file = (s: Screen, w: number) => withBase(`/media/${s.dir}/${s.file}-${w}.webp`);
const view = (s: Screen) => s.trim ?? ([0, 0, s.w, s.h] as const);
// окно не шире видимой части снимка на 2K (масштаб Windows 145 %)
const maxW = (s: Screen) => Math.floor(view(s)[2] / 1.45);

// Ширина картинки = ширина окна × (ширина снимка / видимая ширина). Окно: телефон — карточка минус поля
// (100vw − 56 px), планшет — до ~780 px, компьютер — 580 px (столбец 640 минус поля карточки).
const sizesFor = (s: Screen) => {
  const k = (s.w / view(s)[2]).toFixed(3);
  const tab = Math.round(Math.min(780, maxW(s)) * Number(k));
  return `(max-width: 620px) calc((100vw - 56px) * ${k}), (max-width: 900px) ${tab}px, ${Math.round(580 * Number(k))}px`;
};

const winStyle = (s: Screen) => {
  const [x, y, w, h] = view(s);
  return `--iw:${s.w}; --x0:${x}; --y0:${y}; --cw:${w}; --ch:${h}; --maxw:${maxW(s)}px`;
};

// ── QODEX Tracker: кадры с четырёх камер мусоровоза (как в «Алгоритме работы» страницы Tracker) ──
// Спереди и слева — кадры 418 и 316 px: ячейка не шире 216 px, чтобы на 2K они не растягивались.
// Справа — площадка с полными контейнерами, сзади — контейнер на подъёмнике до погрузки (1200 px).
// Кадры целиком: ячейка 16:9, как у трёх кадров (у кадра слева 316 × 177 по краям срезано меньше 1 px);
// широкий кадр спереди (418 × 176) вписан целиком, над ним тёмная полоса с меткой и временем, как на мониторе
// видеорегистратора (класс ps-i-cam--wide). Размытые служебные строки кадров остаются видны.
// Демо-данные — как на странице Tracker: Мусоровоз 07, ул. Садовая, 21, 08:42.
const T = (name: string) => withBase(`/media/tracker/${name}`);
const CAMS = [
  {
    label: `Кам.${NB}1 · спереди`,
    src: T('cam-front.webp'),
    w: 418,
    h: 176,
    wide: true,
    alt: 'Кадр камеры 1, спереди: улица по ходу мусоровоза',
  },
  {
    label: `Кам.${NB}2 · слева`,
    src: T('cam-left.webp'),
    w: 316,
    h: 177,
    alt: 'Кадр камеры 2, слева: грунтовая улица и обочина',
  },
  {
    label: `Кам.${NB}3 · справа`,
    src: T('cam-b-before-1200.webp'),
    srcset: `${T('cam-b-before-720.webp')} 720w, ${T('cam-b-before-1200.webp')} 1200w`,
    w: 1200,
    h: 675,
    alt: 'Кадр камеры 3, справа: контейнерная площадка, контейнеры заполнены',
  },
  {
    label: `Кам.${NB}4 · сзади`,
    src: T('cam-a-before-1200.webp'),
    srcset: `${T('cam-a-before-720.webp')} 720w, ${T('cam-a-before-1200.webp')} 1200w`,
    w: 1200,
    h: 675,
    alt: 'Кадр камеры 4, над подъёмником: контейнер с отходами перед погрузкой',
  },
];
// ширина кадра: компьютер и планшет — 216 px, телефон — половина окна
const CAM_SIZES = '(max-width: 620px) calc((100vw - 74px) / 2), 216px';
---

<article class:list={['how', { 'how--flip': flip }]} id={id} data-acc-scope aria-labelledby={`${id}-title`}>
  <div class="how__text">
    <div data-reveal>
      <ProductLabel id={id} size="lg" />
    </div>
    <h3 class="t-serif how__title" id={`${id}-title`} data-reveal style="--d:1">
      <span class="visually-hidden">{p.name}. </span>{title}
    </h3>
    <div class="how__steps" data-reveal style="--d:2">
      <h4 class="how__sub">Как работает</h4>
      <FeatureAccordion id={`how-${id}`} items={steps} color={accent} />
    </div>
    <a
      href={productHref(id, from)}
      class="link-arrow how__more"
      data-interest={id}
      data-goal="product_landing"
      data-goal-product={id}
      data-reveal
      style="--d:3"
    >
      Подробнее о продукте<span class="visually-hidden"> {p.name}</span>
      <Icon name="arrow-up-right" />
    </a>
  </div>

  <div class="how__visual" data-reveal style="--d:1">
    <div class:list={['gv', `gv--${preset}`, 'ps-i-gv']}>
      {
        screen && (
          <div class="ps-i-win" style={winStyle(screen)}>
            <div class="ps-i-win__clip">
              <img
                class="ps-i-win__img"
                src={file(screen, screen.big)}
                srcset={`${file(screen, screen.small)} ${screen.small}w, ${file(screen, screen.big)} ${screen.big}w`}
                sizes={sizesFor(screen)}
                width={screen.w}
                height={screen.h}
                alt={screen.alt}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </div>
          </div>
        )
      }
      {
        id === 'tracker' && (
          <div class="ps-i-cams">
            <div class="ps-i-cams__head" aria-hidden="true">
              <span class="ps-i-cams__title">Мусоровоз 07</span>
              <span class="ps-i-cams__rec">
                <i />
                Запись
              </span>
            </div>
            <ul class="ps-i-cams__grid" aria-label="Демо-данные. Кадры с четырёх камер мусоровоза">
              {CAMS.map((c) => (
                <li class:list={['ps-i-cam', { 'ps-i-cam--wide': c.wide }]}>
                  <img
                    class="ps-i-cam__img"
                    src={c.src}
                    srcset={c.srcset}
                    sizes={c.srcset ? CAM_SIZES : undefined}
                    width={c.w}
                    height={c.h}
                    alt={c.alt}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                  <span class="ps-i-cam__tag" aria-hidden="true">
                    {c.label}
                  </span>
                  <span class="ps-i-cam__time" aria-hidden="true">
                    08:42
                  </span>
                </li>
              ))}
            </ul>
            <div class="ps-i-cams__foot" aria-hidden="true">
              <span class="ps-i-cams__place">
                <Icon name="map-pin" size={15} strokeWidth={2} />
                ул.{NB}Садовая,{NB}21
              </span>
              <span class="ps-i-cams__count">4{NB}камеры</span>
            </div>
          </div>
        )
      }
    </div>
    {/* скринридеру пометку читает начало alt снимка: плашка вне подложки прозвучала бы после него */}
    <span class="tag tag--demo how__demo" aria-hidden="true">демо-данные</span>
  </div>

  <div class="how__gain" data-reveal>
    <h4 class="how__sub">Что это даёт</h4>
    <ul class:list={['how__list', { 'is-three': benefits.length > 2 }]}>
      {
        benefits.map((b) => (
          <li>
            <span class="how__check" aria-hidden="true">
              <Icon name="check" size={14} strokeWidth={2.75} />
            </span>
            <span>{b}</span>
          </li>
        ))
      }
    </ul>
    <p class="footnote how__note">{note}</p>
  </div>
</article>

<style>
  /* столбец картинки шире столбца текста (на 2K 640 и 472 px): снимок целиком мельче участка, пусть будет крупнее */
  .how {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    grid-template-areas:
      'text visual'
      'gain gain';
    align-items: center;
    column-gap: clamp(40px, calc(var(--vw) * 6.2), 88px);
    row-gap: clamp(36px, calc(var(--vw) * 4), 56px);
  }

  .how--flip {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    grid-template-areas:
      'visual text'
      'gain gain';
  }

  .how__text {
    grid-area: text;
    min-width: 0;
  }

  /* подписи к экранам из ТЗ длиннее заголовков Calendly — антиква чуть мельче, без «висячих» строк */
  .how__title {
    margin-top: 16px;
    font-size: clamp(1.7rem, calc(var(--vw) * 2.35), 2.2rem);
    line-height: 1.13;
    text-wrap: pretty;
  }

  .how__steps {
    margin-top: clamp(28px, calc(var(--vw) * 3.4), 48px);
  }

  .how__sub {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--muted);
  }

  .how__steps .how__sub {
    margin-bottom: 14px;
  }

  .how__more {
    margin-top: 28px;
  }

  .how__visual {
    /* отступ плашки «демо-данные» от края карточки; от него же считается поле над окном */
    --ps-i-inset: clamp(14px, calc(var(--vw) * 1.6), 22px);
    grid-area: visual;
    position: relative;
    min-width: 0;
  }

  /* «демо-данные» в углу градиентной карточки */
  .how__demo {
    position: absolute;
    z-index: 1;
    top: var(--ps-i-inset);
    left: var(--ps-i-inset);
    pointer-events: none;
  }

  /* ── Подложка: сверху поле под плашку (24 px) и кольцо окна (8 px), между ними воздух, равный отступу
     плашки от края. На 2K всё по 22 px: край — плашка — кольцо, кольцо — бока и низ карточки.
     Высота — по окну (снимок 16:9 ниже, 4:3 выше), без min-height подложки: иначе вокруг широкого снимка
     пустое поле градиента ── */
  .ps-i-gv {
    min-height: 0;
    padding: calc(var(--ps-i-inset) * 2 + 32px) 30px 30px;
  }

  /* ── Окно приложения в пропорциях снимка. --x0, --y0, --cw × --ch — видимая часть в пикселях снимка
     шириной --iw: весь снимок или он без пустых полей по бокам. --maxw — не крупнее исходника на 2K ── */
  .ps-i-win {
    --win-r: 14px;
    position: relative;
    width: min(100%, var(--maxw));
    aspect-ratio: var(--cw) / var(--ch);
    border-radius: var(--win-r);
    background: #fff;
    box-shadow:
      0 0 0 8px rgb(255 255 255 / 0.4),
      var(--shadow-card);
  }

  .ps-i-win__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    /* страховка для Safari на iPhone: скругление обрезает и слой снимка */
    clip-path: inset(0 round var(--win-r));
  }

  .ps-i-win__img {
    position: absolute;
    top: calc(var(--y0) / var(--ch) * -100%);
    left: calc(var(--x0) / var(--cw) * -100%);
    width: calc(var(--iw) / var(--cw) * 100%);
    max-width: none;
    height: auto;
    -webkit-user-select: none;
    user-select: none;
  }

  /* ── QODEX Tracker: окно диспетчера с кадрами четырёх камер ── */
  .ps-i-cams {
    width: min(100%, 454px);
    padding: 8px;
    border-radius: 18px;
    background: #fff;
    color: var(--ink);
    box-shadow:
      0 0 0 8px rgb(255 255 255 / 0.4),
      var(--shadow-card);
  }

  .ps-i-cams__head,
  .ps-i-cams__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 8px 12px;
  }

  .ps-i-cams__foot {
    padding: 12px 8px 6px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .ps-i-cams__title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.2;
  }

  .ps-i-cams__rec,
  .ps-i-cams__count {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
  }

  .ps-i-cams__rec {
    background: #fdecee;
    color: var(--danger);
  }

  .ps-i-cams__rec i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .ps-i-cams__count {
    background: var(--panel);
    color: var(--muted);
  }

  .ps-i-cams__place {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .ps-i-cams__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  /* ячейка 16:9 — пропорции кадров; тёмный фон — полосы у широкого кадра */
  .ps-i-cam {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 10px;
    background: #171b1f;
  }

  .ps-i-cam__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-select: none;
    user-select: none;
  }

  /* широкий кадр спереди — целиком, прижат к низу: полоса сверху (30 px на 2K) вмещает метку и время,
     и они не заходят на кадр */
  .ps-i-cam--wide .ps-i-cam__img {
    object-fit: contain;
    object-position: 50% 100%;
  }

  .ps-i-cam__tag,
  .ps-i-cam__time {
    position: absolute;
    top: 6px;
    padding: 3px 7px;
    border-radius: 6px;
    background: rgb(29 29 31 / 0.66);
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.25;
    white-space: nowrap;
  }

  .ps-i-cam__tag {
    left: 6px;
  }

  .ps-i-cam__time {
    right: 6px;
    font-variant-numeric: tabular-nums;
  }

  /* «Что это даёт»: подпись, пункты мягкими плитками, сноска */
  .how__gain {
    grid-area: gain;
    display: grid;
    gap: 14px;
    padding-top: clamp(22px, calc(var(--vw) * 2.4), 30px);
    border-top: 1px solid var(--line);
  }

  .how__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .how__list.is-three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .how__list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 18px 20px;
    border-radius: calc(var(--r) * var(--rk));
    corner-shape: var(--corner);
    background: var(--panel);
    font-size: 15.5px;
    font-weight: 500;
    line-height: 1.45;
