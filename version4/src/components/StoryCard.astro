---
// Карточка истории клиента (приём Calendly «Real customers. Real results.»): слева результат крупной
// цифрой, задача и решение антиквой, внизу плашка клиента и метка продукта; справа вместо фото —
// градиентная иллюстрация интерфейса продукта (слот visual). Без цитат и отзывов.
// Нужна и на страницах продуктов (этап 2).
import ProductLabel from './ProductLabel.astro';
import { PRODUCTS, type ProductId } from '../config/site';

interface Props {
  client: string;
  product: ProductId;
  task: string;
  solution: string;
  /** Начало фразы результата — крупно (цифра). */
  resultLead: string;
  /** Продолжение той же фразы. */
  resultRest: string;
  /** Градиент иллюстрации — только пресеты палитры Calendly. */
  preset?: 'sky' | 'aqua' | 'dusk' | 'mint' | 'lavender' | 'teal';
  /** Подпись слайда в карусели для скринридера, например «1 из 3». */
  slideLabel?: string;
  class?: string;
}

const {
  client,
  product,
  task,
  solution,
  resultLead,
  resultRest,
  preset = 'sky',
  slideLabel,
  class: className,
  ...rest
} = Astro.props;

// Названия продуктов и «РО «…»» не разрываем переносом (сами тексты — без изменений)
const nb = (t: string) =>
  t.replace(/(QODEX|Кодекс) (TONN|Tracker|ТКО)/g, '$1\u00a0$2').replace(/(^|\s)(РО|ООО) «/g, '$1$2\u00a0«');
---

<article
  class:list={['story', `p-${product}`, className]}
  aria-roledescription={slideLabel ? 'слайд' : undefined}
  aria-label={slideLabel}
  {...rest}
>
  <div class="story__in">
  <div class="story__text">
    <h3 class="visually-hidden">{client}, {PRODUCTS[product].name}</h3>
    <p class="story__result">
      <span class="story__lead">{resultLead}</span>
      <span class="story__rest">{nb(resultRest.trim())}</span>
    </p>
    <dl class="story__qa">
      <div class="story__q">
        <dt>Задача:</dt>
        <dd>{nb(task)}</dd>
      </div>
      <div class="story__q">
        <dt>Решение:</dt>
        <dd>{nb(solution)}</dd>
      </div>
    </dl>
    <div class="story__who">
      <span class="story__client">{nb(client)}</span>
      <ProductLabel id={product} />
    </div>
  </div>

  <div class:list={['story__visual', 'gv', `gv--${preset}`]} aria-hidden="true">
    <div class="gv__stripes"></div>
    <span class="tag tag--demo story__demo">демо-данные</span>
    <slot name="visual" />
  </div>
  </div>
</article>

<style>
  .story {
    container-type: inline-size;
    padding: clamp(12px, calc(var(--vw) * 1.2), 16px);
    border-radius: calc(clamp(28px, calc(var(--vw) * 2.8), 40px) * var(--rk));
    corner-shape: var(--corner);
    background: #fff;
    box-shadow: var(--shadow-card);
  }

  .story__in {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(18px, calc(var(--vw) * 2.2), 30px);
    min-height: clamp(440px, calc(var(--vw) * 36), 500px);
  }

  .story__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(14px, calc(var(--vw) * 1.8), 22px) 0 clamp(8px, calc(var(--vw) * 1), 12px) clamp(10px, calc(var(--vw) * 1.4), 18px);
  }

  /* Результат: начало фразы крупно, как «75 hours saved monthly» у Calendly */
  .story__lead {
    display: block;
    font-size: clamp(2.6rem, calc(var(--vw) * 4.2), 3.6rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.05em;
    color: var(--ink);
    white-space: nowrap;
  }

  .story__rest {
    display: block;
    max-width: 34ch;
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* Задача и решение — тем же кеглем, что и описание результата; подпись отличается только
     насыщенностью и цветом (крупный кегль остался от цитаты антиквой и спорил с цифрой) */
  .story__qa {
    display: grid;
    gap: 10px;
    margin-top: auto;
    padding-top: 24px;
  }

  .story__q {
    max-width: 40ch;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .story__q dt,
  .story__q dd {
    display: inline;
  }

  .story__q dt {
    margin-right: 0.25em;
    font-weight: 600;
    color: var(--ink);
  }

  /* Плашка клиента (как плашка с именем у Calendly) и метка продукта */
  .story__who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 22px;
  }

  .story__client {
    padding: 5px 10px;
    border-radius: calc(8px * var(--rk));
    corner-shape: var(--corner);
    background: var(--panel-2);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink-2);
  }

  /* Иллюстрация: градиент палитры Calendly + белая карточка интерфейса */
  .story__visual {
    --gv-r: clamp(20px, calc(var(--vw) * 2.2), 28px);
    min-height: 0;
    align-content: center;
    gap: 0;
    padding: clamp(40px, calc(var(--vw) * 4), 52px) clamp(14px, calc(var(--vw) * 2), 26px);
  }

  .story__demo {
    position: absolute;
    top: 14px;
    left: 14px;
    font-size: 12px;
  }

  /* Узкая карточка (телефон, планшет): иллюстрация сверху, текст под ней */
  @container (max-width: 620px) {
    .story__in {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
      min-height: 0;
    }

    .story__visual {
      order: -1;
      min-height: 250px;
      padding: 44px 14px 26px;
    }

    .story__text {
      padding: 16px 8px 8px;
    }

    .story__qa {
      padding-top: 20px;
    }
  }
</style>
