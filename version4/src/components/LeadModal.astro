---
// Попап с формой заявки. Открывается по любой ссылке на #forma (кнопки пилота),
// без JavaScript эти ссылки по-прежнему ведут к форме внизу страницы.
// v4: белая панель, слева — цветная панель с заголовком и контактом по пилоту (её фон медленно
// вращается), справа — форма.
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';
import { CONTACTS } from '../config/site';
---

<dialog class="lm" data-lead-modal aria-labelledby="lm-title">
  <div class="lm__panel">
    <button class="lm__close" type="button" aria-label="Закрыть" data-lm-close>
      <Icon name="x" size={20} />
    </button>
    <aside class="lm__side">
      <p class="t-eyebrow lm__eyebrow">Заявка</p>
      <h2 class="lm__title" id="lm-title">Покажем эффект в рублях на одном районе или одной весовой</h2>
      <p class="lm__lead">Пилот РО-БОТа — бесплатно. Напишите или позвоните — пришлём NDA и запустим пилот.</p>
      <div class="lm__person">
        <span class="lm__avatar" aria-hidden="true">ДМ</span>
        <div class="lm__person-text">
          <span class="lm__person-label">Ваш контакт по пилоту</span>
          <strong>{CONTACTS.pilotContact}</strong>
          <a href={CONTACTS.phoneHref} data-goal="phone_click">
            <Icon name="phone" size={16} />
            {CONTACTS.phone}
          </a>
        </div>
      </div>
      <p class="lm__proof"><span aria-hidden="true"></span>73 клиента работают с продуктами QODEX</p>
    </aside>
    <div class="lm__main">
      <LeadForm prefix="lm" layout="stack" tone="light" />
    </div>
  </div>
</dialog>

<style>
  .lm {
    width: min(1040px, calc(calc(var(--vw) * 100) - 32px));
    max-width: none;
    max-height: calc(var(--dvh) * 100 - 32px);
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
    color: var(--ink);
  }

  .lm::backdrop {
    background: rgb(29 29 31 / 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .lm[open] .lm__panel {
    animation: lm-in 0.45s var(--ease-out);
  }

  .lm[open]::backdrop {
    animation: lm-fade 0.3s ease;
  }

  .lm.is-closing .lm__panel {
    animation: lm-out 0.18s ease-in forwards;
  }

  .lm.is-closing::backdrop {
    animation: lm-fade 0.18s ease reverse forwards;
  }

  @keyframes lm-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }

  @keyframes lm-out {
    to {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }

  @keyframes lm-fade {
    from {
      opacity: 0;
    }
  }

  .lm__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    max-height: calc(var(--dvh) * 100 - 32px);
    border-radius: var(--r-lg);
    background: var(--card);
    overflow: hidden;
    box-shadow: 0 40px 120px -30px rgb(29 29 31 / 0.45);
  }

  /* Левая часть — цветная панель: мягкие пятна палитры, как в зонах первого экрана */
  .lm__side {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 10px 0 10px 10px;
    padding: clamp(24px, calc(var(--vw) * 3), 40px);
    border-radius: calc(var(--r-lg) - 8px);
    background: linear-gradient(135deg, #c3dcf8 0%, #d6cdfa 50%, #c4e3f6 100%);
    overflow: hidden;
    /* вращающийся слой Safari на iPhone может не обрезать по скруглению — обрезка продублирована */
    clip-path: inset(0 round calc(var(--r-lg) - 8px));
  }

  /* Пятна нарисованы на прозрачном квадрате, который медленно вращается вокруг центра панели.
     Все пятна гаснут внутри квадрата, поэтому его края не видны, какой бы высокой ни стала панель.
     Анимируется только transform: слой рисуется один раз, дальше его поворачивает видеокарта.
     Не добавляйте сюда filter и blur — с ними слой перерисовывается каждый кадр и вращение дёргается. */
  .lm__side::before {
    --spin: 840px;
    content: '';
    position: absolute;
    z-index: -2;
    top: 50%;
    left: 50%;
    width: var(--spin);
    height: var(--spin);
    margin: calc(var(--spin) / -2) 0 0 calc(var(--spin) / -2);
    background:
      radial-gradient(17% 17% at 33.8% 31.9%, rgb(61 132 223 / 0.36) 0%, rgb(61 132 223 / 0) 100%),
      radial-gradient(28.6% 28.6% at 32.9% 31%, #6bb1ff 0%, rgb(107 177 255 / 0) 72%),
      radial-gradient(29.5% 29.5% at 69% 63.3%, #b89ffa 0%, rgb(184 159 250 / 0) 72%),
      radial-gradient(23.8% 23.8% at 37.6% 71.9%, #f1b5e6 0%, rgb(241 181 230 / 0) 72%),
      radial-gradient(25.7% 25.7% at 68.1% 28.1%, #c7ecfb 0%, rgb(199 236 251 / 0) 72%);
    will-change: transform;
    animation: lm-spin 60s linear infinite;
  }

  /* неподвижная светлая вуаль: осветляет верх панели под заголовком и абзацем */
  .lm__side::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.26) 0%,
      rgb(255 255 255 / 0.14) 55%,
      rgb(255 255 255 / 0) 100%
    );
    pointer-events: none;
  }

  @keyframes lm-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* режим высокой контрастности Windows: цвета текста задаёт система, цветной фон под ним не нужен */
  @media (forced-colors: active) {
    .lm__side {
      background: Canvas;
    }

    .lm__side::before,
    .lm__side::after {
      display: none;
    }
  }

  .lm__title {
    font-size: clamp(1.5rem, calc(var(--vw) * 2.3), 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 600;
    text-wrap: balance;
  }

  /* на цветном фоне серому тексту не хватает контраста — абзац и нижняя строка темнее обычного */
  .lm__lead {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* Контакт по пилоту — белая карточка */
  .lm__person {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
    padding: 16px;
    border-radius: var(--r);
    background: #fff;
    box-shadow:
      0 1px 2px rgb(29 29 31 / 0.05),
      0 12px 30px -14px rgb(29 29 31 / 0.24);
  }

  .lm__avatar {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 50%;
    background: var(--blue-soft);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .lm__person-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .lm__person-label {
    font-size: 13px;
    color: var(--muted);
  }

  .lm__person strong {
    font-size: 16px;
    font-weight: 600;
  }

  .lm__person a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 560;
    color: var(--ink);
    white-space: nowrap;
  }

  .lm__person a:hover {
    color: var(--blue);
  }

  .lm__proof {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }

  .lm__proof span {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--ok);
  }

  /* Правая часть с формой */
  .lm__main {
    position: relative;
    padding: clamp(28px, calc(var(--vw) * 3), 44px);
    padding-top: clamp(60px, calc(var(--vw) * 4.4), 68px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .lm__close {
    position: absolute;
    z-index: 2;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .lm__close:hover {
    border-color: var(--ink);
    background: var(--bg);
  }

  /* на телефоне кнопка лежит на цветной панели: белое кольцо отделяет синюю рамку фокуса от фона */
  .lm__close:focus-visible {
    box-shadow: 0 0 0 3px #fff;
  }

  /* Телефон: шторка снизу */
  @media (max-width: 760px) {
    .lm {
      width: calc(var(--vw) * 100);
      max-height: 94dvh;
      margin: auto 0 0;
    }

    .lm__panel {
      grid-template-columns: 1fr;
      max-height: 94dvh;
      border-radius: 24px 24px 0 0;
      overflow-y: auto;
    }

    .lm[open] .lm__panel {
      animation-name: lm-sheet;
    }

    @keyframes lm-sheet {
      from {
        transform: translateY(40%);
        opacity: 0;
      }
    }

    .lm__side {
      gap: 8px;
      margin: 8px 8px 0;
      padding: 20px 64px 20px 20px;
    }

    /* панель здесь — полоса во всю ширину окна: слой чуть шире окна */
    .lm__side::before {
      --spin: calc(var(--vw) * 112);
    }

    /* заголовок занимает почти всю полосу — вуаль ровная, чтобы он читался в любой фазе */
    .lm__side::after {
      background: rgb(255 255 255 / 0.22);
    }

    .lm__lead,
    .lm__person,
    .lm__proof {
      display: none;
    }

    .lm__title {
      font-size: 1.3rem;
    }

    .lm__main {
      overflow: visible;
      padding: 20px 20px calc(24px + env(safe-area-inset-bottom));
    }

    .lm__close {
      top: 18px;
      right: 18px;
    }
  }

  :global(html.is-modal) {
    overflow: hidden;
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lead-modal]');

  if (dlg && typeof dlg.showModal === 'function') {
    const html = document.documentElement;
    let closing = false;

    const resetIfDone = () => {
      const form = dlg.querySelector<HTMLFormElement>('[data-lead-form]');
      const done = form?.querySelector<HTMLElement>('[data-done]');
      if (form && done && !done.hidden) {
        form.reset();
        form.querySelector<HTMLElement>('[data-lf-fields]')!.hidden = false;
        done.hidden = true;
      }
    };

    const open = () => {
      if (dlg.open) return;
      resetIfDone();
      dlg.showModal();
      html.classList.add('is-modal');
      dlg.querySelector<HTMLInputElement>('input[name="name"]')?.focus({ preventScroll: true });
    };

    const close = () => {
      if (!dlg.open || closing) return;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        dlg.close();
        return;
      }
      closing = true;
      dlg.classList.add('is-closing');
      window.setTimeout(() => {
        dlg.classList.remove('is-closing');
        dlg.close();
        closing = false;
      }, 180);
    };

    dlg.addEventListener('close', () => html.classList.remove('is-modal'));
    // Esc — закрываем с анимацией
    dlg.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    // клик мимо окна (по подложке)
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) close();
    });
    dlg.querySelector('[data-lm-close]')!.addEventListener('click', close);

    // Все кнопки пилота (ссылки на #forma) открывают попап
    document.addEventListener('click', (e) => {
      const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href="#forma"]');
      if (!link || dlg.contains(link)) return;
      e.preventDefault();
      open();
    });
  }
</script>
