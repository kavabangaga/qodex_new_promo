---
// Подвал как у Calendly: тёмно-синяя скруглённая панель, крупная фраза, колонки ссылок, большой логотип.
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { PRODUCT_ICON } from './ProductLabel.astro';
import { CONTACTS, PRODUCTS, PRODUCT_ORDER, productHref, SKOLKOVO_URL, withBase } from '../config/site';

const NB = ' ';

const docs = [
  { href: withBase('/politika'), label: 'Политика конфиденциальности' },
  { href: withBase('/soglasie'), label: 'Согласие на обработку персональных данных' },
  { href: withBase('/soglashenie'), label: 'Пользовательское соглашение' },
  { href: withBase('/documents'), label: 'Документы' },
];
---

<footer class="ftr">
  <div class="ftr__panel">
    <div class="container">
      <div class="ftr__top">
        <div class="ftr__lead">
          <p class="ftr__slogan">Вы начисляете и платите по фактическим данным.</p>
          <a href="#forma" class="btn btn--light ftr__cta" data-goal="pilot_click">
            Запустить бесплатный пилот
            <Icon name="arrow-right" />
          </a>
        </div>

        <div class="ftr__cols">
          <nav class="ftr__col" aria-label="Продукты">
            <p class="ftr__h">Продукты</p>
            <ul>
              {
                PRODUCT_ORDER.map((id) => (
                  <li>
                    <a
                      href={productHref(id, 'footer')}
                      class:list={['ftr__product', `p-${id}`]}
                      data-goal="product_landing"
                      data-goal-product={id}
                    >
                      <span class="ftr__ico" aria-hidden="true">
                        <Icon name={PRODUCT_ICON[id]} size={13} strokeWidth={2.2} />
                      </span>
                      {PRODUCTS[id].name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="ftr__col">
            <p class="ftr__h">Контакты</p>
            <ul>
              <li><a href={CONTACTS.phoneHref} data-goal="phone_click">{CONTACTS.phone}</a></li>
              <li><a href={CONTACTS.emailHref}>{CONTACTS.email}</a></li>
              <li>
                <a href={CONTACTS.telegramHref} target="_blank" rel="noopener" data-goal="telegram_click">
                  Telegram {CONTACTS.telegram}
                </a>
              </li>
              <li>
                <a href={SKOLKOVO_URL} target="_blank" rel="noopener" class="ftr__sk">
                  Резидент Сколково
                  <Icon name="arrow-up-right" size={14} />
                </a>
              </li>
            </ul>
          </div>

          <nav class="ftr__col" aria-label="Документы">
            <p class="ftr__h">Документы</p>
            <ul>
              {
                docs.map((d) => (
                  <li>
                    <a href={d.href}>{d.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>

      <a href={withBase('/')} class="ftr__logo" aria-label="QODEX — на главную"><Logo height={60} /></a>

      <div class="ftr__bottom">
        <p class="ftr__req">
          ООО «КОДЕКС ТЕХНОЛОГИИ» · ИНН 0278962265 · КПП 027801001 · ОГРН 1200200055791 · ОКВЭД 62.01 · Код вида
          ИТ-деятельности 2.01 (приказ Минцифры №{NB}449 от 11.05.2023) · 450009, г.{NB}Уфа, ул.{NB}Братьев
          Кадомцевых, д.{NB}12/2, подъезд 1, кв.{NB}1, комн.{NB}7.
        </p>
        <p class="ftr__copy">© 2020–2026 QODEX</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .ftr {
    padding: 0 var(--page-pad) var(--page-pad);
  }

  /* Графит в тон кнопкам; по углам — мягкое свечение цветов палитры (лаванда, бирюза, небо) */
  .ftr__panel {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(56px, calc(var(--vw) * 7), 104px) 0 clamp(24px, calc(var(--vw) * 3), 40px);
    border-radius: calc(var(--r-2xl) * var(--rk));
    corner-shape: var(--corner);
    background: #1f1f22;
    color: #fff;
  }

  .ftr__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(42% 60% at 96% 0%, rgb(184 159 250 / 0.26) 0%, transparent 70%),
      radial-gradient(36% 55% at 70% 8%, rgb(107 177 255 / 0.16) 0%, transparent 72%),
      radial-gradient(40% 60% at 0% 100%, rgb(93 223 215 / 0.16) 0%, transparent 70%);
    pointer-events: none;
  }

  .ftr__top {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(40px, calc(var(--vw) * 6), 96px);
  }

  .ftr__lead {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 32px;
  }

  .ftr__slogan {
    max-width: 13ch;
    font-size: clamp(2.3rem, calc(var(--vw) * 4.6), 4.25rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .ftr__h {
    margin-bottom: 16px;
    font-size: 17px;
    font-weight: 600;
  }

  .ftr__col ul {
    display: grid;
    gap: 12px;
  }

  .ftr__col a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    line-height: 1.4;
    color: rgb(255 255 255 / 0.72);
    transition: color 0.2s;
  }

  .ftr__col a:hover {
    color: #fff;
  }

  .ftr__ico {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    flex: none;
    border-radius: calc(6px * var(--rk));
    corner-shape: var(--corner);
    background: var(--pc);
    color: #fff;
  }

  .ftr__logo {
    display: inline-flex;
    margin-top: clamp(56px, calc(var(--vw) * 7), 104px);
    color: #fff;
  }

  .ftr__logo :global(svg) {
    width: clamp(180px, calc(var(--vw) * 22), 290px);
    height: auto;
  }

  .ftr__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 13px;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.6);
  }

  .ftr__req {
    max-width: 880px;
  }

  .ftr__copy {
    flex: none;
    font-weight: 500;
    color: rgb(255 255 255 / 0.8);
  }

  @media (max-width: 1023px) {
    .ftr__top {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .ftr__cols {
      grid-template-columns: 1fr 1fr;
    }

    .ftr__cols > :last-child {
      grid-column: 1 / -1;
    }

    .ftr__bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .ftr__cta {
      width: 100%;
    }
  }
</style>
