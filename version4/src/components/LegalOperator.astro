---
// Раздел с реквизитами оператора — один и тот же в согласиях, Политике и Пользовательском соглашении.
// Реквизиты — из COMPANY (выписка из ЕГРЮЛ), номер — из реестра операторов Роскомнадзора.
// defined — термин «Оператор» уже введён раньше в документе (соглашение): без «далее — Оператор».
import { COMPANY, CONTACTS, nbName } from '../config/site';

interface Props {
  defined?: boolean;
}

const { defined = false } = Astro.props;
const NB = String.fromCharCode(160);
---

<p>
  {nbName(COMPANY.fullName)} ({nbName(COMPANY.shortName)}{defined ? '' : ', далее — Оператор'}), ОГРН{NB}{COMPANY.ogrn},
  ИНН{NB}{COMPANY.inn}, КПП{NB}{COMPANY.kpp}, адрес:{' '}{COMPANY.address}; электронная почта:{' '}
  <a href={CONTACTS.emailHref}>{CONTACTS.email}</a>; телефон:{' '}<a href={CONTACTS.phoneHref}>{CONTACTS.phone}</a>.
  Оператор внесён в реестр операторов, осуществляющих обработку персональных данных, под регистрационным
  номером{NB}{COMPANY.pdRegistry}.
</p>
