---
// Большая скруглённая градиентная карточка-иллюстрация (как справа в разделах продуктов Calendly).
// Внутрь кладётся белая карточка интерфейса <div class="ui">…</div> или несколько панелей [data-pane].
interface Props {
  preset?: 'sky' | 'aqua' | 'dusk' | 'mint' | 'lavender' | 'teal';
  /** Декор: «звуковая волна» из полос по бокам, горизонтальные полосы, пиксельный растр или ничего. */
  deco?: 'bars' | 'stripes' | 'dither' | 'none';
  class?: string;
  /** Подпись для скринридера; без неё иллюстрация скрыта от него. */
  label?: string;
  [key: string]: unknown;
}

const { preset = 'sky', deco = 'bars', class: className, label, ...rest } = Astro.props;

// Высоты полос «звуковой волны» — фиксированные, чтобы картинка не прыгала между сборками
const LEFT = [38, 62, 84, 56, 92, 70, 44];
const RIGHT = [52, 80, 46, 96, 64, 88, 40];
---

<div
  class:list={['gv', `gv--${preset}`, className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  {...rest}
>
  {
    deco === 'bars' && (
      <div class="gv__bars">
        <span>
          {LEFT.map((h) => (
            <i style={`--h:${h}%`} />
          ))}
        </span>
        <span>
          {RIGHT.map((h) => (
            <i style={`--h:${h}%`} />
          ))}
        </span>
      </div>
    )
  }
  {deco === 'stripes' && <div class="gv__stripes" />}
  {deco === 'dither' && <canvas class="gv__dither" data-gv-dither={preset} aria-hidden="true" />}
  <slot />
</div>

<script>
  // Пиксельный растр на подложке: приглушённые белые квадратики на сетке, плотность плавно меняется
  // (упорядоченный дизеринг, матрица Байера 8×8): «облако» в верхнем углу, масса полегче у левого края
  // и «холмы» снизу; края у них неровные, середина под карточкой пустая.
  // Рисуется в физических пикселях экрана, поэтому квадраты чёткие при любом масштабе.
  const CELL = 6; // шаг сетки, CSS px
  const DOT = 0.5; // сторона квадратика — доля шага
  const ALPHA = 0.36; // насколько заметен узор

  // порог для каждой клетки 8×8: чем меньше число, тем раньше клетка закрашивается
  const BAYER = [
    [0, 32, 8, 40, 2, 34, 10, 42],
    [48, 16, 56, 24, 50, 18, 58, 26],
    [12, 44, 4, 36, 14, 46, 6, 38],
    [60, 28, 52, 20, 62, 30, 54, 22],
    [3, 35, 11, 43, 1, 33, 9, 41],
    [51, 19, 59, 27, 49, 17, 57, 25],
    [15, 47, 7, 39, 13, 45, 5, 37],
    [63, 31, 55, 23, 61, 29, 53, 21],
  ].map((row) => row.map((v) => (v + 0.5) / 64));

  const smooth = (a: number, b: number, x: number) => {
    const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
    return t * t * (3 - 2 * t);
  };

  // плавный «шум» из нескольких синусоид; фазы зависят от названия подложки — узор одинаков при каждой загрузке
  const waves = (seed: string, n: number) => {
    let h = 2166136261;
    for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
    const rnd = () => ((h = Math.imul(h ^ (h >>> 15), 2246822507) >>> 0) / 4294967296);
    const w = Array.from({ length: n }, () => ({ fx: 0.6 + rnd() * 2.4, fy: 0.6 + rnd() * 2.4, px: rnd() * 6.283, py: rnd() * 6.283, a: 0.4 + rnd() }));
    const total = w.reduce((s, k) => s + k.a, 0);
    return (u: number, v: number) => w.reduce((s, k) => s + k.a * Math.sin(u * k.fx * 6.283 + k.px) * Math.cos(v * k.fy * 6.283 + k.py), 0) / total;
  };

  const draw = (cv: HTMLCanvasElement) => {
    const rect = cv.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    const dpr = window.devicePixelRatio || 1;
    // во сколько раз страница уменьшена автомасштабом (видимая ширина к ширине раскладки)
    const zoom = cv.offsetWidth ? rect.width / cv.offsetWidth : 1;
    const W = Math.round(rect.width * dpr);
    const H = Math.round(rect.height * dpr);
    cv.width = W;
    cv.height = H;
    const cell = Math.max(3, Math.round(CELL * dpr * zoom));
    const dot = Math.max(1, Math.round(cell * DOT));
    const seed = cv.dataset.gvDither || 'gv';
    const hills = waves(seed + 'h', 4);
    const grain = waves(seed + 'g', 5);
    const ctx = cv.getContext('2d')!;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = `rgba(255, 255, 255, ${ALPHA})`;
    for (let y = 0, j = 0; y < H; y += cell, j++) {
      const v = (y + cell / 2) / H;
      for (let x = 0, i = 0; x < W; x += cell, i++) {
        const u = (x + cell / 2) / W;
        // расстояния «искривлены» шумом — края масс неровные, как у облаков
        const warp = 0.13 * hills(u, v);
        const cloud = smooth(0.72, 0.08, Math.hypot((u - 0.96) * 1.1, v + 0.02) + warp);
        const side = 0.72 * smooth(0.44, 0.04, Math.hypot(u + 0.03, (v - 0.56) * 0.8) + warp);
        const horizon = 0.82 + 0.08 * hills(u + 0.5, 0.7);
        const ground = 0.8 * smooth(horizon - 0.26, horizon + 0.22, v);
        const d = Math.max(cloud, side, ground) * (0.84 + 0.26 * grain(u, v));
        if (d > BAYER[j % 8][i % 8]) ctx.fillRect(x, y, dot, dot);
      }
    }
  };

  const canvases = document.querySelectorAll<HTMLCanvasElement>('[data-gv-dither]');
  if (canvases.length) {
    const ro = new ResizeObserver((entries) => entries.forEach((e) => draw(e.target as HTMLCanvasElement)));
    canvases.forEach((cv) => ro.observe(cv));
  }
</script>
