---
// Большая скруглённая градиентная карточка-иллюстрация (как справа в разделах продуктов Calendly).
// Внутрь кладётся белая карточка интерфейса <div class="ui">…</div> или несколько панелей [data-pane].
interface Props {
  preset?: 'sky' | 'aqua' | 'dusk' | 'mint' | 'lavender' | 'teal';
  /** Декор поверх подложки: «звуковая волна» из полос по бокам, горизонтальные полосы (обе выключены
   *  по всему сайту) или ничего. 'blobs' — то же, что 'none' (пятна и так идут). */
  deco?: 'bars' | 'stripes' | 'blobs' | 'none';
  /** Плавающий градиент — на всех плашках по умолчанию (решение заказчика 09.10.2026): пятна подложки ходят
   *  по кругу (GvBlobs.astro). Радиус орбиты и скорость можно задать; false — неподвижный градиент. */
  blobs?: false | { orbit?: number; speed?: number };
  class?: string;
  /** Подпись для скринридера; без неё иллюстрация скрыта от него. */
  label?: string;
  [key: string]: unknown;
}

import GvBlobs from './GvBlobs.astro';

const { preset = 'sky', deco = 'bars', blobs = {}, class: className, label, ...rest } = Astro.props;
const moving = blobs !== false;

// Высоты полос «звуковой волны» — фиксированные, чтобы картинка не прыгала между сборками
const LEFT = [38, 62, 84, 56, 92, 70, 44];
const RIGHT = [52, 80, 46, 96, 64, 88, 40];
---

<div
  class:list={['gv', `gv--${preset}`, { 'gv--blobs': moving }, className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  {...rest}
>
  {
    deco === 'bars' && (
      <div class="gv__bars">
        <span>
          {LEFT.map((h) => (
            <i style={`--h:${h}%`} />
          ))}
        </span>
        <span>
          {RIGHT.map((h) => (
            <i style={`--h:${h}%`} />
          ))}
        </span>
      </div>
    )
  }
  {deco === 'stripes' && <div class="gv__stripes" />}
  {moving && <GvBlobs preset={preset} {...blobs} />}
  <slot />
</div>
