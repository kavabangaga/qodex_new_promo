---
// Плашка о файлах cookie и Яндекс Метрике — согласие посетителя (pages/cookies.astro). Есть только тогда,
// когда Метрика включена (METRIKA_ID в config/site.ts): без Метрики сайт не ставит cookie и не собирает
// персональные данные, спрашивать не о чем. Метрика запускается только после «Принять» (layouts/Base.astro);
// «Отклонить» — сайт работает как обычно. Выбор хранится в браузере год, с датой редакции согласия:
// поменялся текст согласия — плашка спросит снова. «Настройки cookie» в подвале открывают плашку заново.
// Плавающих кнопок связи в v4 нет, как у Calendly: телефон и «Запустить пилот» — в шапке.
import { CONSENT_EDITION, DOC_LINKS, METRIKA_ID } from '../config/site';
---

{
  METRIKA_ID && (
    <section class="cookie" data-cookie data-edition={CONSENT_EDITION.cookies} aria-label="Файлы cookie" hidden>
      <p>
        Мы используем файлы cookie и Яндекс Метрику, чтобы понимать, как посетители пользуются сайтом. Нажмите
        «Принять», если согласны, — подробнее в&nbsp;<a href={DOC_LINKS.cookies}>согласии на использование cookie</a>.
        Без согласия сайт тоже работает.
      </p>
      <div class="cookie__actions">
        <button type="button" class="btn btn--primary btn--sm" data-cookie-accept>
          Принять
        </button>
        <button type="button" class="btn btn--outline btn--sm" data-cookie-decline>
          Отклонить
        </button>
      </div>
    </section>
  )
}

<style>
  .cookie {
    position: fixed;
    left: 24px;
    bottom: 24px;
    z-index: 45;
    display: grid;
    gap: 14px;
    max-width: 440px;
    padding: 18px 18px 18px 20px;
    border-radius: calc(20px * var(--rk));
    corner-shape: var(--corner);
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(29 29 31 / 0.06),
      var(--shadow-float);
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-2);
    animation: cookie-in 0.6s var(--ease-out) 1.6s both;
  }

  @keyframes cookie-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .cookie a {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--ink);
  }

  .cookie__actions {
    display: flex;
    gap: 8px;
  }

  .cookie[hidden] {
    display: none;
  }

  @media (max-width: 760px) {
    .cookie {
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      max-width: none;
    }

    .cookie__actions .btn {
      flex: 1;
    }
  }
</style>

<script>
  // Выбор посетителя: { choice: 'accepted' | 'declined', at: время, edition: дата редакции согласия }
  const KEY = 'qodex:cookie-consent';
  const YEAR = 365 * 24 * 60 * 60 * 1000;

  type Saved = { choice: 'accepted' | 'declined'; at: number; edition: string };

  const box = document.querySelector<HTMLElement>('[data-cookie]');

  if (box) {
    const edition = box.dataset.edition ?? '';
    const metrika = () => (window as unknown as { qodexMetrika?: () => void }).qodexMetrika?.();

    const read = (): Saved | null => {
      try {
        const saved = JSON.parse(localStorage.getItem(KEY) ?? 'null') as Saved | null;
        // выбор действует год и только для той редакции согласия, на которую его дали
        if (saved && saved.edition === edition && Date.now() - saved.at < YEAR) return saved;
      } catch {
        /* хранилище недоступно */
      }
      return null;
    };

    const save = (choice: Saved['choice']) => {
      try {
        localStorage.setItem(KEY, JSON.stringify({ choice, at: Date.now(), edition }));
      } catch {
        /* хранилище недоступно: выбор действует до закрытия страницы */
      }
    };

    // отказ после согласия: убираем cookie Метрики (_ym…) и перезагружаем страницу, чтобы счётчик остановился
    const dropMetrika = () => {
      const host = location.hostname;
      const domains = ['', host, `.${host}`, `.${host.split('.').slice(-2).join('.')}`];
      document.cookie.split(';').forEach((c) => {
        const name = c.split('=')[0].trim();
        if (!name.startsWith('_ym')) return;
        domains.forEach((d) => {
          document.cookie = `${name}=; Max-Age=0; path=/${d ? `; domain=${d}` : ''}`;
        });
      });
      if ((window as unknown as { qodexMetrikaOn?: boolean }).qodexMetrikaOn) location.reload();
    };

    const saved = read();
    if (saved?.choice === 'accepted') metrika();
    box.hidden = saved !== null;

    box.querySelector('[data-cookie-accept]')!.addEventListener('click', () => {
      save('accepted');
      box.hidden = true;
      metrika();
    });

    box.querySelector('[data-cookie-decline]')!.addEventListener('click', () => {
      save('declined');
      box.hidden = true;
      dropMetrika();
    });

    // «Настройки cookie» в подвале: открыть плашку снова
    document.addEventListener('click', (e) => {
      if (!(e.target as Element | null)?.closest('[data-cookie-settings]')) return;
      box.style.animation = 'none';
      box.hidden = false;
      box.querySelector<HTMLButtonElement>('[data-cookie-accept]')!.focus();
    });
  }
</script>
