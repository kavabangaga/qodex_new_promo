---
// Иконки Hugeicons Free (стиль Stroke Rounded, MIT), контурные 24×24.
import { HUGEICONS } from './icons/hugeicons';

// Свои иконки в том же стиле — для того, чего нет в бесплатном наборе.
const OWN = {
  // Мусорный контейнер на колёсах: в Hugeicons есть только бак «waste», на 17–22 px он не читается
  'waste-bin':
    '<path d="M3.5 8h17"/><path d="M6 8l.6-1.6C7 5.4 7.6 5 8.6 5h6.8c1 0 1.6.4 2 1.4L18 8"/><path d="m5 8 .9 8.3c.2 1.8 1 2.7 2.9 2.7h6.4c1.9 0 2.7-.9 2.9-2.7L19 8"/><path d="M10 11.5v4m4-4v4"/><circle cx="8.5" cy="20.6" r="1.4"/><circle cx="15.5" cy="20.6" r="1.4"/>',
} as const;

const PATHS: Record<string, string> = { ...HUGEICONS, ...OWN };

export type IconName = keyof typeof HUGEICONS | keyof typeof OWN | (string & {});

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
  label?: string;
}

const { name, size = 20, class: className = '', strokeWidth = 1.75, label } = Astro.props;

// пустой значок на странице заметить трудно, поэтому сборка сразу останавливается
if (!(name in PATHS)) throw new Error(`Нет иконки «${name}»: добавьте её в src/components/icons/hugeicons.ts`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={[`icon icon-${name}`, className]}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  set:html={PATHS[name]}
/>
