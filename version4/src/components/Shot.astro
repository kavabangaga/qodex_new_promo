    display: grid;
  }

  .toast {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-self: center;
    width: auto;
    margin-top: -18px;
    padding: 12px 16px;
    border-radius: 16px;
    font-size: 14px;
    font-weight: 560;
  }

  /* ── Камеры (рисунки, не фото) ─────────────────────────── */
  .cams {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .cam,
  .frame {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: #dbe5eb;
    isolation: isolate;
  }

  .cam {
    aspect-ratio: 16 / 10;
  }

  .cam svg,
  .frame svg,
  .weigh__photo svg,
  .act__ph svg {
    width: 100%;
    height: 100%;
  }

  .cam svg.is-flip {
    transform: scaleX(-1);
  }

  /* лёгкая «камера»: виньетка */
  .cam::after,
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 45%, transparent 55%, rgb(29 29 31 / 0.22));
    pointer-events: none;
  }

  .cam__tag,
  .cam__time,
  .frame__tag {
    position: absolute;
    z-index: 1;
    padding: 2px 6px;
    border-radius: 5px;
    background: rgb(29 29 31 / 0.62);
    color: #fff;
    font-size: 10.5px;
    font-weight: 500;
    line-height: 1.4;
    white-space: nowrap;
  }

  .cam__tag {
    left: 6px;
    top: 6px;
  }

  .cam__time {
    right: 6px;
    bottom: 6px;
    font-variant-numeric: tabular-nums;
  }

  .frame__tag {
    z-index: 3;
    left: 8px;
    top: 8px;
    font-size: 11px;
  }

  /* вспышка кадра */
  .cam__flash {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }

  .frame {
    aspect-ratio: 320 / 190;
  }

  /* рамки распознавания вокруг контейнеров */
  .det {
    position: absolute;
    z-index: 1;
    top: 43%;
    left: calc(17.5% + var(--k) * 23.1%);
    width: 18.8%;
    height: 36%;
    border: 2px solid #6bb1ff;
    border-radius: 8px;
    background: rgb(107 177 255 / 0.12);
  }

  .det i {
    position: absolute;
    top: -2px;
    left: -2px;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 6px 0 6px 0;
    background: #6bb1ff;
    color: #fff;
    font-size: 11px;
    font-style: normal;
    font-weight: 600;
  }

  .frame__count {
    position: absolute;
    z-index: 1;
    left: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px 7px 10px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 6px 18px -8px rgb(29 29 31 / 0.45);
    font-size: 14px;
    font-weight: 600;
  }

  /* числа, которые сменяют друг друга в одной клетке */
  .num {
    display: inline-grid;
  }

  .num > b {
    grid-area: 1 / 1;
    font-weight: inherit;
    font-variant-numeric: tabular-nums;
  }

  .num > b:not(:last-child) {
    opacity: 0;
  }

  .frame + .u-list {
    margin-top: 12px;
  }

  /* ── Маршрут ───────────────────────────────────────────── */
  .map {
    position: relative;
    aspect-ratio: 360 / 120;
    overflow: hidden;
    border-radius: 14px;
    background: #edf3f5;
  }

  .map svg {
    width: 100%;
    height: 100%;
  }

  .map__wipe {
    position: absolute;
    inset: 0;
    background: #edf3f5;
    transform-origin: right center;
    transform: scaleX(0);
  }

  .stop {
    position: absolute;
    z-index: 1;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border: 3px solid #fff;
    border-radius: 50%;
    box-shadow: 0 2px 6px rgb(29 29 31 / 0.25);
  }

  .stop--ok {
    background: var(--u-ok-bg);
  }

  .stop--warn {
    background: var(--u-warn-bg);
  }

  .stop--bad {
    background: var(--u-bad-bg);
    box-shadow:
      0 0 0 4px rgb(229 72 77 / 0.22),
      0 2px 6px rgb(29 29 31 / 0.25);
  }

  .map__truck {
    position: absolute;
    z-index: 1;
    left: 94.4%;
    top: 16.7%;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border-radius: 50%;
    background: var(--u-blue);
    color: #fff;
    box-shadow: 0 0 0 4px rgb(0 107 255 / 0.2);
  }

  .map + .u-list {
    margin-top: 12px;
  }

  /* ── Весовая ───────────────────────────────────────────── */
  .frame--entry {
    container-type: inline-size;
    background: #e3eaf0;
  }

  /* российский номер на бампере */
  .plate {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 66.5%;
    display: inline-flex;
    align-items: stretch;
    height: 9.5%;
    min-height: 16px;
    transform: translateX(-50%);
    border: 1.5px solid #1b2229;
    border-radius: 4px;
    background: #fff;
    color: #11171c;
    font-size: clamp(9px, 3.6cqw, 14px);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .plate__num {
    display: grid;
    place-items: center;
    padding: 0 6px;
    letter-spacing: 0.02em;
  }

  .plate__reg {
    display: grid;
    place-items: center;
    padding: 0 4px;
    border-left: 1.5px solid #1b2229;
    font-size: 0.8em;
  }

  .plate__reg small {
    display: none;
  }

  .plate__box {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 63.5%;
    width: 34%;
    height: 15.5%;
    margin-left: -17%;
    border: 2px solid var(--u-blue);
    border-radius: 7px;
    box-shadow: 0 0 0 4px rgb(0 107 255 / 0.16);
  }

  .frame__scan {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, transparent 0 44%, rgb(0 107 255 / 0.2) 49%, rgb(0 107 255 / 0.5) 50%, transparent 51% 100%);
    opacity: 0;
    pointer-events: none;
  }

  /* шлагбаум весовой: поднимается после распознавания номера */
  .gate {
    position: absolute;
    z-index: 2;
    left: 7%;
    top: 47%;
    width: 50%;
    height: 4.6%;
    transform-origin: 0 50%;
    transform: rotate(-64deg);
  }

  .gate i {
    position: absolute;
    inset: 0;
    border-radius: 3px;
    background: repeating-linear-gradient(90deg, #e5484d 0 12px, #fff 12px 24px);
    box-shadow: 0 0 0 1px rgb(29 29 31 / 0.25);
  }

  .gate__post {
    position: absolute;
    z-index: 2;
    left: 5%;
    top: 44%;
    width: 4%;
    height: 38%;
    border-radius: 3px;
    background: #4b5864;
  }

  .u-result {
    margin-top: 12px;
    gap: 12px;
  }

  .u-result b {
    font-size: 17px;
    letter-spacing: 0.01em;
  }

  .weigh {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: 10px;
  }

  .weigh__val {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 6px;
    padding: 14px;
    border-radius: 16px;
    background: var(--u-row);
  }

  .weigh__num {
    display: inline-grid;
    font-size: clamp(30px, 3vw, 40px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .weigh__num > b {
    grid-area: 1 / 1;
    font-weight: inherit;
    font-variant-numeric: tabular-nums;
  }

  .weigh__num > b:not(:last-child) {
    opacity: 0;
  }

  .weigh__line {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .weigh__kg {
    font-size: 15px;
    font-weight: 560;
    color: var(--muted);
  }

  .weigh__photo {
    position: relative;
    min-height: 120px;
    overflow: hidden;
    border-radius: 16px;
    background: #9aa6b0;
  }

  .weigh__photo svg {
    position: absolute;
    inset: 0;
  }

  .weigh__ph {
    position: absolute;
    z-index: 1;
    left: 8px;
    bottom: 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgb(29 29 31 / 0.62);
    color: #fff;
    font-size: 11px;
    font-weight: 500;
  }

  /* Кабинет регоператора */
  .tabs {
    display: flex;
    gap: 4px;
    margin: -4px 0 12px;
    padding: 4px;
    border-radius: 12px;
    background: var(--u-row);
    font-size: 12.5px;
    font-weight: 560;
    color: var(--muted);
  }

  .tabs span {
    flex: 1;
    padding: 6px 4px;
    border-radius: 9px;
    text-align: center;
  }

  .tabs .is-on {
    background: #fff;
    color: var(--ink);
    box-shadow: 0 1px 3px rgb(29 29 31 / 0.12);
  }

  .act {
    padding: 8px 10px 8px 8px;
  }

  .act__ph {
    width: 46px;
    height: 34px;
    flex: none;
    overflow: hidden;
    border-radius: 8px;
  }

  .act__state {
    display: grid;
    place-items: center end;
  }

  .act__state > * {
    grid-area: 1 / 1;
  }

  .act__up {
    display: grid;
    color: var(--u-blue);
  }

  .act__lock {
    display: grid;
    place-items: center;
    width: 26px;
    color: var(--subtle);
  }

  /* Уведомление поверх списка */
  .stack--alert {
    padding-top: 46px;
  }

  /* список под уведомлением приглушён белой вуалью (карточка остаётся непрозрачной) */
  .card--dim {
    transform: scale(0.96);
    transform-origin: 50% 100%;
  }

  .card--dim::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgb(255 255 255 / 0.5);
  }

  .alert {
    position: absolute;
    top: 0;
    left: 4%;
    right: 4%;
    display: flex;
    align-items: center;
    gap: 12px;
    width: auto;
    padding: 14px;
    border-radius: 18px;
    box-shadow:
      0 0 0 1px rgb(242 157 56 / 0.35),
      0 18px 40px -16px rgb(29 29 31 / 0.45);
  }

  .alert__ico {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 12px;
    background: var(--u-warn-soft);
    color: #c66d00;
  }

  .alert__ico > span {
    display: grid;
    transform-origin: 50% 10%;
  }

  .alert b {
    font-size: 14.5px;
  }

  .alert__link {
    flex: none;
    font-size: 13px;
    font-weight: 560;
    color: var(--u-blue);
  }

  /* ── Кодекс ТКО: поля, импорт, отправка ───────────────── */
  .field {
    display: grid;
    gap: 5px;
    margin-top: 10px;
  }

  .field:first-of-type {
    margin-top: 0;
  }

  .field__in {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 12px;
    overflow: hidden;
    border: 1.5px solid #dfe3e8;
    border-radius: 12px;
    background: #fff;
    font-size: 14.5px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .field__text {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* «набор текста»: белая шторка отъезжает вправо */
  .field__type {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 10px;
    right: 2px;
    background: #fff;
    transform-origin: right center;
    transform: scaleX(0);
  }

  .field__eye {
    position: relative;
    display: grid;
    margin-left: auto;
    color: var(--subtle);
  }

  .u-big-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 16px;
    padding: 14px;
    border-radius: 16px;
    background: var(--u-ok-soft);
  }

  .u-big-row > span:last-child {
    display: grid;
  }

  .u-big {
    font-size: clamp(28px, 2.6vw, 36px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  .send {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .send > span:last-child {
    display: grid;
  }

  .send__ico {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    flex: none;
    overflow: hidden;
    border-radius: 16px;
    background: var(--u-blue-soft);
    color: var(--u-blue);
  }

  .send__ico > span {
    display: grid;
  }

  /* ── Реестр для блока «Пилот» ──────────────────────────── */
  .shot--registry {
    max-width: 560px;
  }

  .reg {
    container-type: inline-size;
    padding: clamp(16px, 2vw, 24px);
    border-radius: 20px;
  }

  .reg__row {
    display: grid;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--u-row);
  }

  .reg__row.is-sel {
    background: var(--u-sel);
    box-shadow: inset 0 0 0 1.5px rgb(0 107 255 / 0.28);
  }

  .reg__top {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .reg .u-diff__main b {
    white-space: normal;
  }

  .reg__sum {
    flex: none;
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .reg__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }

  .reg__src,
  .reg__date,
  .reg__act {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .reg__date {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .reg__act {
    margin-left: auto;
  }

  .reg__yes,
  .reg__no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    height: 30px;
    border-radius: 9px;
    font-size: 12.5px;
    font-weight: 560;
  }

  .reg__yes {
    padding: 0 10px;
    background: var(--ink);
    color: #fff;
  }

  .reg__no {
    width: 30px;
    background: #fff;
    color: var(--muted);
    box-shadow: inset 0 0 0 1.5px #dfe3e8;
  }

  /* метки 1–3 — пояснения к реестру (легенда под картинкой); стоят как сноски, текст не закрывают */
  .mk {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    margin: -10px 0 0 -3px;
    display: grid;
    place-items: center;
    width: 21px;
    height: 21px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: 11px;
    font-style: normal;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 3px 8px -2px rgb(29 29 31 / 0.45);
  }

  /* в узкой карточке «Подтвердить» — только галочкой, чтобы строка не переносилась */
  @container (max-width: 400px) {
    .reg__yes {
      width: 30px;
      padding: 0;
    }

    .reg__yes-t {
      display: none;
    }
  }

  /* у кнопок метка стоит на углу «✕», чтобы кнопки в строках были на одной линии */
  .reg__act .mk {
    position: absolute;
    top: -12px;
    right: -10px;
    margin: 0;
  }

  .reg__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 14px;
    font-size: 12.5px;
    font-weight: 560;
    color: var(--muted);
  }

  /* ── Анимации: только у активной панели (или у одиночной картинки) ──
     Без анимации видно итоговое состояние: «ожидание» и промежуточные числа скрыты. */
  .a-gone,
  .a-blip {
    opacity: 0;
  }

  .pane.is-active .a-in,
  .shot--static .a-in {
    animation: u-in 0.6s var(--ease-out) both;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-pop,
  .shot--static .a-pop {
    animation: u-pop 0.45s cubic-bezier(0.2, 1.5, 0.4, 1) both;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-fade {
    animation: u-fade 0.6s ease both;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-drop {
    animation: u-drop 0.65s var(--ease-out) both;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-fill {
    animation: u-fill var(--dur, 1.2s) var(--ease-in-out) both;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-gone {
    animation: u-gone 0.25s ease both;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-blip {
    animation: u-blip var(--dur, 0.4s) linear forwards;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-press {
    animation: u-press 0.4s ease both;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-flash {
    animation: u-flash 0.5s ease-out forwards;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-wipe {
    animation: u-wipe 1.3s var(--ease-in-out) both;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-type {
    animation: u-wipe var(--dur, 0.8s) steps(12, end) both;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-gate {
    animation: u-gate 0.9s var(--ease-in-out) both;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-scan {
    animation: u-scan 1.1s ease-in-out 2 backwards;
    animation-delay: 0.1s;
  }

  .pane.is-active .a-ring {
    animation: u-ring 1s ease-in-out both;
    animation-delay: var(--t, 0s);
  }

  .pane.is-active .a-blink {
    animation: u-blink 1.4s ease-in-out infinite;
  }

  .pane.is-active .a-spin {
    animation: u-spin 0.9s linear infinite;
  }

  .pane.is-active .a-rise {
    animation: u-rise 1.4s ease-in-out infinite;
  }

  @keyframes u-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes u-pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes u-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes u-drop {
    from {
      opacity: 0;
      transform: translateY(-22px) scale(0.97);
    }
  }

  @keyframes u-fill {
    from {
      transform: scaleX(0);
    }
  }

  /* «ожидание» видно до своей задержки, потом исчезает */
  @keyframes u-gone {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  /* промежуточное значение видно только во время своей анимации */
  @keyframes u-blip {
    0%,
    99.9% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes u-press {
    50% {
      transform: scale(0.95);
    }
  }

  @keyframes u-flash {
    from {
      opacity: 0.85;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes u-wipe {
    from {
      transform: scaleX(1);
    }
    to {
      transform: scaleX(0);
    }
  }

  @keyframes u-gate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-64deg);
    }
  }

  @keyframes u-scan {
    from {
      opacity: 1;
      transform: translateY(-50%);
    }
    to {
      opacity: 1;
      transform: translateY(40%);
    }
  }

  @keyframes u-ring {
    0%,
    100% {
      transform: rotate(0deg);
    }
    15% {
      transform: rotate(-18deg);
    }
    30% {
      transform: rotate(15deg);
    }
    45% {
      transform: rotate(-10deg);
    }
    60% {
      transform: rotate(6deg);
    }
    75% {
      transform: rotate(-2deg);
    }
  }

  @keyframes u-blink {
    50% {
      opacity: 0.25;
    }
  }

  @keyframes u-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes u-rise {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    35%,
    65% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  /* за экраном анимации стоят: data-idle снимает скрипт ниже, когда картинка на экране */
  .shot[data-idle] * {
    animation-play-state: paused !important;
  }

  @media (scripting: none) {
    .shot[data-idle] * {
      animation-play-state: running !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot * {
      animation: none !important;
    }
  }

  /* ── Планшет и телефон ────────────────────────────────── */
  /* градиентная карточка ниже — карточка интерфейса опускается под плашку «демо-данные» */
  @media (max-width: 900px) {
    .shot:not(.shot--static) {
      margin-top: 30px;
    }
  }

  @media (max-width: 520px) {
    .shot {
      font-size: 13px;
    }

    .u-head {
      margin-bottom: 12px;
    }

    .u-row {
      padding: 9px 10px;
      font-size: 13px;
    }

    .u-diff__meta small {
      font-size: 11px;
    }

    .act__time,
    .alert__link {
      display: none;
    }

    .stack--alert {
      padding-top: 64px;
    }

    .frame__count {
      left: 6px;
      bottom: 6px;
      gap: 5px;
      padding: 4px 9px 4px 7px;
      font-size: 12px;
    }

    .frame__count .u-dot {
      width: 8px;
      height: 8px;
    }

    .weigh {
      grid-template-columns: 1fr;
    }

    .weigh__photo {
      min-height: 92px;
    }

    .cam__tag,
    .cam__time {
      font-size: 9.5px;
    }

    .reg__row {
      padding: 10px 12px;
    }
  }
</style>

<script>
  import { reducedMotion } from '../scripts/motion';

  // Анимации иллюстраций идут, только пока картинка на экране (в разметке они стоят: data-idle).
  // При «уменьшить движение» анимации выключены в CSS — следить не нужно.
  const shots = document.querySelectorAll<HTMLElement>('[data-shot]');
  if (!reducedMotion()) {
    if (!('IntersectionObserver' in window)) {
      shots.forEach((el) => delete el.dataset.idle);
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const el = entry.target as HTMLElement;
            if (entry.isIntersecting) delete el.dataset.idle;
            else el.dataset.idle = '';
          }
        },
        { threshold: 0.2 },
      );
      shots.forEach((el) => io.observe(el));
    }
  }
</script>
