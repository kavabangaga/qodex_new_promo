---
// Иллюстрации интерфейсов продуктов — вместо скриншотов и серых заглушек (v4, как у Calendly):
// белые карточки .ui с короткими демо-данными, кладутся внутрь <GradientVisual>.
//   id продукта  → панели [data-pane] для пунктов «Как работает» (по одной на шаг, в том же порядке);
//   id="registry" → реестр расхождений РО-БОТа для блока «Пилот» с метками 1–3.
// Анимации — только transform и opacity: идут у активной панели и только пока картинка на экране,
// при «уменьшить движение» выключены (видно итоговое состояние). Картинку описывает текст рядом,
// поэтому для скринридера она скрыта (aria-hidden ставит GradientVisual или блок «Пилот»).
import Icon from './Icon.astro';
import type { ProductId } from '../config/site';

interface Props {
  id: ProductId | 'registry';
  class?: string;
}

const { id, class: className } = Astro.props;
const NB = ' ';

// ── Демо-данные (согласованы с первым экраном: Кировский район, А983ВВ 102, Акты_сентябрь.xlsx) ──
const sources = [
  { name: 'ГИС ЖКХ', icon: 'house' },
  { name: 'Росреестр', icon: 'landmark' },
  { name: 'ФИАС', icon: 'map-pin' },
  { name: 'ФНС', icon: 'receipt' },
] as const;

const diffs = [
  {
    obj: 'ул. Ленина, 12, кв. 4',
    what: 'в базе 1 — живут 4',
    src: 'ГИС ЖКХ',
    date: '30.09.2026',
    sum: `4${NB}950${NB}₽/год`,
  },
  {
    obj: 'ООО «Вектор», пр. Мира, 7',
    what: 'нет договора на вывоз',
    src: 'ФНС',
    date: '30.09.2026',
    sum: `38${NB}400${NB}₽/год`,
  },
  {
    obj: 'ул. Садовая, 21, кв. 9',
    what: `площадь 54 → 61${NB}м²`,
    src: 'Росреестр',
    date: '29.09.2026',
    sum: `1${NB}120${NB}₽/год`,
  },
];

// Реестр для «Пилота»: первой — строка юрлица, на ней метки 1–3
const registry = [diffs[1], diffs[0], diffs[2]];

// Мусорный контейнер для «кадров с камер» (рисунок, не фото): x, y — левый верх, w — ширина
function bin(x: number, y: number, w: number, color: string, full = false): string {
  const s = w / 40;
  const bags = full
    ? '<ellipse cx="13" cy="7" rx="9" ry="6" fill="#4d5a66"/><ellipse cx="26" cy="6" rx="10" ry="7" fill="#6b7884"/><ellipse cx="20" cy="4" rx="6" ry="4" fill="#3e4954"/>'
    : '';
  const lid = full
    ? '<rect x="2" y="2" width="36" height="5" rx="2" fill="#2b3a33" transform="rotate(-24 2 7)"/>'
    : '<rect x="1" y="5" width="38" height="6" rx="2" fill="#2b3a33" fill-opacity=".55"/>';
  return `<g transform="translate(${x} ${y}) scale(${s})">${bags}<path d="M3.5 10h33l-3 28a3 3 0 0 1-3 2.7H9.5a3 3 0 0 1-3-2.7Z" fill="${color}"/>${lid}<path d="M13 16v17M20 16v17M27 16v17" stroke="#000" stroke-opacity=".14" stroke-width="2" stroke-linecap="round"/><circle cx="11" cy="43" r="3.2" fill="#26313a"/><circle cx="29" cy="43" r="3.2" fill="#26313a"/></g>`;
}

// Площадка ТКО «до» (контейнеры полные) и «после» погрузки — для сетки из четырёх камер
const site = (full: boolean) =>
  `<rect width="160" height="100" fill="#dbe5eb"/><rect y="30" width="160" height="26" fill="#c8d3da"/>` +
  `<path d="M0 36h160M8 30v26M40 30v26M72 30v26M104 30v26M136 30v26" stroke="#b5c1c9" stroke-width="1.5"/>` +
  `<rect y="56" width="160" height="44" fill="#b3bfc7"/><rect x="16" y="62" width="128" height="24" rx="3" fill="#c5cdd3"/>` +
  bin(28, 38, 30, '#3f8a6c', full) +
  bin(65, 38, 30, '#3f8a6c', full) +
  bin(102, 38, 30, '#4a76ad', full);

// Крупный кадр: три контейнера, которые ИИ обводит рамками
const yard =
  `<rect width="320" height="190" fill="#dde7ed"/><rect y="52" width="320" height="44" fill="#ccd6dd"/>` +
  `<path d="M0 62h320M20 52v44M80 52v44M140 52v44M200 52v44M260 52v44" stroke="#b9c4cc" stroke-width="2"/>` +
  `<rect y="96" width="320" height="94" fill="#b6c2ca"/><rect x="40" y="132" width="240" height="30" rx="4" fill="#c6ced4"/>` +
  bin(62, 86, 48, '#3f8a6c', true) +
  bin(136, 86, 48, '#3f8a6c', true) +
  bin(210, 86, 48, '#4a76ad', true) +
  `<rect x="292" y="20" width="40" height="170" fill="#7d8a95"/><rect x="298" y="36" width="22" height="70" rx="3" fill="#94a2ad"/>`;

// Мусоровоз анфас на въезде весовой (номер — отдельной табличкой поверх рисунка)
const truck =
  `<rect width="320" height="190" fill="#e3eaf0"/><rect y="150" width="320" height="40" fill="#c3ccd4"/>` +
  `<rect x="20" y="160" width="280" height="12" rx="3" fill="#a6b1bb"/>` +
  `<rect x="96" y="26" width="128" height="118" rx="16" fill="#f4f6f9" stroke="#cdd5de" stroke-width="2"/>` +
  `<rect x="106" y="38" width="108" height="48" rx="9" fill="#9fb3c6"/><path d="M118 82 150 40h14l-32 42Z" fill="#fff" fill-opacity=".28"/>` +
  `<rect x="84" y="48" width="10" height="22" rx="3" fill="#6f7c88"/><rect x="226" y="48" width="10" height="22" rx="3" fill="#6f7c88"/>` +
  `<rect x="126" y="96" width="68" height="22" rx="4" fill="#57636e"/><path d="M134 101h52M134 107h52M134 113h52" stroke="#76838e" stroke-width="2"/>` +
  `<rect x="104" y="100" width="18" height="12" rx="4" fill="#fff3c4"/><rect x="198" y="100" width="18" height="12" rx="4" fill="#fff3c4"/>` +
  `<rect x="90" y="124" width="140" height="22" rx="6" fill="#45505b"/>` +
  `<rect x="100" y="146" width="22" height="26" rx="5" fill="#222a31"/><rect x="198" y="146" width="22" height="26" rx="5" fill="#222a31"/>`;

// Кузов сверху — «фото кузова» на весовой и в актах
const body =
  `<rect width="120" height="80" fill="#9aa6b0"/><rect x="14" y="10" width="92" height="60" rx="6" fill="#55708a"/>` +
  `<rect x="20" y="16" width="80" height="48" rx="4" fill="#6c7f74"/>` +
  `<ellipse cx="40" cy="34" rx="16" ry="10" fill="#8a8f6e"/><ellipse cx="70" cy="44" rx="18" ry="11" fill="#a29373"/>` +
  `<ellipse cx="62" cy="28" rx="11" ry="7" fill="#7f8c96"/><ellipse cx="86" cy="30" rx="9" ry="7" fill="#c2b28f"/>` +
  `<ellipse cx="34" cy="52" rx="10" ry="6" fill="#5f6b5a"/>`;

const acts = [
  { n: '4127', plate: 'А983ВВ 102', kg: `4${NB}170`, time: '09:42' },
  { n: '4126', plate: 'Т451ОК 102', kg: `5${NB}020`, time: '09:31' },
  { n: '4125', plate: 'В207НА 102', kg: `3${NB}860`, time: '09:18' },
];
---

{
  id !== 'registry' && (
    <div class:list={['shot', `shot--${id}`, className]} data-shot data-idle data-panes>
      {/* ── РО-БОТ ─────────────────────────────────────────────── */}
      {id === 'robot' && (
        <>
          {/* 1. Выгрузка базы в Excel */}
          <div class="pane is-active" data-pane>
            <div class="ui card">
              <div class="u-head">
                <span class="u-title">Загрузка базы</span>
                <span class="u-pill u-pill--mute">Excel</span>
              </div>
              <div class="u-file">
                <span class="u-xls">
                  <Icon name="file-spreadsheet" size={20} strokeWidth={1.8} />
                </span>
                <span class="u-file__name">
                  <b>Начисления_Кировский.xlsx</b>
                  <small>18{NB}240 строк · 3,1 МБ</small>
                </span>
                <span class="u-okmark a-pop" style="--t:1.5s">
                  <Icon name="check" size={13} strokeWidth={3} />
                </span>
              </div>
              <span class="u-bar">
                <i class="a-fill" style="--t:0.2s; --dur:1.3s" />
              </span>
              <p class="u-cap a-in" style="--t:1.6s">Колонки распознаны</p>
              <div class="u-chips">
                {['Лицевой счёт', 'Адрес', 'Жильцов', 'Площадь'].map((c, k) => (
                  <span class="u-chip a-pop" style={`--t:${1.75 + k * 0.14}s`}>
                    <Icon name="check" size={12} strokeWidth={3} />
                    {c}
                  </span>
                ))}
              </div>
            </div>
          </div>

          {/* 2. Сверка с ГИС ЖКХ, Росреестром, ФИАС и ФНС */}
          <div class="pane" data-pane>
            <div class="ui card">
              <div class="u-head">
                <span class="u-title">Сверка базы</span>
                <span class="u-sub">Кировский район</span>
              </div>
              <ul class="u-list">
                {sources.map((s, k) => (
                  <li class:list={['u-row', 'u-src', { 'is-sel': k === 0 }]}>
                    <span class="u-av">
                      <Icon name={s.icon} size={17} strokeWidth={1.9} />
                    </span>
                    <span class="u-src__name">{s.name}</span>
                    <span class="u-state">
                      <span class="u-spin a-gone" style={`--t:${0.55 + k * 0.45}s`}>
                        <span class="a-spin">
                          <Icon name="loader-circle" size={18} strokeWidth={2.2} />
                        </span>
                      </span>
                      <span class="u-okmark a-pop" style={`--t:${0.6 + k * 0.45}s`}>
                        <Icon name="check" size={13} strokeWidth={3} />
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
              <span class="u-bar u-bar--thin">
                <i class="a-fill" style="--t:0.2s; --dur:2.2s" />
              </span>
            </div>
          </div>

          {/* 3. Список расхождений с источником и датой */}
          <div class="pane" data-pane>
            <div class="ui card">
              <div class="u-head">
                <span class="u-title">Расхождения</span>
                <span class="u-sub">Кировский район</span>
              </div>
              <ul class="u-list">
                {diffs.map((d, k) => (
                  <li class:list={['u-row', 'u-diff', 'a-in', { 'is-sel': k === 0 }]} style={`--t:${0.2 + k * 0.22}s`}>
                    <span class="u-diff__main">
                      <b>{d.obj}</b>
                      <small>{d.what}</small>
                    </span>
                    <span class="u-diff__meta">
                      <span class="u-pill u-pill--info">{d.src}</span>
                      <small>{d.date}</small>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          {/* 4. Сотрудник подтверждает — данные уходят в биллинг одной кнопкой */}
          <div class="pane" data-pane>
            <div class="stack">
              <div class="ui card">
                <div class="u-head">
                  <span class="u-title">Решение</span>
                  <span class="u-who">
                    <span class="u-face">ОК</span>
                    специалист
                  </span>
                </div>
                <ul class="u-list">
                  {diffs.map((d, k) => (
                    <li class="u-row u-pick">
                      <span class:list={['u-box', { 'is-off': k === 2 }]}>
                        {k < 2 && (
                          <span class="u-box__tick a-pop" style={`--t:${0.45 + k * 0.4}s`}>
                            <Icon name="check" size={13} strokeWidth={3} />
                          </span>
                        )}
                      </span>
                      <span class="u-diff__main">
                        <b>{d.obj}</b>
                        <small>{d.what}</small>
                      </span>
                    </li>
                  ))}
                </ul>
                <span class="u-btn u-btn--block a-press" style="--t:1.5s">
                  Отправить в биллинг
                  <Icon name="arrow-right" size={16} strokeWidth={2.2} />
                </span>
              </div>
              <div class="ui ui--plain toast a-in" style="--t:1.9s">
                <span class="u-okmark">
                  <Icon name="check" size={13} strokeWidth={3} />
                </span>
                Отправлено в биллинг: 2
              </div>
            </div>
          </div>
        </>
      )}

      {/* ── QODEX Tracker ─────────────────────────────────────── */}
      {id === 'tracker' && (
        <>
          {/* 1. Четыре камеры снимают площадку до и после погрузки */}
          <div class="pane is-active" data-pane>
            <div class="ui card">
              <div class="u-head">
                <span class="u-title">Мусоровоз 07</span>
                <span class="u-pill u-pill--rec">
                  <i class="a-blink" />
                  Запись
                </span>
              </div>
              <div class="cams">
                {[1, 2, 3, 4].map((n, k) => (
                  <div class="cam a-fade" style={`--t:${0.15 + k * 0.18}s`}>
                    <svg
                      viewBox="0 0 160 100"
                      preserveAspectRatio="xMidYMid slice"
                      class:list={{ 'is-flip': k > 1 }}
                      set:html={site(k % 2 === 0)}
                    />
                    <span class="cam__tag">
                      Кам. {n} · {k % 2 === 0 ? 'до' : 'после'}
                    </span>
                    <span class="cam__time">08:4{2 + (k % 2)}</span>
                    <span class="cam__flash a-flash" style={`--t:${0.9 + k * 0.25}s`} />
                  </div>
                ))}
              </div>
              <div class="u-foot">
                <span>
                  <Icon name="map-pin" size={15} strokeWidth={2} />
                  ул. Садовая, 21
                </span>
                <span class="u-pill u-pill--mute">4 камеры</span>
              </div>
            </div>
          </div>

          {/* 2. ИИ считает контейнеры, спорные — диспетчеру */}
          <div class="pane" data-pane>
            <div class="ui card">
              <div class="frame">
                <svg viewBox="0 0 320 190" preserveAspectRatio="xMidYMid slice" set:html={yard} />
                {[0, 1, 2].map((k) => (
                  <span class="det a-pop" style={`--k:${k}; --t:${0.5 + k * 0.45}s`}>
                    <i>{k + 1}</i>
                  </span>
                ))}
                <span class="frame__tag">Кам. 2 · 08:43</span>
                <span class="frame__count">
                  <span class="u-dot u-dot--ok" />
                  Погружено:
                  <span class="num">
                    <b class="a-blip" style="--t:0s; --dur:0.5s">0</b>
                    <b class="a-blip" style="--t:0.5s; --dur:0.45s">1</b>
                    <b class="a-blip" style="--t:0.95s; --dur:0.45s">2</b>
                    <b class="a-pop" style="--t:1.4s">3</b>
                  </span>
                </span>
              </div>
              <ul class="u-list u-list--tight">
                <li class="u-row a-in" style="--t:1.7s">
                  <span class="u-row__main">
                    <b>Площадка 14</b>
                    <small>посчитал ИИ</small>
                  </span>
                  <span class="u-pill u-pill--ok">
                    <Icon name="check" size={12} strokeWidth={3} />
                    3 из 3
                  </span>
                </li>
                <li class="u-row a-in" style="--t:1.9s">
                  <span class="u-row__main">
                    <b>Площадка 15</b>
                    <small>спорный кадр</small>
                  </span>
                  <span class="u-pill u-pill--warn">
                    <Icon name="eye" size={12} strokeWidth={2.4} />
                    диспетчеру
                  </span>
                </li>
              </ul>
            </div>
          </div>

          {/* 3. Сверка погрузки с планом маршрута: норма, недовывоз или левак */}
          <div class="pane" data-pane>
            <div class="ui card">
              <div class="u-head">
                <span class="u-title">Маршрут 14</span>
                <span class="u-pill u-pill--mute">план и факт</span>
              </div>
              <div class="map">
                <svg viewBox="0 0 360 120" preserveAspectRatio="none" aria-hidden="true">
                  <rect x="214" y="44" width="62" height="30" rx="6" fill="#d7ecdf" />
                  <rect x="86" y="44" width="80" height="30" rx="6" fill="#e3e9f3" />
                  <path d="M0 30H360M0 88H360M70 0V120M190 0V120M300 0V120" stroke="#fff" stroke-width="8" fill="none" />
                  <path
                    d="M18 100 70 88V30H190V88H300V30l40-10"
                    fill="none"
                    stroke="#006bff"
                    stroke-width="3.5"
                    stroke-linejoin="round"
                    stroke-linecap="round"
                  />
                </svg>
                <span class="map__wipe a-wipe" style="--t:0.1s" />
                {[
                  { x: 19.4, y: 50, c: 'ok' },
                  { x: 36.1, y: 25, c: 'ok' },
                  { x: 52.8, y: 58, c: 'warn' },
                  { x: 69.4, y: 73, c: 'ok' },
                  { x: 91.5, y: 55, c: 'bad' },
                ].map((s, k) => (
                  <span
                    class:list={['stop', `stop--${s.c}`, 'a-pop']}
                    style={`left:${s.x}%; top:${s.y}%; --t:${0.5 + k * 0.22}s`}
                  />
                ))}
                <span class="map__truck a-pop" style="--t:1.6s">
                  <Icon name="truck" size={13} strokeWidth={2.2} />
                </span>
              </div>
              <ul class="u-list u-list--tight">
                {[
                  { a: 'ул. Садовая, 21', s: 'Норма', c: 'ok' },
                  { a: 'ул. Лесная, 3', s: 'Недовывоз', c: 'warn' },
                  { a: 'СНТ «Рассвет»', s: 'Левак', c: 'bad' },
                ].map((r, k) => (
                  <li class="u-row a-in" style={`--t:${1.4 + k * 0.18}s`}>
                    <span class:list={['u-dot', `u-dot--${r.c}`]} />
                    <b class="u-row__grow">{r.a}</b>
                    <span class:list={['u-pill', `u-pill--${r.c}`]}>{r.s}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </>
      )}

      {/* ── QODEX TONN ────────────────────────────────────────── */}
      {id === 'tonn' && (
        <>
          {/* 1. Номер машины распознаётся на въезде */}
          <div class="pane is-active" data-pane>
            <div class="ui card">
              <div class="u-head">
                <span class="u-title">Весовая № 1</span>
                <span class="u-pill u-pill--ok">
                  <i class="u-live a-blink" />
                  онлайн
                </span>
              </div>
              <div class="frame frame--entry">
                <svg viewBox="0 0 320 190" preserveAspectRatio="xMidYMid slice" set:html={truck} />
                <span class="gate a-gate" style="--t:1.5s">
                  <i />
                </span>
                <span class="gate__post" />
                <span class="plate">
                  <span class="plate__num">А 983 ВВ</span>
                  <span class="plate__reg">
                    102
                    <small>RUS</small>
                  </span>
                </span>
                <span class="plate__box a-pop" style="--t:0.9s" />
                <span class="frame__scan a-scan" />
                <span class="frame__tag">Въезд · 09:41</span>
              </div>
              <div class="u-row u-result a-in" style="--t:1.1s">
                <span class="u-okmark u-okmark--lg">
                  <Icon name="check" size={15} strokeWidth={3} />
                </span>
                <span class="u-row__main">
                  <small>Номер распознан</small>
                  <b>А983ВВ 102</b>
                </span>
              </div>
            </div>
          </div>

          {/* 2. Вес и фото кузова — без ручного ввода */}
          <div class="pane" data-pane>
            <div class="ui card">
              <div class="u-head">
                <span class="u-title">Взвешивание</span>
                <span class="u-sub">А983ВВ 102</span>
              </div>
              <div class="weigh">
                <div class="weigh__val">
                  <small>Брутто</small>
                  <span class="weigh__line">
                    <span class="weigh__num">
                      <b class="a-blip" style="--t:0.1s; --dur:0.35s">12{NB}310</b>
                      <b class="a-blip" style="--t:0.45s; --dur:0.35s">12{NB}560</b>
                      <b class="a-blip" style="--t:0.8s; --dur:0.35s">12{NB}440</b>
                      <b class="a-pop" style="--t:1.15s">12{NB}480</b>
                    </span>
                    <span class="weigh__kg">кг</span>
                  </span>
                  <span class="u-pill u-pill--ok a-pop" style="--t:1.3s">
                    <Icon name="check" size={12} strokeWidth={3} />
                    стабильно
                  </span>
                </div>
                <div class="weigh__photo a-in" style="--t:0.6s">
                  <svg viewBox="0 0 120 80" preserveAspectRatio="xMidYMid slice" set:html={body} />
                  <span class="cam__flash a-flash" style="--t:0.9s" />
                  <span class="weigh__ph">
                    <Icon name="camera" size={12} strokeWidth={2.2} />
                    Фото кузова
                  </span>
                </div>
              </div>
              <div class="u-two">
                <span class="u-row u-row--stat">
                  <small>Тара</small>
                  <b>8{NB}310 кг</b>
                </span>
