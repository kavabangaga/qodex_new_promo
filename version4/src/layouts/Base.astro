---
import '../styles/global.css';
import { SITE, METRIKA_ID, withBase } from '../config/site';
import { LAYOUT } from '../config/layout';

interface Props {
  title?: string;
  description?: string;
  /** Схема schema.org для страницы (например, FAQPage). */
  jsonLd?: Record<string, unknown>[];
}

const { title = SITE.title, description = SITE.description, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(withBase(SITE.ogImage), Astro.site ?? SITE.url).href;
// предварительная версия (не на qodex.tech) закрыта от поисковиков
const noindex = Astro.site?.hostname !== 'qodex.tech';
// версия значка: при замене фавикона увеличьте — браузеры держат старый значок в своём кэше
const ICON_V = 2;
---

<!doctype html>
<html lang="ru" class={LAYOUT}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- фавикон: буква Q из логотипа; .ico — для старых браузеров, png — «На экран Домой» на iPhone -->
    <link rel="icon" href={withBase(`/favicon.ico?v=${ICON_V}`)} sizes="32x32" />
    <link rel="icon" href={withBase(`/favicon.svg?v=${ICON_V}`)} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase(`/apple-touch-icon.png?v=${ICON_V}`)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fcfbf8" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="QODEX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');

      // Автомасштаб. Страница рассчитана на окно шириной 1760 px. Если окно уже (ноутбук, FHD-монитор
      // с масштабом Windows 125–150 %), вся страница пропорционально уменьшается — не сильнее чем
      // до 75 % — и выглядит как на широком экране. Уже 1200 px работают планшетная и мобильная
      // раскладки, там масштаб не нужен.
      (function () {
        var REF = 1760; // ширина окна, на которую рассчитан макет
        var MIN_W = 1200; // от этой ширины — раскладка для компьютера
        var MIN_Z = 0.75; // сильнее не уменьшаем: мелкий текст перестаёт читаться
        var root = document.documentElement;
        // границу проверяем медиа-запросом: он видит настоящую ширину окна, а innerWidth
        // при уже уменьшенной странице может округляться на 1 px
        var desktop = window.matchMedia('(min-width: ' + MIN_W + 'px)');
        function apply() {
          var w = window.innerWidth;
          var z = desktop.matches ? Math.max(MIN_Z, Math.min(1, w / REF)) : 1;
          z = Math.round(z * 1000) / 1000;
          root.style.setProperty('--z', String(z));
          root.classList.toggle('is-autoscale', z < 1);
          return { w: w, h: window.innerHeight, dpr: window.devicePixelRatio || 1, z: z };
        }
        apply();
        window.addEventListener('resize', apply);
        desktop.addEventListener('change', apply);
        // подсказка для проверки: страница с ?zoominfo показывает данные окна в углу
        if (/[?&]zoominfo/.test(location.search)) {
          addEventListener('DOMContentLoaded', function () {
            var b = document.createElement('div');
            b.style.cssText = 'position:fixed;right:12px;bottom:12px;z-index:9999;padding:10px 14px;border-radius:12px;background:#1d1d1f;color:#fff;font:600 14px/1.5 system-ui';
            var paint = function () {
              var i = apply();
              b.textContent = 'Окно ' + i.w + '×' + i.h + ' · масштаб системы ' + Math.round(i.dpr * 100) + '% · страница ' + Math.round(i.z * 100) + '% (как окно ' + Math.round(i.w / i.z) + '×' + Math.round(i.h / i.z) + ')';
            };
            paint();
            addEventListener('resize', paint);
            document.body.appendChild(b);
          });
        }
      })();
    </script>

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {
      /* Яндекс Метрика запускается только после согласия посетителя: кнопка «Принять» в плашке о cookie
         (components/Floating.astro) вызывает window.qodexMetrika(). Без согласия счётчик не загружается. */
      METRIKA_ID && (
        <script is:inline define:vars={{ id: METRIKA_ID }}>
          window.qodexMetrika = function () {
            if (window.qodexMetrikaOn) return;
            window.qodexMetrikaOn = true;
            (function (m, e, t, r, i, k, a) {
              m[i] =
                m[i] ||
                function () {
                  (m[i].a = m[i].a || []).push(arguments);
                };
              m[i].l = 1 * new Date();
              (k = e.createElement(t)), (a = e.getElementsByTagName(t)[0]);
              k.async = 1;
              k.src = r;
              a.parentNode.insertBefore(k, a);
            })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
            ym(id, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });
          };
        </script>
      )
    }
  </head>
  <body>
    <!-- у каждой страницы <main id="main"> -->
    <a class="skip" href="#main">Перейти к содержимому</a>
    <slot />
  </body>
</html>
