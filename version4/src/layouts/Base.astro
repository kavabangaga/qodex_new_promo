---
import '../styles/global.css';
import { SITE, METRIKA_ID, withBase } from '../config/site';
import { LAYOUT } from '../config/layout';

interface Props {
  title?: string;
  description?: string;
  /** Схема schema.org для страницы (например, FAQPage). */
  jsonLd?: Record<string, unknown>[];
}

const { title = SITE.title, description = SITE.description, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(withBase(SITE.ogImage), Astro.site ?? SITE.url).href;
// предварительная версия (не на qodex.tech) закрыта от поисковиков
const noindex = Astro.site?.hostname !== 'qodex.tech';
// версия значка: при замене фавикона увеличьте — браузеры держат старый значок в своём кэше
const ICON_V = 2;
---

<!doctype html>
<html lang="ru" class={LAYOUT}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- фавикон: буква Q из логотипа; .ico — для старых браузеров, png — «На экран Домой» на iPhone -->
    <link rel="icon" href={withBase(`/favicon.ico?v=${ICON_V}`)} sizes="32x32" />
    <link rel="icon" href={withBase(`/favicon.svg?v=${ICON_V}`)} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase(`/apple-touch-icon.png?v=${ICON_V}`)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fcfbf8" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="QODEX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {
      METRIKA_ID && (
        <script is:inline define:vars={{ id: METRIKA_ID }}>
          (function (m, e, t, r, i, k, a) {
            m[i] =
              m[i] ||
              function () {
                (m[i].a = m[i].a || []).push(arguments);
              };
            m[i].l = 1 * new Date();
            (k = e.createElement(t)), (a = e.getElementsByTagName(t)[0]);
            k.async = 1;
            k.src = r;
            a.parentNode.insertBefore(k, a);
          })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
          ym(id, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });
        </script>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
