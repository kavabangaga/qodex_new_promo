---
interface Props {
  idx: string;
  label: string;
  /** id для заголовка (якорь стоит на заголовке, а не на секции). */
  titleId?: string;
  class?: string;
}

const { idx, label, titleId, class: className } = Astro.props;
---

<header class:list={['sec-head', className]}>
  <span class="eyebrow label" data-reveal>
    <span class="eyebrow__dot" aria-hidden="true"></span>
    <span>{label}</span>
  </span>
  <h2 class="h2" id={titleId} data-reveal style="--d:1"><slot /></h2>
  {
    Astro.slots.has('lead') && (
      <p class="lead" data-reveal style="--d:2">
        <slot name="lead" />
      </p>
    )
  }
</header>
