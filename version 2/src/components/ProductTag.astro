---
import { PRODUCTS, type ProductId } from '../config/site';

interface Props {
  id: ProductId;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<span class:list={['tag', `p-${id}`, className]}>
  <span class="tag__dot" aria-hidden="true"></span>{PRODUCTS[id].name}
</span>
