---
// Содержимое вкладки «Как работает» — бенто: скриншот, шаги, что это даёт, сноска с кнопкой.
// Понадобится и на страницах продуктов (этап 2).
import Shot from './Shot.astro';
import Icon from './Icon.astro';
import { PRODUCTS, productHref, type ProductId } from '../config/site';

interface Props {
  id: ProductId;
  shot: { caption: string; demo?: boolean };
  steps: string[];
  benefits: string[];
  note: string;
  from?: string;
}

const { id, shot, steps, benefits, note, from = 'interfeysy' } = Astro.props;
const p = PRODUCTS[id];
---

<div class:list={['how', `p-${id}`]}>
  <div class="how__tile how__shot" style="--t:0">
    <Shot caption={shot.caption} demo={shot.demo} fig={p.name} captionBelow ratio="16 / 9" />
  </div>

  <div class="how__tile how__card how__steps-card" style="--t:1">
    <h4 class="how__label label">Как работает</h4>
    <ol class="how__steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="how__num">{i + 1}</span>
            <span class="how__step">{s}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="how__tile how__card how__benefits" style="--t:2">
    <h4 class="how__label label">Что это даёт</h4>
    <ul class:list={['how__benefit-list', { 'is-three': benefits.length > 2 }]}>
      {
        benefits.map((b) => (
          <li class="how__benefit">
            <span class="how__check">
              <Icon name="check" size={16} strokeWidth={2.5} />
            </span>
            <span>{b}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="how__tile how__cta-card" style="--t:3">
    <span class="how__cta-name">
      <span class="tag__dot" aria-hidden="true"></span>
      {p.name}
    </span>
    <p class="how__note">{note}</p>
    <a
      href={productHref(id, from)}
      class="btn btn--light how__cta"
      data-interest={id}
      data-goal="product_landing"
      data-goal-product={id}
    >
      Подробнее о продукте<span class="visually-hidden"> {p.name}</span>
      <Icon name="arrow-up-right" />
    </a>
  </div>
</div>

<style>
  .how {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 14px;
  }

  /* Плитки появляются каскадом при смене вкладки */
  .how__tile {
    animation: tile-in 0.7s var(--ease-out) both;
    animation-delay: calc(var(--t) * 70ms);
  }

  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .how__shot {
    grid-column: span 7;
  }

  .how__steps-card {
    grid-column: span 5;
  }

  .how__benefits {
    grid-column: span 8;
  }

  .how__cta-card {
    grid-column: span 4;
  }

  .how__card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(20px, 2.4vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .how__label {
    font-weight: 500;
    font-size: 13px;
    color: var(--pc-ink);
  }

  /* Шаги на вертикальной линии */
  /* шаги делят высоту карточки поровну — линия доходит до низа */
  .how__steps {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 0;
    flex: 1;
  }

  .how__steps li {
    position: relative;
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 14px;
    padding-bottom: 18px;
    font-size: 16px;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .how__steps li:last-child {
    padding-bottom: 0;
  }

  .how__steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 14.5px;
    top: 32px;
    bottom: 2px;
    width: 1px;
    background: color-mix(in oklab, var(--pc) 40%, transparent);
  }

  .how__num {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--pc);
    color: var(--pc-on);
    font-size: 13px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .how__step {
    padding-top: 4px;
  }

  /* Что это даёт — отдельными плитками */
  .how__benefit-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    flex: 1;
  }

  .how__benefit-list.is-three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .how__benefit {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--pc) 9%, white);
    border: 1px solid color-mix(in oklab, var(--pc) 20%, transparent);
    font-size: 15.5px;
    line-height: 1.45;
    font-weight: 500;
    color: var(--ink);
    text-wrap: pretty;
  }

  .how__check {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--pc);
    color: var(--pc-on);
  }

  /* Сноска и кнопка — тёмная плитка */
  .how__cta-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(20px, 2.4vw, 28px);
    border-radius: var(--radius-lg);
    background: var(--night);
    color: var(--night-text);
  }

  .how__cta-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
  }

  .how__cta-name .tag__dot {
    background: var(--pc-glow);
  }

  .how__note {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--night-muted);
    text-wrap: pretty;
  }

  .how__cta {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (min-width: 1600px) {
    :global(html.wide) .how__shot {
      grid-column: 1 / span 6;
      grid-row: 1 / span 2;
    }

    :global(html.wide) .how__steps-card {
      grid-column: 7 / span 3;
      grid-row: 1 / span 2;
    }

    :global(html.wide) .how__benefits {
      grid-column: 10 / span 3;
      grid-row: 1;
    }

    :global(html.wide) .how__cta-card {
      grid-column: 10 / span 3;
      grid-row: 2;
    }

    :global(html.wide) .how__benefit-list,
    :global(html.wide) .how__benefit-list.is-three {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 1000px) {
    .how__shot,
    .how__steps-card,
    .how__benefits,
    .how__cta-card {
      grid-column: 1 / -1;
    }

    .how__benefit-list.is-three {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .how__benefit-list,
    .how__benefit-list.is-three {
      grid-template-columns: 1fr;
    }
  }
</style>
