---
import Icon, { type IconName } from './Icon.astro';
import { PRODUCTS, productHref, type ProductId } from '../config/site';

interface Props {
  id: ProductId;
  icon: IconName;
  text: string;
  /** Цифра карточки: pre + крупно big + post, читается одной строкой. */
  figure: { pre?: string; big: string; post?: string };
  /** Метка блока для UTM. */
  from?: string;
  index?: number;
}

const { id, icon, text, figure, from = 'products', index = 0 } = Astro.props;
const p = PRODUCTS[id];
---

<div class="pcard-wrap" data-reveal style={`--d:${index}`}>
  <article class:list={['pcard', `p-${id}`]} data-spot>
    <div class="pcard__panel">
      <div class="pcard__pixels" aria-hidden="true"></div>
      <div class="pcard__panel-top">
        <span class="pcard__icon"><Icon name={icon} size={20} /></span>
      </div>
      <p class="pcard__fig">
        {figure.pre && <span class="pcard__pre">{figure.pre}</span>}
        <span class="pcard__big num">{figure.big}</span>
        {figure.post && <span class="pcard__post">{figure.post}</span>}
      </p>
      <i class="pcard__hud pcard__hud--tl" aria-hidden="true"></i>
      <i class="pcard__hud pcard__hud--br" aria-hidden="true"></i>
    </div>
    <div class="pcard__body">
      <h3 class="h3 pcard__name">{p.name}</h3>
      <p class="pcard__text">{text}</p>
      <a
        href={productHref(id, from)}
        class="link-arrow pcard__link"
        data-interest={id}
        data-goal="product_landing"
        data-goal-product={id}
      >
        Подробнее<span class="visually-hidden"> о {p.name}</span>
        <Icon name="arrow-right" />
      </a>
    </div>
  </article>
</div>

<style>
  .pcard-wrap {
    display: flex;
  }

  .pcard {
    flex: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }

  .pcard:hover {
    transform: translateY(-6px);
    box-shadow:
      0 30px 60px -30px color-mix(in oklab, var(--pc) 60%, transparent),
      var(--shadow);
  }

  /* Цветная панель с цифрой */
  .pcard__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    min-height: clamp(208px, 13vw, 300px);
    padding: 18px;
    border-radius: calc(var(--radius-lg) - 6px);
    background:
      radial-gradient(120% 90% at var(--mx, 80%) var(--my, 0%), rgb(255 255 255 / 0.28), transparent 55%),
      var(--pc);
    color: var(--pc-on);
    overflow: hidden;
    isolation: isolate;
  }

  /* Пиксельная текстура */
  .pcard__pixels {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(color-mix(in oklab, var(--pc-on) 30%, transparent) 1px, transparent 1.4px);
    background-size: 10px 10px;
    mask-image: linear-gradient(200deg, #000 0%, transparent 55%);
    transition: transform 0.8s var(--ease-out);
  }

  .pcard:hover .pcard__pixels {
    transform: translate(-10px, 10px);
  }

  .pcard__panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pcard__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: color-mix(in oklab, var(--pc-on) 16%, transparent);
  }

  .pcard__idx {
    font-size: 13px;
    opacity: 0.85;
  }

  .pcard__fig {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pcard__big {
    font-size: clamp(2.4rem, 3vw, 4rem);
    font-weight: 700;
    line-height: 1;
  }

  .pcard__pre,
  .pcard__post {
    font-size: 14px;
    line-height: 1.35;
    font-weight: 500;
    opacity: 0.92;
  }

  .pcard__hud {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid color-mix(in oklab, var(--pc-on) 60%, transparent);
  }

  .pcard__hud--tl {
    top: 8px;
    left: 8px;
    border-width: 1.5px 0 0 1.5px;
  }

  .pcard__hud--br {
    right: 8px;
    bottom: 8px;
    border-width: 0 1.5px 1.5px 0;
  }

  .pcard__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    padding: 20px 16px 16px;
  }

  .pcard__text {
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }

  .pcard__link {
    margin-top: auto;
    padding-top: 6px;
    align-self: flex-start;
    color: var(--pc-ink);
  }

  /* Вся карточка кликабельна */
  .pcard__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
</style>
