---
// Схема единого баланса ТКО: четыре звена и итог. Рисуется на тёмном фоне.
// Понадобится и на страницах продуктов (этап 2).
import Icon, { type IconName } from './Icon.astro';
import ProductTag from './ProductTag.astro';
import { PRODUCTS, type ProductId } from '../config/site';

export interface BalanceLink {
  place: string;
  products: ProductId[];
  text: string;
  icon: IconName;
}

interface Props {
  links: BalanceLink[];
  result: { title: string; text: string };
  /** Подсветить звенья одного продукта (для страниц продуктов). */
  highlight?: ProductId;
}

const { links, result, highlight } = Astro.props;

// Рамка звена — цвет первого продукта; если продуктов два, обе метки стоят под звеном
const ring = (ids: ProductId[]) => PRODUCTS[ids[0]].glow;
---

<ol class="bal" data-inview>
  {
    links.map((l, i) => (
      <li
        class:list={['bal__node', `p-${l.products[0]}`, { 'is-dim': highlight && !l.products.includes(highlight) }]}
        style={`--i:${i};--ring:${ring(l.products)}`}
      >
        <div class="bal__rail">
          <span class="bal__icon">
            <span class="bal__icon-in">
              <Icon name={l.icon} size={24} />
            </span>
          </span>
          <span class="bal__eq" aria-hidden="true">
            {i < links.length - 1 ? '=' : <Icon name="arrow-right" size={14} strokeWidth={2.25} />}
          </span>
        </div>
        <div class="bal__content">
          <h3 class="bal__place">{l.place}</h3>
          <div class="bal__tags">
            {l.products.map((id) => (
              <ProductTag id={id} />
            ))}
          </div>
          <p class="bal__text">{l.text}</p>
        </div>
      </li>
    ))
  }
  <li class="bal__node bal__node--result" style={`--i:${links.length}`}>
    <div class="bal__rail">
      <span class="bal__icon">
        <span class="bal__icon-in">
          <Icon name="wallet" size={24} />
        </span>
      </span>
    </div>
    <div class="bal__content bal__content--result">
      <span class="bal__n label">{result.title}</span>
      <p class="bal__result">{result.text}</p>
    </div>
  </li>
</ol>

<style>
  .bal {
    --rail-y: 32px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0 14px;
  }

  /* Рельс: серая основа, четырёхцветная заливка и бегущий импульс */
  .bal::before,
  .bal::after {
    content: '';
    position: absolute;
    top: calc(var(--rail-y) - 1px);
    left: 32px;
    /* до центра иконки итога: 5 колонок, зазор 14px, центр иконки в 32px от края колонки */
    right: calc(20% - 43.2px);
    height: 2px;
    border-radius: 2px;
  }

  .bal::before {
    background: rgb(255 255 255 / 0.55);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.8s var(--ease-in-out);
  }

  .bal::after {
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.95) 50%, transparent) 0 0 / 18% 100% no-repeat;
    opacity: 0;
    filter: drop-shadow(0 0 6px #fff);
  }

  .bal.is-in::before {
    transform: scaleX(1);
  }

  .bal.is-in::after {
    opacity: 1;
    animation: flow 2.8s linear 2.4s infinite;
    background-position: -40% 0;
  }

  @keyframes flow {
    from {
      background-position: -40% 0;
    }
    to {
      background-position: 140% 0;
    }
  }

  .bal__node {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .bal__rail {
    position: relative;
    display: flex;
    align-items: center;
    height: calc(var(--rail-y) * 2);
  }

  .bal__icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    padding: 2px;
    border-radius: 18px;
    background: var(--night-line-2);
    transition:
      background 0.5s,
      box-shadow 0.6s;
    transition-delay: calc(0.4s + var(--i) * 0.3s);
  }

  .bal.is-in .bal__icon {
    background: var(--ring);
    box-shadow: 0 0 40px -6px color-mix(in oklab, var(--pc-glow, #fff) 55%, transparent);
  }

  .bal__icon-in {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 16px;
    background: var(--night-2);
    color: var(--night-muted);
    transition: color 0.5s;
    transition-delay: calc(0.4s + var(--i) * 0.3s);
  }

  .bal.is-in .bal__icon-in {
    color: var(--pc-glow, #fff);
  }

  .bal__eq {
    position: absolute;
    /* посередине между центрами соседних иконок */
    left: calc(50% + 39px);
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border: 1px solid var(--night-line-2);
    border-radius: 8px;
    background: var(--night);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    opacity: 0;
    transform: scale(0.4) rotate(-45deg);
    transition:
      opacity 0.4s,
      transform 0.6s var(--ease-out);
    transition-delay: calc(0.6s + var(--i) * 0.3s);
  }

  .bal.is-in .bal__eq,
  html:not(.js) .bal__eq {
    opacity: 1;
    transform: none;
  }

  .bal__content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.7s var(--ease-out);
    transition-delay: calc(0.5s + var(--i) * 0.3s);
  }

  .bal.is-in .bal__content,
  html:not(.js) .bal__content {
    opacity: 1;
    transform: none;
  }

  .bal__n {
    font-size: 13px;
    color: var(--night-muted);
  }

  .bal__place {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: #fff;
  }

  .bal__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .bal__text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--night-muted);
    text-wrap: pretty;
  }

  /* Итог */
  .bal.is-in .bal__node--result .bal__icon {
    background: #fff;
    box-shadow: 0 0 44px -8px rgb(255 255 255 / 0.45);
  }

  .bal.is-in .bal__node--result .bal__icon-in {
    color: #fff;
  }

  .bal__content--result {
    padding: 18px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--radius);
    background: var(--night-2);
  }

  .bal__content--result .bal__n {
    font-weight: 700;
    font-size: 12px;
    color: #fff;
  }

  .bal__result {
    font-size: 16.5px;
    line-height: 1.45;
    font-weight: 500;
    color: #fff;
    text-wrap: pretty;
  }

  .is-dim {
    opacity: 0.4;
  }

  /* Планшет и телефон: вертикальная цепочка из отрезков */
  @media (max-width: 1000px) {
    .bal {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .bal::before,
    .bal::after {
      display: none;
    }

    .bal__node {
      flex-direction: row;
      gap: 18px;
      padding-bottom: 40px;
    }

    .bal__node--result {
      padding-bottom: 0;
    }

    .bal__rail {
      flex-direction: column;
      height: auto;
      align-self: stretch;
    }

    .bal__node:not(.bal__node--result) .bal__rail::before {
      content: '';
      position: absolute;
      left: 31px;
      top: 32px;
      bottom: -72px;
      width: 2px;
      background: linear-gradient(180deg, var(--pc-glow), var(--night-line-2));
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.6s var(--ease-out);
      transition-delay: calc(0.3s + var(--i) * 0.3s);
    }

    .bal.is-in .bal__rail::before {
      transform: scaleY(1);
    }

    .bal__eq {
      left: 32px;
      top: auto;
      bottom: -34px;
    }

    .bal__content {
      flex: 1;
      padding-top: 8px;
    }

    .bal__content--result {
      padding-top: 18px;
    }
  }
</style>
