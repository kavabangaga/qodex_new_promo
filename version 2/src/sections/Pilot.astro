---
import SectionHead from '../components/SectionHead.astro';
import Shot from '../components/Shot.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { PRODUCTS, type ProductId } from '../config/site';

const NB = ' ';

const others: { id: ProductId; icon: IconName; first: string; payback: string; need: string; pilot: string }[] = [
  {
    id: 'tonn',
    icon: 'scale',
    first: 'Акты с фото с первого дня',
    payback: `45${NB}дней — кейс объекта`,
    need: 'Доступ к весовой',
    pilot: `1${NB}месяц бесплатно после запуска`,
  },
  {
    id: 'kodeks',
    icon: 'cloud-upload',
    first: `Подключение за 15${NB}минут`,
    payback: 'Сразу',
    need: 'Ключ доступа к ФГИС',
    pilot: 'Неделя бесплатно',
  },
];
---

<section class="section" id="pilot">
  <div class="container">
    <SectionHead idx="12" label="Пилот">Первый результат — в первый же день пилота</SectionHead>

    <div class="pl">
      <!-- РО-БОТ — главная карточка: данные пилота + шаги + кнопка -->
      <article class="pl__main p-robot dark" data-reveal>
        <div class="pl__main-bg" aria-hidden="true"></div>
        <header class="pl__head">
          <span class="pl__product">
            <span class="pl__icon"><Icon name="user-search" size={20} /></span>
            {PRODUCTS.robot.name}
          </span>
          <span class="pl__free">Бесплатно</span>
        </header>

        <div class="pl__first">
          <span class="label">Первый результат</span>
          <p>Реестр неплательщиков за 1&nbsp;день</p>
        </div>

        <dl class="pl__meta">
          <div>
            <dt class="label">Окупаемость</dt>
            <dd>9 из 247 найденных юрлиц окупают внедрение</dd>
          </div>
          <div>
            <dt class="label">Что нужно от вас</dt>
            <dd>Выгрузка биллинга по одному району</dd>
          </div>
        </dl>

        <div class="pl__plate">
          <p class="pl__plate-title">Начнём с РО-БОТа: пилот бесплатный.</p>
          <ol class="pl__steps">
            <li><span class="pl__n">1</span><span>NDA</span></li>
            <li><span class="pl__n">2</span><span>Выгрузка биллинга по одному району</span></li>
            <li><span class="pl__n">3</span><span>Реестр неплательщиков в рублях — за 1&nbsp;день</span></li>
          </ol>
          <a href="#forma" class="btn btn--primary btn--light pl__cta" data-interest="robot" data-goal="pilot_click">
            Запустить пилот
            <Icon name="arrow-right" />
          </a>
        </div>
      </article>

      {
        others.map((o, i) => (
          <article class:list={['pl__card', `p-${o.id}`]} style={`--d:${i + 1}`} data-reveal>
            <span class="pl__mark" aria-hidden="true">
              <Icon name={o.icon} size={220} strokeWidth={1} />
            </span>
            <header class="pl__head">
              <span class="pl__product">
                <span class="pl__icon">
                  <Icon name={o.icon} size={20} />
                </span>
                {PRODUCTS[o.id].name}
              </span>
              <span class="pl__free">{o.pilot}</span>
            </header>
            <div class="pl__first">
              <span class="label">Первый результат</span>
              <p>{o.first}</p>
            </div>
            <dl class="pl__meta">
              <div>
                <dt class="label">Окупаемость</dt>
                <dd>{o.payback}</dd>
              </div>
              <div>
                <dt class="label">Что нужно от вас</dt>
                <dd>{o.need}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>

    <div class="example p-robot" data-reveal>
      <div class="example__info">
        <p class="example__text">
          <strong>Так выглядит результат первого дня:</strong> реестр расхождений по району с источником и датой. Ваш
          сотрудник проверяет расхождения и отправляет подтверждённые в биллинг или 1С одной кнопкой. Ничего не
          начисляется автоматически.
        </p>
        <ol class="example__legend" aria-label="Обозначения на скриншоте">
          <li><span class="example__n">1</span>источник</li>
          <li><span class="example__n">2</span>дата</li>
          <li><span class="example__n">3</span>решение принимает сотрудник</li>
        </ol>
      </div>
      <div class="example__shot">
        <Shot caption="Реестр расхождений из демо-аккаунта РО-БОТа" fig="РО-БОТ" demo ratio="16 / 10" />
        <span class="callout callout--a" aria-hidden="true"><i>1</i>источник</span>
        <span class="callout callout--b" aria-hidden="true"><i>2</i>дата</span>
        <span class="callout callout--c" aria-hidden="true"><i>3</i>решение принимает сотрудник</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Бенто: РО-БОТ крупно слева, TONN и Кодекс ТКО — стопкой справа */
  .pl {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 14px;
  }

  .pl__main {
    grid-column: 1 / span 7;
    grid-row: 1 / span 2;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding: clamp(24px, 3vw, 44px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
  }

  .pl__main-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(70% 60% at 100% 0%, color-mix(in oklab, var(--c-robot) 45%, transparent), transparent 70%),
      var(--night);
  }

  .pl__card {
    grid-column: 8 / span 5;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(22px, 2.4vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(70% 80% at 100% 100%, color-mix(in oklab, var(--pc) 16%, transparent), transparent 70%),
      var(--surface);
    overflow: hidden;
    isolation: isolate;
  }

  /* точечная текстура в углу */
  .pl__card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(color-mix(in oklab, var(--pc) 45%, transparent) 1px, transparent 1.4px);
    background-size: 14px 14px;
    mask-image: radial-gradient(ellipse 60% 70% at 100% 100%, #000, transparent 75%);
    opacity: 0.7;
  }

  /* крупная прозрачная иконка продукта */
  .pl__mark {
    position: absolute;
    right: -34px;
    bottom: -40px;
    z-index: -1;
    color: var(--pc);
    opacity: 0.12;
    transform: rotate(-8deg);
    pointer-events: none;
  }

  .pl__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .pl__product {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 17px;
    font-weight: 600;
  }

  .pl__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: color-mix(in oklab, var(--pc) 12%, white);
    color: var(--pc-ink);
  }

  .pl__main .pl__icon {
    background: rgb(255 255 255 / 0.1);
    color: var(--pc-glow);
  }

  .pl__main .pl__product {
    color: #fff;
  }

  .pl__free {
    padding: 6px 12px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--pc) 13%, white);
    color: var(--pc-ink);
    font-size: 14px;
    font-weight: 600;
  }

  .pl__main .pl__free {
    background: var(--pc-glow);
    color: var(--night);
  }

  .pl__first {
    display: grid;
    gap: 8px;
  }

  .pl__first .label {
    color: var(--subtle);
  }

  .pl__first p {
    font-size: clamp(1.5rem, 2.2vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 600;
    text-wrap: balance;
  }

  .pl__main .pl__first p {
    font-size: clamp(2rem, 3.6vw, 3.6rem);
    line-height: 1.04;
    color: #fff;
  }

  .pl__meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 24px;
    padding-top: 18px;
    border-top: 1px dashed var(--line-2);
  }

  .pl__meta div {
    display: grid;
    gap: 6px;
  }

  .pl__meta dt {
    color: var(--subtle);
  }

  .pl__meta dd {
    font-size: 15.5px;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .pl__main .pl__meta dd {
    color: #e3e4e7;
  }

  /* Шаги пилота внутри главной карточки */
  .pl__plate {
    display: grid;
    gap: 18px;
    margin-top: auto;
    padding: clamp(18px, 2vw, 26px);
    border: 1px solid var(--night-line-2);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.04);
  }

  .pl__plate-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: #fff;
  }

  .pl__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    counter-reset: step;
  }

  .pl__steps li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 2px;
    font-size: 15px;
    line-height: 1.4;
    color: #e3e4e7;
  }

  /* соединительная линия между шагами */
  .pl__steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 15px;
    left: 38px;
    right: 6px;
    height: 1px;
    background: rgb(255 255 255 / 0.22);
  }

  .pl__n {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: #fff;
    color: var(--ink);
    font-size: 13px;
    font-weight: 700;
  }

  .pl__cta {
    justify-self: start;
  }

  /* Пример результата первого дня — единая карточка */
  .example {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
    margin-top: clamp(40px, 4vw, 64px);
    padding: clamp(24px, 3.4vw, 56px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(60% 80% at 0% 0%, color-mix(in oklab, var(--pc) 10%, transparent), transparent 70%),
      var(--surface);
  }

  .example__info {
    display: grid;
    gap: clamp(24px, 3vw, 40px);
  }

  .example__text {
    font-size: clamp(19px, 1.7vw, 26px);
    line-height: 1.42;
    letter-spacing: -0.012em;
    color: var(--muted);
    text-wrap: pretty;
  }

  .example__text strong {
    font-weight: 600;
    color: var(--ink);
  }

  .example__legend {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .example__legend li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
  }

  .example__n,
  .callout i {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 8px;
    background: var(--pc);
    color: var(--pc-on);
    font-size: 13px;
    font-weight: 700;
    font-style: normal;
  }

  .example__shot {
    position: relative;
  }

  .callout {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px 5px 5px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 13px;
    font-weight: 600;
    box-shadow: var(--shadow);
    white-space: nowrap;
  }

  .callout i {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-size: 12px;
  }

  .callout--a {
    top: 24%;
    left: -18px;
  }

  .callout--b {
    top: 44%;
    right: -18px;
  }

  .callout--c {
    bottom: 14%;
    left: 14%;
  }

  @media (min-width: 1600px) {
    :global(html.wide) .example {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }

  @media (max-width: 1100px) {
    .pl__main,
    .pl__card {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (max-width: 760px) {
    .pl__meta,
    .pl__steps {
      grid-template-columns: 1fr;
    }

    .pl__steps li {
      grid-template-columns: 30px 1fr;
      align-items: center;
      gap: 12px;
    }

    .pl__steps li:not(:last-child)::after {
      display: none;
    }

    .example {
      grid-template-columns: 1fr;
    }

    .callout--a,
    .callout--c {
      left: 8px;
    }

    .callout--b {
      right: 8px;
    }
  }
</style>
