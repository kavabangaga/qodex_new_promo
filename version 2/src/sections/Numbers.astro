---
import SectionHead from '../components/SectionHead.astro';
import StatTile from '../components/StatTile.astro';

const NB = ' ';
---

<section class="section" id="cifry">
  <div class="container">
    <SectionHead idx="08" label="Цифры">Результаты пилотов и внедрений</SectionHead>

    <div class="bento">
      <StatTile
        class="a"
        feature
        index={0}
        count={73}
        value="73"
        caption="клиента уже работают с продуктами QODEX"
      />
      <StatTile
        class="b"
        index={1}
        prefix="+"
        count={7.5}
        decimals={1}
        value="7,5"
        unit={`${NB}млн${NB}₽`}
        tail="в год"
        caption="только по жильцам в одном районе: +10% жильцов в базе за один день сверки"
        product="robot"
      />
      <StatTile
        class="c"
        index={2}
        count={4}
        value="4"
        unit={`${NB}дня`}
        caption={`сверка всех 755${NB}576 помещений регоператора с ГИС ЖКХ. Вручную это годы работы`}
        product="robot"
      />
      <StatTile
        class="d"
        index={3}
        prefix="−"
        count={57}
        value="57"
        unit="%"
        caption="тоннажа в актах после установки: март 2025 к марту 2024, 4 района Башкортостана"
        product="tonn"
      />
      <StatTile
        class="e"
        index={4}
        prefix=">"
        count={60}
        value="60"
        unit={`${NB}млн${NB}₽`}
        caption="сэкономил РО «Эко-Сити» за год"
        product="tonn"
      />
      <StatTile
        class="f"
        index={5}
        prefix="+"
        count={17}
        value="17"
        unit="%"
        caption="контейнеров сверх плана: в среднем 10 на маршруте, которых нет в реестре. Пилот у РО «Эко-Сити»"
        product="tracker"
      />
    </div>

    <p class="footnote stats__note" data-reveal>
      Кейсы РО-БОТа — разные проекты: +7,5&nbsp;млн&nbsp;₽ — пилот в одном районе, 4&nbsp;дня — сверка всей базы
      регоператора. Регионы и операторы не раскрываются по условиям соглашений.
    </p>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-areas:
      'a a b b'
      'a a c d'
      'e e f f';
    gap: 14px;
  }

  .bento > :global(.a) {
    grid-area: a;
    min-height: 460px;
  }

  .bento > :global(.b) {
    grid-area: b;
  }

  .bento > :global(.c) {
    grid-area: c;
  }

  .bento > :global(.d) {
    grid-area: d;
  }

  .bento > :global(.e) {
    grid-area: e;
  }

  .bento > :global(.f) {
    grid-area: f;
  }

  .bento > :global(.stat:not(.a)) {
    min-height: 220px;
  }

  @media (min-width: 1600px) {
    :global(html.wide) .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-areas:
        'a a b b c d'
        'a a e e f f';
    }

    :global(html.wide) .bento > :global(.a) {
      min-height: 520px;
    }

    :global(html.wide) .bento > :global(.stat:not(.a)) {
      min-height: 250px;
    }
  }

  .stats__note {
    margin-top: 20px;
    max-width: 880px;
  }

  @media (max-width: 1000px) {
    .bento {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'a a'
        'b b'
        'c d'
        'e f';
    }

    .bento > :global(.a) {
      min-height: 340px;
    }
  }

  @media (max-width: 600px) {
    .bento {
      grid-template-columns: 1fr;
      grid-template-areas: 'a' 'b' 'c' 'd' 'e' 'f';
    }

    .bento > :global(.stat:not(.a)) {
      min-height: 0;
    }
  }
</style>
