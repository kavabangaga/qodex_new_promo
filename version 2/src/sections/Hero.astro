---
import Icon, { type IconName } from '../components/Icon.astro';
import Shot from '../components/Shot.astro';
import { PRODUCTS, type ProductId } from '../config/site';

// Четыре места из заголовка = четыре шлюза потока = четыре вкладки со скриншотами
const places: {
  id: ProductId;
  icon: IconName;
  words: string[];
  label: string;
  caption: string;
  demo?: boolean;
}[] = [
  {
    id: 'robot',
    icon: 'user-search',
    words: ['база', 'начислений'],
    label: 'База начислений',
    caption: 'Сверка РО-БОТа — тот же демо-экран, что в блоке «Работающие системы»',
    demo: true,
  },
  { id: 'tracker', icon: 'truck', words: ['маршрут'], label: 'Маршрут', caption: 'Кадр с камеры «Погружено: 3»' },
  {
    id: 'tonn',
    icon: 'scale',
    words: ['весы'],
    label: 'Весы',
    caption: 'Экран весовой «Номер распознан А983ВВ 102» (госномер — демо или размыт)',
  },
  {
    id: 'kodeks',
    icon: 'cloud-upload',
    words: ['ФГИС'],
    label: 'ФГИС',
    caption: 'Кодекс ТКО: «Импорт из Excel: 80/80 актов верно»',
  },
];

const lead = ['Находим', 'деньги', 'регоператора', 'в четырёх', 'местах:'];
let order = lead.length;
const words = places.map((pl) => {
  const start = order;
  order += pl.words.length;
  return { ...pl, start };
});
---

<section class="hero" data-hero>
  <div class="stage dark">
    <div class="stage__bg" aria-hidden="true">
      <div class="stage__grid"></div>
      <div class="stage__glow stage__glow--a"></div>
      <div class="stage__glow stage__glow--b"></div>
      <div class="stage__glow stage__glow--c"></div>
    </div>

    <div class="container stage__layout">
    <div class="stage__in">
      <p class="kicker label">
        <span class="kicker__dot" aria-hidden="true"></span>
        Для региональных операторов ТКО
      </p>

      <h1 class="h1 title">
        {
          lead.map((word, i) => (
            <>
              <span class="w" style={`--i:${i}`}>
                {word}
              </span>{' '}
            </>
          ))
        }
        {
          words.map((pl, k) => (
            <>
              <span class="nw">
                <span class:list={['mk', `p-${pl.id}`]} style={`--k:${k}`}>
                  {pl.words.map((word, j) => (
                    <>
                      {j > 0 && ' '}
                      <span class="w" style={`--i:${pl.start + j}`}>
                        {word}
                      </span>
                    </>
                  ))}
                </span>
                {k < words.length - 1 && (
                  <span class="w" style={`--i:${pl.start + pl.words.length - 1}`}>
                    ,
                  </span>
                )}
              </span>
              {k < words.length - 1 && ' '}
            </>
          ))
        }
      </h1>

      <div class="row">
        <p class="sub">
          С 2020 года автоматизируем учёт отходов — от базы начислений регоператора до весовой на полигоне и передачи
          данных во ФГИС УТКО. Вы начисляете и платите по фактическим данным.
        </p>
        <div class="cta">
          <a href="#forma" class="btn btn--primary btn--light" data-goal="pilot_click">
            Запустить бесплатный пилот
            <Icon name="arrow-right" />
          </a>
          <a href="#poteri" class="btn btn--ghost">
            Где вы теряете деньги
            <Icon name="arrow-down" />
          </a>
        </div>
      </div>

      <ul class="proof label">
        <li>73 клиента</li>
        <li>Резидент Сколково</li>
        <li>Аккредитованная IT-компания</li>
      </ul>
    </div>

    <div class="showcase" data-showcase>
      {
        places.map((pl, i) => (
          <div class="screen" role="tabpanel" id={`screen-${pl.id}`} aria-labelledby={`gate-${pl.id}`} hidden={i !== 0}>
            <Shot caption={pl.caption} fig={PRODUCTS[pl.id].name} demo={pl.demo} ratio="16 / 10" />
          </div>
        ))
      }
    </div>
    </div>

    <div class="flow" data-flow>
      <canvas class="flow__canvas" aria-hidden="true"></canvas>
      <div class="container flow__gates" role="tablist" aria-label="Экраны продуктов">
        {
          places.map((pl, i) => (
            <button
              class:list={['gate', `p-${pl.id}`]}
              type="button"
              role="tab"
              id={`gate-${pl.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`screen-${pl.id}`}
              tabindex={i === 0 ? 0 : -1}
              data-gate
            >
              <span class="gate__top">
                <span class="gate__label">{pl.label}</span>
              </span>
              <span class="gate__anchor" data-gate-anchor aria-hidden="true" />
              <span class="gate__icon" aria-hidden="true">
                <Icon name={pl.icon} size={20} strokeWidth={1.75} />
              </span>
              <span class="gate__bottom">
                <span class="gate__product">
                  <span class="tag__dot" aria-hidden="true" />
                  {PRODUCTS[pl.id].name}
                </span>
                <span class="gate__progress" aria-hidden="true" />
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

</section>

<style>
  .hero {
    padding: 8px clamp(6px, 1vw, 12px) 0;
  }

  .stage {
    position: relative;
    border-radius: clamp(20px, 2.4vw, 32px);
    overflow: hidden;
    isolation: isolate;
    padding-top: clamp(40px, 5vw, 88px);
    padding-bottom: clamp(12px, 1.6vw, 28px);
  }

  /* Текст и окно со скриншотом: колонки на широком экране, друг под другом на узком */
  .stage__layout {
    display: grid;
    gap: clamp(32px, 4vw, 64px);
  }

  .stage__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .stage__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 30%, #000 20%, transparent 80%);
  }

  .stage__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.5;
    animation: drift 20s var(--ease-in-out) infinite alternate;
  }

  .stage__glow--a {
    width: 520px;
    height: 420px;
    left: -140px;
    top: -160px;
    background: var(--c-robot);
    opacity: 0.45;
  }

  .stage__glow--b {
    width: 460px;
    height: 380px;
    right: -120px;
    top: -120px;
    background: var(--c-robot);
    opacity: 0.18;
    animation-delay: -7s;
  }

  .stage__glow--c {
    display: none;
    animation-delay: -13s;
  }

  @keyframes drift {
    to {
      transform: translate3d(8%, 10%, 0) scale(1.12);
    }
  }

  .stage__in {
    position: relative;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 32px;
    padding: 0 14px 0 12px;
    margin-bottom: 26px;
    border: 1px solid var(--night-line-2);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    backdrop-filter: blur(8px);
    color: #d8dade;
    font-size: 13px;
    animation: rise 0.8s var(--ease-out) both;
  }

  .kicker__dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-tonn);
  }

  .kicker__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--c-tonn);
    animation: ping 2.2s ease-out infinite;
  }

  @keyframes ping {
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  .title {
    max-width: 16.5em;
    font-size: clamp(2.1rem, 4.7vw, 4.1rem);
    color: #fff;
  }

  .nw {
    white-space: nowrap;
  }

  .w {
    display: inline-block;
    animation: word 0.9s var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms + 150ms);
  }

  @keyframes word {
    from {
      opacity: 0;
      transform: translateY(0.4em);
      filter: blur(10px);
    }
  }

  /* Четыре места: слово загорается цветом продукта вместе со шлюзом */
  .mk {
    position: relative;
    color: #fff;
    background-image: linear-gradient(var(--pc), var(--pc));
    background-repeat: no-repeat;
    background-position: 0 96%;
    background-size: 0% 0.09em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    animation:
      mk-color 0.6s var(--ease-out) forwards,
      mk-line 0.9s var(--ease-out) forwards;
    animation-delay: calc(1800ms + var(--k) * 600ms);
  }

  @keyframes mk-color {
    to {
      color: var(--pc-glow);
    }
  }

  @keyframes mk-line {
    to {
      background-size: 100% 0.09em;
    }
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 28px 48px;
    margin-top: 28px;
  }

  .sub {
    max-width: 58ch;
    font-size: clamp(1.02rem, 1.3vw, 1.15rem);
    line-height: 1.6;
    color: #b9bcc3;
    animation: rise 0.9s var(--ease-out) 0.6s both;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    animation: rise 0.9s var(--ease-out) 0.75s both;
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0;
    margin-top: 26px;
    color: #9aa0a8;
    font-size: 13px;
    animation: rise 0.9s var(--ease-out) 0.9s both;
  }

  .proof li {
    display: flex;
    align-items: center;
  }

  .proof li + li::before {
    content: '';
    width: 3px;
    height: 3px;
    margin: 0 12px;
    border-radius: 50%;
    background: #5a5f68;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Поток */
  .flow {
    position: relative;
    height: clamp(210px, 20vw, 270px);
    margin-top: clamp(16px, 2.5vw, 32px);
    animation: fade 1.2s ease 0.4s both;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .flow__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .flow__gates {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: 100%;
  }

  .gate {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 6px 4px;
    border: 0;
    background: none;
    color: #c9ccd2;
    text-align: center;
    cursor: pointer;
  }

  .gate__top {
    display: grid;
    justify-items: center;
    gap: 6px;
  }

  .gate__n {
    display: inline-grid;
    place-items: center;
    height: 20px;
    padding: 0 6px;
    border: 1px solid var(--night-line-2);
    border-radius: 5px;
    font-size: 13px;
    color: #9aa0a8;
    transition:
      color 0.3s,
      border-color 0.3s,
      background-color 0.3s;
  }

  .gate__label {
    font-family: var(--font-display);
    font-size: clamp(0.8rem, 1.1vw, 1rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #e6e7ea;
    transition: color 0.3s;
  }

  .gate__anchor {
    width: 1px;
    height: 1px;
  }

  /* Круг шлюза с иконкой продукта — плоский; поток обтекает его, от него расходятся волны */
  .gate__icon {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin: -23px 0 0 -23px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 50%;
    background: #121419;
    color: #7d838d;
    transition:
      color 0.5s,
      border-color 0.5s,
      box-shadow 0.6s,
      transform 0.5s var(--ease-out);
  }

  .gate.is-on .gate__icon {
    color: var(--pc-glow);
    border-color: color-mix(in oklab, var(--pc-glow) 55%, transparent);
    background: color-mix(in oklab, var(--pc) 22%, #0b0c0f);
    animation: gate-pop 0.7s var(--ease-out);
  }

  .gate.is-on[aria-selected='true'] .gate__icon {
    transform: scale(1.1);
    color: #fff;
    border-color: var(--pc-glow);
    background: color-mix(in oklab, var(--pc) 45%, #0b0c0f);
  }

  .gate:hover .gate__icon {
    color: var(--pc-glow);
  }

  @keyframes gate-pop {
    0% {
      transform: scale(0.8);
    }
    60% {
      transform: scale(1.14);
    }
  }

  .gate__bottom {
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .gate__product {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 600;
    color: #9aa0a8;
    transition: color 0.3s;
  }

  .gate__progress {
    position: relative;
    width: 72px;
    height: 2px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.1);
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .gate__progress::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--pc-glow);
    transform: scaleX(0);
    transform-origin: left;
  }

  .gate:hover .gate__label,
  .gate[aria-selected='true'] .gate__label {
    color: #fff;
  }

  .gate[aria-selected='true'] .gate__n {
    color: var(--night);
    background: var(--pc-glow);
    border-color: var(--pc-glow);
  }

  .gate[aria-selected='true'] .gate__product {
    color: var(--pc-glow);
  }

  .gate[aria-selected='true'] .gate__progress {
    opacity: 1;
  }

  [data-hero].is-auto .gate[aria-selected='true'] .gate__progress::after {
    animation: progress var(--show-ms, 5000ms) linear forwards;
  }

  [data-hero].is-paused .gate[aria-selected='true'] .gate__progress::after {
    animation-play-state: paused;
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  /* Скриншот «выезжает» из сцены */
  .showcase {
    position: relative;
    z-index: 2;
    align-self: center;
    animation: rise-lg 1.2s var(--ease-out) 0.8s both;
  }

  .showcase :global(.shot__body) {
    aspect-ratio: 16 / 8;
  }

  @media (min-width: 1280px) {
    :global(html.wide) .stage__layout {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      align-items: center;
    }

    :global(html.wide) .title {
      max-width: none;
      font-size: clamp(2.6rem, 3.5vw, 5.2rem);
    }

    :global(html.wide) .row {
      grid-template-columns: 1fr;
      align-items: start;
    }

    :global(html.wide) .showcase :global(.shot__body) {
      aspect-ratio: 16 / 10.5;
    }
  }

  @keyframes rise-lg {
    from {
      opacity: 0;
      transform: translateY(48px);
    }
  }

  /* четырёхцветная рамка окна */
  .showcase :global(.shot__frame) {
    border: 1px solid rgb(255 255 255 / 0.16);
    background: var(--night-2);
    box-shadow:
      0 40px 100px -40px rgb(0 0 0 / 0.6),
      var(--shadow-lg);
  }

  .screen:not([hidden]) {
    animation: screen-in 0.6s var(--ease-out);
  }

  @keyframes screen-in {
    from {
      opacity: 0;
      filter: blur(6px);
      transform: scale(0.99);
    }
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .cta .btn {
      width: 100%;
    }

    .proof {
      gap: 6px 16px;
    }

    .proof li + li::before {
      display: none;
    }

    .gate__product,
    .gate__progress {
      display: none;
    }

    .gate__label {
      font-size: 13px;
      line-height: 1.2;
      max-width: 9ch;
    }

    .flow {
      height: 228px;
    }

    .gate__icon {
      width: 38px;
      height: 38px;
      margin: -19px 0 0 -19px;
    }

    .showcase :global(.shot__body) {
      aspect-ratio: 4 / 3.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__glow {
      animation: none;
    }

    .mk {
      color: var(--pc-glow);
      background-size: 100% 0.09em;
    }
  }
</style>

<script>
  import { createFlow } from '../scripts/heroFlow';
  import { reducedMotion } from '../scripts/motion';
  import { PRODUCTS, PRODUCT_ORDER } from '../config/site';

  const INTERVAL = 5000;
  const INTRO_START = 1800;
  const INTRO_STEP = 600;

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const reduced = reducedMotion();
    const gates = [...hero.querySelectorAll<HTMLButtonElement>('[data-gate]')];
    const canvas = hero.querySelector<HTMLCanvasElement>('.flow__canvas')!;
    const flow = createFlow({
      canvas,
      gateEls: gates.map((g) => g.querySelector<HTMLElement>('[data-gate-anchor]')!),
      colors: PRODUCT_ORDER.map((id) => PRODUCTS[id].glow),
      reduced,
    });

    let current = 0;
    let timer: number | undefined;
    let remaining = INTERVAL;
    let startedAt = 0;
    let hovering = false;
    let focused = false;
    let auto = false;

    hero.style.setProperty('--show-ms', `${INTERVAL}ms`);

    const select = (i: number, focus = false) => {
      current = (i + gates.length) % gates.length;
      gates.forEach((g, k) => {
        const on = k === current;
        g.setAttribute('aria-selected', String(on));
        g.tabIndex = on ? 0 : -1;
        document.getElementById(g.getAttribute('aria-controls')!)!.hidden = !on;
      });
      flow.highlight(current);
      if (focus) gates[current].focus();
      const bar = gates[current].querySelector<HTMLElement>('.gate__progress');
      if (bar) {
        bar.style.display = 'none';
        void bar.offsetWidth;
        bar.style.display = '';
      }
      remaining = INTERVAL;
      schedule();
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (!auto || hovering || focused) return;
      startedAt = performance.now();
      timer = window.setTimeout(() => select(current + 1), remaining);
    };

    const pause = () => {
      if (!auto) return;
      window.clearTimeout(timer);
      remaining = Math.max(0, remaining - (performance.now() - startedAt));
      hero.classList.add('is-paused');
    };

    const resume = () => {
      if (hovering || focused) return;
      hero.classList.remove('is-paused');
      schedule();
    };

    gates.forEach((g, i) => g.addEventListener('click', () => select(i)));
    hero.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key === 'ArrowRight') select(current + 1, true);
      else if (key === 'ArrowLeft') select(current - 1, true);
      else return;
      e.preventDefault();
    });

    // пауза при наведении на поток или скриншот и при фокусе
    const zones = [hero.querySelector('[data-flow]')!, hero.querySelector('[data-showcase]')!];
    zones.forEach((z) => {
      z.addEventListener('mouseenter', () => {
        hovering = true;
        pause();
      });
      z.addEventListener('mouseleave', () => {
        hovering = false;
        resume();
      });
    });
    hero.addEventListener('focusin', () => {
      focused = true;
      pause();
    });
    hero.addEventListener('focusout', (e) => {
      if (hero.contains((e as FocusEvent).relatedTarget as Node)) return;
      focused = false;
      resume();
    });

    if (reduced) {
      flow.activateAll();
      gates.forEach((g) => g.classList.add('is-on'));
      select(0);
    } else {
      // Интро: сначала видны потери, затем шлюзы включаются по очереди вместе со словами заголовка
      gates.forEach((g, i) =>
        window.setTimeout(() => {
          flow.activate(i);
          g.classList.add('is-on');
        }, INTRO_START + i * INTRO_STEP),
      );
      window.setTimeout(
        () => {
          auto = true;
          hero.classList.add('is-auto');
          select(0);
        },
        INTRO_START + gates.length * INTRO_STEP,
      );
      flow.highlight(-1);
    }
  }
</script>
