---
import SectionHead from '../components/SectionHead.astro';
import Icon, { type IconName } from '../components/Icon.astro';

const cols: { title: string; icon: IconName; items: string[] }[] = [
  {
    title: 'Данные и доступы',
    icon: 'lock',
    items: [
      'Вся чувствительная информация хранится внутри контура вашей организации',
      'Решение по расхождениям принимает ваш сотрудник',
      'NDA, серверы в России',
    ],
  },
  {
    title: 'Персональные данные',
    icon: 'user-x',
    items: ['Персональные данные не храним', 'Доступы к госсистемам остаются у ваших сотрудников'],
  },
  {
    title: 'Статус компании',
    icon: 'badge-check',
    items: ['Аккредитованная IT-компания', 'Резидент Сколково'],
  },
  {
    title: 'Интеграции',
    icon: 'plug',
    items: [
      'ГИС ЖКХ, Росреестр, ФИАС, ФНС',
      'Биллинг и 1С: выгрузка в Excel, запись одной кнопкой',
      'ФГИС УТКО по API; любые автовесы',
    ],
  },
];
---

<section class="section dark sec-sec" id="bezopasnost">
  <div class="container">
    <SectionHead idx="11" label="Безопасность">
      Безопасность, данные и интеграции
      <Fragment slot="lead">Ответы на вопросы юриста, службы безопасности и ИТ — до первой встречи.</Fragment>
    </SectionHead>

    <div class="sec">
      {
        cols.map((c, i) => (
          <div class="sec__col" style={`--d:${i}`} data-reveal>
            <span class="sec__icon">
              <Icon name={c.icon} size={22} />
            </span>
            <h3 class="sec__title">{c.title}</h3>
            <ul class="sec__list">
              {c.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sec-sec {
    overflow: hidden;
    isolation: isolate;
  }

  .sec-sec::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgb(255 255 255 / 0.08) 1px, transparent 1.3px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 30%, #000 10%, transparent 75%);
  }

  .sec {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--night-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: rgb(255 255 255 / 0.02);
  }

  .sec__col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(22px, 2.6vw, 34px);
  }

  .sec__col + .sec__col {
    border-left: 1px solid var(--night-line);
  }

  .sec__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 14px;
    background: var(--night-2);
    color: #fff;
  }

  .sec__title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .sec__list {
    display: grid;
    gap: 12px;
  }

  .sec__list li {
    position: relative;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--night-muted);
    text-wrap: pretty;
  }

  .sec__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--night-muted);
    border-radius: 2px;
  }

  @media (max-width: 1000px) {
    .sec {
      grid-template-columns: 1fr 1fr;
    }

    .sec__col:nth-child(3) {
      border-left: 0;
    }

    .sec__col:nth-child(n + 3) {
      border-top: 1px solid var(--night-line);
    }
  }

  @media (max-width: 600px) {
    .sec {
      grid-template-columns: 1fr;
    }

    .sec__col + .sec__col {
      border-left: 0;
      border-top: 1px solid var(--night-line);
    }
  }
</style>
